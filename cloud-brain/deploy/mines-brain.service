[Unit]
Description=Mines cloud brain (durable agent tasks, loopback 127.0.0.1:8790 only; phone reaches it through its SSH tunnel)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=mbrain
Group=mbrain
WorkingDirectory=/opt/mines-brain
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=MB_HOST=127.0.0.1 MB_PORT=8790 MB_WORKERS=2
Environment=MB_DB=/var/lib/mines-brain/brain.db MB_TOKEN_FILE=/var/lib/mines-brain/token
Environment=MB_DEVBOX_KEY=/var/lib/mines-brain/devbox_ed MB_DEVBOX_PORT=22022 MB_CDP=http://127.0.0.1:9222
ExecStart=/usr/bin/python3 -m mines_brain.server
Restart=always
RestartSec=3
# small box (t4g.small, 2 GB, shared with sing-box / chromium / devbox): stay small, be the first to be squeezed
MemoryHigh=300M
MemoryMax=400M
CPUQuota=80%
OOMScoreAdjust=300
TasksMax=128
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mines-brain
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
