{
  "manifest_version": 2,
  "name": "Mines Browser Bridge",
  "version": "1.0",
  "description": "Lets Mines read and operate pages in its own browser (built into the Mines app).",
  "browser_specific_settings": { "gecko": { "id": "mines-browser@openminis" } },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": false }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "<all_urls>"],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}
