#!/bin/sh
# [Mines-net-26] mines-devkit — one-tap developer toolkit for the sandbox.
#
#   mines-devkit install [--no-java]   gcc/g++/make (build-base), python3 + pip, nodejs + npm,
#                                      git, openjdk17-jdk — picks fast mirrors first, every
#                                      download has a stall guard, then checks each tool works
#   mines-devkit check                 what is installed now
#   mines-devkit vps-command           the command that installs the same kit on a Linux server
PKGS="build-base python3 py3-pip nodejs npm git openjdk17-jdk"

check() {
    local miss="" v
    for t in "gcc --version" "g++ --version" "make --version" "python3 --version" "pip --version" "node --version" "npm --version" "git --version" "java -version"; do
        set -- $t
        if v=$($t 2>&1 | head -1) && command -v "$1" >/dev/null 2>&1; then echo "  ✓ $1  $v"; else echo "  ✗ $1 没装好"; miss="$miss $1"; fi
    done
    if command -v gcc >/dev/null 2>&1; then
        d=$(mktemp -d); printf '#include <stdio.h>\nint main(void){puts("ok");return 0;}\n' > "$d/h.c"
        if gcc "$d/h.c" -o "$d/h" 2>/dev/null && [ "$("$d/h")" = ok ]; then echo "  ✓ C 编译运行正常"; else echo "  ✗ gcc 编译测试失败"; miss="$miss gcc-test"; fi
        rm -rf "$d"
    fi
    MISSING=$miss
}

case ${1:-install} in
    install)
        pk=$PKGS; [ "$2" = "--no-java" ] && pk=$(echo "$PKGS" | sed 's/ openjdk17-jdk//')
        echo "① 选最快的软件源…"
        mines-mirror auto apk pip npm || echo "  （测速有失败，继续用现有软件源）"
        echo "② 更新软件包列表…"
        apk update || { echo "✗ 软件包列表下载失败。运行 mines-doctor 看原因。"; echo "MINES_DEVKIT_FAIL"; exit 1; }
        echo "③ 安装：$pk（约 300–400 MB，按网速几分钟到十几分钟）"
        apk add $pk || { echo "✗ 安装没完成。运行 mines-doctor 看原因；也可以改在 VPS 上装。"; echo "MINES_DEVKIT_FAIL"; exit 1; }
        echo "④ 检查…"
        check
        if [ -n "$MISSING" ]; then echo "✗ 这些没装好：$MISSING"; echo "MINES_DEVKIT_FAIL"; exit 1; fi
        echo "✓ 开发工具包装好了"; echo "MINES_DEVKIT_OK" ;;
    check) check; [ -z "$MISSING" ] ;;
    vps-command)
        echo 'set -e; if command -v apt-get >/dev/null 2>&1; then S=""; [ "$(id -u)" = 0 ] || S=sudo; $S env DEBIAN_FRONTEND=noninteractive apt-get update -q && $S env DEBIAN_FRONTEND=noninteractive apt-get install -y -q build-essential python3 python3-pip nodejs npm git openjdk-17-jdk-headless; elif command -v dnf >/dev/null 2>&1; then dnf install -y gcc gcc-c++ make python3 python3-pip nodejs npm git java-17-openjdk-devel; elif command -v yum >/dev/null 2>&1; then yum install -y gcc gcc-c++ make python3 python3-pip nodejs npm git java-17-openjdk-devel; elif command -v apk >/dev/null 2>&1; then apk add build-base python3 py3-pip nodejs npm git openjdk17-jdk; else echo "unknown distro"; exit 2; fi; gcc --version | head -1; python3 --version; node --version; git --version; java -version 2>&1 | head -1; echo MINES_DEVKIT_OK' ;;
    *) sed -n '2,9p' "$0"; exit 2 ;;
esac
