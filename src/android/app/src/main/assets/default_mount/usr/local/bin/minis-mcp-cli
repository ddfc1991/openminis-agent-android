#!/bin/sh
# minis-mcp-cli — MinisApp MCP (Model Context Protocol) client for iSH/PRoot.
#
# Thin sh wrapper: ensures the python3 + httpx runtime is present, then execs
# the shared Python implementation. The Python under
# /usr/local/lib/minis-mcp-cli is platform-neutral and is shipped identically
# on iOS (iSH) and Android (PRoot/Alpine) — keep it POSIX + dependency-light.
#
# Data file: /var/minis/mcp-servers/servers.json (mcpServers object format,
# Claude-Desktop compatible). Logs: /var/minis/mcp-servers/mcp-cli.log.
# Diagnostics go to the log, never to stdout (stdout is reserved for the
# JSON the agent parses).

LOG="/var/minis/mcp-servers/mcp-cli.log"
# [issue #380] Do NOT `mkdir -p /var/minis/mcp-servers` here.
#
# That path is a SYMLINK the host maintains into its App Group. Creating it from
# the guest wins the race whenever the link is not yet in place and leaves a real
# local directory shadowing the mount: the app then writes OAuth bridge files into
# the App Group that this sandbox can never read, and every MCP call reports "not
# authorized" while the host believes authorization succeeded.
#
# The host owns this directory (ensureMinisSymlinks). If it is missing, logging is
# the only thing that degrades — `_log` already discards errors — and the Python
# below reports the real problem with the path it tried.
_log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG" 2>/dev/null; }

# Ensure python3 is available.
if ! command -v python3 > /dev/null 2>&1; then
  _log "Installing python3..."
  apk add --quiet python3 py3-pip >> "$LOG" 2>&1
fi

# [Mines-mcp-29] The lib dir is read-only, so python could never cache its
# bytecode and recompiled every module on every call (slow under PRoot). Keep
# the cache under /root instead.
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-/root/.cache/minis-mcp-pyc}"

# httpx is only needed for HTTP servers and is imported lazily now. Check it
# once (stamp file) instead of starting a second python on every call; prefer
# Alpine's py3-httpx (no pip / PyPI needed).
STAMP=/root/.cache/minis-mcp-httpx.ok
if [ ! -f "$STAMP" ]; then
  if python3 -c "import httpx" 2>/dev/null; then
    mkdir -p /root/.cache 2>/dev/null; : > "$STAMP" 2>/dev/null
  else
    _log "Installing httpx..."
    apk add --quiet py3-httpx >> "$LOG" 2>&1 || pip install --quiet httpx >> "$LOG" 2>&1 || \
        pip install --quiet --break-system-packages httpx >> "$LOG" 2>&1
    python3 -c "import httpx" 2>/dev/null && { mkdir -p /root/.cache; : > "$STAMP"; }
  fi
fi

exec python3 /usr/local/lib/minis-mcp-cli/main.py "$@"
