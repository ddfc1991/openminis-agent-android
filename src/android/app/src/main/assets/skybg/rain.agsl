        float by = i == 0 ? 0.71 : (i == 1 ? 0.62 : (i == 2 ? 0.77 : (i == 3 ? 0.79 : (i == 4 ? 0.66 : (i == 5 ? 0.69 : 0.61)))));
        float br = i == 0 ? 9.0 : (i == 1 ? 6.0 : (i == 2 ? 12.0 : (i == 3 ? 7.5 : (i == 4 ? 10.0 : (i == 5 ? 8.0 : 5.5)))));
        float bi = i == 0 ? 0.16 : (i == 1 ? 0.12 : (i == 2 ? 0.20 : (i == 3 ? 0.14 : (i == 4 ? 0.18 : (i == 5 ? 0.15 : 0.11)))));
        float3 bc = i == 4 ? float3(half3(0.7882, 0.5725, 0.3686)) : (i == 5 ? float3(half3(0.7255, 0.5176, 0.3412)) : (i == 1 ? float3(half3(0.4980, 0.6275, 0.7098)) : (i == 3 ? float3(half3(0.5412, 0.6510, 0.7216)) : float3(half3(0.4353, 0.5608, 0.6588)))));
        float ph = float(i) * 1.7;
