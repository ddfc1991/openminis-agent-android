/** one water drop on the glass (yu2 / yu4 maps): height gradient G, refraction mask M, rim, dark edge, speculars, caustic */
void rDrop(inout float2 G, inout float M, inout float RIM, inout float EDGE, inout float SPEC, inout float CAU,
           float2 p, float2 ctr, float R, float ax, float av) {
    float2 d = p - ctr;
    float r2 = ((d.x / ax) * (d.x / ax) + (d.y * ax) * (d.y * ax)) / (R * R);
    if (r2 > 1.69 || av <= 0.0) return;
    float r = sqrt(r2);
    float dome = max(1.0 - r2, 0.0);
    if (r2 < 1.0) G += av * -2.0 * float2(d.x / (ax * ax), d.y * ax * ax);
    M = max(M, av * ss(0.0, 0.3, dome));
