        float per = life + 0.8 + 4.5 * h12(g + 7.9);
        float ph = h12(g + 1.1) * per;
        float cyc = floor((t + ph) / per); float age = mod(t + ph, per);
        if (age > life) continue;
        if (h12(g + cyc * 3.7 + 0.4) > 0.55 * zone + 0.1) continue;
        float2 rr = h22(g + cyc * 1.37);
        float2 ctr = (g + 0.1 + 0.8 * rr) * cell;
        float rmax = 34.0 + 56.0 * h12(g + cyc * 2.1), amp0 = 0.45 + 0.55 * h12(g + cyc * 5.3), asp = 0.86 + 0.10 * h12(g + cyc * 6.1);
        float a = age / life;
        float R = rmax * (1.0 - exp(-2.4 * a)) / (1.0 - exp(-2.4)) + 1.0;
        float wd = 4.5 + 4.0 * a;
        float amp = amp0 * pow(1.0 - a, 1.7) * min(1.0, a / 0.05);
        float2 d = float2(q.x - ctr.x, (q.y - ctr.y) / asp);
