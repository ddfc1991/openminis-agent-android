    float lit = clamp(-(Gr.x * 0.6 + Gr.y) * 3.0, -1.0, 1.0);
    float kz = 0.35 + 0.65 * rzU(yo);
    float3 o = refr + (silver - refr) * (clamp(0.35 * lit, 0.0, 0.22) * kz) - (0.06 * clamp(-lit, 0.0, 1.0) * kz) * refr;
    o = float3(screen(half3(o), half3(silver), 0.45 * clamp(Pk, 0.0, 1.0) * kz));
    // a few soft pink petals floating (defocused hints)
    float wv = TAU * cloudT / 26.0;
    float3 cpink = float3(half3(0.9216, 0.8078, 0.8510)), clight = float3(half3(0.9647, 0.9020, 0.9255)), cdeep = float3(half3(0.8667, 0.7059, 0.7686));
    for (int i = 0; i < 6; i++) {
        float px = i == 0 ? 0.16 : (i == 1 ? 0.80 : (i == 2 ? 0.50 : (i == 3 ? 0.30 : (i == 4 ? 0.68 : 0.06))));
        float py = i == 0 ? 0.645 : (i == 1 ? 0.715 : (i == 2 ? 0.785 : (i == 3 ? 0.815 : (i == 4 ? 0.630 : 0.120))));
        float sz = 0.5 * (i == 0 ? 34.0 : (i == 1 ? 38.0 : (i == 2 ? 24.0 : (i == 3 ? 40.0 : (i == 4 ? 26.0 : 36.0)))));
        float df = 0.5 * (i == 0 ? 22.0 : (i == 1 ? 26.0 : (i == 2 ? 7.0 : (i == 3 ? 30.0 : (i == 4 ? 12.0 : 26.0)))));
        float al = i == 0 ? 0.40 : (i == 1 ? 0.36 : (i == 2 ? 0.55 : (i == 3 ? 0.30 : (i == 4 ? 0.45 : 0.28))));
        float fi = float(i);
        float ox = 0.5 * (14.0 + 20.0 * h12(float2(fi, 1.0))), oy = 0.5 * (8.0 + 12.0 * h12(float2(fi, 2.0)));
        float ph = TAU * h12(float2(fi, 3.0)); float kk = (h12(float2(fi, 4.0)) < 0.5 ? -1.0 : 1.0) * (h12(float2(fi, 5.0)) < 0.5 ? 1.0 : 2.0);
        float2 c = float2(px * 360.0 + ox * sin(kk * wv + ph) + 0.5 * ox * sin(2.0 * wv + 1.3 * ph), py * DH + oy * cos(kk * wv + ph));
        float2 dd = q - c;
        if (abs(dd.x) > sz + 3.0 * df + 4.0 || abs(dd.y) > sz + 3.0 * df + 4.0) continue;
        float ang = TAU * h12(float2(fi, 6.0)) + (0.35 + 0.55 * h12(float2(fi, 7.0))) * sin(wv + ph) + 0.25 * sin(3.0 * wv + 2.0 * ph);
        float casp = 0.80 + 0.12 * h12(float2(fi, 8.0)), tone = h12(float2(fi, 9.0));
        float ca = cos(ang), sa = sin(ang);
        float u = (dd.x * ca + dd.y * sa) / sz; float vv = (-dd.x * sa + dd.y * ca) / (sz * casp);
        vv = vv / (0.55 + 0.45 * clamp((u + 1.0) * 0.5, 0.0, 1.0));            // teardrop: narrow at the base
        float notch = 0.22 * exp(-sq((u - 1.0) / 0.18) - sq(vv / 0.25));
        float dist = sqrt(u * u + vv * vv) + notch;
        float soft = df / sz;
        float m = 1.0 - ss(1.0 - 0.35 * soft - 0.05, 1.0 + soft + 0.05, dist);
        float3 col = mix(cpink, clight, 0.55 * (1.0 - ss(0.0, 0.9, dist)) + 0.2 * tone);
        col = mix(col, cdeep, 0.35 * clamp((-0.2 - u) / 0.8, 0.0, 1.0));
        float aa = min(1.06 * al * m, 0.8);
        o = o * (1.0 - aa) + col * aa;
    }
    // drizzle: barely there, only against the darker water in the open stage
    float lumU = dot(float3(sky.eval(fragCoord).rgb), float3(0.3333));
    float vis = clamp((0.82 - lumU) * 4.0, 0.0, 1.0) * rzU(yo);
    o = float3(screen(half3(o), half3(half3(0.9569, 0.9647, 0.9725)), clamp(drizzle(q, t * 0.45, 0.05 * (q.y - DH * 0.5)) * vis * 0.05, 0.0, 1.0)));
    // gentle vignette
    float r2 = sq((xo - 0.5) / 0.62) + sq((yo - 0.52) / 0.75);
    o = mix(o, float3(half3(0.6627, 0.6980, 0.7373)), clamp(max(r2 - 0.25, 0.0) * 0.09, 0.0, 0.6));
    return half4(rGuard(half3(clamp(o, 0.0, 1.0)), gLo, gHi), 1.0);
}
half4 rainDarkGlass(float2 fragCoord, float sc, float2 p, float DH, float t) {
    // sparse drops on a misted window (yu4 Glass4): drops bead up slowly and evaporate; a few slide and clear a trail
    float2 G = float2(0.0); float M = 0.0, RIM = 0.0, EDGE = 0.0, SPEC = 0.0, CAU = 0.0;
    for (int k = 0; k < 3; k++) {
        float cell = k == 0 ? 33.0 : (k == 1 ? 55.0 : 115.0);
        float Rlo = k == 0 ? 0.9 : (k == 1 ? 2.2 : 4.8); float Rhi = k == 0 ? 2.2 : (k == 1 ? 4.8 : 9.0);
        float2 id = floor(p / cell);
        for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {
            if (k < 2 && (i != 0 || j != 0)) continue;
            float2 g = id + float2(float(i), float(j));
            float ph = h12(g + float(k) * 13.7) * 40.0;
            float life = 10.0 + 9.0 * h12(g + 5.1 + float(k));
            float per = life + 1.0 + 6.0 * h12(g + 9.9);
            float cyc = floor((t + ph) / per); float age = mod(t + ph, per);
            float2 r = h22(g + cyc * 3.17 + float(k) * 1.3);
            float R0 = mix(Rlo, Rhi, h12(g + cyc * 1.91));
            float margin = k < 2 ? R0 * 1.3 / cell : 0.0;
            float2 ctr = (g + margin + (1.0 - 2.0 * margin) * r) * cell;
            float shr = 2.5;
            float av = ss(0.0, 1.2, age) * (1.0 - pow(clamp((age - (life - shr)) / shr, 0.0, 1.0), 1.5)) * step(age, life);
            rDrop(G, M, RIM, EDGE, SPEC, CAU, p, ctr, R0 * (0.75 + 0.25 * min(av, 1.0)), 0.88 + 0.24 * h12(g + cyc), av);
        }
    }
    // sliders: now and then a drop breaks loose and slides down stick-slip with a wobble, leaving beads and a cleared trail
    float clr = 0.0;
    float colW = 90.0; float cx = floor(p.x / colW);
    for (int i = -1; i <= 1; i++) {
        float col = cx + float(i);
        float per = 19.0 + 14.0 * h12(float2(col, 3.0));
        float o0 = h12(float2(col, 7.0)) * per;
        float cyc = floor((t + o0) / per); float st = mod(t + o0, per);
        if (h12(float2(col, cyc)) < 0.45) continue;
        float Rs = 5.0 + 2.5 * h12(float2(col, cyc + 0.5)); float dur = 4.5 + 2.5 * h12(float2(col, cyc + 1.5));
        float y0 = (0.40 + 0.15 * h12(float2(col, cyc + 2.5))) * DH; float ln = (0.28 + 0.14 * h12(float2(col, cyc + 3.5))) * DH;
        float x0 = (col + 0.2 + 0.6 * h12(float2(col, cyc + 4.5))) * colW;
        float wa = 3.0 + 4.0 * h12(float2(col, cyc + 5.5)), wl = 40.0 + 50.0 * h12(float2(col, cyc + 6.5)), wph = TAU * h12(float2(col, cyc + 7.5));
        float q = min(st / dur, 1.0);
        float hy = ln * clamp(q + sin(TAU * q * 4.0) / (TAU * 4.0) * 0.9, 0.0, 1.0);
        float fadeIn = ss(0.0, 0.8, st); float fadeOut = 1.0 - ss(dur + 7.0, dur + 10.0, st);
        float yy = p.y - y0;
        float xPath = x0 + wa * sin(yy / wl + wph) + 2.0 * sin(yy / 22.0);
        if (st < dur + 0.8) {
            float aH = fadeIn * (1.0 - ss(dur, dur + 0.8, st));
            float hx = x0 + wa * sin(hy / wl + wph) + 2.0 * sin(hy / 22.0);
            rDrop(G, M, RIM, EDGE, SPEC, CAU, p, float2(hx, y0 + hy), Rs, 0.84, aH);
            rDrop(G, M, RIM, EDGE, SPEC, CAU, p, float2(hx, y0 + hy - Rs * 0.95), Rs * 0.55, 0.9, aH * 0.8);
        }
        if (yy > 0.0 && yy < hy) {
            float since = st - (yy / ln) * dur;
            float wdt = Rs * (0.75 + 0.2 * sin(yy * 0.23));
            clr = max(clr, exp(-since / 6.0) * fadeIn * fadeOut * (1.0 - ss(wdt * 0.8, wdt, abs(p.x - xPath))));
            float sp = 18.0 + 12.0 * h12(float2(col, cyc + 8.5));
            float kb = floor(yy / sp + 0.5); float by = kb * sp;
            if (by > 6.0 && by < hy) {
                float bx = x0 + wa * sin(by / wl + wph) + 2.0 * sin(by / 22.0);
                float br = (0.18 + 0.22 * h12(float2(col * 3.1 + kb, cyc))) * Rs;
                float sb = st - (by / ln) * dur;
                rDrop(G, M, RIM, EDGE, SPEC, CAU, p, float2(bx, y0 + by), br, 0.95, (1.0 - ss(6.0, 9.5, sb)) * fadeOut);
            }
        }
    }
    M *= 1.0 - 0.8 * clr;
    // the scene behind the glass: night sky (pass 1) + the lamp + drizzle in its light
    float litm;
    float3 hal = lampLight(p, DH, cloudT, litm);   // [3911 integ] lamp / mist on the wind clock, same as pass 1
    float shr = 0.05 * (p.y - DH * 0.5) + 6.0 * sin(TAU * cloudT / RL);
    float rv = drizzle(p, t, shr);
    float3 add = clamp(hal + float3(half3(1.0000, 0.8627, 0.6510)) * (0.60 * rv * litm), 0.0, 1.0);
    float3 base = skyAt(fragCoord);
    float3 bg = 1.0 - (1.0 - base) * (1.0 - add);
    // condensation: soft-focus everything and bloom the lamp; slid trails clear it
    float3 bl = float3(0.0);
    float rb = 9.0 * sc;
    for (int k = 0; k < 8; k++) { float a = float(k) * 0.785398 + 0.39; bl += skyAt(fragCoord + float2(cos(a), sin(a)) * rb); }
    bl = bl / 8.0;
    float3 bloom = 1.0 - (1.0 - bl) * (1.0 - clamp(hal * 1.15, 0.0, 1.0));
    float3 fogc = float3(half3(0.1020, 0.1490, 0.2078));
    float speck = T3b(p * 1.7);
    float fa = (0.42 + 0.08 * clamp(speck / 1.6, -1.0, 1.0)) * (1.0 - 0.85 * clr) * (1.0 - M);
    float3 o = mix(bg, bloom * 1.05 + fogc * 0.22, fa);
    float2 off = G * 10.0 * sc;
    if (M > 0.004) {                                 // drop = inverted, minified view of the scene behind (lamp included)
        float litr;
        float3 hr = lampLight(p + G * 10.0, DH, cloudT, litr);
        float3 br0 = skyAt(fragCoord + off);
        float3 refr = (1.0 - (1.0 - br0) * (1.0 - clamp(hr, 0.0, 1.0))) * 1.12 + 0.008;
        o = mix(o, refr, M);
    }
    o = o * (1.0 - 0.45 * EDGE);
    float lumL = dot(bloom, float3(0.3333));
    float3 ltint = clamp(bloom / max(lumL, 0.02) * clamp(lumL * 3.0, 0.2, 1.5), 0.0, 1.5) * 0.6;
    o = o + (min(ltint, float3(1.4)) * 0.40 + float3(half3(0.6863, 0.7529, 0.8118)) * 0.07) * RIM;
    o = float3(screen(half3(o), half3(half3(1.0000, 0.9412, 0.8549)), 0.28 * SPEC * (0.25 + 0.9 * clamp(lumL * 3.0, 0.0, 1.0))));
    o = o + min(ltint, float3(1.4)) * 0.55 * CAU;
    // grade: lifted blacks, gentle cool vignette
    o = o * 0.94 + float3(half3(0.0549, 0.0863, 0.1333)) * 0.054;
    float xo = p.x / 360.0, yo = p.y / DH;
    float r2 = sq((xo - 0.5) / 0.62) + sq((yo - 0.52) / 0.75);
    o = mix(o, float3(half3(0.0471, 0.0784, 0.1255)) * 0.7, clamp(max(r2 - 0.25, 0.0) * 0.22, 0.0, 0.6));
    // text guard; home keeps the lamp bright in the open stage (no text there), the chat page stays strict
    float hi = gHi >= 0.1 && gHi < 1.0 ? mix(gHi, 0.80, rzOpen(yo)) : gHi;
    return half4(rGuard(half3(clamp(o, 0.0, 1.0)), gLo, hi), 1.0);
}
half4 main(float2 fragCoord) {
    float sc = iResolution.x / 360.0;             // glass maps designed at 360 px wide (yu4 / yu5 half res)
    float2 p = fragCoord / sc;
    float DH = iResolution.y / sc;
    return gk > 0.5 ? rainDarkGlass(fragCoord, sc, p, DH, iTime) : rainLightGlass(fragCoord, sc, p, DH, iTime);
}
