    EDGE = max(EDGE, av * ss(0.55, 0.85, r) * (1.0 - ss(0.88, 1.0, r)) * (0.45 + clamp(0.5 - d.y / R, 0.0, 1.2)));
    SPEC = max(SPEC, av * exp(-(((d.x + 0.32 * R) * (d.x + 0.32 * R) + (d.y + 0.42 * R) * (d.y + 0.42 * R)) / ((0.2 * R) * (0.2 * R)))));
    CAU = max(CAU, av * ss(0.35, 0.8, r) * (1.0 - ss(0.8, 1.0, r)) * clamp(d.y / R + 0.1, 0.0, 1.0));
}
/** ring profile (yu5 Ripples5): value + d/dr of exp(-((r-R)/w)^2) - 0.7 exp(-((r-R+k w)/w)^2) */
float2 rRing(float r, float R, float w, float k) {
    float a = (r - R) / w, b = (r - R + k * w) / w;
    float ea = exp(-a * a), eb = exp(-b * b);
    return float2(ea - 0.7 * eb, (-2.0 * a * ea + 1.4 * b * eb) / w);
}
half4 rainLightGlass(float2 fragCoord, float sc, float2 q, float DH, float t) {
    float3 silver = float3(half3(0.9333, 0.9412, 0.9529));
    // ripples: soft wide double rings seen from above, mostly in the open stage, a few near the top; tiny glint where they land
    float F = 0.0; float2 Gr = float2(0.0); float Pk = 0.0;
    float cell = 120.0;
    float2 id = floor(q / cell);
    for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {
        float2 g = id + float2(float(i), float(j));
        float2 cc = (g + 0.5) * cell;
        float yc = cc.y / DH;
        float zone = ss(0.50, 0.585, yc) * (1.0 - ss(0.835, 0.90, yc)) + 0.35 * ss(0.0, 0.03, yc) * (1.0 - ss(0.20, 0.26, yc));
        if (zone < 0.02) continue;
