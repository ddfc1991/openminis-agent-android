        float2 v = rRing(r, R, wd, 2.2);
        if (a > 0.12) v += 0.5 * rRing(r, 0.58 * R, wd, 2.0);
        F += amp * v.x;
        Gr += amp * v.y * float2(d.x / r, d.y / (r * asp));
        if (age < 0.30) Pk += exp(-age / 0.09) * amp0 * exp(-sq(r / 2.2));
    }
    float yo = q.y / DH, xo = q.x / 360.0;
