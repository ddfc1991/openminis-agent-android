uniform float cloudT;
// [38.9.11.1] 天空动画: calm 1 = 流畅 (subtler fog, gentler contrast), 0.5 = 精美; hq 1 = full fog layers + shafts, 0 = three layers + soft glow
uniform float calm;
uniform float hq;
// [38.9.11.2] 晴 「闪光」 fix (user: gentle light, never glare / flashes): 1 = the light-breathing term follows a slow smooth curve
// (was 4 point samples of the cloud mask that stepped by 0.25 as a cloud edge crossed one → the glow pulsed between key frames),
// shafts 30 %, glare core and lit cloud rims softened, in 流畅 and 精美. 0 = 38.9.11.1 (smoke before / after only).
uniform float sunFix;
uniform float dark;
uniform float3 liftTint;
uniform float lift;
uniform float3 mulc;
uniform float gLo;
uniform float gHi;
uniform shader tex0;
uniform shader tex1;
uniform shader tex2;
uniform shader tex3;

const float TAU = 6.2831853;
const float SPAN = 9.0;
const float GAIN = 1.0;

float ss(float a, float b, float x) { float t = clamp((x - a) / (b - a), 0.0, 1.0); return t * t * (3.0 - 2.0 * t); }
float bump(float t, float t0, float t1, float fade) { return ss(t0, t0 + fade, t) * (1.0 - ss(t1 - fade, t1, t)); }
/** a soft window [t0, t1] that comes back every [period] seconds */
float ev(float t, float period, float t0, float t1, float fade) { return bump(mod(t, period), t0, t1, fade); }
half3 mixc(half3 a, half3 b, float w) { return mix(a, b, half(clamp(w, 0.0, 1.0))); }
half3 screen(half3 a, half3 c, float w) { return 1.0 - (1.0 - a) * (1.0 - c * half(clamp(w, 0.0, 1.0))); }
float h12(float2 p) { float3 q = fract(float3(p.xyx) * 0.1031); q += dot(q, q.yzx + 33.33); return fract((q.x + q.y) * q.z); }
float2 h22(float2 p) { float3 q = fract(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973)); q += dot(q, q.yzx + 33.33); return fract((q.xx + q.yz) * q.zy); }

float T0r(float2 u) { return (float(tex0.eval(u).r) - 0.5) * SPAN; }
float T0g(float2 u) { return (float(tex0.eval(u).g) - 0.5) * SPAN; }
float T0b(float2 u) { return (float(tex0.eval(u).b) - 0.5) * SPAN; }
float W1(float2 u) { return (float(tex1.eval(u).r) - 0.5) * SPAN; }
float W2(float2 u) { return (float(tex1.eval(u).g) - 0.5) * SPAN; }
float T1b(float2 u) { return (float(tex1.eval(u).b) - 0.5) * SPAN; }
float T2r(float2 u) { return (float(tex2.eval(u).r) - 0.5) * SPAN; }
float T2g(float2 u) { return (float(tex2.eval(u).g) - 0.5) * SPAN; }
float T2b(float2 u) { return (float(tex2.eval(u).b) - 0.5) * SPAN; }
float T3r(float2 u) { return (float(tex3.eval(u).r) - 0.5) * SPAN; }
float T3g(float2 u) { return (float(tex3.eval(u).g) - 0.5) * SPAN; }
float T3b(float2 u) { return (float(tex3.eval(u).b) - 0.5) * SPAN; }
float TX(int ch, float2 u) {
    if (ch == 0) return T0r(u); if (ch == 1) return T0g(u); if (ch == 2) return T0b(u); if (ch == 5) return T1b(u);
    if (ch == 6) return T2r(u); if (ch == 7) return T2g(u); if (ch == 8) return T2b(u);
    if (ch == 9) return T3r(u); if (ch == 10) return T3g(u); return T3b(u);
}

// camera: the gaze wanders on slow, never-repeating paths (pan, roll, dolly, perspective tilt: the top recedes)
// A = (px, py, roll rad, zoom), B = (tilt k, kx)
void cam(float t, float2 pan, float rotDeg, float zoom, float2 tilt, float ph, out float4 A, out float2 B) {
    float w = TAU * t / 61.0, w2 = TAU * t / 37.0, w3 = TAU * t / 23.0;
    float px = pan.x * (sin(w + ph) + 0.45 * sin(w2 + 1.3 + ph));
    float py = pan.y * (sin(w + 2.1 + ph) * 0.8 + 0.5 * sin(w3 + 0.4 + ph));
    float r = radians(rotDeg) * (sin(w + 0.7 + ph) + 0.3 * sin(w2 + 2.4));
    float z = 1.0 + zoom * sin(w + 4.0 + ph);
    A = float4(px, py, r, z);
    B = float2(tilt.x + tilt.y * sin(w + 1.9 + ph), 0.12 * sin(w + 3.3 + ph));
}
/** world texture coords of a layer: depth 0 far .. 1 near (parallax + dolly), scale = texels per px */
float2 camUV(float2 c, float BH, float4 A, float2 B, float depth, float scale) {
    float zz = 1.0 + (A.w - 1.0) * (0.4 + 1.2 * depth);
    float kk = B.x * (0.5 + 0.8 * depth);
    float D = max(1.0 + kk * (c.y / BH) + B.y * (c.x / 270.0), 0.25);
    float2 q = c / D;
    float cs = cos(A.z), sn = sin(A.z);
    float2 uv = float2(cs * q.x - sn * q.y, sn * q.x + cs * q.y) / zz;
    return (uv + A.xy * (0.35 + 1.3 * depth)) * scale;
}
/** domain-warped cloud noise advected by the wind (sky.py cloud_noise) */
float cnoise(int ch, float2 uv, float2 wind, float warp, float wspd, float aniso, float t) {
    float uu = uv.x + wind.x * t; float vv = (uv.y + wind.y * t) * aniso;
    float wu = W1(float2(uu * 0.6 + wspd * t, vv * 0.6));
    float wv = W2(float2(uu * 0.6 - wspd * 0.7 * t, vv * 0.6 + wspd * 0.5 * t));
    return TX(ch, float2(uu + warp * wu, vv + warp * wv)) * GAIN;
}
/** cheap version (no warp) for ray marching */
float cfast(int ch, float2 uv, float2 wind, float aniso, float t) {
    return TX(ch, float2(uv.x + wind.x * t, (uv.y + wind.y * t) * aniso)) * GAIN;
}

// ── 雨 timing (shared by the sky pass and the glass pass) ──
/** 1 = steady rain; eases to a lighter gap and thickens again (never the same rhythm: incommensurate periods) */
float rainDensity(float t) { return 1.0 - 0.72 * ev(t, 53.0, 18.0, 33.0, 5.0); }
float flash1(float x) { // a few quick decaying pulses after x = 0
    float e = 0.0;
    if (x >= 0.0 && x < 2.2) {
        e += 1.0 * exp(-x / 0.07) * min(1.0, x / 0.03 + 0.0001);
        float y = x - 0.16; if (y >= 0.0) e += 0.55 * exp(-y / 0.05) * min(1.0, y / 0.03);
        y = x - 0.42; if (y >= 0.0) e += 0.85 * exp(-y / 0.12) * min(1.0, y / 0.03);
        y = x - 1.0; if (y >= 0.0) e += 0.35 * exp(-y / 0.18) * min(1.0, y / 0.03);
    }
    return e;
}
/** soft in-cloud lightning: every ~37 s / ~59 s, a few flickers */
float rainFlash(float t) { return flash1(mod(t, 37.0) - 11.0) + 0.6 * flash1(mod(t, 59.0) - 40.0); }
float2 rainFlashPos(float t, float BH) { return mod(floor(t / 37.0), 2.0) < 1.0 ? float2(270.0 * 0.22, BH * 0.20) : float2(270.0 * 0.78, BH * 0.33); }
/** late amber glow breaking low */
float rainAmber(float t) { return ev(t, 71.0, 30.0, 52.0, 7.0); }

// ── theme grade + text guard (WCAG luminance, linear space) ──
uniform float desat;
/** theme grade: dark = contrast (lift) + desaturate a little + multiply; light = lift toward the page tint */
half3 themeGrade(half3 c) {
    // [i29] dark: lift = contrast, c^(1 + 2*lift) before the multiply, so pale day skies keep their cloud structure
    if (dark > 0.5) { half3 k = half3(pow(max(float3(c), float3(0.0)), float3(1.0 + 2.0 * lift))); float g = dot(float3(k), float3(0.3, 0.59, 0.11)); return mix(k, half3(g), half(desat)) * half3(mulc); }
    return mix(c, half3(liftTint), half(lift));
}
/** text guard: light theme lifts the dark parts into [gLo, knee] (dark ink ≥ 4.5:1); dark theme pulls the bright parts into
 *  [knee, gHi] (light ink ≥ 4.5:1). Soft knee, in linear light, so the sky keeps its structure above / below the knee. */
half3 guard(half3 c) {
    float3 lin = pow(max(float3(c), float3(0.0)), float3(2.2));
    float L = dot(lin, float3(0.2126, 0.7152, 0.0722));
    if (gLo > 0.0) {
        float knee = min(gLo * 1.5, 0.95);
        if (L < knee) {
            float target = gLo + L * (knee - gLo) / knee;
            float3 tl = pow(float3(liftTint), float3(2.2)); float Lt = dot(tl, float3(0.2126, 0.7152, 0.0722));
            lin = mix(lin, tl, clamp((target - L) / max(Lt - L, 1e-3), 0.0, 1.0));
        }
    }
    if (gHi < 1.0) {
        float knee = gHi * 0.6;
        if (L > knee) { float target = knee + (L - knee) * (gHi - knee) / max(1.0 - knee, 1e-3); lin *= target / L; }
    }
    return half3(pow(lin, float3(1.0 / 2.2)));
}

// ── 夜 cloud deck (shared: the sky pass draws it, the stars pass hides stars behind it) ──
float yeCloud(float2 c, float BH, float t, float4 A, float2 B) {
    float2 uv = camUV(c, BH, A, B, 1.0, 0.35);
    return cnoise(5, uv, float2(9.0, 2.0), 9.0, 0.8, 1.0, t);
}
void yeCam(float t, out float4 A, out float2 B) { cam(t, float2(40.0, 30.0), 7.0, 0.05, float2(0.30, 0.10), 2.0, A, B); }
//#SKY sunny
// 晴: real blue top → warm cream / peach bottom, huge out-of-focus cloud masses, warm light breaking through, sweeping shafts
float qOcc(float2 c, float BH, float t, float4 A, float2 B) {
    float th1 = 0.65 - 0.5 * (0.5 + 0.5 * sin(TAU * t / 27.0 + 1.35));
    float th2 = 0.80 - 0.5 * (0.5 + 0.5 * sin(TAU * t / 45.0 + 3.0));
    float n1 = cfast(1, camUV(c, BH, A, B, 0.45, 0.30), float2(6.0, 1.2), 1.0, t);
    float n2 = cfast(0, camUV(c, BH, A, B, 1.0, 0.19), float2(10.0, 2.0), 1.0, t);
    return max(ss(th1, th1 + 1.25, n1), ss(th2, th2 + 1.25, n2));
}
half3 skyColor(float2 p, float BH, float t) {
    half3 top = half3(0.4235, 0.5765, 0.7216), mid = half3(0.6588, 0.7529, 0.8275), low = half3(0.9333, 0.8745, 0.7961);
    half3 cloud = half3(0.9647, 0.9529, 0.9333), cshad = half3(0.6549, 0.7137, 0.7765), lit = half3(1.0000, 0.9137, 0.7843), warm = half3(1.0000, 0.8667, 0.6902);
    float2 c = p - float2(135.0, BH * 0.5); float xn = p.x / 270.0, yn = p.y / BH;
    float4 A; float2 B; cam(t, float2(80.0, 55.0), 6.0, 0.09, float2(0.45, 0.15), 0.0, A, B);
    float2 L = float2(270.0 * (0.92 + 0.10 * sin(TAU * t / 67.0 + 0.5)), BH * (-0.06 + 0.05 * sin(TAU * t / 41.0 + 1.0)));
    float g = clamp(yn + 0.08 * sin(xn * 3.0 + 1.0), 0.0, 1.0);
    half3 img = mixc(top, mid, ss(0.0, 0.62, g));
    img = mixc(img, low, pow(ss(0.45, 1.0, g), 1.2));
    float dist = length((p - L) / 270.0);
    img = mixc(img, warm, 0.70 * exp(-pow(dist / 0.42, 1.5)));
    img = screen(img, lit, (0.5 - 0.25 * sunFix) * exp(-(dist / 0.22) * (dist / 0.22)));   // glare core softened
    // far: thin high veil, slow; it thickens and thins
    float n = cnoise(2, camUV(c, BH, A, B, 0.0, 0.55), float2(4.0, 0.6), 6.0, 0.5, 1.0, t);
    float cov = -0.05 + 0.25 * sin(TAU * t / 47.0 + 1.2);
    float d = ss(0.4 - cov, 1.9 - cov, n) * 0.45;
    img = mixc(img, cloud * 0.98 + warm * 0.02, d);
    float2 dir = normalize(L - p + float2(1e-3, 0.0));
    // mid + near: huge soft masses, near drifts faster (parallax); gaps open and close
    for (int k = 0; k < 2; k++) {
        float depth = k == 0 ? 0.45 : 1.0; float sc = k == 0 ? 0.30 : 0.19;
        float2 wind = k == 0 ? float2(6.0, 1.2) : float2(10.0, 2.0); float wp = k == 0 ? 9.0 : 12.0;
        float base = k == 0 ? 0.65 : 0.80; float alpha = k == 0 ? 0.80 : 0.90; int ch = k == 0 ? 1 : 0;
        n = cnoise(ch, camUV(c, BH, A, B, depth, sc), wind, wp, 0.9, 1.0, t);
        float th = base - 0.5 * (0.5 + 0.5 * sin(TAU * t / (k == 0 ? 27.0 : 45.0) + depth * 3.0));
        d = ss(th, th + 1.25, n);
        float nl = cnoise(ch, camUV(c + dir * 9.0, BH, A, B, depth, sc), wind, wp, 0.9, 1.0, t);
        float litv = clamp(n - nl, 0.0, 1.0) * exp(-dist * 0.8) * d;
        float shade = ss(0.2, 1.9, n) * (1.0 - 0.5 * exp(-dist * 1.5)) * 1.3;
        half3 col = cloud * half(1.0 - shade * 0.55) + cshad * half(shade * 0.55);
        col = col + (lit - col) * half(litv * (0.9 - 0.5 * sunFix));   // lit cloud rims calmer
        img = mixc(img, col, alpha * d);
    }
    // god rays: transmission gathered toward the light, sweeping as clouds pass
    float acc = 0.0;
    for (int i = 1; i <= 8; i++) {
        float f = float(i) / 9.0; float2 q = mix(p, L, f);
        acc += pow(1.0 - qOcc(q - float2(135.0, BH * 0.5), BH, t, A, B), 1.5);
    }
    float rays = clamp((acc / 8.0 * exp(-dist * 0.9) - 0.2) * 1.8, 0.0, 1.0);
    img = screen(img, lit, 0.75 * rays * (1.0 - 0.7 * sunFix));   // [38.9.11.2] gentle: shafts at 30 %
    // light breathing through: how open the sky is near the light
    float near = 0.0;
    for (int i = 0; i < 4; i++) {
        float a = float(i) * 1.5708 + 0.4; float2 q = L + float2(cos(a), sin(a)) * 40.0 + float2(-30.0, 30.0);
        near += 1.0 - qOcc(q - float2(135.0, BH * 0.5), BH, t, A, B);
    }
    near *= 0.25;
    float nearS = 0.5 + 0.16 * sin(TAU * t / 53.0 + 0.7) + 0.06 * sin(TAU * t / 89.0 + 2.0);
    near = mix(near, nearS, sunFix);
    img = mixc(img, warm, (0.22 + 0.30 * near) * exp(-pow(dist / 0.55, 1.5)));
    img = screen(img, lit, (0.15 + 0.35 * near) * (1.0 - 0.4 * sunFix) * exp(-(dist / 0.25) * (dist / 0.25)));
    return img;
}
//#SKY sunset
// 日落: the 晴 sky at golden hour — dusk blue top, rose middle, amber low; light low on the right, warm-lit cloud edges
float qOcc(float2 c, float BH, float t, float4 A, float2 B) {
    float th1 = 0.55 - 0.5 * (0.5 + 0.5 * sin(TAU * t / 29.0 + 1.35));
    float th2 = 0.70 - 0.5 * (0.5 + 0.5 * sin(TAU * t / 47.0 + 3.0));
    float n1 = cfast(1, camUV(c, BH, A, B, 0.45, 0.30), float2(5.0, 0.6), 1.3, t);
    float n2 = cfast(0, camUV(c, BH, A, B, 1.0, 0.19), float2(8.0, 1.0), 1.3, t);
    return max(ss(th1, th1 + 1.25, n1), ss(th2, th2 + 1.25, n2));
}
half3 skyColor(float2 p, float BH, float t) {
    half3 top = half3(0.3059, 0.3647, 0.4941), mid = half3(0.7059, 0.5412, 0.5569), low = half3(0.9294, 0.7137, 0.5490);
    half3 cloud = half3(0.9216, 0.8275, 0.7765), cshad = half3(0.5608, 0.5020, 0.5647), lit = half3(1.0000, 0.8275, 0.6353), warm = half3(1.0000, 0.6902, 0.4784);
    float2 c = p - float2(135.0, BH * 0.5); float xn = p.x / 270.0, yn = p.y / BH;
    float4 A; float2 B; cam(t, float2(70.0, 40.0), 5.0, 0.08, float2(0.45, 0.12), 1.4, A, B);
    float2 L = float2(270.0 * (0.80 + 0.08 * sin(TAU * t / 71.0 + 0.5)), BH * (0.74 + 0.03 * sin(TAU * t / 43.0 + 1.0)));
    float g = clamp(yn + 0.06 * sin(xn * 3.0 + 1.0), 0.0, 1.0);
    half3 img = mixc(top, mid, ss(0.05, 0.62, g));
    img = mixc(img, low, pow(ss(0.45, 1.0, g), 1.1));
