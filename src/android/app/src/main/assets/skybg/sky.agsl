    img = mixc(img, warm, 0.55 * exp(-pow(dist / 0.55, 1.5)));
    img = screen(img, lit, 0.45 * exp(-(dist / 0.25) * (dist / 0.25)));
    float n = cnoise(2, camUV(c, BH, A, B, 0.0, 0.55), float2(3.0, 0.4), 6.0, 0.5, 1.4, t);
    float d = ss(0.3, 1.8, n) * 0.40;
    img = mixc(img, mixc(cloud, warm, 0.25), d);
    float2 dir = normalize(L - p + float2(1e-3, 0.0));
    for (int k = 0; k < 2; k++) {
        float depth = k == 0 ? 0.45 : 1.0; float sc = k == 0 ? 0.30 : 0.19;
        float2 wind = k == 0 ? float2(5.0, 0.6) : float2(8.0, 1.0); float wp = k == 0 ? 9.0 : 12.0;
        float base = k == 0 ? 0.55 : 0.70; float alpha = k == 0 ? 0.75 : 0.85; int ch = k == 0 ? 1 : 0;
        n = cnoise(ch, camUV(c, BH, A, B, depth, sc), wind, wp, 0.8, 1.3, t);
        float th = base - 0.5 * (0.5 + 0.5 * sin(TAU * t / (k == 0 ? 29.0 : 47.0) + depth * 3.0));
        d = ss(th, th + 1.25, n);
        float nl = cnoise(ch, camUV(c + dir * 9.0, BH, A, B, depth, sc), wind, wp, 0.8, 1.3, t);
        float litv = clamp(n - nl, 0.0, 1.0) * exp(-dist * 0.6) * d;
        float shade = ss(0.2, 1.9, n) * (1.0 - 0.4 * exp(-dist * 1.5)) * 1.3;
        half3 col = cloud * half(1.0 - shade * 0.6) + cshad * half(shade * 0.6);
