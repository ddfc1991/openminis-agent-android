// Textures (assets/skybg/tex0..3.webp, 512² RGB, REPEAT + linear): tileable FFT fractal noise, value = (c - 0.5) * 9.
// No sun / moon / trees / icons: only defocused cloud masses on 2–4 parallax layers, light, mist, stars, glass.
//#SHARED
uniform float2 iResolution;
uniform float iTime;
