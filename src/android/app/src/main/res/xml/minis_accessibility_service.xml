<?xml version="1.0" encoding="utf-8"?>
<!-- [Mines-fast-ui] flagRequestTouchExplorationMode removed: it switched the
     whole phone into explore-by-touch (TalkBack-style single tap = focus,
     double tap = activate) whenever the service was on, which made the phone
     itself feel slow and broken. Event types narrowed from typeAllMask to what
     the CLI's wait/event/settle logic actually uses, so the system does less
     IPC per frame. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewClicked|typeViewFocused|typeViewTextChanged|typeViewScrolled|typeNotificationStateChanged|typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:canRequestEnhancedWebAccessibility="false"
    android:canRequestFilterKeyEvents="false"
    android:description="@string/a11y_service_description"
    android:summary="@string/a11y_service_summary"
    android:notificationTimeout="50" />
