<?xml version="1.0" encoding="utf-8"?>
<!-- Mines adaptive launcher icon (forced Dark). Foreground is drawn inside the
     66dp safe zone of the 108dp canvas, so no inset is needed. The
     monochrome layer serves Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg_force_dark" />
    <foreground android:drawable="@drawable/ic_mines_foreground_dark" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
