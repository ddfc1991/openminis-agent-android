+
+/**
+ * [Mines-38.5] 知识库 脑图 (user 「知识库能不能做成那种脑图」, XMind-style: tap a branch → it opens outward and the
+ * camera glides to it; tap a leaf → a card with the full title, summary and 「打开对话」). Centre 「我」, first ring =
+ * topics clustered from the organised chats' titles / summaries, second ring = the chats. Only one branch is open
+ * at a time, so branches never overlap. Pinch to zoom, drag to pan. Plain Compose Canvas, no extra library.
+ */
+object KnowledgeClusters {
+    private val rules = listOf(
+        "开发项目" to Regex("(?i)代码|插件|开发|apk|build|github|kotlin|python|部署|服务器|vps|脚本|编译|bug|接口|网站|前端|app"),
+        "交易" to Regex("(?i)交易|币|btc|eth|okx|binance|行情|量化|合约|现货|k线|仓位"),
+        "AI 工具" to Regex("(?i)\\bai\\b|模型|claude|gpt|gemini|deepseek|提示词|agent|智能体|kimi|grok|大模型|语音"),
+        "安全研究" to Regex("(?i)漏洞|挖洞|安全|src|渗透|bounty|xss|sql|逆向|抓包|靶场"),
+        "资料与链接" to Regex("(?i)链接|文章|分享|公众号|微信|x平台|推特|视频"),
+    )
+
+    fun topicOf(e: com.openminis.app.plus.ChatKnowledge.Entry): String {
+        val t = e.title + " " + e.topic + " " + e.summary
+        return rules.firstOrNull { (_, rx) -> rx.containsMatchIn(t) }?.first ?: e.topic.takeIf { it.isNotBlank() && it.length <= 6 } ?: "生活与其他"
+    }
+
+    fun cluster(list: List<com.openminis.app.plus.ChatKnowledge.Entry>) =
+        list.groupBy { topicOf(it) }.toList().sortedByDescending { it.second.size }.take(8)
+}
+
+private class MapNode(val id: String, val label: String, val pos: Offset, val level: Int, val entry: com.openminis.app.plus.ChatKnowledge.Entry? = null, var rect: Rect = Rect.Zero)
+
+@Composable
+fun KnowledgeMindMap(entries: List<com.openminis.app.plus.ChatKnowledge.Entry>, height: Dp = 560.dp,
+                     onOpenChat: (String) -> Unit) {
+    val m = mines()
+    val density = LocalDensity.current
+    val measurer = rememberTextMeasurer()
+    val scope = rememberCoroutineScope()
+    val clusters = remember(entries) { KnowledgeClusters.cluster(entries) }
+    var openBranch by remember { mutableStateOf<String?>(null) }
+    var leaf by remember { mutableStateOf<com.openminis.app.plus.ChatKnowledge.Entry?>(null) }
+    val camX = remember { Animatable(0f) }; val camY = remember { Animatable(0f) }; val zoom = remember { Animatable(0.9f) }
+    val px = { d: Float -> with(density) { d.dp.toPx() } }
+
+    // layout in world coordinates (px), 「我」 at the origin
+    val nodes = remember(clusters, openBranch, density) {
+        val out = ArrayList<MapNode>()
+        out += MapNode("me", "我", Offset.Zero, 0)
+        val k = clusters.size.coerceAtLeast(1)
+        clusters.forEachIndexed { i, (topic, list) ->
+            val a = Math.toRadians(-90.0 + 360.0 * i / k)
+            val dir = Offset(kotlin.math.cos(a).toFloat(), kotlin.math.sin(a).toFloat())
+            val bp = dir * px(150f)
+            out += MapNode("b:$topic", "$topic · ${list.size}", bp, 1)
+            if (openBranch == topic) {
+                val perp = Offset(-dir.y, dir.x)
+                val kids = list.take(10)
+                kids.forEachIndexed { j, e ->
+                    val off = (j - (kids.size - 1) / 2f) * px(58f)
+                    out += MapNode("l:${e.sessionId}", e.title.ifBlank { e.summary.take(16) }, bp + dir * px(190f) + perp * off, 2, e)
+                }
+            }
+        }
+        out
+    }
+
+    fun focus(p: Offset, z: Float) = scope.launch {
+        launch { camX.animateTo(-p.x * z, tween(420)) }; launch { camY.animateTo(-p.y * z, tween(420)) }; launch { zoom.animateTo(z, tween(420)) }
+    }
+
+    val ink = m.ink; val ink2 = m.ink2; val line = m.icon.copy(alpha = 0.45f)
+    val branchFill = m.container; val leafFill = if (m.dark) Color(0xFF2A2421) else Color(0xFFFFFDFA)
+    val meStyle = TextStyle(fontSize = 18.sp, fontWeight = FontWeight.Bold, color = Color.White)
+    val bStyle = TextStyle(fontSize = 17.sp, fontWeight = FontWeight.SemiBold, color = m.onContainer)
+    val lStyle = TextStyle(fontSize = 15.sp, fontWeight = FontWeight.Medium, color = ink)
+
+    Box(Modifier.fillMaxWidth().height(height).semantics { contentDescription = "知识脑图：双指缩放，拖动查看，点主题展开" }) {
+        Canvas(Modifier.fillMaxWidth().height(height)
+            .pointerInput(Unit) {
+                detectTransformGestures { _, pan, z, _ ->
+                    scope.launch {
+                        zoom.snapTo((zoom.value * z).coerceIn(0.4f, 3f)); camX.snapTo(camX.value + pan.x); camY.snapTo(camY.value + pan.y)
+                    }
+                }
+            }
+            .pointerInput(nodes) {
+                detectTapGestures { tap ->
+                    val c = Offset(size.width / 2f, size.height / 2f)
+                    val hit = nodes.lastOrNull { it.rect.contains(tap) } ?: return@detectTapGestures
+                    @Suppress("UNUSED_VARIABLE") val unused = c
+                    when (hit.level) {
+                        0 -> { openBranch = null; focus(Offset.Zero, 0.9f) }
+                        1 -> {
+                            val t = hit.id.removePrefix("b:")
+                            openBranch = if (openBranch == t) null else t
+                            // glide to the branch, a bit further out so its children are in view
+                            if (openBranch != null) focus(hit.pos * 1.45f, 1.15f) else focus(Offset.Zero, 0.9f)
+                        }
+                        else -> leaf = hit.entry
+                    }
+                }
+            }) {
+            val c = Offset(size.width / 2f + camX.value, size.height / 2f + camY.value)
+            val z = zoom.value
+            fun scr(p: Offset) = c + p * z
+            // lines first
+            nodes.filter { it.level > 0 }.forEach { n ->
+                val parent = if (n.level == 1) Offset.Zero else nodes.firstOrNull { it.id == "b:$openBranch" }?.pos ?: Offset.Zero
+                val a = scr(parent); val b = scr(n.pos)
+                val mid = Offset((a.x + b.x) / 2f, a.y)
+                val path = Path().apply { moveTo(a.x, a.y); quadraticTo(mid.x, mid.y, b.x, b.y) }
+                drawPath(path, line, style = Stroke(width = (if (n.level == 1) 3f else 2f) * z.coerceIn(0.6f, 1.4f)))
+            }
+            nodes.forEach { n ->
+                val style = when (n.level) { 0 -> meStyle; 1 -> bStyle; else -> lStyle }
+                val maxW = (if (n.level == 2) 210.dp else 190.dp).toPx()
+                val tl = measurer.measure(n.label, style.copy(fontSize = style.fontSize * z), maxLines = 1, overflow = TextOverflow.Ellipsis,
+                    constraints = Constraints(maxWidth = (maxW * z).toInt().coerceAtLeast(1)))
+                val padH = 16.dp.toPx() * z; val padV = 10.dp.toPx() * z
+                val w = tl.size.width + padH * 2; val h = tl.size.height + padV * 2
+                val p = scr(n.pos)
+                val r = if (n.level == 0) Rect(p - Offset(36.dp.toPx() * z, 36.dp.toPx() * z), Size(72.dp.toPx() * z, 72.dp.toPx() * z))
+                    else Rect(Offset(p.x - w / 2f, p.y - h / 2f), Size(w, h))
+                n.rect = r
+                when (n.level) {
+                    0 -> drawCircle(m.primary, radius = r.width / 2f, center = r.center)
+                    1 -> drawRoundRect(branchFill, r.topLeft, r.size, CornerRadius(h / 2f, h / 2f))
+                    else -> {
+                        drawRoundRect(leafFill, r.topLeft, r.size, CornerRadius(14.dp.toPx() * z, 14.dp.toPx() * z))
+                        drawRoundRect(m.hairline.copy(alpha = 0.25f), r.topLeft, r.size, CornerRadius(14.dp.toPx() * z, 14.dp.toPx() * z), style = Stroke(1.dp.toPx()))
+                    }
+                }
+                drawText(tl, topLeft = Offset(r.center.x - tl.size.width / 2f, r.center.y - tl.size.height / 2f))
+            }
+        }
+        if (entries.isEmpty()) Text("还没有整理好的对话，聊几次之后这里会长出脑图", fontSize = MT.Body, color = ink2,
+            modifier = Modifier.semantics { })
+    }
+    leaf?.let { e ->
+        MinesDialog(e.title.ifBlank { "对话" }, onDismiss = { leaf = null }, confirm = "打开对话", onConfirm = { leaf = null; onOpenChat(e.sessionId) }, dismiss = "关闭") {
+            if (e.topic.isNotBlank()) Text(e.topic, fontSize = MT.Sub, color = m.primaryText)
+            Text(e.summary, fontSize = MT.Body, lineHeight = MT.BodyLH, color = m.ink)
+            e.decisions.take(4).forEach { Text("✓ $it", fontSize = MT.Sub, lineHeight = MT.SubLH, color = m.ink2) }
+        }
+    }
+}
