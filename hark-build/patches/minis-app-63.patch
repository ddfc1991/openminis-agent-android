diff --git a/src/android/app/src/main/java/com/openminis/app/browser/WebFit.kt b/src/android/app/src/main/java/com/openminis/app/browser/WebFit.kt
new file mode 100644
index 0000000..5561eb8
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/browser/WebFit.kt
@@ -0,0 +1,44 @@
+package com.openminis.app.browser
+
+import android.content.Context
+import android.webkit.WebView
+import java.lang.ref.WeakReference
+
+/**
+ * [Mines-webfit-38.3] Every in-app WebView fits the phone screen (user 2026-10-14:
+ * 「所有内置浏览器/WebView 必须自适应屏幕」, realme Neo7 Turbo 1280×2800 / 480 dpi ≈ 427 dp wide).
+ *
+ * - wide viewport + overview: pages with `<meta viewport width=device-width>` lay out at the
+ *   screen width; pages without one lay out at 980 CSS px and are zoomed out to the screen width
+ *   (never cut off on the right)
+ * - pinch / double-tap zoom on, no floating +/- buttons, zoom-locking viewports unlocked ([BrowserZoom])
+ * - text size follows the system font size × Mines' own 字号 setting ([BrowserZoom.defaultTextZoom])
+ * - mobile user agent (contains "Mobile"); the in-app browser's 电脑 mode keeps its desktop UA and
+ *   is shrunk to the screen width by BrowserUseManager.applyShrinkToFit
+ *
+ * Callers host the WebView with fillMaxSize / MATCH_PARENT and pad for the keyboard (imePadding).
+ */
+object WebFit {
+    /** This phone's mobile Chrome UA (always contains "Mobile"). */
+    fun mobileUa(c: Context): String = com.openminis.app.plus.LoginWeb.userAgent(c)
+
+    /** Applies the fit-to-screen settings. [keepUa] leaves a UA the caller chose on purpose (电脑 mode). */
+    fun apply(wv: WebView, keepUa: Boolean = false) {
+        BrowserZoom.configure(wv)
+        if (!keepUa) {
+            val ua = wv.settings.userAgentString.orEmpty()
+            if (!ua.contains("Mobile")) wv.settings.userAgentString = mobileUa(wv.context)
+        }
+    }
+
+    /** The WebView the user is looking at in the in-app browser (for the smoke self-test). */
+    @Volatile var shown: WeakReference<WebView>? = null
+
+    /** Layout probe: CSS viewport vs screen, horizontal overflow, the page's meta viewport and UA. */
+    const val PROBE_JS = """(function(){try{var d=document.documentElement,b=document.body;
+var m=document.querySelector('meta[name=viewport]');
+return JSON.stringify({url:location.href,title:document.title,innerWidth:window.innerWidth,screenWidth:screen.width,
+dpr:window.devicePixelRatio,scrollWidth:Math.max(d?d.scrollWidth:0,b?b.scrollWidth:0),clientWidth:d?d.clientWidth:0,
+vvScale:window.visualViewport?visualViewport.scale:0,vvWidth:window.visualViewport?visualViewport.width:0,
+metaViewport:m?m.getAttribute('content'):'',ua:navigator.userAgent});}catch(e){return JSON.stringify({error:String(e)});}})()"""
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/browser/WebPaintCheck.kt b/src/android/app/src/main/java/com/openminis/app/browser/WebPaintCheck.kt
new file mode 100644
index 0000000..47befb1
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/browser/WebPaintCheck.kt
@@ -0,0 +1,166 @@
+package com.openminis.app.browser
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Rect
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import android.view.PixelCopy
+import android.view.View
+import android.view.Window
+import android.view.WindowManager
+import android.webkit.WebView
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlin.coroutines.resume
+
+/**
+ * [Mines-webpaint-38.4] The in-app browser must really draw the page it loaded.
+ *
+ * Smoke 44 (1280×2800 / 480 dpi): www.coze.cn was fully in the accessibility tree (DOM laid out, text
+ * visible to the page) but the screenshot of the browser sheet showed only the page's background colour.
+ * The sheet's WebView was drawn through a hardware layer (LAYER_TYPE_HARDWARE, an old workaround for
+ * blank WebViews in dialogs on some GPUs); with a long, layer-heavy page Chromium hit its tile memory
+ * limit ("tile memory limits exceeded, some content may not draw") and the content tiles never made it
+ * into the layer.
+ *
+ * What the sheet does now: the on-screen WebView draws directly (LAYER_TYPE_NONE: real on-screen
+ * position for tile priority, no extra layer copy) and [heal] watches it. When the page finished loading
+ * but the pixels on screen are one flat colour while the page itself reports visible text in the
+ * viewport, the layer type is switched (none → hardware → software) until the page shows. A page whose
+ * visibility went "hidden" while on screen is resumed. Each step is logged and kept in [lastHeal]
+ * for the self-test.
+ */
+object WebPaintCheck {
+    private const val TAG = "WebPaintCheck"
+
+    /** What the last check / heal did (self-test probe). */
+    @Volatile var lastHeal: String = ""
+
+    /**
+     * Visible text in the viewport as the page sees it: text nodes inside the viewport whose element chain is
+     * displayed, not visibility:hidden and has an effective opacity > 0.1. `hidden` counts text that is in the
+     * viewport but transparent (e.g. a fade-in animation that never ran).
+     */
+    const val TEXT_JS = """(function(){try{var W=innerWidth,H=innerHeight,n=0,hid=0,s=[],c=0,t;
+if(!document.body)return JSON.stringify({vis:document.visibilityState,rs:document.readyState,shown:0,hidden:0});
+var w=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);
+while((t=w.nextNode())&&c<5000){c++;var v=t.nodeValue;if(!v||v.trim().length<2)continue;var e=t.parentElement;if(!e)continue;
+var r=e.getBoundingClientRect();if(r.bottom<=0||r.top>=H||r.right<=0||r.left>=W||r.width<2||r.height<2)continue;
+var o=1,ok=true,x=e;while(x&&x.nodeType==1){var cs=getComputedStyle(x);if(cs.display=='none'||cs.visibility=='hidden'){ok=false;break}o*=parseFloat(cs.opacity||'1');x=x.parentElement}
+if(ok&&o>0.1)n++;else{hid++;if(s.length<6)s.push(e.tagName+':'+o.toFixed(2)+':'+v.trim().slice(0,16))}}
+return JSON.stringify({vis:document.visibilityState,rs:document.readyState,shown:n,hidden:hid,sample:s,raf:window.__minesRaf||-1,
+bg:getComputedStyle(document.body).backgroundColor,scrollY:window.scrollY});}catch(e){return JSON.stringify({err:String(e)})}})()"""
+
+    /** The window [v] is drawn in (a Compose dialog / bottom sheet window, else the activity's). */
+    fun windowOf(v: View): Window? {
+        var cur: Any? = v
+        while (cur is View) {
+            if (cur is androidx.compose.ui.window.DialogWindowProvider) return cur.window
+            cur = cur.parent
+        }
+        var c = v.context
+        while (c is android.content.ContextWrapper) {
+            if (c is android.app.Activity) return c.window
+            c = c.baseContext
+        }
+        return null
+    }
+
+    /**
+     * Share (in 1/10000) of pixels of [b] that differ from its most common colour (5 bits per channel), i.e. how
+     * much is drawn on top of the background. 0 = one flat colour.
+     */
+    fun inkPermyriad(b: Bitmap): Int {
+        val n = b.width * b.height
+        if (n <= 0) return 0
+        val px = IntArray(n); b.getPixels(px, 0, b.width, 0, 0, b.width, b.height)
+        val counts = HashMap<Int, Int>()
+        for (p in px) { val k = p and 0x00F8F8F8; counts[k] = (counts[k] ?: 0) + 1 }
+        val top = counts.values.maxOrNull() ?: n
+        return ((n - top).toLong() * 10000 / n).toInt()
+    }
+
+    /**
+     * [inkPermyriad] of what is really on screen inside [v] (PixelCopy of its window), or -1 when it cannot be
+     * read (secure window, not attached, copy failed).
+     */
+    suspend fun screenInk(v: View): Int {
+        val win = windowOf(v) ?: return -1
+        if (!v.isAttachedToWindow || v.width <= 0 || v.height <= 0) return -1
+        if ((win.attributes.flags and WindowManager.LayoutParams.FLAG_SECURE) != 0) return -1
+        val loc = IntArray(2); v.getLocationInWindow(loc)
+        val r = Rect(loc[0], loc[1], loc[0] + v.width, loc[1] + v.height)
+        val bw = (v.width / 4).coerceAtLeast(1); val bh = (v.height / 4).coerceAtLeast(1)
+        val bmp = Bitmap.createBitmap(bw, bh, Bitmap.Config.ARGB_8888)
+        val ok = suspendCancellableCoroutine<Boolean> { cont ->
+            try {
+                PixelCopy.request(win, r, bmp, { res -> if (cont.isActive) cont.resume(res == PixelCopy.SUCCESS) }, Handler(Looper.getMainLooper()))
+            } catch (t: Throwable) { if (cont.isActive) cont.resume(false) }
+        }
+        return if (ok) inkPermyriad(bmp).also { bmp.recycle() } else { bmp.recycle(); -1 }
+    }
+
+    /** [inkPermyriad] of a software draw of [wv] (what the page looks like without the GPU path). */
+    fun softwareInk(wv: WebView): Int = runCatching {
+        val bw = (wv.width / 4).coerceAtLeast(1); val bh = (wv.height / 4).coerceAtLeast(1)
+        val bmp = Bitmap.createBitmap(bw, bh, Bitmap.Config.ARGB_8888)
+        val c = Canvas(bmp); c.scale(0.25f, 0.25f); c.translate(-wv.scrollX.toFloat(), -wv.scrollY.toFloat())
+        wv.draw(c)
+        inkPermyriad(bmp).also { bmp.recycle() }
+    }.getOrDefault(-1)
+
+    fun layerName(t: Int) = when (t) { View.LAYER_TYPE_HARDWARE -> "hardware"; View.LAYER_TYPE_SOFTWARE -> "software"; else -> "none" }
+
+    private suspend fun pageText(wv: WebView): org.json.JSONObject? = suspendCancellableCoroutine { cont ->
+        try {
+            wv.evaluateJavascript(TEXT_JS) { r ->
+                val o = runCatching { org.json.JSONObject(org.json.JSONTokener(r ?: "\"\"").nextValue() as String) }.getOrNull()
+                if (cont.isActive) cont.resume(o)
+            }
+        } catch (t: Throwable) { if (cont.isActive) cont.resume(null) }
+    }
+
+    /**
+     * Watches the on-screen browser WebView while it is mounted (call from a LaunchedEffect keyed on it).
+     * Cheap: one small PixelCopy every 1.5 s, only for the first ~30 s after each page finished loading.
+     */
+    suspend fun heal(wv: WebView) {
+        var url: String? = null
+        var checks = 0
+        var healthy = false
+        while (true) {
+            delay(1500)
+            if (!wv.isAttachedToWindow || wv.width <= 0) continue
+            val u = wv.url
+            if (u != url) { url = u; checks = 0; healthy = false }
+            if (healthy || wv.progress < 100 || u.isNullOrBlank() || !u.startsWith("http")) continue
+            if (++checks > 20) continue
+            val ink = screenInk(wv)
+            if (ink < 0) continue
+            if (ink >= 10) {   // ≥ 0.1 % of the view drawn over the background
+                healthy = true
+                lastHeal = "ok ink=$ink layer=${layerName(wv.layerType)} url=$u"
+                continue
+            }
+            // flat on screen: is the page itself showing text right now?
+            val p = pageText(wv) ?: continue
+            if (p.optString("vis") == "hidden") {
+                Log.w(TAG, "page hidden while on screen → onResume ($u)")
+                wv.onResume()
+            }
+            val shown = p.optInt("shown")
+            val from = wv.layerType
+            val to = when (from) { View.LAYER_TYPE_NONE -> View.LAYER_TYPE_HARDWARE; View.LAYER_TYPE_HARDWARE -> View.LAYER_TYPE_SOFTWARE; else -> -1 }
+            if (shown >= 3 && checks >= 2 && to >= 0) {
+                Log.w(TAG, "blank paint: ink=$ink text=$shown layer ${layerName(from)} → ${layerName(to)} ($u)")
+                wv.setLayerType(to, null)
+                wv.invalidate()
+                lastHeal = "switched ${layerName(from)}→${layerName(to)} ink=$ink text=$shown url=$u"
+            } else {
+                lastHeal = "flat ink=$ink text=$shown hiddenText=${p.optInt("hidden")} layer=${layerName(from)} url=$u"
+            }
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/AccountJar.kt b/src/android/app/src/main/java/com/openminis/app/plus/AccountJar.kt
new file mode 100644
index 0000000..01a71ee
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/AccountJar.kt
@@ -0,0 +1,227 @@
+package com.openminis.app.plus
+
+import android.webkit.CookieManager
+import android.webkit.WebView
+import androidx.webkit.WebViewCompat
+import androidx.webkit.WebViewFeature
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+
+/**
+ * [Mines-38.7] 多账号隔离 (user 2026-10-15 「如果是多账号的，一定要做好隔离」): every account of one platform keeps its own
+ * cookies, localStorage and token, and signing one in / out / expiring never touches another.
+ *
+ * Account ids: "x" = the platform's first account (the app's default WebView store, so existing logins stay),
+ * "x#2", "x#3" … = further accounts.
+ *
+ * Two ways, picked per phone:
+ *  - PROFILE (WebView supports androidx.webkit MULTI_PROFILE): "x#n" uses its own WebView profile "mines_acct_x_n"
+ *    (own cookies, localStorage, IndexedDB, cache). Accounts can be used at the same time.
+ *  - SWAP (older WebView, e.g. the API 34 emulator): the shared store is switched per account. Before an account's
+ *    WebView loads anything, the cookies of the platform's domains are saved for the account that had them and replaced
+ *    by this account's saved set; localStorage is saved after each use and put back by a document-start script that
+ *    runs before the page's own code. One account of a platform at a time — callers hold [lock] for the whole use.
+ * Saved sets live in the encrypted vault (PlusVault secret extras), never in plain prefs.
+ */
+object AccountJar {
+    /** smoke: force SWAP even where profiles work, so both paths are tested. */
+    @Volatile var forceSwap = false
+
+    fun profiles(): Boolean = !forceSwap && LoginWeb.profilesSupported()
+    fun mode(): String = if (profiles()) "profile" else "swap"
+
+    fun base(acct: String) = acct.substringBefore('#')
+    fun isExtra(acct: String) = acct.contains('#')
+
+    private val locks = HashMap<String, Mutex>()
+    /** One user of a platform's shared store at a time (SWAP); a no-op contention-wise for PROFILE accounts. */
+    fun lock(acct: String): Mutex = synchronized(locks) {
+        locks.getOrPut(if (profiles()) acct else base(acct)) { Mutex() }
+    }
+
+    private fun profileName(acct: String) = "mines_acct_" + acct.replace(Regex("[^A-Za-z0-9_]"), "_")
+
+    /** The cookie store [acct] uses right now (its profile, or the shared one). */
+    fun cookieManager(acct: String): CookieManager {
+        if (isExtra(acct) && profiles()) runCatching {
+            return androidx.webkit.ProfileStore.getInstance().getOrCreateProfile(profileName(acct)).cookieManager
+        }
+        return CookieManager.getInstance()
+    }
+
+    // ---------------- SWAP bookkeeping ----------------
+
+    private fun activeKey(base: String) = "jar_active_" + base
+    fun active(base: String): String? = PlusVault.extra("accountjar", activeKey(base))?.takeIf { it.isNotBlank() }
+    private fun setActive(base: String, acct: String?) = PlusVault.setExtra("accountjar", activeKey(base), acct ?: "")
+
+    private fun saved(acct: String): JSONObject = runCatching { JSONObject(PlusVault.secretExtra("accountjar", acct) ?: "{}") }.getOrDefault(JSONObject())
+    private fun putSaved(acct: String, o: JSONObject?) = PlusVault.setSecretExtra("accountjar", acct, o?.toString())
+
+    private fun hostOf(u: String) = runCatching { java.net.URI(u).host }.getOrNull().orEmpty()
+    private fun root(host: String): String {
+        val p = host.split('.')
+        return if (p.size <= 2) host else p.takeLast(if (p[p.size - 2].length <= 3 && p.last().length <= 2) 3 else 2).joinToString(".")
+    }
+
+    /** "a=b; c=d" → map. */
+    private fun pairs(s: String?): Map<String, String> = s.orEmpty().split(';').mapNotNull { kv ->
+        val i = kv.indexOf('='); if (i <= 0) null else kv.substring(0, i).trim() to kv.substring(i + 1).trim()
+    }.toMap()
+
+    private fun isIp(h: String) = h.matches(Regex("[0-9.]+")) || h.contains(':') || h == "localhost"
+
+    /** The page urls whose cookies make one session: host + registrable root (+www), same scheme / port as given. */
+    private fun urlsOf(urls: List<String>): List<String> = urls.flatMap { u ->
+        val uri = runCatching { java.net.URI(u) }.getOrNull() ?: return@flatMap emptyList()
+        val h = uri.host ?: return@flatMap emptyList()
+        val sch = uri.scheme ?: "https"
+        val port = if (uri.port > 0) ":" + uri.port else ""
+        if (isIp(h)) listOf("$sch://$h$port/") else listOf("$sch://$h$port/", "$sch://" + root(h) + "/", "$sch://www." + root(h) + "/")
+    }.distinct()
+
+    private fun attrs(u: String): String {
+        val h = hostOf(u)
+        return "; Path=/" + (if (isIp(h)) "" else "; Domain=." + root(h)) + (if (u.startsWith("https")) "; Secure; SameSite=None" else "")
+    }
+
+    /** Snapshot of the shared store for [urls] (cookies per url). */
+    private fun snapshotCookies(urls: List<String>): JSONObject {
+        val cm = CookieManager.getInstance()
+        val o = JSONObject()
+        for (u in urlsOf(urls)) {
+            val p = pairs(runCatching { cm.getCookie(u) }.getOrNull())
+            if (p.isNotEmpty()) o.put(u, JSONObject(p as Map<*, *>))
+        }
+        return o
+    }
+
+    private fun clearCookies(urls: List<String>) {
+        val cm = CookieManager.getInstance()
+        for (u in urlsOf(urls)) {
+            val names = pairs(runCatching { cm.getCookie(u) }.getOrNull()).keys
+            val h = hostOf(u); val r = root(h)
+            for (n in names) {
+                cm.setCookie(u, "$n=; Max-Age=0; Path=/")
+                if (!isIp(h)) { cm.setCookie(u, "$n=; Max-Age=0; Path=/; Domain=.$r"); cm.setCookie(u, "$n=; Max-Age=0; Path=/; Domain=$r") }
+            }
+        }
+    }
+
+    private fun restoreCookies(o: JSONObject) {
+        val cm = CookieManager.getInstance()
+        for (u in o.keys()) {
+            val m = o.optJSONObject(u) ?: continue
+            for (n in m.keys()) cm.setCookie(u, "$n=${m.optString(n)}" + attrs(u))
+        }
+    }
+
+    /**
+     * Makes the shared store hold [acct]'s session for [urls] (SWAP); a no-op with profiles or when it already does.
+     * Main thread. Callers hold [lock] and destroy WebViews of the previous account first.
+     */
+    suspend fun activate(acct: String, urls: List<String>) = withContext(Dispatchers.Main) { activateNow(acct, urls) }
+
+    /** Same as [activate], on the caller's (main) thread: the 账号连接 login screen swaps before its WebView loads. */
+    fun activateNow(acct: String, urls: List<String>) {
+        if (profiles()) return   // profiles: "x" = default store, "x#n" = own profile; nothing to swap
+        val b = base(acct)
+        val cur = active(b) ?: b      // nobody swapped yet: the store holds the first account
+        if (cur == acct) return
+        // save who was there (cookies; localStorage was saved by [saveLocal] after its last use)
+        if (cur != "-") { val keep = saved(cur); keep.put("cookies", snapshotCookies(urls)); putSaved(cur, keep) }
+        clearCookies(urls)
+        saved(acct).optJSONObject("cookies")?.let { restoreCookies(it) }
+        runCatching { CookieManager.getInstance().flush() }
+        setActive(b, acct)
+    }
+
+    /** After a use / sign-in: remember [acct]'s current cookies (SWAP) so a later swap back restores them exactly. */
+    suspend fun remember(acct: String, urls: List<String>) = withContext(Dispatchers.Main) { rememberNow(acct, urls) }
+
+    fun rememberNow(acct: String, urls: List<String>) {
+        if (profiles()) return
+        if ((active(base(acct)) ?: base(acct)) != acct) return
+        val keep = saved(acct); keep.put("cookies", snapshotCookies(urls)); putSaved(acct, keep)
+    }
+
+    /**
+     * 账号连接 sign-in of an extra account finished (SWAP): keep its session (cookies + this page's localStorage) and give
+     * the shared store back to the first account, so the in-app browser / first account never see the extra one.
+     */
+    fun afterLogin(wv: WebView?, acct: String, urls: List<String>) {
+        if (profiles() || !isExtra(acct)) return
+        val done = { dump: String? -> saveLocal(acct, dump); rememberNow(acct, urls); activateNow(base(acct), urls) }
+        if (wv == null) { done(null); return }
+        runCatching { wv.evaluateJavascript(DUMP_LOCAL_JS) { r -> done(runCatching { org.json.JSONTokener(r ?: "\"\"").nextValue() as? String }.getOrNull()) } }
+            .onFailure { done(null) }
+    }
+
+    /** JS returning the page origin's localStorage as JSON (stored per account per origin, SWAP only). */
+    const val DUMP_LOCAL_JS = "(function(){try{var o={};for(var i=0;i<localStorage.length;i++){var k=localStorage.key(i);if(k!='__mines_acct')o[k]=localStorage.getItem(k);}return JSON.stringify({origin:location.origin,ls:o});}catch(e){return ''}})()"
+
+    fun saveLocal(acct: String, dump: String?) {
+        if (profiles() || dump.isNullOrBlank()) return
+        val d = runCatching { JSONObject(dump) }.getOrNull() ?: return
+        val keep = saved(acct)
+        val ls = keep.optJSONObject("ls") ?: JSONObject()
+        ls.put(d.optString("origin"), d.optJSONObject("ls") ?: JSONObject())
+        keep.put("ls", ls); putSaved(acct, keep)
+    }
+
+    /**
+     * Prepares a WebView for [acct] before anything is loaded: its own profile (PROFILE), or the document-start script
+     * that swaps localStorage to [acct]'s saved set the first time each origin loads for this account (SWAP).
+     * Returns false when the account cannot be isolated on this phone (no profile, no document-start script).
+     */
+    fun prepare(wv: WebView, acct: String): Boolean {
+        if (profiles()) {
+            if (!isExtra(acct)) return true
+            return runCatching {
+                androidx.webkit.ProfileStore.getInstance().getOrCreateProfile(profileName(acct))
+                WebViewCompat.setProfile(wv, profileName(acct)); true
+            }.getOrDefault(false)
+        }
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) return false
+        val ls = saved(acct).optJSONObject("ls") ?: JSONObject()
+        // the first account adopts whatever the store already holds (a sign-in from before 38.7 is not wiped)
+        val js = "(function(){try{var me=" + JSONObject.quote(acct) + ";var cur=localStorage.getItem('__mines_acct');if(cur===me)return;" +
+            "var all0=" + ls.toString() + ";if(!cur&&" + (!isExtra(acct)) + "&&!all0[location.origin]){localStorage.setItem('__mines_acct',me);return;}" +
+            "var all=" + ls.toString() + ";var d=all[location.origin]||{};localStorage.clear();" +
+            "for(var k in d){try{localStorage.setItem(k,d[k]);}catch(e){}}localStorage.setItem('__mines_acct',me);}catch(e){}})();"
+        return runCatching { WebViewCompat.addDocumentStartJavaScript(wv, js, setOf("*")); true }.getOrDefault(false)
+    }
+
+    /**
+     * Signs [acct] out on this phone only: its cookies / profile / saved set are deleted; other accounts untouched.
+     * Main thread; callers destroy the account's WebViews first.
+     */
+    suspend fun signOut(acct: String, urls: List<String>) = withContext(Dispatchers.Main) {
+        if (profiles() && isExtra(acct)) {
+            runCatching { androidx.webkit.ProfileStore.getInstance().deleteProfile(profileName(acct)) }
+                .onFailure { runCatching { cookieManager(acct).removeAllCookies(null) } }
+        } else {
+            // the shared store: clear it only when it holds this account's session right now
+            if ((active(base(acct)) ?: base(acct)) == acct) {
+                clearCookies(urls)
+                if (!profiles()) setActive(base(acct), "-")   // nobody is in the store now
+            }
+        }
+        putSaved(acct, null)
+        runCatching { CookieManager.getInstance().flush() }
+    }
+
+    /** Cookie header for an HTTP read as [acct] (feeds): its profile / the live store when it is active / its saved set. */
+    suspend fun cookieHeader(acct: String, url: String): String = withContext(Dispatchers.Main) { cookieOf(acct, url) }
+
+    fun cookieOf(acct: String, url: String): String {
+        if (profiles() || (active(base(acct)) ?: base(acct)) == acct) return runCatching { cookieManager(acct).getCookie(url) }.getOrNull().orEmpty()
+        val c = saved(acct).optJSONObject("cookies") ?: return ""
+        val h = hostOf(url); val r = root(h)
+        val out = LinkedHashMap<String, String>()
+        for (u in c.keys()) { val uh = hostOf(u); if (uh == h || uh == r || h.endsWith(".$r") && (uh == r || uh == "www.$r")) c.optJSONObject(u)?.let { m -> m.keys().forEach { k -> out[k] = m.optString(k) } } }
+        return out.entries.joinToString("; ") { it.key + "=" + it.value }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/CharacterVoices.kt b/src/android/app/src/main/java/com/openminis/app/plus/CharacterVoices.kt
