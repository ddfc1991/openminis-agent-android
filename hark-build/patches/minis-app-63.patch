+            Column(Modifier.padding(horizontal = 14.dp, vertical = 10.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Text(text.lines().takeLast(9).joinToString("\n"), fontSize = 11.sp, lineHeight = 15.sp, fontFamily = FontFamily.Monospace, color = m.ink2,
+                    modifier = Modifier.fillMaxWidth().clip(RoundedCornerShape(14.dp)).background(m.surface2).padding(10.dp))
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    WarmPrimaryPill("复制全部", height = 40.dp, fontSize = 14, onClick = {
+                        val cm = c.getSystemService(android.content.ClipboardManager::class.java)
+                        cm?.setPrimaryClip(android.content.ClipData.newPlainText("Mines 语音断线记录", VoiceDiag.text(c, 200)))
+                        FeedTasks.toast(c, "已复制")
+                    })
+                    androidx.compose.material3.OutlinedButton(onClick = { VoiceDiag.clear(c); tick++ }, modifier = Modifier.heightIn(min = 40.dp)) { Text("清空", fontSize = 14.sp) }
+                }
+            }
+        }
+    }
