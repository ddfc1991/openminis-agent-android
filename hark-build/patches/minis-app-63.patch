+@Composable
+private fun SmallLink(text: String, onClick: () -> Unit) {
+    val m = mines()
+    Text(text, fontSize = MT.Sub, fontWeight = FontWeight.SemiBold, color = m.primaryText, maxLines = 1, softWrap = false,
