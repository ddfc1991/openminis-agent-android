+                androidx.compose.material3.OutlinedTextField(relay, { relay = it.trim() }, singleLine = true, modifier = Modifier.fillMaxWidth(),
+                    label = { Text("中转地址（可不填）") }, placeholder = { Text("例如 38.76.209.77:443") })
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    WarmPrimaryPill("保存", height = 40.dp, fontSize = 14, onClick = {
+                        PlusVault.setExtra("gemini", "relay", relay); FeedTasks.toast(c, if (relay.isBlank()) "已清除中转" else "已保存，下次通话会先比较直连和中转")
+                    })
+                }
+                Text(VoiceDiag.summary(), fontSize = 12.sp, lineHeight = 17.sp, color = m.ink2)
+            }
+        }
+        PlusSection("断线记录", footer = "每次通话断开的时间、代码、线路和网络。遇到「一下断一下断」时点复制，发给开发者。") {
