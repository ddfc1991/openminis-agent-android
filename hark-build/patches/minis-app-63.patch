+            .clip(shape).background(minesGlassFill(strong = true)).border(1.dp, m.glassBorder, shape)
+            .pressClickable(onNewChat)
+            .heightIn(min = 51.dp).padding(start = 14.dp, end = 5.dp),  // [Mines-38.2] board 58 px x 0.874
