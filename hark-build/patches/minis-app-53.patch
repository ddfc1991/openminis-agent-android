+/** 💬: open a chat with this card as context, through Mines' own share path. */
+private fun discuss(context: android.content.Context, m: Digest.Item, ask: String) {
+    val text = ask + (m.headline ?: m.title) + "\n" + (m.brief ?: m.summary) + "\n来源：" + m.source + " · " + m.sender + (m.url?.let { "\n$it" } ?: "")
+    runCatching {
+        context.startActivity(Intent(Intent.ACTION_SEND).setClass(context, com.openminis.app.share.ShareReceiverActivity::class.java)
+            .setType("text/plain").putExtra(Intent.EXTRA_TEXT, text).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+    }.onFailure {
+        val cm = context.getSystemService(android.content.ClipboardManager::class.java)
+        cm?.setPrimaryClip(android.content.ClipData.newPlainText("Mines", text))
+        android.widget.Toast.makeText(context, "已复制，去对话里粘贴就能讨论", android.widget.Toast.LENGTH_SHORT).show()
+    }
+}
