+private fun relTime(t: Long): String {
+    val m = (System.currentTimeMillis() - t) / 60_000
+    return when { m < 1 -> "刚刚"; m < 60 -> "$m 分钟前"; m < 1440 -> "${m / 60} 小时前"; else -> "${m / 1440} 天前" }
+}
