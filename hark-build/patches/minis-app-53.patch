diff --git a/src/android/app/src/main/java/com/openminis/app/plus/PetFrameGen.kt b/src/android/app/src/main/java/com/openminis/app/plus/PetFrameGen.kt
new file mode 100644
index 0000000..8ecdd14
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/PetFrameGen.kt
@@ -0,0 +1,141 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.util.Base64
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.ByteArrayOutputStream
+import java.io.File
+
+/**
+ * [Mines-pet-32] 「生成动作」: makes the desk pet's frames (blink, mouth A/O, think)
+ * from the user's own picture with Gemini's image-editing model (Nano Banana;
+ * ai.google.dev/gemini-api/docs/image-generation, checked 2026-10-13: the
+ * Interactions API with gemini-nano-banana-2.1 / gemini-3.1-flash-image, the
+ * older generateContent path with gemini-2.5-flash-image as fallback). The
+ * original goes along as the reference every time; only the face area of each
+ * result is blended back onto the original (same framing → no jitter).
+ * Cost: 4 image edits on the user's Gemini key (free tier when available).
+ */
+object PetFrameGen {
+    val progress = MutableStateFlow<String?>(null)
+
+    private val prompts = linkedMapOf(
+        PetFrames.BLINK to "Change ONLY the eyes: both eyes gently closed in a natural blink. Mouth unchanged.",
+        PetFrames.MOUTH_A to "Change ONLY the mouth: open as if saying \"ah\" while talking. Eyes unchanged.",
+        PetFrames.MOUTH_O to "Change ONLY the mouth: a small round \"oh\" shape while talking. Eyes unchanged.",
+        PetFrames.THINK to "Change ONLY the eyes: glancing upward to one side, thoughtful. Mouth unchanged.",
+    )
+    private val models = listOf("gemini-nano-banana-2.1", "gemini-3.1-flash-image", "gemini-2.5-flash-image")
+
+    /** Returns a one-line result for the UI. */
+    suspend fun generate(context: Context): String = withContext(Dispatchers.IO) {
+        PlusVault.init(context)
+        val key = GeminiRoute.apiKey() ?: return@withContext "要先在「应用」里连上 Gemini（填 API Key），才能生成动作"
+        val src = listOf(Avatars.noBgFile(context), Avatars.sourceFile(context)).firstOrNull { it.exists() }
+            ?: return@withContext "先在上面选一张你自己的图片作为形象"
+        val base0 = BitmapFactory.decodeFile(src.absolutePath) ?: return@withContext "这张图片读不出来，换一张试试"
+        // keep it modest: long side 820 px like the built-in frames
+        val sc = 820f / maxOf(base0.width, base0.height)
+        val base = if (sc < 1f) Bitmap.createScaledBitmap(base0, (base0.width * sc).toInt(), (base0.height * sc).toInt(), true) else base0
+        val png = ByteArrayOutputStream().also { base.compress(Bitmap.CompressFormat.PNG, 100, it) }.toByteArray()
+        val dir = PetFrames.customDir(context).apply { mkdirs() }
+        File(dir, "base.png").outputStream().use { base.compress(Bitmap.CompressFormat.PNG, 100, it) }
+        val route = runCatching { GeminiRoute.routes(context, false).firstOrNull() }.getOrNull()
+        var ok = 0; var lastErr = ""
+        prompts.entries.forEachIndexed { i, (name, p) ->
+            progress.value = "正在生成第 ${i + 1}/${prompts.size} 个动作…"
+            val prompt = "Edit the reference image: the exact same character, identical pose, framing, crop, size, position, clothing, hair, colours and line art. $p Everything else identical. Same background. No text, no watermark."
+            val out = runCatching { edit(route, key, prompt, png) }.onFailure { lastErr = it.message ?: "" }.getOrNull()
+            if (out != null) {
+                val merged = blendFace(base, out)
+                File(dir, "$name.png").outputStream().use { merged.compress(Bitmap.CompressFormat.PNG, 100, it) }
+                ok++
+            }
+        }
+        progress.value = null
+        PetFrames.invalidate()
+        PlusPrefs.update(context) { it.copy(avatarVersion = it.avatarVersion + 1) }
+        if (ok == 0) "没生成出来：${lastErr.take(80)}" else "已生成 $ok 个动作，桌宠会眨眼、说话时动嘴了"
+    }
+
+    private fun edit(route: GeminiRoute.Route?, key: String, prompt: String, png: ByteArray): Bitmap {
+        val b64 = Base64.encodeToString(png, Base64.NO_WRAP)
+        val client = if (route != null) GeminiRoute.client(route, 120_000) else okhttp3.OkHttpClient.Builder().readTimeout(120, java.util.concurrent.TimeUnit.SECONDS).build()
+        var err = ""
+        for (m in models) {
+            val (url, body) = if (m == "gemini-2.5-flash-image")
+                "https://generativelanguage.googleapis.com/v1beta/models/$m:generateContent" to JSONObject().put("contents", JSONArray().put(JSONObject().put("parts", JSONArray()
+                    .put(JSONObject().put("text", prompt)).put(JSONObject().put("inline_data", JSONObject().put("mime_type", "image/png").put("data", b64))))))
+            else "https://generativelanguage.googleapis.com/v1beta/interactions" to JSONObject().put("model", m).put("input", JSONArray()
+                .put(JSONObject().put("type", "text").put("text", prompt)).put(JSONObject().put("type", "image").put("mime_type", "image/png").put("data", b64)))
+            val r = runCatching {
+                client.newCall(Request.Builder().url(url).header("x-goog-api-key", key)
+                    .post(body.toString().toRequestBody("application/json".toMediaType())).build()).execute().use { it.code to it.body?.string().orEmpty() }
+            }.getOrElse { e -> err = e.message ?: ""; null } ?: continue
+            if (r.first !in 200..299) { err = "HTTP ${r.first} " + r.second.take(120); continue }
+            val data = findImage(JSONObject(r.second)) ?: run { err = "回复里没有图片"; null } ?: continue
+            val bytes = Base64.decode(data, Base64.DEFAULT)
+            BitmapFactory.decodeByteArray(bytes, 0, bytes.size)?.let { return it }
+        }
+        throw IllegalStateException(err)
+    }
+
+    /** Finds the first base64 image in either API's answer. */
+    private fun findImage(o: Any?): String? {
+        when (o) {
+            is JSONObject -> {
+                if (o.optString("type") == "image" && o.has("data")) return o.optString("data")
+                (o.optJSONObject("inlineData") ?: o.optJSONObject("inline_data"))?.let { d -> if (d.optString("mimeType", d.optString("mime_type")).startsWith("image")) return d.optString("data") }
+                for (k in o.keys()) findImage(o.opt(k))?.let { return it }
+            }
+            is JSONArray -> for (i in 0 until o.length()) findImage(o.opt(i))?.let { return it }
+        }
+        return null
+    }
+
+    /** Blend only the changed face area of [gen] onto [base] (top half, feathered). */
+    private fun blendFace(base: Bitmap, gen0: Bitmap): Bitmap {
+        val w = base.width; val h = base.height
+        val gen = Bitmap.createScaledBitmap(gen0, w, h, true)
+        val a = IntArray(w * h); val g = IntArray(w * h)
+        base.getPixels(a, 0, w, 0, 0, w, h); gen.getPixels(g, 0, w, 0, 0, w, h)
+        fun lum(c: Int) = ((c shr 16 and 255) + (c shr 8 and 255) + (c and 255)) / 3
+        val lim = (h * 0.5f).toInt()
+        // diff mask on a 4× coarser grid, dilated, then feathered by distance
+        val cw = (w + 3) / 4; val ch = (lim + 3) / 4
+        val m = FloatArray(cw * ch)
+        for (y in 0 until lim) for (x in 0 until w) {
+            val d = kotlin.math.abs(lum(a[y * w + x]) - lum(g[y * w + x]))
+            if (d > 40) m[(y / 4) * cw + x / 4] += 1f / 16f
+        }
+        val dense = FloatArray(cw * ch)
+        val r = 3
+        for (y in 0 until ch) for (x in 0 until cw) {
+            var s = 0f; var n = 0
+            for (yy in maxOf(0, y - r)..minOf(ch - 1, y + r)) for (xx in maxOf(0, x - r)..minOf(cw - 1, x + r)) { s += m[yy * cw + xx]; n++ }
+            dense[y * cw + x] = if (s / n > 0.2f) 1f else 0f
+        }
+        val out = a.copyOf()
+        for (y in 0 until lim) for (x in 0 until w) {
+            // soft edge: average dense over a 3×3 coarse neighbourhood
+            val cy = y / 4; val cx = x / 4
+            var s = 0f; var n = 0
+            for (yy in maxOf(0, cy - 2)..minOf(ch - 1, cy + 2)) for (xx in maxOf(0, cx - 2)..minOf(cw - 1, cx + 2)) { s += dense[yy * cw + xx]; n++ }
+            val k = s / n
+            if (k <= 0f) continue
+            val i = y * w + x; val pa = a[i]; val pg = g[i]
+            fun mix(sh: Int) = (((pa shr sh) and 255) * (1 - k) + ((pg shr sh) and 255) * k).toInt()
+            out[i] = (pa and (0xff shl 24)) or (mix(16) shl 16) or (mix(8) shl 8) or mix(0)
+        }
+        return Bitmap.createBitmap(out, w, h, Bitmap.Config.ARGB_8888)
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/PetSprite.kt b/src/android/app/src/main/java/com/openminis/app/plus/PetSprite.kt
new file mode 100644
index 0000000..c6e0bfb
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/PetSprite.kt
@@ -0,0 +1,154 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.graphics.RectF
+import com.openminis.app.R
+import java.io.File
+import kotlin.math.PI
+import kotlin.math.sin
+
+/**
+ * [Mines-pet-32] Real frame animation for the desk pet (no GPU needed).
+ *
+ * One character = a base picture plus same-framing frames: blink (eyes
+ * closed), mouth_a / mouth_o (visemes for lip-sync), think (eyes up). Built-in
+ * characters ship them (generated from the line-up art, the changed face area
+ * composited back onto the original so the body never jitters); for the
+ * user's own picture 「生成动作」 makes them with Gemini ([PetFrameGen]).
+ *
+ * Drawing: the base is drawn through a grid mesh (drawBitmapMesh) whose
+ * vertices move with a slow sine — breathing in the chest, a gentle sway that
+ * grows towards the hair ends — then each active frame is crossfaded on top
+ * with its own alpha (eased, 120–200 ms), so nothing ever hard-swaps.
+ */
+object PetFrames {
+    const val BLINK = "blink"; const val MOUTH_A = "mouth_a"; const val MOUTH_O = "mouth_o"; const val THINK = "think"
+    val names = listOf(BLINK, MOUTH_A, MOUTH_O, THINK)
+
+    private val builtin: Map<String, Map<String, Int>> = mapOf(
+        "claude" to mapOf(BLINK to R.drawable.pet_claude_blink, MOUTH_A to R.drawable.pet_claude_mouth_a, MOUTH_O to R.drawable.pet_claude_mouth_o, THINK to R.drawable.pet_claude_think),
+        "gemini" to mapOf(BLINK to R.drawable.pet_gemini_blink, MOUTH_A to R.drawable.pet_gemini_mouth_a, MOUTH_O to R.drawable.pet_gemini_mouth_o, THINK to R.drawable.pet_gemini_think),
+        "gpt" to mapOf(BLINK to R.drawable.pet_gpt_blink, MOUTH_A to R.drawable.pet_gpt_mouth_a, MOUTH_O to R.drawable.pet_gpt_mouth_o, THINK to R.drawable.pet_gpt_think),
+        "grok" to mapOf(BLINK to R.drawable.pet_grok_blink, MOUTH_A to R.drawable.pet_grok_mouth_a, THINK to R.drawable.pet_grok_think),
+        "kimi" to mapOf(BLINK to R.drawable.pet_kimi_blink, MOUTH_A to R.drawable.pet_kimi_mouth_a, MOUTH_O to R.drawable.pet_kimi_mouth_o),
+        "wenxin" to mapOf(BLINK to R.drawable.pet_wenxin_blink, MOUTH_A to R.drawable.pet_wenxin_mouth_a, MOUTH_O to R.drawable.pet_wenxin_mouth_o, THINK to R.drawable.pet_wenxin_think),
+        "whale" to mapOf(BLINK to R.drawable.pet_whale_blink, MOUTH_A to R.drawable.pet_whale_mouth_a, MOUTH_O to R.drawable.pet_whale_mouth_o, THINK to R.drawable.pet_whale_think),
+    )
+
+    fun customDir(c: Context) = File(c.filesDir, "pet_frames")
+    fun customBase(c: Context) = File(customDir(c), "base.png")
+    fun hasCustom(c: Context) = customBase(c).exists() && names.any { File(customDir(c), "$it.png").exists() }
+
+    data class FrameSet(val key: String, val base: Bitmap, val frames: Map<String, Bitmap>)
+    @Volatile private var cache: FrameSet? = null
+
+    /** The frame set for [style] (built-in id or custom), or null when this character has none. */
+    fun load(c: Context, style: String, version: Long): FrameSet? {
+        val key = "$style/$version"
+        cache?.takeIf { it.key == key }?.let { return it }
+        val set = runCatching {
+            if (style == Avatars.CUSTOM) {
+                if (!hasCustom(c)) return@runCatching null
+                val base = BitmapFactory.decodeFile(customBase(c).absolutePath) ?: return@runCatching null
+                val fr = names.mapNotNull { n -> File(customDir(c), "$n.png").takeIf { it.exists() }?.let { f -> BitmapFactory.decodeFile(f.absolutePath)?.let { n to it } } }.toMap()
+                FrameSet(key, base, fr)
+            } else {
+                val b = Avatars.builtins.firstOrNull { it.id == style } ?: return@runCatching null
+                val ids = builtin[style] ?: return@runCatching null
+                val base = BitmapFactory.decodeResource(c.resources, b.neutral) ?: return@runCatching null
+                FrameSet(key, base, ids.mapNotNull { (n, id) -> BitmapFactory.decodeResource(c.resources, id)?.let { n to it } }.toMap())
+            }
+        }.getOrNull()
+        cache = set
+        return set
+    }
+
+    fun invalidate() { cache = null }
+}
+
+/** Draws a [PetFrames.FrameSet] with mesh breathing + crossfaded frames. */
+class PetSprite {
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+    private val outlinePaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+    private val COLS = 6; private val ROWS = 10
+    private val verts = FloatArray((COLS + 1) * (ROWS + 1) * 2)
+
+    /** Current eased alpha per frame (0..1). */
+    private val alpha = HashMap<String, Float>()
+
+    /** Ease each frame's alpha towards its target; [dt] in seconds, [tau] ≈ crossfade time. */
+    fun step(targets: Map<String, Float>, dt: Float, tau: Float = 0.08f) {
+        val k = (dt / tau).coerceIn(0f, 1f)
+        val keys = (alpha.keys + targets.keys).toSet()
+        for (n in keys) {
+            val cur = alpha[n] ?: 0f
+            val tgt = targets[n] ?: 0f
+            alpha[n] = cur + (tgt - cur) * k
+        }
+    }
+
+    fun alphaOf(n: String) = alpha[n] ?: 0f
+
+    /**
+     * @param t seconds since start (breathing / sway phase)
+     * @param breath 0..1 strength (0 while held or asleep-deep)
+     * @param outline draw a high-contrast silhouette outline (busy wallpapers)
+     */
+    fun draw(canvas: Canvas, set: PetFrames.FrameSet, dst: RectF, t: Float, breath: Float, outline: Int?, density: Float) {
+        val bmp = set.base
+        val bw = bmp.width.toFloat(); val bh = bmp.height.toFloat()
+        // aspect-fit, bottom anchored
+        val ar = bw / bh
+        val dw = if (dst.width() / dst.height() > ar) dst.height() * ar else dst.width()
+        val dh = dw / ar
+        val l = dst.left + (dst.width() - dw) / 2f
+        val top = dst.bottom - dh
+        val sx = dw / bw; val sy = dh / bh
+        // mesh: breathing (chest rows 0.45..0.8 widen slightly), sway growing towards the bottom/sides (hair)
+        var i = 0
+        val br = sin(t * 2f * PI.toFloat() / 3.6f) * breath           // ~3.6 s breath
+        val sw = sin(t * 2f * PI.toFloat() / 5.3f + 0.7f) * breath     // slower sway
+        for (r in 0..ROWS) {
+            val fy = r.toFloat() / ROWS
+            for (c in 0..COLS) {
+                val fx = c.toFloat() / COLS
+                var x = fx * bw; var y = fy * bh
+                val chest = (1f - kotlin.math.abs(fy - 0.6f) / 0.25f).coerceIn(0f, 1f)
+                x += (fx - 0.5f) * bw * 0.018f * br * chest
+                y -= bh * 0.006f * br * (1f - fy)                      // head rises a touch on the in-breath
+                val side = kotlin.math.abs(fx - 0.5f) * 2f
+                x += bw * 0.012f * sw * fy * fy * (0.4f + side)        // hair / skirt ends sway most
+                verts[i++] = l + x * sx; verts[i++] = top + y * sy
+            }
+        }
+        if (outline != null) {
+            outlinePaint.colorFilter = PorterDuffColorFilter(outline, PorterDuff.Mode.SRC_IN)
+            val o = 2.2f * density
+            for ((ox, oy) in listOf(o to 0f, -o to 0f, 0f to o, 0f to -o)) {
+                canvas.save(); canvas.translate(ox, oy)
+                canvas.drawBitmapMesh(bmp, COLS, ROWS, verts, 0, null, 0, outlinePaint)
+                canvas.restore()
+            }
+        }
+        paint.alpha = 255
+        canvas.drawBitmapMesh(bmp, COLS, ROWS, verts, 0, null, 0, paint)
+        // frames share the base framing → same mesh, crossfaded on top
+        for (n in PetFrames.names) {
+            val a = alphaOf(n); if (a < 0.02f) continue
+            val f = set.frames[n] ?: continue
+            if (f.width != bmp.width || f.height != bmp.height) continue
+            paint.alpha = (a * 255).toInt().coerceIn(0, 255)
+            canvas.drawBitmapMesh(f, COLS, ROWS, verts, 0, null, 0, paint)
+        }
+        paint.alpha = 255
+    }
+
+    companion object { val OUTLINE_LIGHT = Color.WHITE }
+}
