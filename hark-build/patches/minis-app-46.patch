+import androidx.compose.ui.window.Popup
+import androidx.compose.ui.window.PopupProperties
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleEventObserver
+import com.openminis.app.plus.MinesJobs
+import kotlinx.coroutines.delay
+
+/**
+ * [Mines-jobs-25] App-wide host for background jobs: a slim pill at the top
+ * while something runs (tap for the last output line), and a short popup at
+ * the bottom when a job ends — "已安装 X" on success (3 s), or the reason with
+ * 重试 / 详情 on failure (stays 10 s). Never blocks the screen: both are
+ * non-focusable popups, touches outside go to the app.
+ */
+@Composable
+fun MinesJobsHost() {
+    val context = LocalContext.current
+    val owner = LocalLifecycleOwner.current
+    DisposableEffect(owner) {
+        val obs = LifecycleEventObserver { _, e ->
+            if (e == Lifecycle.Event.ON_START) MinesJobs.appInForeground = true
+            if (e == Lifecycle.Event.ON_STOP) MinesJobs.appInForeground = false
+        }
+        owner.lifecycle.addObserver(obs)
+        onDispose { owner.lifecycle.removeObserver(obs) }
+    }
+    val jobs by MinesJobs.jobs.collectAsState()
+    val running = jobs.filter { it.running }
+    var expanded by remember { mutableStateOf(false) }
+    var toast by remember { mutableStateOf<MinesJobs.Job?>(null) }
+    var details by remember { mutableStateOf(false) }
+    LaunchedEffect(Unit) { MinesJobs.finished.collect { toast = it; details = false } }
+    LaunchedEffect(toast, details) {
+        val t = toast ?: return@LaunchedEffect
+        if (details) return@LaunchedEffect
+        delay(if (t.ok) 3000 else 10_000)
+        if (toast?.id == t.id) toast = null
+    }
+
+    if (running.isNotEmpty()) {
+        Popup(alignment = Alignment.TopCenter, properties = PopupProperties(focusable = false)) {
+            Column(
+                Modifier.statusBarsPadding().padding(top = 6.dp)
+                    .widthIn(max = 340.dp)
+                    .shadow(6.dp, RoundedCornerShape(18.dp))
+                    .clip(RoundedCornerShape(18.dp))
+                    .background(Color(0xF02B2522))
+                    .clickable { expanded = !expanded }
+                    .padding(horizontal = 14.dp, vertical = 8.dp)
+                    .semantics { liveRegion = LiveRegionMode.Polite },
+            ) {
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    CircularProgressIndicator(Modifier.size(14.dp), strokeWidth = 2.dp, color = Color(0xFFF4F0E8))
+                    Spacer(Modifier.width(8.dp))
+                    Text(
+                        if (running.size == 1) running[0].title + "…" else "${running.size} 个任务在后台进行",
+                        color = Color.White, fontSize = 14.sp, maxLines = 1, overflow = TextOverflow.Ellipsis,
+                    )
+                }
+                if (expanded) running.forEach { j ->
+                    Text(j.lastLine.ifBlank { "准备中…" }, color = Color(0xFFD9D2C7), fontSize = 12.sp, maxLines = 2,
+                        overflow = TextOverflow.Ellipsis, modifier = Modifier.padding(top = 4.dp))
+                }
+            }
+        }
+    }
+
+    val t = toast
+    if (t != null) {
+        Popup(alignment = Alignment.BottomCenter, properties = PopupProperties(focusable = false)) {
+            AnimatedVisibility(visible = true, enter = fadeIn(), exit = fadeOut()) {
+                Column(
+                    Modifier.navigationBarsPadding().padding(horizontal = 16.dp, vertical = 24.dp)
+                        .widthIn(max = 420.dp).fillMaxWidth()
+                        .shadow(8.dp, RoundedCornerShape(16.dp))
+                        .clip(RoundedCornerShape(16.dp))
+                        .background(if (t.ok) Color(0xFF1F3A2B) else Color(0xFF3A1F1F))
+                        .padding(horizontal = 16.dp, vertical = 12.dp)
+                        .semantics { liveRegion = LiveRegionMode.Assertive },
+                    verticalArrangement = Arrangement.spacedBy(6.dp),
+                ) {
+                    Text(
+                        if (t.ok) "✓ " + t.successText else "✗ " + t.title + " 没成功",
+                        color = Color.White, fontSize = 16.sp,
+                    )
+                    if (!t.ok) Text(t.reason, color = Color(0xFFFFD6D6), fontSize = 14.sp)
+                    if (details) Box(Modifier.fillMaxWidth().clip(RoundedCornerShape(8.dp)).background(Color(0x33000000)).padding(8.dp)) {
+                        Text(t.lines.takeLast(8).joinToString("\n"), color = Color(0xFFE8E2D9), fontSize = 11.sp)
+                    }
+                    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.End) {
+                        if (!t.ok) {
+                            TextButton(onClick = { details = !details }) { Text(if (details) "收起" else "详情", color = Color.White) }
+                            TextButton(onClick = { toast = null; MinesJobs.retry(context, t) }) { Text("重试", color = Color(0xFFFFB199)) }
+                        }
+                        TextButton(onClick = { toast = null }) { Text("好", color = Color.White) }
+                    }
+                }
+            }
+        }
+    }
+}
