+        if (o.has("usage") && !o.isNull("usage")) return false
+        if (o.has("error") || o.has("type")) return false
+        val ch = o.optJSONArray("choices") ?: return o.length() == 0 || (o.length() <= 3 && (o.has("id") || o.has("object")) && !o.has("output"))
