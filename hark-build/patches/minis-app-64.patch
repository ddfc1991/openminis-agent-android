@@ -0,0 +1,33 @@
+package com.openminis.app.browser
+
+/**
+ * [Mines-38.9.7] 无痕标签 (user 2026-10-18). Pure rules, unit-tested:
+ *  - an incognito tab lives in its own WebView profile (androidx.webkit MULTI_PROFILE), so its cookies / storage never
+ *    touch the default jar that LoginMemory, SessionKeeper, AutoSources and the agent read;
+ *  - closing the incognito sheet wipes that profile (cookies, storage, cache, history) and deletes it;
+ *  - when the phone's WebView has no profile support the tab is NOT opened (sharing the normal jar would be a lie) —
+ *    the user gets one clear line instead.
+ */
+object IncognitoCore {
+    const val PROFILE = "mines-incognito"
+    const val TITLE_PREFIX = "无痕 · "
+    const val NO_PROFILE_MSG = "这台手机的系统 WebView 太旧，不支持无痕标签。请在应用商店更新「Android System WebView」后再试。"
+    const val CLOSED_MSG = "无痕标签已关闭，Cookie 和浏览记录已清除"
+
+    sealed class Plan { object Open : Plan(); data class Refuse(val why: String) : Plan() }
+
+    fun plan(profileSupported: Boolean): Plan = if (profileSupported) Plan.Open else Plan.Refuse(NO_PROFILE_MSG)
+
+    /** What an incognito tab may feed: nothing that outlives it. */
+    fun recordsHistory(incognito: Boolean) = !incognito
+    fun feedsAccounts(incognito: Boolean) = !incognito      // AutoAccounts / LoginMemory / SessionKeeper / AutoSources
+    fun handsOver(incognito: Boolean) = !incognito          // BrowserHandoff (agent takeover)
+    fun persistsTabs(incognito: Boolean) = !incognito       // browser_tabs/<sid>.json
+
+    fun title(base: String, incognito: Boolean) = if (incognito) TITLE_PREFIX + base else base
+
+    /** 自检 line. */
+    fun selfCheck(supported: Boolean, lastClose: String?): Pair<Boolean, String> =
+        if (!supported) false to "系统 WebView 不支持独立配置（需要更新 Android System WebView）"
+        else true to ("独立配置可用" + (lastClose?.let { " · 上次关闭：$it" } ?: ""))
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/browser/WebPrewarm.kt b/src/android/app/src/main/java/com/openminis/app/browser/WebPrewarm.kt
new file mode 100644
