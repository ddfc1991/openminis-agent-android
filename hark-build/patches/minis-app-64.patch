+        val host = root(m.fromAddr.substringAfter('@', ""))
+        if (host.isBlank()) return
+        val a = KeychainCore.detectAlert(AutoAccounts.siteOf(host), host, m.address, m.subject, m.text, m.at, "邮件") ?: return
+        addAlert(c, a, "m:" + m.id)
+    }
+
+    /** An SMS 【站点】…异地登录 / 新设备… → an alert for the number it went to. */
+    fun onSms(c: Context, body: String) {
+        init(c)
+        val site = Regex("[【\\[]([^】\\]]{2,16})[】\\]]").find(body)?.groupValues?.get(1)?.trim() ?: return
+        val phone = runCatching { LoginAssist.phoneNumber(c) }.getOrNull().orEmpty()
+        val a = KeychainCore.detectAlert(site, "", phone, "", body, System.currentTimeMillis(), "短信") ?: return
+        addAlert(c, a, "s:" + body.hashCode())
+    }
+
+    fun pending(): KeychainCore.Alert? = _alerts.value.firstOrNull { it.second == "new" }?.first
+
+    /** 「是我」: the alert is closed, the account back to 正常. */
+    fun confirmMe(c: Context, a: KeychainCore.Alert) { _alerts.value = _alerts.value.map { if (it.first.key == a.key) it.first to "me" else it }; save(c) }
+    /** 「不是我」: stays 异常登录 until the user says it is handled; returns the security page to open. */
+    fun notMe(c: Context, a: KeychainCore.Alert): String {
+        _alerts.value = _alerts.value.map { if (it.first.key == a.key) it.first to "notme" else it }; save(c)
+        return KeychainCore.securityUrl(a.host.ifBlank { guessHost(c, a.site) })
+    }
+    fun handled(c: Context, acct: Acct) {
+        _alerts.value = _alerts.value.map { (x, st) -> if ((st == "new" || st == "notme") && ((x.host.isNotBlank() && root(x.host) == root(acct.host)) || x.site.equals(acct.site, true))) x to "done" else x to st }
+        save(c)
+    }
+    fun alertFor(acct: Acct): KeychainCore.Alert? = _alerts.value.firstOrNull { (x, st) -> (st == "new" || st == "notme") && ((x.host.isNotBlank() && root(x.host) == root(acct.host)) || x.site.equals(acct.site, true)) }?.first
+
+    private fun guessHost(c: Context, site: String): String = all(c).firstOrNull { it.site.equals(site, true) }?.host.orEmpty()
+
+    /** 消息 › 账号异常 cards (one per open alert). */
+    fun digestItems(c: Context): List<Digest.Item> {
+        init(c)
+        return _alerts.value.filter { it.second == "new" || it.second == "notme" }.take(5).map { (a, _) ->
+            Digest.Item("kc:" + a.key, "账号巡查", "patrol", a.site, "${a.site} 有新设备登录",
+                listOf(a.device, a.place).filter { it.isNotBlank() }.joinToString(" · ").ifBlank { "看一下是不是你" }, a.at,
+                act = "route:" + com.openminis.app.ui.plus.PlusRoutes.KEYCHAIN)
+        }
+    }
+
+    /** AutoAccounts recorded a new account: glass toast inside Mines, system toast when Mines is in the background. */
+    fun announce(c: Context, site: String, sub: String) {
+        if (MinesJobs.appInForeground && _toast.tryEmit(site to sub)) return
+        runCatching { android.widget.Toast.makeText(c.applicationContext, "已记下 $site 账号", android.widget.Toast.LENGTH_SHORT).show() }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/KeychainCore.kt b/src/android/app/src/main/java/com/openminis/app/plus/KeychainCore.kt
new file mode 100644
index 0000000..ae2c8c4
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/KeychainCore.kt
@@ -0,0 +1,169 @@
+package com.openminis.app.plus
+
+/**
+ * [Mines-38.9] 账号关联 keychain — the pure part (no Android types, unit-tested on the JVM): identity of an account
+ * (phone / e-mail), masking, status order, TOTP (RFC 6238), otpauth:// parsing, new-device / abnormal-login detection in
+ * a mail or SMS, and each site's security page.
+ */
+object KeychainCore {
+    enum class Status(val label: String, val rank: Int) { ABNORMAL("异常登录", 0), EXPIRED("登录失效", 1), OK("正常", 2) }
+
+    enum class IdKind { PHONE, EMAIL, OTHER }
+    data class Identity(val kind: IdKind, val key: String, val label: String, val masked: String)
+
+    private val EMAIL = Regex("^[^@\\s]+@([A-Za-z0-9-]+\\.)+[A-Za-z]{2,}$")
+    private val PHONE = Regex("^\\+?[0-9][0-9 \\-]{6,16}[0-9]$")
+
+    fun digits(s: String) = s.filter { it.isDigit() }
+
+    /** Which identity an account name belongs to: 手机号 (by its last 11 digits) / the mailbox / 其他. */
+    fun identity(account: String): Identity {
+        val a = account.trim()
+        if (EMAIL.matches(a)) {
+            val dom = a.substringAfter('@').lowercase()
+            val label = when {
+                dom == "gmail.com" || dom == "googlemail.com" -> "Gmail"
+                dom == "163.com" -> "163 邮箱"
+                dom == "126.com" -> "126 邮箱"
+                dom == "qq.com" -> "QQ 邮箱"
+                dom.startsWith("outlook.") || dom.startsWith("hotmail.") || dom == "live.com" -> "Outlook"
+                dom == "icloud.com" || dom == "me.com" -> "iCloud"
+                else -> "邮箱"
+            }
+            return Identity(IdKind.EMAIL, a.lowercase(), label, a.substringBefore('@').take(10) + "@…")
+        }
+        if (PHONE.matches(a)) {
+            val d = digits(a).takeLast(11)
+            return Identity(IdKind.PHONE, "phone:$d", "手机号", maskPhone(a))
+        }
+        return Identity(IdKind.OTHER, "other", "其他账号", "")
+    }
+
+    /** +86 136****8658 style: country code kept, middle four hidden. */
+    fun maskPhone(p: String): String {
+        val d = digits(p)
+        if (d.length < 7) return p
+        val local = if (d.length > 11 && d.startsWith("86")) d.takeLast(11) else d.takeLast(minOf(11, d.length))
+        val cc = if (p.trim().startsWith("+") || d.length > 11) "+" + d.dropLast(local.length).ifBlank { "86" } + " " else ""
+        val m = if (local.length >= 11) local.take(3) + "****" + local.takeLast(4) else local.take(2) + "***" + local.takeLast(2)
+        return cc + m
+    }
+
+    fun maskAccount(a: String): String = when (identity(a).kind) {
+        IdKind.PHONE -> maskPhone(a).substringAfter(' ')
+        else -> a
+    }
+
+    // ---------------- TOTP (RFC 6238, SHA-1, 6 digits, 30 s) ----------------
+
+    data class Totp(val secret: String, val digits: Int = 6, val period: Int = 30, val algo: String = "HmacSHA1", val issuer: String = "", val label: String = "")
+
+    fun base32(s: String): ByteArray? {
+        val alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
+        val clean = s.uppercase().filter { it != ' ' && it != '-' && it != '=' }
+        if (clean.isEmpty() || clean.any { it !in alpha }) return null
+        val out = java.io.ByteArrayOutputStream()
+        var buf = 0; var bits = 0
+        for (c in clean) {
+            buf = (buf shl 5) or alpha.indexOf(c); bits += 5
+            if (bits >= 8) { out.write((buf shr (bits - 8)) and 0xFF); bits -= 8 }
+        }
+        return out.toByteArray()
+    }
+
+    /** A pasted secret (base32) or an otpauth://totp/… URI (from a QR code shown on the site). */
+    fun parseTotp(input: String): Totp? {
+        val t = input.trim()
+        if (t.startsWith("otpauth://", true)) {
+            val q = t.substringAfter('?', "")
+            val params = q.split('&').mapNotNull { kv -> kv.split('=', limit = 2).takeIf { it.size == 2 }?.let { it[0].lowercase() to java.net.URLDecoder.decode(it[1], "UTF-8") } }.toMap()
+            val sec = params["secret"] ?: return null
+            if (base32(sec) == null) return null
+            val label = java.net.URLDecoder.decode(t.substringAfter("totp/", "").substringBefore('?'), "UTF-8")
+            val algo = when (params["algorithm"]?.uppercase()) { "SHA256" -> "HmacSHA256"; "SHA512" -> "HmacSHA512"; else -> "HmacSHA1" }
+            return Totp(sec.uppercase().replace(" ", ""), params["digits"]?.toIntOrNull()?.coerceIn(6, 8) ?: 6,
+                params["period"]?.toIntOrNull()?.coerceIn(15, 120) ?: 30, algo, params["issuer"] ?: label.substringBefore(':'), label.substringAfter(':'))
+        }
+        val sec = t.uppercase().replace(" ", "").replace("-", "")
+        return if (sec.length >= 16 && base32(sec) != null) Totp(sec) else null
+    }
+
+    fun totpCode(t: Totp, epochMs: Long): String {
+        val key = base32(t.secret) ?: return ""
+        val counter = epochMs / 1000 / t.period
+        val msg = ByteArray(8) { i -> ((counter shr ((7 - i) * 8)) and 0xFF).toByte() }
+        val mac = javax.crypto.Mac.getInstance(t.algo); mac.init(javax.crypto.spec.SecretKeySpec(key, t.algo))
+        val h = mac.doFinal(msg)
+        val o = h[h.size - 1].toInt() and 0x0F
+        val bin = ((h[o].toInt() and 0x7F) shl 24) or ((h[o + 1].toInt() and 0xFF) shl 16) or ((h[o + 2].toInt() and 0xFF) shl 8) or (h[o + 3].toInt() and 0xFF)
+        var mod = 1; repeat(t.digits) { mod *= 10 }
+        return (bin % mod).toString().padStart(t.digits, '0')
+    }
+
+    fun secondsLeft(t: Totp, epochMs: Long): Int = t.period - ((epochMs / 1000) % t.period).toInt()
+
+    fun spaced(code: String) = if (code.length == 6) code.take(3) + " " + code.takeLast(3) else code
+
+    // ---------------- new-device / abnormal login in a mail or SMS ----------------
+
+    data class Alert(val site: String, val host: String, val account: String, val device: String, val place: String, val at: Long, val source: String, val key: String)
+
+    private val ALERT = Regex("(?i)(新设备|新的设备|异地登录|异常登录|陌生设备|新登录|登录提醒|登录通知|安全提醒|new (sign-?in|login|device)|unusual (sign-?in|activity|login)|suspicious|security alert|signed in from|login attempt|was used to sign in)")
+    private val NOT_ALERT = Regex("(?i)(验证码|verification code|one-time|otp|your code|动态码)")   // a code mail is a code, not an alert
+
+    /** A mail (subject + body) or an SMS that says someone signed in somewhere new; null when it is not one. */
+    fun detectAlert(siteHint: String, host: String, account: String, subject: String, body: String, at: Long, source: String): Alert? {
+        val head = subject + " " + body.take(400)
+        if (!ALERT.containsMatchIn(head)) return null
+        if (NOT_ALERT.containsMatchIn(subject) && !Regex("(新设备|异地|new device|unusual)", RegexOption.IGNORE_CASE).containsMatchIn(subject)) return null
+        val text = body.replace('\r', ' ')
+        fun field(vararg k: String): String {
+            for (w in k) {
+                val m = Regex("(?i)$w\\s*[:：]\\s*([^\\n。；;|]{2,60})").find(text) ?: continue
+                return m.groupValues[1].trim().trimEnd(',', '，', '.').take(40)
+            }
+            return ""
+        }
+        var device = field("设备", "登录设备", "device", "browser", "浏览器", "客户端", "operating system", "系统")
+        var place = field("位置", "地点", "登录地点", "地区", "location", "near", "城市", "ip ?地址", "ip address", "ip")
+        if (device.isBlank()) Regex("(?i)(windows|mac ?os|macintosh|iphone|ipad|android|linux|chrome ?os)[^\\n,，。.;]{0,24}").find(text)?.let { device = it.value.trim().removeSuffix(" device").take(40) }
+        if (place.isBlank()) Regex("(?:\\b(?:from|near|in)\\s+([A-Z][a-zA-Z]+(?: [A-Z][a-zA-Z]+){0,2})|(?:来自|在)\\s*([\\u4e00-\\u9fa5]{2,8})(?:附近|登录))").find(text)?.let { place = it.groupValues[1].ifBlank { it.groupValues[2] }.trim() }
+        val site = siteHint.ifBlank { host }
+        return Alert(site, host, account, device, place, at, source, (host.ifBlank { site } + "|" + account + "|" + (at / 60_000)).lowercase())
+    }
+
+    /** Where the user changes the password / signs out other devices for a site (null → the site's home page). */
+    fun securityUrl(host: String): String {
+        val h = host.lowercase().removePrefix("www.")
+        fun has(x: String) = h == x || h.endsWith(".$x")
+        return when {
+            has("github.com") -> "https://github.com/settings/security"
+            has("okx.com") -> "https://www.okx.com/account/security"
+            has("binance.com") -> "https://www.binance.com/en/my/security"
+            has("aliyun.com") -> "https://account.console.aliyun.com/v2/#/secure"
+            has("cloudflare.com") -> "https://dash.cloudflare.com/profile/authentication"
+            has("google.com") || has("gmail.com") -> "https://myaccount.google.com/security"
+            has("163.com") || has("126.com") -> "https://mail.163.com/"
+            has("qq.com") -> "https://aq.qq.com/"
+            has("microsoft.com") || has("outlook.com") || has("live.com") -> "https://account.microsoft.com/security"
+            has("x.com") || has("twitter.com") -> "https://x.com/settings/security_and_account_access"
+            has("apple.com") || has("icloud.com") -> "https://account.apple.com/"
+            has("modelscope.cn") -> "https://www.modelscope.cn/my/myaccesstoken"
+            h.isBlank() -> "about:blank"
+            else -> "https://$h/"
+        }
+    }
+
+    /** One plain step-by-step guide shown with 「不是我，帮我处理」 (nothing is changed automatically). */
+    fun guideFor(host: String): List<String> {
+        val h = host.lowercase()
+        val base = listOf("改一个新密码（别和别的网站一样）", "在「登录设备 / 会话」里退出不认识的设备", "打开两步验证（可以存在 Mines 里）")
+        return when {
+            h.contains("okx") || h.contains("binance") -> base + "查一下提币地址白名单和 API Key，删掉不认识的"
+            h.contains("github") -> base + "看一下 Personal access tokens 和 SSH keys，删掉不认识的"
+            h.contains("aliyun") || h.contains("cloudflare") -> base + "看一下 AccessKey / API Token，删掉不认识的"
+            h.contains("google") || h.contains("gmail") || h.contains("163") || h.contains("qq") -> base + "看一下邮件转发和过滤规则有没有被加"
+            else -> base
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/MailImap.kt b/src/android/app/src/main/java/com/openminis/app/plus/MailImap.kt
new file mode 100644
index 0000000..d5f9d4a
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/MailImap.kt
@@ -0,0 +1,155 @@
+package com.openminis.app.plus
+
+import java.io.BufferedInputStream
+import java.io.ByteArrayOutputStream
+import java.io.OutputStream
+import java.net.InetSocketAddress
+import java.net.Socket
+import javax.net.ssl.SSLSocket
+import javax.net.ssl.SSLSocketFactory
+
+/**
+ * [Mines-38.8] 消息 → 邮箱: a read-only IMAP reader for the aggregated inbox (no Android imports, unit-tested on the JVM).
+ *
+ * Only ever LOGIN / SELECT (EXAMINE) / FETCH with BODY.PEEK — Mines never sends mail, never marks mail read, never deletes.
+ * An account is "connected" only after a real LOGIN + SELECT succeeded (user rule: never pretend linked).
+ */
+object MailImap {
+    enum class Fail { AUTH, NET, PROTOCOL }
+
+    class ImapError(val kind: Fail, message: String) : Exception(message)
+
+    data class Msg(
+        val uid: String, val from: String, val fromAddr: String, val subject: String, val text: String,
+        val at: Long, val unread: Boolean,
+    )
+
+    data class Box(val exists: Int, val unseen: Int, val msgs: List<Msg>)
+
+    /** Test hook: "host:port" → plain TCP instead of TLS on 993 (JVM unit test + adb self-test fake server only). */
+    @Volatile var plainOverride: String? = null
+
+    /** IMAP host for an address, or null when Mines does not know the provider. */
+    fun hostFor(email: String): String? {
+        val d = email.substringAfter('@', "").lowercase().trim()
+        return when {
+            d == "gmail.com" || d == "googlemail.com" -> "imap.gmail.com"
+            d == "163.com" -> "imap.163.com"
+            d == "126.com" -> "imap.126.com"
+            d == "yeah.net" -> "imap.yeah.net"
+            d == "vip.163.com" -> "imap.vip.163.com"
+            d == "qq.com" || d == "foxmail.com" || d == "vip.qq.com" -> "imap.qq.com"
+            d == "sina.com" || d == "sina.cn" -> "imap.sina.com"
+            d == "aliyun.com" -> "imap.aliyun.com"
+            d == "outlook.com" || d == "hotmail.com" || d == "live.com" -> "outlook.office365.com"
+            d == "smoke.test" && plainOverride != null -> "smoke"
+            else -> null
+        }
+    }
+
+    private val DATE = java.time.format.DateTimeFormatter.ofPattern("d-MMM-yyyy HH:mm:ss Z", java.util.Locale.US)
+
+    private fun open(host: String): Socket {
+        plainOverride?.let { o ->
+            val h = o.substringBefore(':'); val p = o.substringAfter(':').toIntOrNull() ?: 1143
+            return Socket().apply { connect(InetSocketAddress(h, p), 8000); soTimeout = 15_000 }
+        }
+        return (SSLSocketFactory.getDefault().createSocket() as SSLSocket).apply {
+            connect(InetSocketAddress(host, 993), 8000); soTimeout = 15_000; startHandshake()
+        }
+    }
+
+    /** Newest [max] messages of INBOX, newest first, plus the unseen count. Throws [ImapError]. */
+    fun inbox(host: String, user: String, pass: String, max: Int = 20): Box {
+        val sock = try { open(host) } catch (e: Exception) { throw ImapError(Fail.NET, "连不上 $host（${e.javaClass.simpleName}）") }
+        sock.use { s ->
+            val inp = BufferedInputStream(s.getInputStream())
+            val out = s.getOutputStream()
+            try {
+                val greet = readLine(inp)
+                if (!greet.startsWith("* OK") && !greet.startsWith("* PREAUTH")) throw ImapError(Fail.PROTOCOL, "服务器没有正常应答")
+                var n = 0
+                fun cmd(c: String): List<Any> { n++; val tag = "m$n"; send(out, "$tag $c"); return readTagged(inp, tag) }
+                // 163 / 126 / yeah refuse SELECT ("Unsafe Login") unless the client says who it is first
+                if (host.contains("163") || host.contains("126") || host.contains("yeah")) cmd("ID (\"name\" \"Mines\" \"version\" \"38.8\" \"vendor\" \"Mines\")")
+                val login = cmd("LOGIN ${q(user)} ${q(pass)}")
+                if (!lastOk(login)) {
+                    val why = (login.lastOrNull() as? String)?.substringAfter(" NO ", "")?.trim()?.take(80).orEmpty()
+                    throw ImapError(Fail.AUTH, if (why.isNotBlank()) "登录被拒：$why" else "登录被拒")
+                }
+                val sel = cmd("EXAMINE INBOX")   // read-only: nothing is ever marked read
+                if (!lastOk(sel)) {
+                    val why = (sel.lastOrNull() as? String)?.take(80).orEmpty()
+                    throw ImapError(if (why.contains("Unsafe", true)) Fail.AUTH else Fail.PROTOCOL, "打不开收件箱：$why")
+                }
+                val exists = sel.filterIsInstance<String>().firstNotNullOfOrNull { Regex("^\\* (\\d+) EXISTS").find(it)?.groupValues?.get(1)?.toIntOrNull() } ?: 0
+                val st = cmd("STATUS INBOX (UNSEEN)")
+                var unseen = st.filterIsInstance<String>().firstNotNullOfOrNull { Regex("UNSEEN (\\d+)").find(it)?.groupValues?.get(1)?.toIntOrNull() } ?: -1
+                if (exists == 0) { runCatching { cmd("LOGOUT") }; return Box(0, 0, emptyList()) }
+                val from = maxOf(1, exists - max + 1)
+                val res = cmd("FETCH $from:$exists (UID FLAGS INTERNALDATE BODY.PEEK[]<0.16000>)")
+                runCatching { cmd("LOGOUT") }
+                val msgs = ArrayList<Msg>()
+                var i = 0
+                while (i < res.size) {
+                    val line = res[i] as? String
+                    val lit = res.getOrNull(i + 1) as? ByteArray
+                    if (line != null && line.contains("FETCH") && lit != null) {
+                        val uid = Regex("UID (\\d+)").find(line)?.groupValues?.get(1) ?: line.hashCode().toString()
+                        val flags = Regex("FLAGS \\(([^)]*)\\)").find(line + " " + ((res.getOrNull(i + 2) as? String)?.takeIf { !it.contains("FETCH") }.orEmpty()))?.groupValues?.get(1).orEmpty()
+                        val at = Regex("INTERNALDATE \"([^\"]+)\"").find(line)?.groupValues?.get(1)?.let {
+                            runCatching { java.time.ZonedDateTime.parse(it.trim(), DATE).toInstant().toEpochMilli() }.getOrDefault(0L)
+                        } ?: 0L
+                        val raw = String(lit, Charsets.UTF_8)
+                        val headEnd = Regex("\\r?\\n\\r?\\n").find(raw)?.range?.first ?: raw.length
+                        val (subject, fromH) = MailParse.headers(raw.substring(0, headEnd))
+                        val text = runCatching { MailParse.mime(raw) }.getOrDefault("")
+                        val addr = Regex("<([^>]+)>").find(fromH)?.groupValues?.get(1) ?: fromH.takeIf { it.contains('@') }.orEmpty()
+                        msgs += Msg(uid, fromH.substringBefore('<').trim().ifBlank { addr.ifBlank { fromH } }, addr.trim(), subject,
+                            text.replace(Regex("[ \\t]+"), " ").trim().take(6000), at, !flags.contains("\\Seen", ignoreCase = true))
+                        i += 2
+                    } else i++
+                }
+                if (unseen < 0) unseen = msgs.count { it.unread }
+                return Box(exists, unseen, msgs.sortedByDescending { it.uid.toLongOrNull() ?: 0L })
+            } catch (e: ImapError) { throw e
+            } catch (e: java.net.SocketTimeoutException) { throw ImapError(Fail.NET, "$host 没有应答（超时）")
+            } catch (e: java.io.IOException) { throw ImapError(Fail.NET, "和 $host 的连接断了") }
+        }
+    }
+
+    internal fun q(s: String) = "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
+
+    private fun send(out: OutputStream, line: String) { out.write((line + "\r\n").toByteArray(Charsets.UTF_8)); out.flush() }
+
+    private fun lastOk(r: List<Any>) = (r.lastOrNull() as? String)?.split(' ')?.getOrNull(1)?.equals("OK", true) == true
+
+    private fun readLine(inp: BufferedInputStream): String {
+        val b = ByteArrayOutputStream()
+        while (true) {
+            val c = inp.read()
+            if (c < 0) { if (b.size() == 0) throw java.io.EOFException(); break }
+            if (c == '\n'.code) break
+            if (c != '\r'.code) b.write(c)
+        }
+        return String(b.toByteArray(), Charsets.UTF_8)
+    }
+
+    private fun readTagged(inp: BufferedInputStream, tag: String): List<Any> {
+        val out = ArrayList<Any>()
+        var guard = 0
+        while (guard++ < 20000) {
+            val line = readLine(inp)
+            out += line
+            val lit = Regex("\\{(\\d+)\\}$").find(line)?.groupValues?.get(1)?.toIntOrNull()
+            if (lit != null) {
+                val buf = ByteArray(lit); var got = 0
+                while (got < lit) { val r = inp.read(buf, got, lit - got); if (r < 0) break; got += r }
+                out += buf
+                continue
+            }
+            if (line.startsWith("$tag ")) break
+        }
+        return out
+    }
+}
