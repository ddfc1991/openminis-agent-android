+    fun replayable(steps: List<Step>): Boolean = steps.isNotEmpty() && steps.none { sensitive.containsMatchIn(it.label) || sensitive.containsMatchIn(it.arg) }
+
+    // ── output (Mobile-MCP-style list_elements_on_screen) ───────────────
