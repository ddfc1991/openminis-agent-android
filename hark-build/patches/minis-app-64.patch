+                    val (cx, cy, z) = WeatherSkyCore.along(sh, elapsedMs.toFloat() / (WeatherSkyCore.SLOT_MS + WeatherSkyCore.XFADE_MS)).let { Triple(it[0], it[1], it[2]) }
