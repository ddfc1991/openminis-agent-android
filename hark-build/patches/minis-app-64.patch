+            colors = SliderDefaults.colors(thumbColor = m.primary, activeTrackColor = m.primary, inactiveTrackColor = m.ink3.copy(alpha = 0.25f)))
+        Text(hint, fontSize = MT.Caption, color = m.ink2)
+    }
+    Spacer(Modifier.width(1.dp))
+}
