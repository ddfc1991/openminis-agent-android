+package com.openminis.app.plus
+
+/**
+ * [Mines-38.9.6 i14] Weather background v5 (user-approved 2026-10-18 「可以了就这样」): pure part — which scene, the shader
+ * parameters per scene (skybg/v5 README tables), and the theme veil that keeps text ≥ 4.5:1. No Android imports (unit-tested).
+ */
+object WeatherSkyCore {
+    enum class Scene(val id: Int, val key: String, val zh: String) {
+        SUNNY(0, "sunny", "晴"), CLOUDY(1, "cloudy", "多云"), RAIN(2, "rain", "雨"), SNOW(3, "snow", "雪"),
+        FOG(4, "fog", "雾"), NIGHT(5, "night", "夜"), SUNSET(6, "sunset", "日落");
+        /** the scene's own palette is dark (UI column of the README) */
+        val darkSky: Boolean get() = this == RAIN || this == NIGHT || this == SUNSET
+        /** pass 2 (full-res particles) only here */
+        val particles: Boolean get() = this == RAIN || this == SNOW || this == NIGHT
+        companion object { fun of(k: String?): Scene? = values().firstOrNull { it.key == k || it.zh == k } }
+    }
+
+    /** README: 8 s in the preview, 24 s in the app (same cycles, 3× calmer) */
+    const val LOOP_S = 24f
+    /** frame cap */
+    const val FPS = 30
+    /** crossfade when the weather / time changes */
+    const val FADE_MS = 1500L
+
+    fun isRain(code: Int) = code in 51..67 || code in 80..82 || code in 95..99
+    fun isSnow(code: Int) = code in 71..77 || code == 85 || code == 86
+    fun isFog(code: Int) = code == 45 || code == 48
+
+    /**
+     * Scene from the current WMO weather code (open-meteo, null = no fresh weather) and the time of day.
+     * Weather that shows at any hour (rain / snow / fog) wins; a clear or cloudy sky becomes 夜 at night and 日落 in the hour
+     * or so before dark. Safe default without weather: 夜 at night, 日落 at dusk, else 多云 (neutral, never a false 晴 or 雨).
+     */
+    fun pick(code: Int?, hour: Int, isDay: Boolean? = null): Scene {
+        val night = if (isDay != null) !isDay else (hour >= 19 || hour < 6)
+        val dusk = !night && hour in 17..18
+        if (code != null) {
+            if (isRain(code)) return Scene.RAIN
+            if (isSnow(code)) return Scene.SNOW
+            if (isFog(code)) return Scene.FOG
+        }
+        if (night) return Scene.NIGHT
+        if (dusk && (code == null || code in 0..3)) return Scene.SUNSET
+        return when (code) { 0, 1 -> Scene.SUNNY; else -> Scene.CLOUDY }
+    }
+
+    /**
+     * Veil of the page colour (light #F4EAE4 / dark #161114) laid over the sky so the ink stays ≥ 4.5:1 on the bare
+     * background at the scene's worst pixel (1st / 99th luminance percentile of the fallback frame, computed by
+     * r3891/skyveil.py) + 0.06 margin. A light scene in the light theme and a dark scene in the dark theme need none.
+     */
+    fun veil(scene: Scene, dark: Boolean): Float = if (dark) when (scene) {
+        Scene.SUNNY, Scene.SNOW, Scene.FOG -> 0.64f; Scene.CLOUDY -> 0.62f; Scene.SUNSET -> 0.22f; Scene.RAIN, Scene.NIGHT -> 0f
+    } else when (scene) {
+        Scene.RAIN -> 0.58f; Scene.NIGHT -> 0.60f; Scene.SUNSET -> 0.50f; else -> 0f
+    }
+
+    /** Uniforms of one scene (README "Params per scene" + "Element colours / strengths"). Colours are 0xRRGGBB. */
+    class Params(
+        val cTop: Int, val cBot: Int, val cM: IntArray, val mistK: Float, val texK: Float, val veil: Int, val veilA: Float,
+        val cE0: Int, val cE1: Int, val cE2: Int, val kE: FloatArray, val sun: FloatArray,
+    )
+
+    fun params(s: Scene): Params = when (s) {
+        Scene.SUNNY -> Params(0xDCC5A6, 0xD2C0AA, intArrayOf(0xFAE6C6, 0xC2A585, 0xE6D5BF, 0xF2D3A4), 1.6f, 0.10f, 0xECE3D7, 0.12f,
+            0xFFE8BE, 0xFFF7E6, 0xBFA586, floatArrayOf(0.85f, 0.60f, 0.45f, 0.22f), floatArrayOf(0.88f, 0.16f))
+        Scene.CLOUDY -> Params(0xCDD2D7, 0xBEC3C9, intArrayOf(0xE4E7EA, 0xAAB1B9, 0xC8CDD3, 0xD9DDE1), 1.5f, 0.10f, 0xD4D7DA, 0.14f,
+            0x9EA6B0, 0xACB3BC, 0xEEF1F3, floatArrayOf(0.40f, 0.36f, 0.28f, 0.22f), floatArrayOf(0.5f, 0.2f))
+        Scene.RAIN -> Params(0x34423F, 0x1E2829, intArrayOf(0x43575A, 0x172022, 0x2D3C3F, 0x3A4C50), 1.6f, 0.22f, 0x2A3536, 0.12f,
+            0x9DB2B2, 0x0E1517, 0xB9CCCC, floatArrayOf(0.35f, 0.20f, 0.30f, 1.0f), floatArrayOf(0.5f, 0.2f))
+        Scene.SNOW -> Params(0xD3DBE6, 0xC3CCD9, intArrayOf(0xEDF1F7, 0xAFBBCB, 0xD6DEE9, 0xC7D0DE), 1.5f, 0.10f, 0xE6EAF0, 0.12f,
+            0xF6F8FC, 0xFFFFFF, 0xFFFFFF, floatArrayOf(0.22f, 0.85f, 0f, 0f), floatArrayOf(0.5f, 0.2f))
+        Scene.FOG -> Params(0xD7D4D1, 0xCBC8C5, intArrayOf(0xECEAE7, 0xB6B2AF, 0xDAD7D4, 0xC4C0BC), 1.7f, 0.10f, 0xD6D3D0, 0.16f,
+            0xEEECE9, 0xE6E3E0, 0xB5B1AD, floatArrayOf(0.50f, 0.40f, 0.30f, 0f), floatArrayOf(0.5f, 0.2f))
+        Scene.NIGHT -> Params(0x1B2244, 0x0E1328, intArrayOf(0x2F3C70, 0x070A18, 0x1F2A55, 0x283463), 1.6f, 0.22f, 0x151B33, 0.10f,
+            0x3B4B82, 0xE6ECFF, 0xE6ECFF, floatArrayOf(0.30f, 1.0f, 0f, 0f), floatArrayOf(0.5f, 0.2f))
+        Scene.SUNSET -> Params(0x5C3749, 0x33202C, intArrayOf(0x7C4754, 0x8C5B3F, 0x3A2533, 0x6A3F4C), 1.6f, 0.22f, 0x452E37, 0.10f,
+            0xE89A6A, 0xF0B07C, 0xB26E66, floatArrayOf(0.50f, 0.34f, 0.35f, 0.26f), floatArrayOf(0.30f, 1.55f))
+    }
+
+    /** Why the static frame is shown instead of the shader (null = shader). Order matters only for the reported reason. */
+    fun staticReason(api: Int, powerSave: Boolean, animOff: Boolean, forcedStatic: Boolean, shaderError: String?): String? = when {
+        forcedStatic -> "forced"
+        api < 33 -> "api<33"
+        powerSave -> "battery saver"
+        animOff -> "reduce motion"
+        shaderError != null -> "shader error"
+        else -> null
+    }
+
+    /** Splits the bundled sky.agsl into (SKY, PARTICLES) sources at its //#PASS markers. */
+    fun split(src: String): Pair<String, String> {
+        val a = src.indexOf("//#SHARED"); val b = src.indexOf("//#PASS1"); val c = src.indexOf("//#PASS2")
+        require(a >= 0 && b > a && c > b) { "sky.agsl markers missing" }
+        val shared = src.substring(a, b)
+        return (shared + src.substring(b, c)) to (shared + src.substring(c))
+    }
+}
