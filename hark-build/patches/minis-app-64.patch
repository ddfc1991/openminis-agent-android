--- a/src/android/app/src/main/assets/default_mount/etc/ssh/ssh_config.d/minis.conf
+++ b/src/android/app/src/main/assets/default_mount/etc/ssh/ssh_config.d/minis.conf
@@ -1,8 +1,9 @@
 # Mines defaults for ssh from the phone sandbox (mobile networks drop idle
 # TCP and change address often). Override per host in ~/.ssh/config.
 Host *
-    ServerAliveInterval 10
-    ServerAliveCountMax 3
+    # [38.9] 15 s keepalive x 4 = a drop is declared only after ~60 s of silence
+    ServerAliveInterval 15
+    ServerAliveCountMax 4
     TCPKeepAlive yes
     ConnectTimeout 12
     ConnectionAttempts 2
diff --git a/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-vps b/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-vps
index dfd05ae..2e398d2 100755
--- a/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-vps
+++ b/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-vps
@@ -77,7 +77,7 @@ load() {
     set_target "${SERVERS%% *}"
 }
 
-BASE_OPTS="-o BatchMode=yes -o ConnectTimeout=12 -o ConnectionAttempts=2 -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o IPQoS=none -o StrictHostKeyChecking=accept-new"
+BASE_OPTS="-o BatchMode=yes -o ConnectTimeout=12 -o ConnectionAttempts=2 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o TCPKeepAlive=yes -o IPQoS=none -o StrictHostKeyChecking=accept-new"
 # One shared connection per server (ControlMaster): later commands skip the
 # TCP + key exchange round trips entirely, which is most of the latency on a
 # mobile link and far fewer handshakes for middleboxes to interfere with.
@@ -189,7 +189,8 @@ run_job() {
             echo "minis-vps: 连接断了 ${budget} 秒还没恢复。任务还在 $VPS_TARGET 上继续跑；网络好了运行  minis-vps attach $name  接着看结果。" >&2
             return 75
         fi
-        echo "minis-vps: 断线了，${delay} 秒后自动重连（第 $tries 次），任务在服务器上继续跑…" >&2
+        # [38.9] transient drops reconnect silently; only say something from the 3rd try on
+        if [ "$tries" -ge 3 ]; then echo "minis-vps: 还在重连（第 $tries 次），任务在服务器上继续跑…" >&2; fi
         sleep "$delay"; delay=$((delay * 2)); [ "$delay" -gt 30 ] && delay=30
     done
 }
