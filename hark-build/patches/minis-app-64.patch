+
+/** [Mines-38.9.9] bare ssh / scp to a 工作位置 server → hint to use `minis-vps run`. */
+class VpsSshHintTest {
+    private val sv = "root@8.217.89.133:22|ws://8.217.89.133:8022/,!ubuntu@vps2.example.com:2222|wss://t.example/x"
