+        val s = SelfMapCore.Snapshot("38.9.8", listOf("聊天", "模型组", "工作位置"),
+            listOf(SelfMapCore.Provider("百炼", "openAI", true, 12), SelfMapCore.Provider("旧的", "openAI", false, 3)),
