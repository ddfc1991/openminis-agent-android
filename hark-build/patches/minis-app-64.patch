+@Composable
+fun KcChip(st: Status) {
+    val m = mines()
+    val (fg, bg) = when (st) {
+        Status.OK -> if (m.dark) Color(0xFF78CE94) to Color(0xFF264232) else Color(0xFF28804E) to Color(0xFFDEF0E4)
+        Status.EXPIRED -> if (m.dark) Color(0xFFECB256) to Color(0xFF4C381C) else Color(0xFF8A5A0C) to Color(0xFFFAECD0)
+        Status.ABNORMAL -> Color.White to Color(0xFFC9372C)
+    }
+    Box(Modifier.clip(RoundedCornerShape(50)).background(bg).padding(horizontal = 8.dp, vertical = 3.dp)) {
+        Text(st.label, fontSize = 12.sp, lineHeight = 16.sp, fontWeight = FontWeight.SemiBold, color = fg, maxLines = 1, softWrap = false)
+    }
+}
