+    @Test fun namedIdentityCarriedOver() {
+        val p = ConnDedupe.plan(listOf(E("cloudflare", "chrome", "Chrome 已登录"), E("cloudflare#2", "key", "me@example.com", "t"))) { "cloudflare" }
