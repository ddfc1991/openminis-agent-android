diff --git a/src/android/app/src/main/assets/skybg/sky.agsl b/src/android/app/src/main/assets/skybg/sky.agsl
new file mode 100644
index 0000000..6567630
--- /dev/null
+++ b/src/android/app/src/main/assets/skybg/sky.agsl
@@ -0,0 +1,260 @@
+// Mines 38.9.6 weather background v5 (user-approved 2026-10-18 「可以了就这样」), from skybg/v5/shader/sky.agsl.
+// App changes vs the draft: no `continue` (bodies wrapped in if), every loop is `for (int i = 0; i < CONST; i++)`,
+// no child shader in the particle pass (drop lens tinted with the veil), pow() bases clamped >= 0.
+// WeatherSky.kt splits this file at the //#PASS markers: SKY = shared + pass 1, PARTICLES = shared + pass 2.
+//#SHARED
+// =========================== shared ===========================
+uniform float2 iResolution;   // size of the surface THIS pass is drawn into (px)
+uniform float  iTime;         // seconds in [0, LOOP)
+uniform float  LOOP;          // 8.0 preview, 24.0 suggested in-app
+uniform float  scene;         // 0 sunny 1 cloudy 2 rain 3 snow 4 fog 5 night 6 sunset
+uniform half3  cTop, cBot;    // base gradient
+uniform half3  cM0, cM1, cM2, cM3;   // 4 mist blob colours (blob i uses cM[i % 4])
+uniform half   mistK;         // blob strength (ms in README)
+uniform half   texK;          // mist texture breathing (0.10 light scenes, 0.22 dark)
+uniform half3  cVeil;  uniform half veilA;   // frosted milk veil
+uniform half3  cE0, cE1, cE2; // element colours (per scene, see README)
+uniform half   kE0, kE1, kE2, kE3; // element strengths (per scene, see README)
+uniform float2 sunPos;        // in screen widths (x 0..1, y 0..~2.2). sunny (.88,.16), sunset (.30,1.55)
+uniform half   motion;        // 1 normal, 0 = reduce-motion (time frozen; draw once)
+
+const float TAU = 6.2831853;
+float ph(float k, float p) { return TAU * k * iTime / LOOP + p; }
+float hash21(float2 p) { return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453); }
+float vnoise(float2 p) {
+    float2 i = floor(p), f = fract(p);
+    float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
+    float a = hash21(i), b = hash21(i + float2(1, 0)), c = hash21(i + float2(0, 1)), d = hash21(i + float2(1, 1));
+    return a + (b - a) * u.x + (c - a) * u.y + (a - b - c + d) * u.x * u.y;
+}
+float fbm2(float2 p) {
+    float s = vnoise(p);
+    p = float2(p.x * 1.6 - p.y * 1.2 + 5.2, p.x * 1.2 + p.y * 1.6 + 1.3);
+    return (s + 0.45 * vnoise(p)) / 1.45;
+}
+float rnd(float x) { return floor(x + 0.5); }   // SkSL-safe round
+float ss(float a, float b, float x) { return smoothstep(a, b, x); }
+
+// noise that flows AND morphs: warp + offset travel on closed curves (figure-8) -> loops, never back-and-forth
+float morph(float2 uv, float scale, float R, float warp, float sd) {
+    float th = ph(1.0, sd);
+    float2 o = float2(R * cos(th) + sd * 13.1, R * 0.6 * sin(2.0 * th + sd) + sd * 7.7);
+    float2 x = uv * scale;
+    float2 c1 = 0.8 * float2(cos(ph(1.0, sd * 2.0)), sin(ph(1.0, sd * 2.0)));
+    float2 c2 = 0.8 * float2(sin(ph(1.0, sd * 3.0)), cos(ph(1.0, sd * 3.0)));
+    float2 q = float2(fbm2(x * 0.6 + c1 + float2(3.1, 0)), fbm2(x * 0.6 + c2 + float2(8.7, 2.4)));
+    return fbm2(x + warp * (q - 0.5) + o);
+}
+// noise translating at vel (screen widths / s), seamless via variance-normalised crossfade over LOOP
+float driftAt(float2 uv, float tt, float scale, float2 vel, float warp, float sd, float2 sxy) {
+    float2 x = uv * scale * sxy + float2(sd * 17.3, sd * 9.1);
+    float2 q = float2(fbm2(x * 0.7 + float2(3.1 + 0.3 * tt, 0)), fbm2(x * 0.7 + float2(8.7, 2.4 + 0.3 * tt)));
+    return fbm2(x + warp * (q - 0.5) - vel * scale * sxy * tt);
+}
+float drift(float2 uv, float scale, float2 vel, float warp, float sd, float2 sxy) {
+    float w = iTime / LOOP;
+    float A = driftAt(uv, iTime, scale, vel, warp, sd, sxy), B = driftAt(uv, iTime - LOOP, scale, vel, warp, sd, sxy);
+    return 0.5 + ((1.0 - w) * (A - 0.5) + w * (B - 0.5)) / sqrt((1.0 - w) * (1.0 - w) + w * w);
+}
+
+//#PASS1
+// =========================== PASS 1: SKY (quarter res) ===========================
+// mesh-gradient mist: 7 big soft blobs on random closed paths (2 harmonics), varied speed/direction, radius pulse.
+half3 mist(float2 uv, half3 base) {
+    half3 num = base; float den = 1.0;
+    for (int i = 0; i < 7; i++) {
+        float fi = float(i) + scene * 7.0;
+        float2 c0 = float2(hash21(float2(fi, 1)) * 1.2 - 0.1, hash21(float2(fi, 2)) * 2.4 - 0.1);
+        float2 a1 = (0.10 + 0.12 * float2(hash21(float2(fi, 3)), hash21(float2(fi, 4)))) * sign(float2(hash21(float2(fi, 5)), hash21(float2(fi, 6))) - 0.5);
+        float2 a2 = 0.03 + 0.08 * float2(hash21(float2(fi, 7)), hash21(float2(fi, 8)));
+        float k = hash21(float2(fi, 9)) < 0.67 ? 1.0 : 2.0;
+        float p0 = hash21(float2(fi, 10)) * TAU, p1 = hash21(float2(fi, 11)) * TAU;
+        float a = ph(k, 0.0);
+        float2 c = c0 + float2(a1.x * cos(a + p0) + a2.x * cos(2.0 * a + p1), a1.y * sin(a + p1) + a2.y * sin(ph(3.0, p0)));
+        float rr = (0.28 + 0.22 * hash21(float2(fi, 12))) * (1.0 + 0.14 * sin(ph(1.0, p1)));
+        float w = float(mistK) * exp(-dot(uv - c, uv - c) / (2.0 * rr * rr));
+        float m4 = mod(float(i), 4.0);
+        half3 mc = m4 < 0.5 ? cM0 : (m4 < 1.5 ? cM1 : (m4 < 2.5 ? cM2 : cM3));
+        num += half(w) * mc; den += w;
+    }
+    return num / half(den);
+}
+
+half4 skyMain(float2 fragCoord) {
+    float2 uv = fragCoord / iResolution.x;                // screen widths
+    float yN = fragCoord.y / iResolution.y;
+    half3 col = mix(cTop, cBot, half(ss(0.0, 1.0, yN)));
+    col = mist(uv, col);
+    col *= 1.0 + half(morph(uv, 2.0, 1.2, 1.5, scene * 2.3 + 0.5) - 0.5) * texK;
+
+    if (scene < 0.5) {                                    // 晴: diffuse sun bloom, slow ray sweep, wandering dapples
+        float2 d = uv - sunPos; float r = length(d), an = atan(d.y, d.x);
+        float glow = exp(-(r / 0.7) * (r / 0.7)) * (0.85 + 0.15 * sin(ph(1.0, 0.4))) + 0.5 * exp(-(r / 0.22) * (r / 0.22));
+        float rays = (0.5 + 0.5 * sin(7.0 * an + ph(1.0, 0.3) + 0.8 * sin(ph(1.0, 2.0)))) * (0.5 + 0.5 * sin(11.0 * an - ph(1.0, 1.7)));
+        rays = pow(rays, 1.3) * exp(-r) * ss(0.05, 0.3, r);
+        float pat = ss(0.62, 0.95, 1.0 - abs(2.0 * morph(uv, 5.5, 0.9, 1.6, 3.0) - 1.0)) * (0.35 + 0.65 * ss(0.45, 0.8, morph(uv, 1.6, 1.1, 1.2, 5.0)));
+        col = mix(col, cE0, half(glow) * kE0);
+        col = mix(col, cE0, half(rays) * kE1);
+        col = mix(col, cE1, half(pat * (0.4 + 0.6 * exp(-r / 1.2))) * kE2);
+        col = mix(col, cE2, half(ss(0.55, 0.85, drift(uv, 1.3, float2(0.035, -0.01), 1.2, 8.0, float2(1)))) * kE3);
+    } else if (scene < 1.5) {                             // 多云: three shadow layers at parallax speeds + light breaks
+        col = mix(col, cE0, half(ss(0.42, 0.78, drift(uv, 1.1, float2(0.020, -0.0024), 1.4, 1.0, float2(1)))) * kE0);
+        col = mix(col, cE0, half(ss(0.42, 0.78, drift(uv, 1.6, float2(0.034, -0.0041), 1.4, 2.0, float2(1)))) * kE1);
+        col = mix(col, cE1, half(ss(0.42, 0.78, drift(uv, 2.3, float2(0.052, -0.0062), 1.4, 3.0, float2(1)))) * kE2);
+        col = mix(col, cE2, half(ss(0.55, 0.85, morph(uv, 1.4, 0.9, 1.2, 6.0))) * kE3);
+    } else if (scene < 2.5) {                             // 雨: dark curtains sliding down
+        col = mix(col, cE0, half(ss(0.4, 0.8, drift(uv, 1.5, float2(-0.01, 0.06), 1.3, 4.0, float2(1)))) * kE0);
+    } else if (scene < 3.5) {                             // 雪: pale drifting light
+        col = mix(col, cE0, half(ss(0.5, 0.85, morph(uv, 1.5, 1.0, 1.2, 7.0))) * kE0);
+    } else if (scene < 4.5) {                             // 雾: horizontally stretched banks rolling opposite ways, breathing
+        col = mix(col, cE0, half(ss(0.35, 0.8, drift(uv, 1.0, float2(0.030, 0.004), 1.6, 1.0, float2(0.45, 2.2))) * (1.0 + 0.25 * sin(ph(1.0, 1.0)))) * kE0);
+        col = mix(col, cE1, half(ss(0.35, 0.8, drift(uv, 1.5, float2(-0.045, 0.004), 1.6, 2.0, float2(0.45, 2.2))) * (1.0 + 0.25 * sin(ph(1.0, 2.0)))) * kE1);
+        col = mix(col, cE2, half(ss(0.35, 0.8, drift(uv, 2.2, float2(0.060, 0.004), 1.6, 3.0, float2(0.45, 2.2))) * (1.0 + 0.25 * sin(ph(1.0, 3.0)))) * kE2);
+        col *= 1.0 + 0.025 * half(sin(ph(1.0, 0.0)));
+    } else if (scene < 5.5) {                             // 夜: cool haze wandering
+        col = mix(col, cE0, half(ss(0.45, 0.85, morph(uv, 1.4, 1.0, 1.4, 9.0))) * kE0);
+    } else {                                              // 日落: low glow, swinging warm rays, rose/amber clouds
+        float2 sp = sunPos + float2(0, 0.02 * sin(ph(1.0, 0.0)));
+        float2 d = uv - sp; float r = length(d), an = atan(d.y, d.x);
+        float glow = exp(-(r / 0.6) * (r / 0.6)) * (0.85 + 0.15 * sin(ph(1.0, 1.0))) + 0.55 * exp(-(r / 0.2) * (r / 0.2));
+        float sw = 0.45 * sin(ph(1.0, 0.2)) + 0.15 * sin(ph(2.0, 1.3));
+        float rays = (0.5 + 0.5 * sin(6.0 * (an - sw))) * (0.6 + 0.4 * sin(10.0 * (an + 0.6 * sw) + ph(1.0, 2.0)));
+        rays = pow(rays, 1.2) * exp(-r / 1.0) * ss(0.08, 0.4, r) * ss(0.25, -0.05, d.y);
+        col = mix(col, cE0, half(glow) * kE0);
+        col = mix(col, cE1, half(rays) * kE1);
+        float fade = ss(1.8, 0.2, uv.y);
+        col = mix(col, cE2, half(ss(0.45, 0.8, drift(uv, 1.3, float2(0.022, -0.004), 1.3, 1.0, float2(0.7, 1.6))) * fade) * kE2);
+        col = mix(col, cE2 * half3(1.12, 1.15, 0.95), half(ss(0.45, 0.8, drift(uv, 2.0, float2(0.04, -0.004), 1.3, 2.0, float2(0.7, 1.6))) * fade) * kE3);
+    }
+    col = mix(col, cVeil, veilA);
+    half2 v = half2(half(fragCoord.x / iResolution.x) - 0.5, half(yN) - 0.45);
+    col *= 1.0 - 0.10 * (v.x * v.x * 2.0 + v.y * v.y);
+    return half4(clamp(col, 0.0, 1.0), 1.0);
+}
+
+half4 main(float2 p) { return skyMain(p); }
+//#PASS2
+// =========================== PASS 2: PARTICLES (full res, rain/snow/night only) ===========================
+// Returned premultiplied; draw with BlendMode.SRC_OVER over pass 1. Preview px unit = 540 w; scale by s.
+
+// rain streaks: cell-hashed, each cell has at most one streak falling ~900 px/(LOOP/k) with sin^2 life (flicker)
+half rainStreaks(float2 px, float s) {
+    float acc = 0.0;
+    for (int l = 0; l < 2; l++) {                              // 2 depth layers
+        float fl = float(l);
+        float2 cell = float2(46.0 + 20.0 * fl, 260.0) * s;
+        float spd = rnd((2.0 + fl) * 900.0 / 260.0) * cell.y / LOOP;   // shift per LOOP = whole cells -> seamless
+        float2 g = px; g.y -= iTime * spd; g.x += g.y * 0.066;
+        float2 id = floor(g / cell), f = fract(g / cell);
+        float h = hash21(id + 11.0 + fl * 31.0);
+        if (h >= 0.5) {
+            float x = hash21(id + 3.0) * 0.7 + 0.15;
+            float wx = (f.x - x) * cell.x / (2.6 * s);             // gaussian width 2.6 px (preview) -> soft
+            float line = exp(-wx * wx) * ss(0.0, 0.15, f.y) * (1.0 - ss(0.35, 0.6, f.y));
+            float life = sin(3.14159 * fract(iTime * (2.0 + fl) / LOOP + h * 7.0)); life *= life;
+            acc += line * life * (0.4 + 0.6 * hash21(id + 5.0));
+        }
+    }
+    return half(clamp(acc, 0.0, 1.0));
+}
+
+// drops on glass: grid of cells, each may hold a drop that beads (sticks) then slides down with a short trail.
+// returns rgb premultiplied: glint (light) + lens rim (dark) + refraction (offset sky sample)
+half4 glassDrops(float2 px, float s) {
+    float2 cell = float2(90.0, 150.0) * s;
+    float2 id = floor(px / cell);
+    half4 o = half4(0);
+    for (int j = 0; j < 2; j++) {                              // this cell and the one above (a drop can slide down into ours)
+        float2 cid = id + float2(0.0, float(j) - 1.0);
+        float h = hash21(cid + 21.0);
+        if (h >= 0.55) {
+            float k = hash21(cid + 4.0) < 0.7 ? 1.0 : 2.0;
+            float a = fract(iTime * k / LOOP + h * 3.7);
+            float st = 0.3 + 0.35 * hash21(cid + 6.0);
+            float prog = a < st ? 0.0 : pow((a - st) / (1.0 - st), 1.6);
+            float rr = (3.5 + 4.5 * hash21(cid + 8.0)) * s * (1.0 - 0.25 * prog);
+            float2 c = (cid + float2(0.15 + 0.7 * hash21(cid + 9.0), 0.2)) * cell;
+            c.y += prog * (120.0 + 300.0 * hash21(cid + 10.0)) * s; c.x += sin(prog * 5.0 + h * 9.0) * 3.0 * s;
+            float life = ss(0.0, 0.12, a) * (1.0 - ss(0.85, 1.0, a));
+            float2 d = px - c; float q = dot(d, d) / (rr * rr);
+            bool inTrail = prog > 0.0 && d.y < 0.0 && abs(d.x) < rr;
+            if (q <= 9.0 || inTrail) {
+                half bead = half(exp(-q * 1.2));
+                float2 gd = d + float2(rr * 0.35, rr * 0.4);
+                half glint = half(exp(-dot(gd, gd) / (rr * rr * 0.12)));
+                float sq = sqrt(q) - 1.0;
+                half rim = half(exp(-sq * sq / 0.05));
+                half trail = 0.0;
+                if (inTrail) trail = half(exp(-d.x * d.x / (rr * rr * 0.12)) * ss(0.0, 1.0, -d.y / (prog * 300.0 * s + 1.0)) * 0.35);
+                half3 refr = mix(cVeil, cE2, 0.35);                    // app: no child shader; the lens tint is the veil
+                half3 c3 = mix(refr, cE2, glint * 0.9 + trail) * bead + cE1 * rim * 0.5;
+                o += half4(c3, 1.0) * half(life) * max(bead, max(rim * 0.5, trail)) * kE3;
+            }
+        }
+    }
+    return o;
+}
+
+// snow: 3 depths (far small/slow -> near big/blurry/fast), sway + shared gust
+half snow(float2 px, float s) {
+    float acc = 0.0;
+    float gust = 12.0 * sin(ph(1.0, 0.7)) + 6.0 * sin(ph(2.0, 2.1));
+    for (int l = 0; l < 3; l++) {
+        float fl = float(l);
+        float sig = (fl < 0.5 ? 1.5 : (fl < 1.5 ? 2.8 : 5.5)) * s;    // far / mid / near blur
+        float cellS = (48.0 + 40.0 * fl) * s;
+        float vy = max(1.0, rnd((22.0 + 20.0 * fl) * 8.0 / (48.0 + 40.0 * fl))) * cellS / LOOP; // whole cells per LOOP
+        float2 g = px; g.y -= iTime * vy;
+        g.x -= gust * s * (0.55 + 0.5 * fl) + iTime * rnd(vy * LOOP * 0.25 / cellS) * cellS / LOOP; // gust + slant, loop-safe
+        float2 id = floor(g / cellS), f = fract(g / cellS);
+        float h = hash21(id + 5.0 + fl * 17.0);
+        if (h >= 0.45) {
+            float2 c = float2(hash21(id + 1.0), hash21(id + 2.0)) * 0.6 + 0.2;
+            c.x += sin(h * 6.28 + ph(2.0, 0.0) * 0.5) * (6.0 + 5.0 * fl) * s / cellS;
+            float2 d = (f - c) * cellS;
+            float life = pow(max(sin(3.14159 * fract(iTime / LOOP * (1.0 + step(0.5, h)) + h * 5.0)), 0.0), 0.8);
+            acc += exp(-dot(d, d) / (2.0 * sig * sig)) * life * (0.75 + 0.075 * fl * 2.0);
+        }
+    }
+    return half(clamp(acc, 0.0, 1.0));
+}
+
+// stars: one candidate per 34 px cell, ~45% lit; brightness^1.5; twinkle = two sines with whole cycles (1..4, 3|5)
+half stars(float2 px, float s) {
+    float cellS = 34.0 * s; float acc = 0.0;
+    float2 g = px + float2(0.5 * s * sin(ph(1.0, 0.0)), 0.0);
+    float2 id = floor(g / cellS), f = fract(g / cellS);
+    float h = hash21(id + 13.0);
+    if (h > 0.45) {
+        float b = pow(0.25 + 0.5 * hash21(id + 2.0), 1.5); bool big = hash21(id + 3.0) > 0.92; if (big) b = 0.9;
+        float k = floor(1.0 + 4.0 * hash21(id + 4.0)), p = hash21(id + 6.0) * TAU;
+        float tw = (0.55 + 0.45 * sin(ph(k, p))) * (0.8 + 0.2 * sin(ph(hash21(id + 7.0) > 0.5 ? 3.0 : 5.0, p * 1.7)));
+        float2 d = (f - (0.2 + 0.6 * float2(hash21(id + 8.0), hash21(id + 9.0)))) * cellS;
+        float sg = 1.6 * s, sb = 5.5 * s; float r2 = dot(d, d);
+        acc = b * tw * tw * (0.75 * exp(-r2 / (2.0 * sg * sg)) + (big ? 0.27 * exp(-r2 / (2.0 * sb * sb)) : 0.0));
+    }
+    // one soft shooting star per loop, t in [5.0, 5.9] of 8 (scaled to LOOP)
+    float u = (iTime / LOOP * 8.0 - 5.0) / 0.9;
+    if (u > 0.0 && u < 1.0) {
+        float e = ss(0.0, 0.15, u) * (1.0 - ss(0.6, 1.0, u));
+        float2 head = float2(380.0 - u * 170.0, 120.0 + u * 80.0) * s, dir = normalize(float2(90.0, -42.0));
+        float2 d = px - head; float along = clamp(dot(d, dir) / (100.0 * s), 0.0, 1.0);
+        float2 perp = d - dir * along * 100.0 * s;
+        acc += e * pow(1.0 - along, 1.5) * 0.25 * exp(-dot(perp, perp) / (2.0 * 2.2 * 2.2 * s * s));
+    }
+    return half(clamp(acc, 0.0, 1.0));
+}
+
+half4 particleMain(float2 fragCoord) {
+    float s = iResolution.x / 540.0;                         // preview px -> device px
+    if (scene > 1.5 && scene < 2.5) {
+        half4 o = half4(cE0, 1.0) * rainStreaks(fragCoord, s) * kE1;        // cE0 streak tint, kE1 ~0.20
+        half4 d = glassDrops(fragCoord, s);
+        return d + o * (1.0 - d.a);
+    }
+    if (scene > 2.5 && scene < 3.5) return half4(cE1, 1.0) * snow(fragCoord, s) * kE1;     // white, ~0.8
+    if (scene > 4.5 && scene < 5.5) return half4(cE1, 1.0) * stars(fragCoord, s) * kE1;    // cool white, ~1.0
+    return half4(0);
+}
+
+half4 main(float2 p) { return particleMain(p); }
