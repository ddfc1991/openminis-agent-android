+        assertEquals("新到 1 条 · 163 授权码失效；X 读取超时 等 3 处没读到",
+            FeedRefresh.line(Outcome(listOf("x"), listOf("163 授权码失效", "X 读取超时", "GitHub 令牌失效"))))
+    }
+
+    @Test fun newCardsGoToTheTopAfterPinned() {
