+package com.openminis.app.plus
+
+import com.openminis.app.plus.WeatherSkyCore.Scene
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/** [Mines-38.9.6 i14] weather sky v5: scene choice, theme veil, static fallback reasons, and the AGSL source rules. */
+class WeatherSkyCoreTest {
+    @Test fun scenes() {
+        assertEquals(Scene.SUNNY, WeatherSkyCore.pick(0, 11))
+        assertEquals(Scene.CLOUDY, WeatherSkyCore.pick(3, 11))
+        assertEquals(Scene.RAIN, WeatherSkyCore.pick(61, 23))
+        assertEquals(Scene.RAIN, WeatherSkyCore.pick(95, 12))
+        assertEquals(Scene.SNOW, WeatherSkyCore.pick(73, 9))
+        assertEquals(Scene.FOG, WeatherSkyCore.pick(45, 2))
+        assertEquals(Scene.NIGHT, WeatherSkyCore.pick(0, 23))
+        assertEquals(Scene.NIGHT, WeatherSkyCore.pick(1, 12, isDay = false))
+        assertEquals(Scene.SUNSET, WeatherSkyCore.pick(1, 18))
+        // no weather: safe default by time only
+        assertEquals(Scene.CLOUDY, WeatherSkyCore.pick(null, 10))
+        assertEquals(Scene.NIGHT, WeatherSkyCore.pick(null, 2))
+        assertEquals(Scene.SUNSET, WeatherSkyCore.pick(null, 17))
+    }
+
+    @Test fun veilKeepsMatchingThemesClear() {
+        for (s in Scene.values()) {
+            if (s.darkSky) { assertTrue(WeatherSkyCore.veil(s, false) >= 0.5f); assertTrue(WeatherSkyCore.veil(s, true) <= 0.25f) }
+            else { assertEquals(0f, WeatherSkyCore.veil(s, false)); assertTrue(WeatherSkyCore.veil(s, true) >= 0.6f) }
+        }
+    }
+
+    @Test fun staticReasons() {
+        assertEquals("api<33", WeatherSkyCore.staticReason(31, false, false, false, null))
+        assertEquals("battery saver", WeatherSkyCore.staticReason(35, true, false, false, null))
+        assertEquals("reduce motion", WeatherSkyCore.staticReason(35, false, true, false, null))
+        assertEquals("shader error", WeatherSkyCore.staticReason(35, false, false, false, "x"))
+        assertEquals(null, WeatherSkyCore.staticReason(35, false, false, false, null))
+        assertEquals(24f, WeatherSkyCore.LOOP_S)
+    }
+
+    private fun agsl(): String = listOf("src/main/assets/skybg/sky.agsl", "app/src/main/assets/skybg/sky.agsl").map { File(it) }.first { it.isFile }.readText()
+
+    @Test fun agslFollowsSkSLLoopRules() {
+        val src = agsl()
+        val code = src.lines().map { it.substringBefore("//") }.joinToString("\n")
+        assertTrue("no continue / while / do", !Regex("""\b(continue|while|do)\b""").containsMatchIn(code))
+        val loops = Regex("""for\s*\(([^)]*)\)""").findAll(code).map { it.groupValues[1] }.toList()
+        assertTrue(loops.isNotEmpty())
+        loops.forEach { assertTrue("loop must be for (int i = 0; i < CONST; i++): $it", Regex("""^\s*int (\w+) = 0; \1 < \d+; \1\+\+\s*$""").matches(it)) }
+        assertTrue("no child shader", !code.contains("uniform shader"))
+        val (a, b) = WeatherSkyCore.split(src)
+        assertTrue(a.contains("return skyMain(p)") && !a.contains("particleMain"))
+        assertTrue(b.contains("return particleMain(p)") && !b.contains("half4 skyMain"))
+        for (sc in Scene.values()) assertTrue(File(File(listOf("src/main/assets/skybg", "app/src/main/assets/skybg").first { File(it).isDirectory }), "bg-${sc.key}.webp").isFile)
+    }
+}
