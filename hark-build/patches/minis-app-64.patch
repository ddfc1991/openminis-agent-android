+            }
+        }
+    }
+}
+
+@androidx.annotation.RequiresApi(33)
+private fun drawOverlay(nc: android.graphics.Canvas, sh: WeatherSky.Shaders, s: Scene, w: Float, h: Float, t: Float, sunX: Float, sunY: Float,
+                        dim: Float, alpha: Float, nodes: Array<Any?>, slot: Int) {
+    // PASS 1: quarter-res atmosphere (wisps / mist / glare) into a RenderNode, blurred there, drawn ×4
+    val qw = kotlin.math.ceil(w / 4f).toInt().coerceAtLeast(1); val qh = kotlin.math.ceil(h / 4f).toInt().coerceAtLeast(1)
+    val node = (nodes[slot] as? android.graphics.RenderNode) ?: android.graphics.RenderNode("mines-sky-$slot").also {
+        it.setRenderEffect(android.graphics.RenderEffect.createBlurEffect(4f, 4f, android.graphics.Shader.TileMode.CLAMP)); nodes[slot] = it
+    }
+    node.setPosition(0, 0, qw, qh)
+    node.alpha = alpha
+    sh.setOverlay(s, qw.toFloat(), qh.toFloat(), t, sunX, sunY, dim)
+    val rc = node.beginRecording(qw, qh)
+    try { rc.drawPaint(android.graphics.Paint().apply { shader = sh.sky }) } finally { node.endRecording() }
+    nc.save(); nc.scale(w / qw, h / qh); nc.drawRenderNode(node); nc.restore()
+    // PASS 2: full-res particles (rain / snow / stars)
+    val parts = WeatherSky.parts(s) ?: return
+    sh.setParticles(s, parts, w, h, t, dim)
+    val p = android.graphics.Paint().apply { shader = sh.particles; this.alpha = (255 * alpha).toInt() }
+    nc.drawRect(0f, 0f, w, h, p)
+}
+
+/** 128 px monochrome noise tile (grain). */
+private fun skyGrain(): android.graphics.Bitmap {
+    val n = 128; val px = IntArray(n * n); val rnd = java.util.Random(11)
+    for (i in px.indices) { val v = 96 + rnd.nextInt(64); px[i] = android.graphics.Color.argb(255, v, v, v) }
+    return android.graphics.Bitmap.createBitmap(px, n, n, android.graphics.Bitmap.Config.ARGB_8888)
+}
+
+/** [Mines-38.9.9] user: the same weather sky on every page — the chat page (no chat wallpaper) gets it with a thicker veil. */
+@Composable
+fun chatSkyOn(): Boolean {
+    val ctx = LocalContext.current
+    val t by WeatherSky.tick.collectAsState()
+    return remember(t) { WeatherSky.enabled(ctx) } && !wallpaperOn()
+}
