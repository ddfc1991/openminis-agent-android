+                }
+                if (kind == WeatherAmbience.Kind.FOG) {
+                    for (b in 0 until 3) {
+                        val y = h * (0.25f + 0.25f * b) + 40f * sc * kotlin.math.sin(twoPi * t / (18f + 4f * b) + b)
