@@ -0,0 +1,54 @@
+package com.openminis.app.browser
+
+import android.webkit.WebView
+import androidx.webkit.ProfileStore
+import androidx.webkit.WebViewCompat
+import androidx.webkit.WebViewFeature
+
+/** [Mines-38.9.7] Android side of [IncognitoCore]: separate WebView profile, wiped on close. Main thread. */
+object Incognito {
+    @Volatile var lastClose: String? = null; private set
+
+    fun supported(): Boolean = runCatching { WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE) }.getOrDefault(false)
+
+    /** Must run right after `WebView(context)`, before anything else touches [wv]. */
+    fun attach(wv: WebView): Boolean {
+        if (!supported()) return false
+        return runCatching {
+            ProfileStore.getInstance().getOrCreateProfile(IncognitoCore.PROFILE)
+            WebViewCompat.setProfile(wv, IncognitoCore.PROFILE)
+            true
+        }.getOrElse { android.util.Log.w("Incognito", "setProfile failed", it); false }
+    }
+
+    /** Before the tabs' WebViews are destroyed. */
+    fun wipeViews(views: List<WebView>) {
+        for (v in views) runCatching { v.clearHistory(); v.clearCache(true); v.clearFormData() }
+    }
+
+    /** After the tabs are destroyed: cookies + storage gone, profile deleted. */
+    fun wipeProfile() {
+        if (!supported()) return
+        val r = runCatching {
+            val store = ProfileStore.getInstance()
+            val p = store.getProfile(IncognitoCore.PROFILE)
+            if (p != null) {
+                p.cookieManager.removeAllCookies(null)
+                p.cookieManager.flush()
+                p.webStorage.deleteAllData()
+            }
+            // deleteProfile throws while a WebView still uses it; the next open re-creates it either way
+            runCatching { store.deleteProfile(IncognitoCore.PROFILE) }
+            "已清除"
+        }.getOrElse { "清除失败：" + (it.message ?: it.javaClass.simpleName) }
+        lastClose = java.text.SimpleDateFormat("HH:mm", java.util.Locale.CHINA).format(java.util.Date()) + " " + r
+    }
+
+    /** Close an incognito pool: wipe its views, destroy the tabs, wipe the profile. */
+    fun close(pool: BrowserTabPool) {
+        if (!pool.incognito) return
+        wipeViews(pool.tabs.value.map { it.manager.webView })
+        pool.destroyAllTabs()
+        android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({ wipeProfile() }, 300)
+    }
+}
