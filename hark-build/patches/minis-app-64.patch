+        current(c).filter { it.type.provider && it.value.isNotBlank() }.forEach { i ->
+            if (i.type.host.isNotBlank() && i.signedIn) addRec(c, Rec(i.type.host, i.type.label, i.value, i.type, Method.WEB, sources = setOf("Mines 里已登录"), at = now))
+        }
+    }
+}
