+        modifier
+            .then(if (halo) Modifier.glassOuterShadow(shape, dark = m.dark) else Modifier)
+            .clip(shape)
+            .background(fill)
+            .glassSheen(shape, m.dark)
+            .border(1.dp, m.glassBorder, shape),
