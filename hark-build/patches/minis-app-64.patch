+                    com.openminis.app.ui.plus.PlusNav.go(com.openminis.app.ui.group.GroupRoutes.PARTNERS); l.countDown() }
+                l.await(5, java.util.concurrent.TimeUnit.SECONDS); "ok"
+            }
