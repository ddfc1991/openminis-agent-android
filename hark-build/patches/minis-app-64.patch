+    "163", "126", "yeah" -> Color(0xFFB5532F) to Color(0x1FB5532F)
+    "QQ" -> Color(0xFF2F6FB5) to Color(0x1F2F6FB5)
+    else -> Color(0xFF6B5E55) to Color(0x1F6B5E55)
+}
