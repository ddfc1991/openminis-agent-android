+@Composable
+fun androidx.compose.material3.ExposedDropdownMenuBoxScope.GlassExposedDropdownMenu(
+    expanded: Boolean,
+    onDismissRequest: () -> Unit,
+    modifier: Modifier = Modifier,
+    content: @Composable ColumnScope.() -> Unit,
