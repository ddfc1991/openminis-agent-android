+                when (inst) { null -> null; "local" -> com.openminis.app.plus.SessionStatus.Pill.WARN; else -> com.openminis.app.plus.SessionStatus.Pill.OK },
+                pillLabel = when (inst) { null -> null; "local" -> "同名本地"; else -> "已安装" },
+                chevron = Chevron.NONE, subtitleLines = if (open) 12 else 3, onClick = { expanded = if (open) null else s.slug },
