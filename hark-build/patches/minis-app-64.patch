--- a/src/android/app/src/main/java/com/openminis/app/tools/AgentToolSwitch.kt
+++ b/src/android/app/src/main/java/com/openminis/app/tools/AgentToolSwitch.kt
@@ -24,6 +24,13 @@ enum class AgentToolSwitch(val key: String, val defaultValue: Boolean) {
      *  (see [migrateLegacyIfNeeded]); flipping the default would silently
