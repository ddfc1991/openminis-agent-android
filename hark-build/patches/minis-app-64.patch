diff --git a/src/android/app/src/main/java/com/openminis/app/plus/ReachCore.kt b/src/android/app/src/main/java/com/openminis/app/plus/ReachCore.kt
new file mode 100644
index 0000000..f1a3324
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/ReachCore.kt
@@ -0,0 +1,57 @@
+package com.openminis.app.plus
+
+/**
+ * [Mines-38.9.6 i17] Is a server down, or is only the phone's path to it broken? (user 2026-10-18 17:15: the agent said
+ * 8.217.89.133 「全端口失联」 and 梦云 「SSH 断」 while both answered from outside.) A verdict needs three paths: direct from
+ * the phone, through the user's proxy, and from outside (check-host.net nodes). One failed path never means 「服务器挂了」.
+ * Pure (JVM-testable): the probing itself is in [ReachProbe].
+ */
+object ReachCore {
+    enum class Kind { OK_DIRECT, OK_PROXY, PHONE_PATH, DOWN, UNKNOWN }
+
+    /** null = path not tried / no answer (e.g. no proxy configured, outside check unavailable) */
+    data class Paths(val direct: Boolean?, val proxy: Boolean?, val outsideOk: Int = 0, val outsideTotal: Int = 0,
+                     val directWhy: String = "", val proxyWhy: String = "")
+
+    data class Verdict(val kind: Kind, val text: String) {
+        /** only this verdict lets anyone say the server itself is down */
+        val serverDown: Boolean get() = kind == Kind.DOWN
+        val reachable: Boolean get() = kind == Kind.OK_DIRECT || kind == Kind.OK_PROXY
+    }
+
+    fun verdict(p: Paths): Verdict {
+        val outside = if (p.outsideTotal > 0) "外部检测 ${p.outsideOk}/${p.outsideTotal} 个节点连得上" else "外部检测没结果"
+        fun d() = "直连" + when (p.direct) { true -> "通"; false -> "不通" + why(p.directWhy); null -> "没测" }
+        fun x() = "走代理" + when (p.proxy) { true -> "通"; false -> "不通" + why(p.proxyWhy); null -> "（没设代理）" }
+        return when {
+            p.direct == true -> Verdict(Kind.OK_DIRECT, "在线（直连通）")
+            p.proxy == true -> Verdict(Kind.OK_PROXY, "在线（${d()}，走代理通）")
+            p.outsideTotal > 0 && p.outsideOk > 0 -> Verdict(Kind.PHONE_PATH, "手机网络到不了，服务器本身在线（${d()}，${x()}，$outside）")
+            p.outsideTotal >= 2 && p.outsideOk == 0 && p.direct == false ->
+                Verdict(Kind.DOWN, "服务器挂了或端口关了（${d()}，${x()}，$outside）")
+            else -> Verdict(Kind.UNKNOWN, "暂时没法判断（${d()}，${x()}，$outside），不能说服务器挂了")
+        }
+    }
+
+    private fun why(s: String) = if (s.isBlank()) "" else "：" + s.take(40)
+
+    /**
+     * check-host.net /check-result/<id> JSON → (ok, answered, pending). Each node: null = still running,
+     * [[{"time":…,"address":…}]] / [{"time":…}] = connected, [{"error":"…"}] = failed.
+     */
+    fun parseCheckHost(json: String): Triple<Int, Int, Int> {
+        val o = runCatching { org.json.JSONObject(json) }.getOrNull() ?: return Triple(0, 0, 0)
+        var ok = 0; var answered = 0; var pending = 0
+        for (k in o.keys()) {
+            val v = o.opt(k)
+            if (v == null || v == org.json.JSONObject.NULL) { pending++; continue }
+            val arr = v as? org.json.JSONArray ?: continue
+            var first: Any? = if (arr.length() > 0) arr.opt(0) else null
+            if (first is org.json.JSONArray) first = if (first.length() > 0) first.opt(0) else null
+            val e = first as? org.json.JSONObject
+            answered++
+            if (e != null && e.has("time") && !e.has("error")) ok++
+        }
+        return Triple(ok, answered, pending)
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/ReachProbe.kt b/src/android/app/src/main/java/com/openminis/app/plus/ReachProbe.kt
new file mode 100644
index 0000000..3819e0f
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/ReachProbe.kt
@@ -0,0 +1,72 @@
+package com.openminis.app.plus
+
+import java.net.InetSocketAddress
+import java.net.Proxy
+import java.net.Socket
+import java.util.concurrent.TimeUnit
+
+/**
+ * [Mines-38.9.6 i17] Three-path reachability for one server port (see [ReachCore]): direct from the phone (SSH ports need
+ * the "SSH-" banner — a TUN / fake-ip VPN answers the TCP connect itself), through the active proxy, and from outside via
+ * check-host.net TCP nodes. Blocking; call off the main thread. ~6 s direct + 8 s proxy + ≤ 15 s outside.
+ */
+object ReachProbe {
+    data class Report(val host: String, val port: Int, val paths: ReachCore.Paths, val verdict: ReachCore.Verdict)
+
+    private val http = okhttp3.OkHttpClient.Builder().connectTimeout(8, TimeUnit.SECONDS).readTimeout(10, TimeUnit.SECONDS)
+        .callTimeout(15, TimeUnit.SECONDS).build()
+
+    /** banner = the port speaks first (SSH); otherwise a connect that is not reset within 1.2 s counts */
+    private fun answer(sock: Socket, ssh: Boolean, timeoutMs: Int): Pair<Boolean, String> {
+        sock.soTimeout = if (ssh) timeoutMs else 1200
+        val buf = ByteArray(64)
+        return try {
+            val n = sock.getInputStream().read(buf)
+            when {
+                n > 0 && String(buf, 0, n).startsWith("SSH-") -> true to ""
+                ssh -> false to (if (n < 0) "连上就被断开" else "不是 SSH")
+                else -> (n >= 0) to (if (n < 0) "连上就被断开" else "")
+            }
+        } catch (e: java.net.SocketTimeoutException) {
+            if (ssh) false to "端口通了但没有 SSH 回应" else true to ""
+        }
+    }
+
+    fun direct(host: String, port: Int, ssh: Boolean, timeoutMs: Int = 6000): Pair<Boolean, String> = runCatching {
+        Socket(Proxy.NO_PROXY).use { s ->
+            s.connect(InetSocketAddress(VpsSsh.preferIpv4(host), port), timeoutMs)
+            answer(s, ssh, timeoutMs)
+        }
+    }.getOrElse { false to VpsSsh.reason(it) }
+
+    /** null = no proxy configured / running */
+    fun viaProxy(host: String, port: Int, ssh: Boolean, timeoutMs: Int = 8000): Pair<Boolean, String>? {
+        val u = runCatching { SplitProxy.activeUpstreamNow() }.getOrNull() ?: return null
+        return runCatching { SplitProxy.tunnelVia(u, host, port, timeoutMs).use { answer(it, ssh, timeoutMs) } }
+            .getOrElse { false to ("代理 ${u.host}:${u.port} " + VpsSsh.reason(it)) }
+    }
+
+    /** (ok, answered) from up to 3 check-host.net nodes, or (0, 0) when the service cannot be reached */
+    fun outside(host: String, port: Int, budgetMs: Long = 15_000): Pair<Int, Int> = runCatching {
+        val start = http.newCall(okhttp3.Request.Builder().url("https://check-host.net/check-tcp?host=$host:$port&max_nodes=3")
+            .header("Accept", "application/json").build()).execute().use { it.body?.string().orEmpty() }
+        val id = org.json.JSONObject(start).optString("request_id").ifBlank { return@runCatching 0 to 0 }
+        val t0 = System.currentTimeMillis(); var last = Triple(0, 0, 0)
+        while (System.currentTimeMillis() - t0 < budgetMs) {
+            Thread.sleep(2000)
+            val body = http.newCall(okhttp3.Request.Builder().url("https://check-host.net/check-result/$id")
+                .header("Accept", "application/json").build()).execute().use { it.body?.string().orEmpty() }
+            last = ReachCore.parseCheckHost(body)
+            if (last.second > 0 && last.third == 0) break
+        }
+        last.first to last.second
+    }.getOrDefault(0 to 0)
+
+    fun check(host: String, port: Int, ssh: Boolean = true): Report {
+        val d = direct(host, port, ssh)
+        val x = if (d.first) null else viaProxy(host, port, ssh)
+        val o = if (d.first || x?.first == true) 0 to 0 else outside(host, port)
+        val paths = ReachCore.Paths(d.first, x?.first, o.first, o.second, d.second, x?.second.orEmpty())
+        return Report(host, port, paths, ReachCore.verdict(paths))
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/Relogin.kt b/src/android/app/src/main/java/com/openminis/app/plus/Relogin.kt
