+import com.openminis.app.agent.ExperienceCore
+import com.openminis.app.plus.Experience
+import com.openminis.app.ui.brand.MinesIcons
+
+/**
+ * [Mines-38.9] 设置 › 经验: the experience library as a plain list (same look as 技能 / 插件 pages): 做法 and 教训,
+ * version, how often it helped, where it came from. Tap → edit (saved as a new version) or delete. 「新加一条」 adds one.
+ */
+@Composable
+fun ExperienceScreen(onBack: () -> Unit) {
+    val ctx = LocalContext.current
+    remember { Experience.init(ctx); 0 }
+    val list by Experience.list.collectAsState()
+    var editing by remember { mutableStateOf<ExperienceCore.Entry?>(null) }
+    var adding by remember { mutableStateOf(false) }
+    var confirmDel by remember { mutableStateOf<ExperienceCore.Entry?>(null) }
+    PlusPage("经验", onBack, subtitle = "Mines 自己记下的做法和教训；换哪个模型都会先看这里") {
+        if (list.isEmpty()) InfoLine("还没有经验。Mines 做完一件多步骤的事、或者同一个错误碰到两次，会自己记一条。")
+        for (k in ExperienceCore.Kind.values()) {
+            val l = list.filter { it.kind == k }
+            if (l.isEmpty()) continue
+            PlusSection(k.label + "（${l.size}）") {
+                l.forEach { e ->
+                    PlusRow(MinesIcons.named(if (k == ExperienceCore.Kind.HOWTO) "list-checks" else "triangle-alert") ?: MinesIcons.named("info"),
+                        e.pattern, e.steps.lines().firstOrNull { it.isNotBlank() }.orEmpty(),
+                        value = "v${e.version}" + (if (e.uses > 0) " · 用过 ${e.uses} 次" else "") + " · " + e.source,
+                        onClick = { editing = e })
+                }
+            }
+        }
+        Spacer(Modifier.height(16.dp))
+        Row(Modifier.fillMaxWidth().padding(horizontal = 24.dp)) {
+            PillButton("新加一条", Modifier.fillMaxWidth(), primary = false) { adding = true }
+        }
+        Spacer(Modifier.height(24.dp))
+    }
+    val e = editing
+    if (e != null || adding) {
+        var pat by remember(e) { mutableStateOf(e?.pattern.orEmpty()) }
+        var steps by remember(e) { mutableStateOf(e?.steps.orEmpty()) }
+        var pit by remember(e) { mutableStateOf(e?.pitfalls.orEmpty()) }
+        var lesson by remember(e) { mutableStateOf(e?.kind == ExperienceCore.Kind.LESSON) }
+        MinesDialog(if (e == null) "新加一条经验" else "${e.kind.label} · v${e.version}", { editing = null; adding = false }, confirm = "保存",
+            confirmEnabled = pat.isNotBlank() && steps.isNotBlank(), onConfirm = {
+                if (e == null) Experience.add(ctx, if (lesson) ExperienceCore.Kind.LESSON else ExperienceCore.Kind.HOWTO, pat, steps, pit)
+                else Experience.edit(ctx, e.id, pat, steps, pit)
+                editing = null; adding = false
+            }, dismiss = if (e != null) "删除" else "取消", onDismissButton = { if (e != null) confirmDel = e; editing = null; adding = false }) {
+            if (e == null) Row {
+                PillButton("做法", primary = !lesson) { lesson = false }
+                Spacer(Modifier.padding(4.dp))
+                PillButton("教训", primary = lesson) { lesson = true }
+            }
+            OutlinedTextField(pat, { pat = it.take(60) }, label = { Text("什么事") }, singleLine = true)
+            OutlinedTextField(steps, { steps = it.take(1200) }, label = { Text(if (lesson) "下次改成这样做" else "怎么做（一行一步）") }, minLines = 3)
+            OutlinedTextField(pit, { pit = it.take(400) }, label = { Text(if (lesson) "哪里失败了、为什么" else "要注意的坑（可不填）") }, minLines = 2)
+            if (e != null) Text("工具：${e.tools.joinToString("、").ifBlank { "—" }} · 来源：${e.source}", fontSize = MT.Caption, color = mines().ink2)
+        }
+    }
+    confirmDel?.let { d ->
+        MinesDialog("删掉这条经验？", { confirmDel = null }, confirm = "删除", danger = true, onConfirm = { Experience.delete(ctx, d.id); confirmDel = null }) {
+            Text(d.pattern, fontSize = MT.Body, color = mines().ink)
+        }
+    }
+}
