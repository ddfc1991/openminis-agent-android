+    }
+    @Volatile private var gpu: Any? = null
+    fun gpuOrNull(c: android.content.Context): Any? {
+        if (Build.VERSION.SDK_INT < 33 || shaderError != null) return null
+        gpu?.let { return it }
+        return runCatching { Gpu(c) }.onFailure { shaderError = (it.message ?: it.javaClass.simpleName).take(300) }.getOrNull()?.also { gpu = it }
+    }
+}
