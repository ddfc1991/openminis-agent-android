+        if (toast.isNotBlank()) InfoLine(toast)
+        val byDay = runs.groupBy { day(it.endedAt) }
+        byDay.forEach { (d, l) ->
+            PlusSection(d + "（${l.size}）") {
+                l.forEach { r ->
+                    PlusRow(MinesIcons.named(if (r.ok) "list-checks" else "triangle-alert") ?: MinesIcons.named("info"),
+                        r.task.lineSequence().firstOrNull().orEmpty().ifBlank { "（没有文字的任务）" },
+                        WorkflowLogCore.statusLabel(r.status) + " · ${r.steps.size} 步 · " + dur(r.durationMs) + (if (r.skillId.isNotBlank()) " · 已存成技能" else ""),
+                        value = hm(r.endedAt), onClick = { open = r.id })
+                }
+            }
+        }
+        Spacer(Modifier.height(24.dp))
+    }
+    val r = open?.let { id -> runs.firstOrNull { it.id == id } }
+    if (r != null) {
+        val m = mines()
+        MinesDialog(r.task.lineSequence().firstOrNull().orEmpty().take(40).ifBlank { "工作流" }, onDismiss = { open = null },
+            confirm = if (r.skillId.isBlank()) "存成技能" else null,
+            onConfirm = { toast = WorkflowLog.saveAsSkill(ctx, r.id); open = null },
+            dismiss = "关闭") {
+            Column(Modifier.heightIn(max = 420.dp).verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                Text(WorkflowLogCore.statusLabel(r.status) + " · " + hm(r.startedAt) + "–" + hm(r.endedAt) + " · " + dur(r.durationMs), fontSize = MT.Caption, color = m.ink2)
+                Spacer(Modifier.height(4.dp))
+                // [Mines-38.9.9] which skills, in which order, from which input — reused automatically on similar requests
+                WorkflowLogCore.comboLine(r).takeIf { it.isNotBlank() }?.let { Text(it, fontSize = MT.Sub, color = m.ink) }
+                r.steps.forEachIndexed { i, s ->
+                    Text("${i + 1}. " + (if (s.ok) "" else "✗ ") + s.tool + "  " + s.brief + (if (!s.ok && s.error.isNotBlank()) " → " + s.error else ""),
+                        fontSize = MT.Sub, lineHeight = MT.CaptionLH, color = if (s.ok) m.ink else m.ink2)
+                }
+                if (r.result.isNotBlank()) {
+                    Spacer(Modifier.height(6.dp))
+                    Text("结果", fontSize = MT.Caption, color = m.ink2)
+                    Text(r.result, fontSize = MT.Sub, lineHeight = MT.CaptionLH, color = m.ink)
+                }
+                if (r.skillId.isNotBlank()) Text("已存成技能：${r.skillId}", fontSize = MT.Caption, color = m.ink2)
+                Spacer(Modifier.height(6.dp))
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp), modifier = Modifier.fillMaxWidth()) {
+                    if (r.sid.isNotBlank()) PillButton("打开对话", Modifier.weight(1f), primary = false) { open = null; onOpenChat(r.sid) }
+                    PillButton("删除", Modifier.weight(1f), primary = false) { WorkflowLog.delete(ctx, r.id); open = null }
+                }
+            }
+        }
+    }
+}
+
+private fun hm(at: Long) = if (at <= 0) "" else java.text.SimpleDateFormat("HH:mm", java.util.Locale.CHINA).format(java.util.Date(at))
+private fun day(at: Long): String {
+    val f = java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.CHINA)
+    val d = f.format(java.util.Date(at)); val today = f.format(java.util.Date())
+    val yest = f.format(java.util.Date(System.currentTimeMillis() - 86_400_000L))
+    return when (d) { today -> "今天"; yest -> "昨天"; else -> d.substring(5) }
+}
+private fun dur(ms: Long): String = when { ms < 60_000 -> "${(ms / 1000).coerceAtLeast(1)} 秒"; ms < 3_600_000 -> "${ms / 60_000} 分钟"; else -> "${ms / 3_600_000} 小时" }
