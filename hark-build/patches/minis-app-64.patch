+            if (a.id != "gmail_web") GlassMenuRow("从邮箱里移除", WarmIcons.of("trash"), danger = true) { manage = null; MailInbox.remove(ctx, a.id); if (sel == a.id) sel = null }
+        }
+    }
+}
