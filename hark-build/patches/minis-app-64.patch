+        Text(txt, fontSize = (size.value * (if (txt.length > 1) 0.42f else 0.55f)).sp, lineHeight = (size.value * 0.6f).sp, fontWeight = FontWeight.Bold, color = Color.White, maxLines = 1, softWrap = false)
+    }
+}
