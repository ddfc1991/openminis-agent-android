+/** 关联结果 folded into 账号关联: one collapsed row per state (hidden when empty), 忽略 / 恢复 on each platform. */
+@Composable
+private fun LinkResultsInline(rev: Int, go: (String) -> Unit, changed: () -> Unit) {
+    val m = mines()
