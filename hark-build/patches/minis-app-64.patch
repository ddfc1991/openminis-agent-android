+        expanded = expanded,
+        onDismissRequest = onDismissRequest,
+        modifier = modifier.glassSheen(shape, m.dark),
+        shape = shape,
+        containerColor = glassPopupFill(),
+        tonalElevation = 0.dp,
+        shadowElevation = 0.dp,
+        border = BorderStroke(1.dp, m.glassBorder),
+    ) {
+        if (expanded) GlassWindowEffect()
+        content()
+    }
+}
