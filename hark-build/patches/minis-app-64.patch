+object FogWind {
+    data class Sample(val speed: Double, val dirFrom: Double, val code: Int)
+    @Volatile var sample = Sample(2.0, 270.0, 2)
+    /** smoke: a fixed wind (fog-demo: calm / windy / rain); null = real weather */
+    @Volatile var forced: Sample? = null
