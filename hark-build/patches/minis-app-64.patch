+        }
+        PlusRow(null, "Meta Muse 网页版", if (muse) "已打开 · 需要美国网络" else "默认关闭：我在美国网络下使用时再打开", chevron = false, trailing = {
+            Switch(muse, { on -> muse = on; PresetRegistry.setMuseOn(on); scope.launch { Partners.refresh(ctx) } })
