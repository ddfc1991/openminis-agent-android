+package com.openminis.app.plus
+
+/**
+ * [Mines-38.9.8] 「免登录 AI（Mines）」 in 模型组 (user 2026-10-19 「这些免登陆的，用不了啊」): the routes it lists (扣子 bots,
+ * web-chat bridges 豆包 / 元宝 / Kimi / DeepSeek / 通义 / 智谱清言 / Gemini / Hark …) were listed as soon as a sign-in cookie
+ * existed — never actually called. Now each route is called for real (one tiny chat, time-limited); a route that does not
+ * answer is hidden from the gateway's model list until a later test passes (user rule: nothing that cannot run is shown),
+ * with its reason kept for 自检 / the 免登录 AI card. Also: two routes with the same name (two bots both called
+ * 「Mines-Test」) get the end of their id appended so they can be told apart. Pure, unit-tested in FreeRouteCoreTest.
+ */
+object FreeRouteCore {
+    const val TEST_PROMPT = "只回复两个字母：OK"
+    const val TEST_TIMEOUT_MS = 45_000L
+    const val CHAT_TIMEOUT_MS = 90_000L
+    const val RETEST_MS = 12 * 3_600_000L
+
+    data class Live(val id: String, val ok: Boolean, val reason: String, val at: Long, val ms: Long = 0)
+
+    /** A reply counts when it has any visible text (the routes are chat pages; they may not obey 「OK」 exactly). */
+    fun answered(reply: String?): Boolean = !reply.isNullOrBlank() && reply.trim().length in 1..4000 && !Regex("^(error|错误|出错)", RegexOption.IGNORE_CASE).containsMatchIn(reply.trim())
+
+    /** Shown in the gateway's /v1/models: never tested yet, or the last test passed. */
+    fun visible(id: String, live: Map<String, Live>): Boolean = live[id]?.ok ?: true
+
+    fun needsTest(id: String, live: Map<String, Live>, now: Long): Boolean = live[id]?.let { now - it.at > RETEST_MS } ?: true
+
+    fun timeoutReason(ms: Long) = "${ms / 1000} 秒没有回复，已停止（网页没打开或要重新登录）"
+
+    /** One 自检 line: 「能用 5 个：豆包、Kimi…；已隐藏 2 个：元宝（45 秒没有回复…）…」. */
+    fun summary(names: Map<String, String>, live: Map<String, Live>): Pair<Boolean, String> {
+        val tested = names.keys.filter { live.containsKey(it) }
+        val ok = tested.filter { live[it]!!.ok }
+        val dead = tested.filter { !live[it]!!.ok }
+        val untested = names.keys.filter { !live.containsKey(it) }
+        if (names.isEmpty()) return true to "没有免登录路线（没登录任何网页版 / 扣子）"
+        val sb = StringBuilder()
+        if (ok.isNotEmpty()) sb.append("能用 ${ok.size} 个：").append(ok.joinToString("、") { names[it] ?: it })
+        if (dead.isNotEmpty()) { if (sb.isNotEmpty()) sb.append("；"); sb.append("已隐藏 ${dead.size} 个：").append(dead.joinToString("、") { "${names[it] ?: it}（${live[it]!!.reason.take(40)}）" }) }
+        if (untested.isNotEmpty()) { if (sb.isNotEmpty()) sb.append("；"); sb.append("没测 ${untested.size} 个") }
+        return (dead.isEmpty()) to sb.toString()
+    }
+
+    /**
+     * Display names that can be told apart: a name used by more than one id gets " · " + the last 4 characters of the
+     * id's own part (coze:7696936574432591908 → 「Mines-Test · 1908」); unique names stay as they are.
+     */
+    fun distinctNames(items: List<Pair<String, String>>): Map<String, String> {
+        val dup = items.groupBy { it.second.trim() }.filter { it.value.map { p -> p.first }.distinct().size > 1 }.keys
+        val out = LinkedHashMap<String, String>()
+        for ((id, name) in items) {
+            if (name.trim() !in dup) { out[id] = name; continue }
+            val tail = id.substringAfterLast(':').substringAfterLast('/').substringAfterLast('#').filter { it.isLetterOrDigit() }.takeLast(4)
+            out[id] = if (tail.isBlank()) name else "$name · $tail"
+        }
+        // still equal (same tail) → use 6 characters
+        val again = out.entries.groupBy { it.value }.filter { it.value.size > 1 }
+        for ((_, es) in again) es.forEach { e -> out[e.key] = items.first { it.first == e.key }.second + " · " + e.key.filter { it.isLetterOrDigit() }.takeLast(6) }
+        return out
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/FreeRoutes.kt b/src/android/app/src/main/java/com/openminis/app/plus/FreeRoutes.kt
new file mode 100644
index 0000000..a7ecdfd
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/FreeRoutes.kt
@@ -0,0 +1,84 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import com.openminis.app.MinisApp
+import com.openminis.app.plus.group.AiClient
+import com.openminis.app.plus.group.Partner
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.withTimeoutOrNull
+import org.json.JSONObject
+
+/**
+ * [Mines-38.9.8] Live test of every 「免登录 AI（Mines）」 route (see [FreeRouteCore]): one tiny real chat per route,
+ * time-limited, sequential (web routes share the phone's WebView). Results persist; a route that does not answer is left
+ * out of the gateway's /v1/models (so 模型组 stops offering it) until a later test passes. Runs ≤ once per 12 h per route
+ * at launch, and on demand from 自检.
+ */
+object FreeRoutes {
+    private const val PREFS = "mines_free_routes"
+    private val _live = MutableStateFlow<Map<String, FreeRouteCore.Live>>(emptyMap())
+    val live: StateFlow<Map<String, FreeRouteCore.Live>> = _live.asStateFlow()
+    @Volatile private var loaded = false
+    @Volatile var testing: Boolean = false; private set
+
+    fun init(c: Context) {
+        if (loaded) return
+        loaded = true
+        runCatching {
+            val o = JSONObject(c.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString("live", "{}") ?: "{}")
+            _live.value = o.keys().asSequence().associateWith { k ->
+                val x = o.getJSONObject(k); FreeRouteCore.Live(k, x.optBoolean("ok"), x.optString("reason"), x.optLong("at"), x.optLong("ms"))
+            }
+        }
+    }
+
+    fun record(c: Context, l: FreeRouteCore.Live) {
+        init(c)
+        _live.value = _live.value + (l.id to l)
+        runCatching {
+            val o = JSONObject(); _live.value.values.forEach { v -> o.put(v.id, JSONObject().put("ok", v.ok).put("reason", v.reason).put("at", v.at).put("ms", v.ms)) }
+            c.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString("live", o.toString()).apply()
+        }
+    }
+
+    fun visible(c: Context, id: String): Boolean { init(c); return FreeRouteCore.visible(id, _live.value) }
+
+    /** One route, one tiny chat (≤ 45 s, detached so a stuck page can not hold the timeout). */
+    suspend fun testOne(c: Context, p: Partner): FreeRouteCore.Live {
+        val t0 = System.currentTimeMillis()
+        val call = CoroutineScope(Dispatchers.IO).async { runCatching { AiClient.reply(p, "", listOf(AiClient.Turn("user", FreeRouteCore.TEST_PROMPT)), 32) } }
+        val r = withTimeoutOrNull(FreeRouteCore.TEST_TIMEOUT_MS) { call.await() }
+        val ms = System.currentTimeMillis() - t0
+        val l = when {
+            r == null -> { call.cancel(); FreeRouteCore.Live(p.id, false, FreeRouteCore.timeoutReason(FreeRouteCore.TEST_TIMEOUT_MS), System.currentTimeMillis(), ms) }
+            r.isFailure -> FreeRouteCore.Live(p.id, false, ((r.exceptionOrNull() as? com.openminis.app.plus.group.MemberError)?.message ?: r.exceptionOrNull()?.message ?: "没有回复").take(80), System.currentTimeMillis(), ms)
+            FreeRouteCore.answered(r.getOrNull()?.text) -> FreeRouteCore.Live(p.id, true, "", System.currentTimeMillis(), ms)
+            else -> FreeRouteCore.Live(p.id, false, "回复是空的", System.currentTimeMillis(), ms)
+        }
+        record(c, l)
+        return l
+    }
+
+    /** Tests the routes that need it ([force] = all), then refreshes the gateway provider's model list. */
+    suspend fun testAll(c: Context, force: Boolean = false): Pair<Boolean, String> {
+        init(c)
+        if (testing) return true to "正在实测…"
+        testing = true
+        try {
+            val routes = PartnerGateway.readyRoutes(c)
+            val now = System.currentTimeMillis()
+            for (p in routes) if (force || FreeRouteCore.needsTest(p.id, _live.value, now)) testOne(c, p)
+            runCatching {
+                val repo = (c.applicationContext as? MinisApp)?.providerRepositoryOrNull
+                c.getSharedPreferences("mines_partner_gateway", Context.MODE_PRIVATE).getString("inst", null)?.let { repo?.triggerAsyncModelReconcile(it, forceRefresh = true) }
+            }
+            val names = routes.associate { it.id to it.spec.name }
+            return FreeRouteCore.summary(names, _live.value.filterKeys { it in names })
+        } finally { testing = false }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/GatewayTunnel.kt b/src/android/app/src/main/java/com/openminis/app/plus/GatewayTunnel.kt
new file mode 100644
index 0000000..5ea6c4c
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/GatewayTunnel.kt
@@ -0,0 +1,68 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import com.jcraft.jsch.Session
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * [Mines-38.9.1] user 2026-10-16 (WorkBuddy 「本机网关 127.0.0.1:8788」 → 「连不上（网络问题，可能要开代理）」): 127.0.0.1 on
+ * the phone is the phone itself, but the user's model gateway runs on a server. When a 127.0.0.1 / localhost endpoint
+ * refuses, Mines looks for the port on the user's OWN servers (设置 › 网络 › 电脑与服务器 — nothing built in), and when
+ * one is listening there it opens an SSH local forward (phone 127.0.0.1:<port> → server 127.0.0.1:<port>) over the
+ * existing JSch session (keepalive 15 s × 4) and retries. The forward is re-made when the session drops.
+ */
+object GatewayTunnel {
+    private class T(val serverId: String, val name: String, val session: Session)
+    private val open = HashMap<Int, T>()
+    @Volatile var lastNote: String? = null
+
+    fun isLocal(base: String): Pair<String, Int>? {
+        val m = Regex("^https?://(127\\.0\\.0\\.1|localhost|\\[::1\\]):(\\d+)", RegexOption.IGNORE_CASE).find(base.trim()) ?: return null
+        return m.groupValues[1] to (m.groupValues[2].toIntOrNull() ?: return null)
+    }
+
+    /** Name of the server the port is now forwarded to, or null (no server of the user has it / no server set up). */
+    suspend fun ensure(c: Context, port: Int): String? = withContext(Dispatchers.IO) {
+        synchronized(open) { open[port]?.let { t -> if (t.session.isConnected) return@withContext t.name else open.remove(port) } }
+        val app = c.applicationContext
+        PlusPrefs.init(app)
+        val servers = PlusPrefs.state.value.servers.filter { it.enabled && it.host.isNotBlank() }
+        for (sv in servers) {
+            val listening = runCatching {
+                VpsSsh.run(app, sv, "(ss -ltn 2>/dev/null || netstat -ltn 2>/dev/null) | grep -E '[:.]$port[[:space:]]' >/dev/null && echo MINES_YES", 12_000, 1).first.output
+            }.getOrNull()?.contains("MINES_YES") == true
+            if (!listening) continue
+            val s = runCatching { VpsSsh.openAny(app, sv) }.getOrNull() ?: continue
+            val ok = runCatching { s.setPortForwardingL("127.0.0.1", port, "127.0.0.1", port); true }.getOrDefault(false)
+            if (!ok) { runCatching { s.disconnect() }; continue }
+            synchronized(open) { open[port] = T(sv.id, sv.name.ifBlank { sv.host }, s) }
+            lastNote = "已经通过 SSH 接到 ${sv.name.ifBlank { sv.host }} 的 $port 端口"
+            return@withContext sv.name.ifBlank { sv.host }
+        }
+        null
+    }
+
+    fun close(port: Int) { synchronized(open) { open.remove(port)?.let { runCatching { it.session.disconnect() } } } }
+
+    /** Specific words for a failed call to [base] (never a vague 「可能要开代理」 unless a proxy really is involved). */
+    fun explain(base: String, msg: String, proxyOn: Boolean, triedTunnel: Boolean): String {
+        val m = msg.lowercase()
+        val host = runCatching { java.net.URI(base).host + ":" + java.net.URI(base).port.let { if (it > 0) it else if (base.startsWith("https")) 443 else 80 } }.getOrDefault(base)
+        val local = isLocal(base)
+        return when {
+            local != null && (m.contains("refused") || m.contains("failed to connect")) ->
+                "${local.first}:${local.second} 上没有服务（这是手机本机）" + if (triedTunnel) "；你的服务器上也没找到在 ${local.second} 端口的网关" else "；网关在服务器上的话，到「设置 › 网络 › 电脑与服务器」加上那台服务器，我会自动用 SSH 接过去"
+            m.contains("refused") -> "$host 拒绝连接（端口没开或服务没跑）"
+            m.contains("timeout") || m.contains("timed out") -> if (proxyOn) "$host 等太久没回复（开着代理：可能被代理拦了，试试让 Mines 直连）" else "$host 等太久没回复（超时）"
+            m.contains("unable to resolve") || m.contains("no address") -> if (proxyOn) "找不到 $host（域名解析失败；开着代理，可能是代理的 DNS）" else "找不到 $host（域名解析失败）"
+            m.contains("cleartext") -> "$host 用的是 http，系统不让明文连接"
+            m.contains("ssl") || m.contains("certificate") || m.contains("handshake") -> "$host 的 HTTPS 证书有问题"
+            m.contains("canceled") -> "已停止"
+            m.contains("reset") || m.contains("broken pipe") || m.contains("unexpected end") -> "$host 中途断开了连接"
+            else -> "连不上 $host（${msg.take(60).ifBlank { "网络错误" }}）"
+        }
+    }
+
+    fun proxyOn(c: Context?): Boolean = runCatching { c != null && VpsSsh.vpnActive(c) }.getOrDefault(false)
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/GlassAuto.kt b/src/android/app/src/main/java/com/openminis/app/plus/GlassAuto.kt
new file mode 100644
index 0000000..d5b6d9a
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/GlassAuto.kt
@@ -0,0 +1,182 @@
+package com.openminis.app.plus
+
+import kotlin.math.pow
+import kotlin.math.sqrt
+
+/**
+ * [Mines-38.9.4] user 2026-10-17 16:59 「那个磨砂玻璃可以调节一下，不用户自己调节」: the frosted glass picks its own tint.
+ * [Mines-38.9.5 i] user 21:22 on the 38.9.4 sheets: auto was too white (light 86 %, dark 73 %); the 38.9.3 look (slider
+ * ~30 %) is the one they like. So the glass now stays THIN — light 30–40 %, dark 35–45 %, hard cap light 45 % / dark 50 %
+ * (strong variant included) — and readability comes from the text instead of from whitening the whole card:
+ *  1. secondary text (ink2) is pulled toward the primary ink just as far as the worst band needs ([Plan.ink2]);
+ *  2. where even that is not enough, text rows on those bands get a soft halo / scrim in the glass tint behind the glyphs
+ *     ([Plan.halo] per band, 0…[HALO_MAX]), not a denser card.
+ *
+ * What is behind the glass is measured (the fog as it is drawn — base colour + the 4 drifting blobs at the current
+ * 雾气浓淡 / weather density, sampled on a 12 × 24 grid at 4 moments of its 24 s loop — or the photo wallpaper on a
+ * 12 × 24 thumbnail). Per vertical band of the screen it keeps the WORST luminance for the text colour (darkest
+ * spot for dark ink on light glass, brightest for light ink on dark glass), pushed a little further by how busy the
+ * background is (std-dev).
+ *
+ * Pure (no Android types) so it is unit-tested: GlassAutoTest.
+ */
+object GlassAuto {
+    const val BANDS = 6
+    const val LIGHT_MIN = 0.30f; const val LIGHT_MAX = 0.40f; const val LIGHT_CAP = 0.45f
+    const val DARK_MIN = 0.35f; const val DARK_MAX = 0.45f; const val DARK_CAP = 0.50f
+    const val TARGET = 4.5f
+    /** strongest halo behind text rows (tint alpha at the glyph centre; it fades out over ~6 dp) */
+    const val HALO_MAX = 0.70f
+    fun min(dark: Boolean) = if (dark) DARK_MIN else LIGHT_MIN
+    fun max(dark: Boolean) = if (dark) DARK_MAX else LIGHT_MAX
+    fun cap(dark: Boolean) = if (dark) DARK_CAP else LIGHT_CAP
+
+    /** Per band (top → bottom): darkest / brightest luminance (after the busy-ness margin), mean, std-dev. */
+    data class Band(val lo: Float, val hi: Float, val mean: Float, val sd: Float)
+    data class Stats(val bands: List<Band>) {
+        val worstLo: Float get() = bands.minOf { it.lo }
+        val worstHi: Float get() = bands.maxOf { it.hi }
+    }
+
+    // ---------------- colour maths (sRGB, WCAG) ----------------
+
+    private fun lin(c: Float): Float = if (c <= 0.04045f) c / 12.92f else ((c + 0.055f) / 1.055f).toDouble().pow(2.4).toFloat()
+    private fun srgb(l: Float): Float { val c = l.coerceIn(0f, 1f); return if (c <= 0.0031308f) 12.92f * c else (1.055 * c.toDouble().pow(1 / 2.4) - 0.055).toFloat() }
+    fun lum(argb: Int): Float = 0.2126f * lin(((argb shr 16) and 0xFF) / 255f) + 0.7152f * lin(((argb shr 8) and 0xFF) / 255f) + 0.0722f * lin((argb and 0xFF) / 255f)
+    fun contrast(a: Float, b: Float): Float = (maxOf(a, b) + 0.05f) / (minOf(a, b) + 0.05f)
+
+    /** Luminance of a glass of luminance [tint] at [alpha] over a backdrop of luminance [bg] (blended in sRGB, like the GPU). */
+    fun over(tint: Float, alpha: Float, bg: Float): Float = lin(alpha * srgb(tint) + (1 - alpha) * srgb(bg))
+
+    // ---------------- the solver ----------------
+
+    private fun worst(dark: Boolean, band: Band) = if (dark) band.hi else band.lo
+
+    /** Lowest alpha (0.01 steps) in [min]…[max] keeping [ink] ≥ [TARGET]:1 over the worst spot of [band]; [max] when none does
+     *  (the glass never goes denser than that — the text gets help instead, see [plan]). */
+    fun solveBand(dark: Boolean, tint: Float, ink: Float, band: Band): Float {
+        var a = min(dark)
+        while (a <= max(dark) + 1e-4f) {
+            if (contrast(ink, over(tint, a, worst(dark, band))) >= TARGET) return a
+            a += 0.01f
+        }
+        return max(dark)
+    }
+
+    /** Alpha per band and the screen-wide one (the max: a card can scroll over any band). */
+    fun solve(dark: Boolean, tint: Float, ink: Float, s: Stats): Pair<List<Float>, Float> {
+        val per = s.bands.map { solveBand(dark, tint, ink, it) }
+        return per to (per.maxOrNull() ?: min(dark))
+    }
+
+    /** Glass alpha per band + screen-wide, the secondary-text colour to use, and the halo behind text rows per band. */
+    data class Plan(val per: List<Float>, val all: Float, val ink2: Int, val inkMix: Float, val halo: List<Float>)
+
+    /** [ink2] pulled toward [ink] by [t] (0 = ink2, 1 = ink), in sRGB like the GPU. */
+    fun mixInk(ink2: Int, ink: Int, t: Float): Int = blend(ink, ink2, t.coerceIn(0f, 1f))
+
+    /** Contrast of text [inkLum] over the glass at [a] with a halo of [halo] (tint coverage behind the glyphs) over [bg]. */
+    fun textContrast(tint: Float, a: Float, halo: Float, bg: Float, inkLum: Float): Float =
+        contrast(inkLum, over(tint, a + (1 - a) * halo.coerceIn(0f, 1f), bg))
+
+    /**
+     * Thin glass first, then the text: per band the lowest alpha in min…max that already gives ink2 ≥ 4.5:1 (else max);
+     * then ONE ink2 for the screen = the least pull toward [ink] that makes every band pass at its own alpha; where even the
+     * primary ink is not enough, the lowest halo (0.05 steps, ≤ [HALO_MAX]) that does.
+     */
+    fun plan(dark: Boolean, tint: Int, ink2: Int, ink: Int, s: Stats): Plan {
+        val tl = lum(tint)
+        val (per, all) = solve(dark, tl, lum(ink2), s)
+        var t = 0f
+        while (t < 1f && s.bands.indices.any { i -> textContrast(tl, per[i], 0f, worst(dark, s.bands[i]), lum(mixInk(ink2, ink, t))) < TARGET }) t += 0.05f
+        t = t.coerceAtMost(1f)
+        val ink2n = mixInk(ink2, ink, t); val il = lum(ink2n)
+        val halo = s.bands.indices.map { i ->
+            var h = 0f
+            while (h < HALO_MAX && textContrast(tl, per[i], h, worst(dark, s.bands[i]), il) < TARGET) h += 0.05f
+            (Math.round(h.coerceAtMost(HALO_MAX) * 20f) / 20f)
+        }
+        return Plan(per, all, ink2n, t, halo)
+    }
+
+    /** Worst spot = 10th / 90th percentile; busy backgrounds read worse through frost, so it is widened by ¼ std-dev (≤ 0.04). */
+    private fun band(ls: List<Float>): Band {
+        if (ls.isEmpty()) return Band(0.5f, 0.5f, 0.5f, 0f)
+        val mean = ls.average().toFloat()
+        val sd = sqrt(ls.map { (it - mean) * (it - mean) }.average()).toFloat()
+        val m = (sd * 0.25f).coerceAtMost(0.04f)
+        val sorted = ls.sorted()
+        val p05 = sorted[(sorted.size * 0.10f).toInt().coerceIn(0, sorted.lastIndex)]
+        val p95 = sorted[(sorted.size * 0.90f).toInt().coerceIn(0, sorted.lastIndex)]
+        return Band((p05 - m).coerceIn(0f, 1f), (p95 + m).coerceIn(0f, 1f), mean, sd)
+    }
+
+    /** [px] row-major ARGB of a w × h thumbnail of what is behind the glass. */
+    fun statsOf(px: IntArray, w: Int, h: Int): Stats {
+        val rows = (0 until BANDS).map { b ->
+            val y0 = h * b / BANDS; val y1 = maxOf(y0 + 1, h * (b + 1) / BANDS)
+            val ls = ArrayList<Float>()
+            for (y in y0 until minOf(y1, h)) for (x in 0 until w) ls += lum(px[y * w + x])
+            band(ls)
+        }
+        return Stats(rows)
+    }
+
+    /** Photo thumbnail drawn at [photoAlpha] over the page colour [page]. */
+    fun photoStats(px: IntArray, w: Int, h: Int, photoAlpha: Float, page: Int): Stats {
+        val a = photoAlpha.coerceIn(0f, 1f)
+        val out = IntArray(px.size) { i -> blend(px[i], page, a) }
+        return statsOf(out, w, h)
+    }
+
+    // ---------------- the fog, as PorcelainBackdrop draws it ----------------
+
+    private val SPOTS = arrayOf(   // (cx, cy, ax, ay, kx, ky, phase, radius × width) — keep in step with PorcelainBackdrop
+        floatArrayOf(0.24f, 0.17f, 230f, 210f, 1f, 1f, 0.0f, 0.50f),
+        floatArrayOf(0.80f, 0.40f, 210f, 250f, 1f, 2f, 1.9f, 0.48f),
+        floatArrayOf(0.24f, 0.66f, 230f, 190f, 2f, 1f, 3.6f, 0.46f),
+        floatArrayOf(0.78f, 0.88f, 190f, 230f, 1f, 1f, 4.8f, 0.48f),
+    )
+    private val LIGHT_BASE = 0xFFF4EAE4.toInt(); private val DARK_BASE = 0xFF161114.toInt()
+    private val LIGHT_COLS = intArrayOf(0xFFF0844E.toInt(), 0xFFA07CF0.toInt(), 0xFFFF9F45.toInt(), 0xFFEC72A4.toInt())
+    private val DARK_COLS = intArrayOf(0xFF963A42.toInt(), 0xFF563296.toInt(), 0xFFA85C1C.toInt(), 0xFF8C2E60.toInt())
+    private val LIGHT_A = floatArrayOf(1.0f, 1.0f, 0.95f, 0.95f); private val DARK_A = floatArrayOf(0.90f, 0.85f, 0.75f, 0.78f)
+
+    fun blend(top: Int, under: Int, a: Float): Int {
+        fun ch(s: Int) = ((((top shr s) and 0xFF) * a + ((under shr s) and 0xFF) * (1 - a)).toInt()).coerceIn(0, 255)
+        return (0xFF shl 24) or (ch(16) shl 16) or (ch(8) shl 8) or ch(0)
+    }
+
+    /** Fog stats: [fogK] = 外观调节 › 雾气浓淡, [dens] = weather density; 12 × 24 grid × 4 moments of the 24 s loop. */
+    fun fogStats(dark: Boolean, fogK: Float, dens: Float, aspect: Float = 2.19f): Stats {
+        val w = 12; val h = 24
+        val base = if (dark) DARK_BASE else LIGHT_BASE
+        val cols = if (dark) DARK_COLS else LIGHT_COLS
+        val als = (if (dark) DARK_A else LIGHT_A).map { (it * fogK).coerceIn(0f, 1f) }
+        val W = 1080f; val H = W * aspect
+        val perBand = List(BANDS) { ArrayList<Float>() }
+        for (t in floatArrayOf(0f, 6f, 12f, 18f)) {
+            val om = (2.0 * Math.PI * t / 24.0).toFloat()
+            val centres = SPOTS.mapIndexed { i, sp ->
+                val cx = sp[0] * W + 1.7f * sp[2] * kotlin.math.cos(sp[4] * om + sp[6])
+                val cy = sp[1] * H + 1.7f * sp[3] * kotlin.math.sin(sp[5] * om + sp[6])
+                val r = sp[7] * W * 1.6f * 1.12f
+                val a = (als[i] * dens).coerceIn(0f, 1f)   // breathing peak (0.74 + 0.26) = 1
+                floatArrayOf(cx, cy, r, a)
+            }
+            for (gy in 0 until h) for (gx in 0 until w) {
+                val x = (gx + 0.5f) * W / w; val y = (gy + 0.5f) * H / h
+                var c = base
+                centres.forEachIndexed { i, s ->
+                    val dx = x - s[0]; val dy = (y - s[1]) / 1.15f
+                    val d = sqrt(dx * dx + dy * dy) / s[2]       // 0 … 1 of the gradient radius
+                    val fall = if (d >= 1f) 0f else kotlin.math.exp(-2.0 * (d * 1.6) * (d * 1.6)).toFloat()
+                    val a = s[3] * fall
+                    if (a > 0.002f) c = blend(cols[i], c, a)
+                }
+                perBand[(gy * BANDS / h).coerceIn(0, BANDS - 1)] += lum(c)
+            }
+        }
+        return Stats(perBand.map { band(it) })
+    }
+}
