+        }
+    }
+
+    open?.let { mail -> MailDetail(mail, onDismiss = { open = null }, onOpenWeb = onOpenWeb) }
+    if (adding) MailAdd(onDismiss = { adding = false }, onOpenWeb = onOpenWeb, onAdded = { adding = false; scope.launch { MailInbox.refresh(ctx, force = true) } })
