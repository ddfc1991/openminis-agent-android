+    private suspend fun eval(wv: WebView, js: String): String = suspendCancellableCoroutine { c ->
+        runCatching {
+            wv.evaluateJavascript(js) { r ->
+                val v = runCatching { org.json.JSONTokener(r ?: "\"\"").nextValue() as? String }.getOrNull().orEmpty()
