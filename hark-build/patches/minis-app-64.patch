+                val name = com.openminis.app.ui.plus.LinkAll.name(id)
+                val host = if (k != null) Keychain.hostOf(k.loginUrl ?: k.site ?: k.panelUrl ?: k.keyUrl) else Keychain.hostOf(com.openminis.app.plus.group.AiCatalog.spec(id)?.webUrl)
