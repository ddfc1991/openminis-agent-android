+/** [Mines-38.8] compact 40 dp / 14 sp pill for the key page's frosted bottom bar (primary = terracotta, else quiet outline). */
+@Composable
+private fun KaPill(text: String, primary: Boolean = false, icon: String? = null, onClick: () -> Unit) {
