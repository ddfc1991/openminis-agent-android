--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/WebProxy.kt
@@ -0,0 +1,24 @@
+package com.openminis.app.plus
+
+/**
+ * [Mines-38.9.6 i12] WebView traffic through the local split proxy (androidx.webkit ProxyController). The WebView itself
+ * never sees the upstream credentials: 127.0.0.1:[SplitProxy.PORT] adds Proxy-Authorization upstream. Before this the
+ * Gmail / Google sign-in pages in Mines ignored the proxy (WebView does not use the app's ProxySelector).
+ */
+object WebProxy {
+    @Volatile var applied: Boolean = false; private set
+    fun apply(on: Boolean) {
+        runCatching {
+            if (!androidx.webkit.WebViewFeature.isFeatureSupported(androidx.webkit.WebViewFeature.PROXY_OVERRIDE)) return
+            val pc = androidx.webkit.ProxyController.getInstance()
+            val ex = java.util.concurrent.Executor { it.run() }
+            if (on) {
+                val cfg = androidx.webkit.ProxyConfig.Builder()
+                    .addProxyRule("127.0.0.1:${SplitProxy.PORT}")
+                    .addBypassRule("localhost").addBypassRule("127.0.0.1").addBypassRule("10.0.2.2")
+                    .build()
+                pc.setProxyOverride(cfg, ex) { applied = true }
+            } else if (applied) pc.clearProxyOverride(ex) { applied = false }
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/WebSession.kt b/src/android/app/src/main/java/com/openminis/app/plus/WebSession.kt
new file mode 100644
index 0000000..82d99a1
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/WebSession.kt
@@ -0,0 +1,71 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.withContext
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * [Mines-38.9.5 i] real web-session check (see [WebSessionCore]): flush the WebView cookies, send ONE authenticated request
+ * with them, and publish the result per service so the detail hero, the 网站登录 row and 「我已登录好了」 agree.
+ */
+object WebSession {
+    private val _state = MutableStateFlow<Map<String, WebSessionCore.St>>(emptyMap())
+    val state: StateFlow<Map<String, WebSessionCore.St>> = _state
+
+    fun of(kindId: String): WebSessionCore.St = _state.value[kindId] ?: WebSessionCore.St.UNCHECKED
+
+    private fun put(kindId: String, st: WebSessionCore.St) { _state.value = _state.value + (kindId to st) }
+
+    /** Check now; updates [state], the vault session record and the identity row. Never throws. */
+    suspend fun verify(c: Context, kind: ConnectionKind): WebSessionCore.St {
+        val prev = of(kind.id)
+        put(kind.id, WebSessionCore.St.CHECKING)
+        val res = withContext(Dispatchers.IO) {
+            runCatching {
+                LoginWeb.flush()
+                val probe = WebSessionCore.probeFor(kind.id, kind.loginUrl, kind.panelUrl, kind.site) ?: return@runCatching WebSessionCore.St.UNCHECKED
+                val cm = LoginWeb.cookies(kind.id)
+                val cookie = listOf(probe.url, kind.loginUrl, kind.panelUrl, kind.site).filterNotNull()
+                    .mapNotNull { u -> runCatching { cm.getCookie(u) }.getOrNull() }.firstOrNull { it.isNotBlank() }.orEmpty()
+                val hasCookie = cookie.isNotBlank() && (kind.doneCookies.isEmpty() || MailParse.cookieHas(cookie, kind.doneCookies))
+                if (!hasCookie) return@runCatching WebSessionCore.St.SIGNED_OUT
+                val h = URL(probe.url).openConnection() as HttpURLConnection
+                h.instanceFollowRedirects = false
+                h.connectTimeout = 8000; h.readTimeout = 10000
+                h.requestMethod = probe.method
+                h.setRequestProperty("Cookie", cookie)
+                h.setRequestProperty("User-Agent", android.webkit.WebSettings.getDefaultUserAgent(c))
+                h.setRequestProperty("Accept", "application/json, text/html;q=0.9")
+                if (probe.body != null) {
+                    h.doOutput = true; h.setRequestProperty("Content-Type", "application/json")
+                    h.outputStream.use { it.write(probe.body.toByteArray()) }
+                }
+                val code = h.responseCode
+                val body = runCatching { (if (code < 400) h.inputStream else h.errorStream)?.bufferedReader()?.use { it.readText().take(4000) } }.getOrNull().orEmpty()
+                WebSessionCore.judge(probe, code, body, h.getHeaderField("Location"), true)
+            }.getOrElse { WebSessionCore.St.ERROR }
+        }
+        val st = WebSessionCore.next(prev, res)
+        put(kind.id, st)
+        runCatching {
+            when (st) {
+                WebSessionCore.St.SIGNED_IN -> LoginWeb.markSignedIn(kind.id, null)
+                WebSessionCore.St.SIGNED_OUT -> LoginWeb.markSignedOut(kind.id)
+                else -> {}
+            }
+            val host = Keychain.hostOf(kind.loginUrl ?: kind.site ?: kind.panelUrl)
+            IdentityStore.recFor(c, host)?.let { r ->
+                when (st) {
+                    WebSessionCore.St.SIGNED_IN -> IdentityStore.setStatus(c, r.key, IdentityCore.LINKED)
+                    WebSessionCore.St.SIGNED_OUT -> IdentityStore.setStatus(c, r.key, IdentityCore.EXPIRED)
+                    else -> {}
+                }
+            }
+        }
+        return st
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/WebSessionCore.kt b/src/android/app/src/main/java/com/openminis/app/plus/WebSessionCore.kt
new file mode 100644
index 0000000..1453506
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/WebSessionCore.kt
@@ -0,0 +1,79 @@
+package com.openminis.app.plus
+
+/**
+ * [Mines-38.9.5 i] user 2026-10-17 22:02 / 22:04 (Notion on 38.9.4): after signing in in the Mines browser the page still
+ * said 「需要登录」, and the detail page contradicted itself (green 「已连接 · 网页登录」, red 「已连接 · 断开」, row 「未检查」).
+ * Root causes: (1) 「我已登录好了」 / 「我在 Chrome 里登录好了」 marked the service signed in WITHOUT any check — a Google
+ * sign-in finished in Chrome leaves its cookies in Chrome, never in Mines' WebView, so Mines had no session at all;
+ * (2) the 网站登录 row read a cached record (status written once, never re-checked); (3) the hero read 「entry exists」 as
+ * 「connected」.
+ *
+ * Now a web sign-in is judged by ONE rule: cookies flushed, then a real authenticated request with those cookies
+ * (Notion: POST /api/v3/getSpaces). Pure decision logic here (unit-tested: WebSessionCoreTest); the request is in
+ * [WebSession].
+ */
+object WebSessionCore {
+    enum class St(val label: String) { SIGNED_IN("已登录"), SIGNED_OUT("未登录"), UNCHECKED("未检查"), CHECKING("检查中"), ERROR("检查失败") }
+
+    /** How to ask a site 「am I signed in?」 with its cookies. */
+    data class Probe(val url: String, val method: String = "GET", val body: String? = null,
+                     /** the response is signed-in when [okWhen] says so (code, body) */
+                     val kind: Judge = Judge.CODE_2XX_NO_LOGIN_REDIRECT)
+    enum class Judge { NOTION_SPACES, CODE_2XX_NO_LOGIN_REDIRECT }
+
+    /** Known probes; others fall back to the panel / site page (2xx and not redirected to a login page). */
+    fun probeFor(kindId: String, loginUrl: String?, panelUrl: String?, site: String?): Probe? = when (kindId.substringBefore('#')) {
+        "notion" -> Probe("https://www.notion.so/api/v3/getSpaces", "POST", "{}", Judge.NOTION_SPACES)
+        else -> (panelUrl ?: site)?.takeIf { it.startsWith("http") }?.let { Probe(it) }
+    }
+
+    private val LOGIN_PATH = Regex("""(?i)/(login|signin|sign-in|sign_in|passport|auth/login|account/login)(\b|/|\?|$)""")
+
+    /** One response → state. [location] = redirect target (not followed), [hasCookie] = the site's session cookie is there. */
+    fun judge(p: Probe, code: Int, body: String, location: String?, hasCookie: Boolean): St = when (p.kind) {
+        Judge.NOTION_SPACES -> when {
+            code == 401 || code == 403 -> St.SIGNED_OUT
+            code in 200..299 -> {
+                val t = body.trim()
+                // getSpaces answers {"<userId>": {"space": {...}, "notion_user": {...}}} when signed in, {} when not
+                if (t.length > 2 && t.startsWith("{") && (t.contains("notion_user") || t.contains("\"space\""))) St.SIGNED_IN else St.SIGNED_OUT
+            }
+            code == 0 -> St.ERROR
+            else -> if (!hasCookie) St.SIGNED_OUT else St.ERROR
+        }
+        Judge.CODE_2XX_NO_LOGIN_REDIRECT -> when {
+            !hasCookie -> St.SIGNED_OUT
+            code in 300..399 && location != null && LOGIN_PATH.containsMatchIn(location) -> St.SIGNED_OUT
+            code == 401 || code == 403 -> St.SIGNED_OUT
+            code in 200..399 -> St.SIGNED_IN
+            code == 0 -> St.ERROR
+            else -> St.ERROR
+        }
+    }
+
+    /**
+     * State transition shown on the page. A network ERROR never flips a confirmed state (no false 「登录失效」 on a blip),
+     * except that it can't claim 已登录 for something never confirmed; CHECKING keeps the previous label underneath.
+     */
+    fun next(prev: St, result: St): St = when (result) {
+        St.ERROR -> if (prev == St.SIGNED_IN || prev == St.SIGNED_OUT) prev else St.ERROR
+        St.CHECKING -> St.CHECKING
+        else -> result
+    }
+
+    /** What 「我已登录好了」 does: finish only on a confirmed session; otherwise stay on the page and say why. */
+    fun finishAllowed(st: St): Boolean = st == St.SIGNED_IN
+
+    /** Status line for the detail page hero (one truth for hero, row and button). */
+    fun heroLine(st: St, method: String): String = when (st) {
+        St.SIGNED_IN -> "已登录 · $method"
+        St.SIGNED_OUT -> "未登录 · 点「登录」"
+        St.CHECKING -> "正在检查登录…"
+        St.ERROR -> "暂时检查不了（网络）"
+        St.UNCHECKED -> "未检查"
+    }
+
+    /** Hint when the site was signed in through Google in Chrome (cookies stay in Chrome). */
+    fun chromeHint(kindName: String): String =
+        "在 Chrome 里用 Google 登录的 $kindName，Mines 读不到。请在 Mines 里选「用邮箱登录」，验证码会自动从你关联的邮箱读取；或者用 Integration Token。"
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/WorkspaceCore.kt b/src/android/app/src/main/java/com/openminis/app/plus/WorkspaceCore.kt
new file mode 100644
index 0000000..a098577
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/WorkspaceCore.kt
@@ -0,0 +1,177 @@
+package com.openminis.app.plus
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * [Mines-38.9.5 i] user 2026-10-17 16:55 / 16:59 / 17:44: a server or cloud browser the agent obtains (free VPS, trial,
+ * remote desktop) registers itself under 工作位置 — no manual step, nothing forgotten — with provider, account used,
+ * 到期 (countdown, grey when over), 限制, 费用, IP 归属地 (country / region / city + ASN), where its credential sits (a vault
+ * reference, never the secret), one 主设备 used by default, and what runs on each box (services / ports / containers,
+ * read by a read-only ps / ss / docker / systemctl probe). Pure part, unit-tested in WorkspaceCoreTest.
+ */
+object WorkspaceCore {
+    enum class Kind(val id: String, val label: String) {
+        SERVER("server", "服务器"), CLOUD_BROWSER("cloud_browser", "云浏览器"), DESKTOP("desktop", "远程桌面");
+        companion object { fun of(s: String?): Kind = values().firstOrNull { it.id == s?.lowercase() || it.label == s } ?: SERVER }
+    }
+
+    data class Meta(
+        val id: String,                 // VpsServer.id for servers, own id for browsers / desktops
+        val kind: Kind = Kind.SERVER,
+        val name: String = "",
+        val host: String = "",          // host / IP / URL
+        val provider: String = "",
+        val account: String = "",
+        val expiresAt: Long = 0L,       // 0 = no end
+        val limits: String = "",
+        val cost: String = "",          // "免费" / "¥0（试用）" / "$5/月"
+        val vaultRef: String = "",      // id of the vault entry holding the credential (never the secret)
+        val sourceUrl: String = "",
+        val geo: String = "",           // 「日本 东京 · AS9370 Sakura」
+        val running: List<String> = emptyList(),
+        val runningAt: Long = 0L,
+        val notes: List<String> = emptyList(),   // what the agent deployed / the user wrote (「:8090 下载服务」)
+        val addedBy: String = "agent",
+        val addedAt: Long = 0L,
+    )
+
+    // ---------------- expiry ----------------
+
+    private const val DAY = 24 * 3_600_000L
+
+    fun expired(m: Meta, now: Long): Boolean = m.expiresAt in 1..now
+
+    /** 「还剩 3 天」 / 「还剩 5 小时」 / 「今天到期」 / 「已过期 2 天」 / "" (no end). */
+    fun expiryText(m: Meta, now: Long): String {
+        if (m.expiresAt <= 0L) return ""
+        val d = m.expiresAt - now
+        return when {
+            d <= 0 -> { val ago = (-d) / DAY; if (ago >= 1) "已过期 $ago 天" else "已过期" }
+            d < 3_600_000L -> "不到 1 小时到期"
+            d < DAY -> "还剩 ${d / 3_600_000L} 小时"
+            else -> "还剩 ${(d + DAY - 1) / DAY} 天"
+        }
+    }
+
+    /** Reminder points before the end: 3 days, 1 day, 2 hours. Returns which one is due now (null = none). */
+    fun reminderDue(m: Meta, now: Long, alreadySent: Set<String>): String? {
+        if (m.expiresAt <= 0L || expired(m, now)) return null
+        val left = m.expiresAt - now
+        return listOf("3d" to 3 * DAY, "1d" to DAY, "2h" to 2 * 3_600_000L)
+            .lastOrNull { (k, at) -> left <= at && k !in alreadySent }?.first
+    }
+
+    /** "2026-11-01" / "2026-11-01 18:00" / "7d" / "30 days" / epoch ms → epoch ms (0 = no end / unreadable). */
+    fun parseExpiry(s: String?, now: Long): Long {
+        val t = s?.trim().orEmpty()
+        if (t.isBlank()) return 0L
+        t.toLongOrNull()?.let { return if (it > 1_000_000_000_000L) it else if (it > 1_000_000_000L) it * 1000 else 0L }
+        Regex("^(\\d+)\\s*(d|day|days|天)$", RegexOption.IGNORE_CASE).find(t)?.let { return now + it.groupValues[1].toLong() * DAY }
+        Regex("^(\\d+)\\s*(h|hour|hours|小时)$", RegexOption.IGNORE_CASE).find(t)?.let { return now + it.groupValues[1].toLong() * 3_600_000L }
+        for (p in listOf("yyyy-MM-dd HH:mm", "yyyy-MM-dd'T'HH:mm", "yyyy-MM-dd", "yyyy/MM/dd")) {
+            val f = java.text.SimpleDateFormat(p, java.util.Locale.US).apply { isLenient = false; timeZone = java.util.TimeZone.getTimeZone("Asia/Shanghai") }
+            runCatching { return f.parse(t.take(p.replace("'", "").length))!!.time.let { if (p.contains("HH")) it else it + DAY - 1000 } }
+        }
+        return 0L
+    }
+
+    // ---------------- 主设备 ----------------
+
+    /** Exactly one primary among [ids]: the chosen one, else the current one if still there, else the first. */
+    fun primary(ids: List<String>, current: String?, chosen: String? = null): String? = when {
+        ids.isEmpty() -> null
+        chosen != null && chosen in ids -> chosen
+        current != null && current in ids -> current
+        else -> ids.first()
+    }
+
+    // ---------------- IP 归属地 ----------------
+
+    /** ip-api.com JSON (fields country,regionName,city,as,isp) → 「日本 东京 · AS9370 Sakura Internet」. */
+    fun geoLine(json: String): String = runCatching {
+        val o = JSONObject(json)
+        if (o.optString("status") == "fail") return ""
+        val place = listOf(o.optString("country"), o.optString("regionName"), o.optString("city")).filter { it.isNotBlank() }.distinct().joinToString(" ")
+        val asn = o.optString("as").trim().ifBlank { o.optString("isp").trim() }
+        listOf(place, asn.take(48)).filter { it.isNotBlank() }.joinToString(" · ")
+    }.getOrDefault("")
+
+    // ---------------- what runs on a server (read-only probe) ----------------
+
+    /** Read-only: lists listening ports, containers, running services, top processes. Never changes anything. */
+    const val RUNNING_PROBE = "(ss -ltnpH 2>/dev/null || ss -ltnp 2>/dev/null | tail -n +2) | head -40; echo '---D'; " +
+        "(docker ps --format '{{.Names}}|{{.Image}}|{{.Ports}}' 2>/dev/null | head -20); echo '---S'; " +
+        "(systemctl list-units --type=service --state=running --no-legend --no-pager --plain 2>/dev/null | head -60); echo '---P'; " +
+        "(ps -eo comm= --sort=-%cpu 2>/dev/null | head -12)"
+
+    private val BORING = Regex("^(systemd.*|dbus.*|cron|crond|rsyslog|ssh|sshd|getty@.*|serial-getty@.*|polkit|unattended-upgrades|" +
+        "networkd-dispatcher|snapd.*|multipathd|irqbalance|udisks2|accounts-daemon|chrony.*|ntp.*|qemu-guest-agent|cloud-.*|atd|" +
+        "user@.*|ModemManager|packagekit|thermald|upower|wpa_supplicant|NetworkManager|containerd|docker|aliyun.*|AssistDaemon|" +
+        "tuned|firewalld|auditd|lvm2.*|blk-availability|kdump|irqbalance|ksm.*|gssproxy|rpcbind|postfix|exim4|fwupd|apport|" +
+        "haveged|google.*|walinuxagent|hv-.*|vmtoolsd|open-vm-tools|tailscaled|fail2ban|iscsid|lxcfs|php.*-fpm)\\.service$", RegexOption.IGNORE_CASE)
+
+    /**
+     * The probe's output → short lines: 「端口 8090 · python3」, 「容器 mines-link（nginx:alpine）」, 「服务 hermes」.
+     * Ports on 22 / 53 (sshd / resolver) and stock system services are left out.
+     */
+    fun parseRunning(out: String): List<String> {
+        val res = LinkedHashSet<String>()
+        var sec = "L"
+        for (raw in out.lines()) {
+            val line = raw.trim()
+            when (line) { "---D" -> { sec = "D"; continue }; "---S" -> { sec = "S"; continue }; "---P" -> { sec = "P"; continue } }
+            if (line.isBlank()) continue
+            when (sec) {
+                "L" -> {
+                    val cols = line.split(Regex("\\s+"))
+                    val local = cols.firstOrNull { Regex(":(\\d+)$").containsMatchIn(it) && (it.contains('.') || it.contains('*') || it.contains('[') || it.startsWith("0")) } ?: continue
+                    val port = Regex(":(\\d+)$").find(local)?.groupValues?.get(1)?.toIntOrNull() ?: continue
+                    if (port == 22 || port == 53) continue
+                    if (local.startsWith("127.") || local.startsWith("[::1]")) continue
+                    val proc = Regex("users:\\(\\(\"([^\"]+)\"").find(line)?.groupValues?.get(1)
+                    res += "端口 $port" + (proc?.let { " · $it" } ?: "")
+                }
+                "D" -> {
+                    val p = line.split('|')
+                    if (p.size >= 2) res += "容器 ${p[0]}（${p[1].substringAfterLast('/').take(30)}）"
+                }
+                "S" -> {
+                    val unit = line.split(Regex("\\s+")).firstOrNull().orEmpty()
+                    if (unit.endsWith(".service") && !BORING.matches(unit)) res += "服务 " + unit.removeSuffix(".service")
+                }
+            }
+        }
+        return res.toList().take(24)
+    }
+
+    /** Re-read what runs at most every 30 min (the 工作位置 check runs every 90 s). */
+    fun runningStale(m: Meta?, now: Long): Boolean = m == null || now - m.runningAt > 30 * 60_000L
+
+    /** Card lines (order the user asked: provider / account, expiry, limits, cost, IP 归属地, vault). */
+    fun cardLines(m: Meta, now: Long): List<String> = listOfNotNull(
+        listOf(m.provider, m.account.takeIf { it.isNotBlank() }?.let { "账号 ${AccountsCore.maskPhone(it)}" }.orEmpty()).filter { it.isNotBlank() }.joinToString(" · ").ifBlank { null },
+        expiryText(m, now).ifBlank { null }?.let { "到期：$it" },
+        m.limits.ifBlank { null }?.let { "限制：$it" },
+        m.cost.ifBlank { null }?.let { "费用：$it" },
+        m.geo.ifBlank { null }?.let { "IP 归属地：$it" },
+        m.vaultRef.ifBlank { null }?.let { "凭据：在保险箱（$it）" },
+    )
+
+    // ---------------- JSON ----------------
+
+    fun toJson(m: Meta): JSONObject = JSONObject().put("id", m.id).put("kind", m.kind.id).put("name", m.name).put("host", m.host)
+        .put("provider", m.provider).put("account", m.account).put("expiresAt", m.expiresAt).put("limits", m.limits).put("cost", m.cost)
+        .put("vaultRef", m.vaultRef).put("sourceUrl", m.sourceUrl).put("geo", m.geo).put("running", JSONArray(m.running))
+        .put("runningAt", m.runningAt).put("notes", JSONArray(m.notes)).put("addedBy", m.addedBy).put("addedAt", m.addedAt)
+
+    fun fromJson(o: JSONObject): Meta {
+        fun list(k: String) = o.optJSONArray(k)?.let { a -> (0 until a.length()).map { a.optString(it) } }.orEmpty()
+        return Meta(o.optString("id"), Kind.of(o.optString("kind")), o.optString("name"), o.optString("host"), o.optString("provider"),
+            o.optString("account"), o.optLong("expiresAt"), o.optString("limits"), o.optString("cost"), o.optString("vaultRef"),
+            o.optString("sourceUrl"), o.optString("geo"), list("running"), o.optLong("runningAt"), list("notes"), o.optString("addedBy", "agent"), o.optLong("addedAt"))
+    }
+
+    fun listToJson(l: List<Meta>): String = JSONArray(l.map { toJson(it) }).toString()
+    fun listFromJson(s: String?): List<Meta> = runCatching { JSONArray(s ?: "[]").let { a -> (0 until a.length()).map { fromJson(a.getJSONObject(it)) } } }.getOrDefault(emptyList())
+}
