+        assertEquals("", LoginValueCore.cleanAccount("\\u0001\\u0001"))
+        assertEquals("", LoginValueCore.cleanAccount("\u0001\u0001"))
+        assertTrue(LoginValueCore.badAccount("\\u0001\\u0001"))
