+            Account("gmail", "deningyang740@gmail.com", "Gmail", "在 Mines 内登录", "gmail"),
+            Account("mail163", "qqq440681@163.com", "163", "授权码", "mail163"),
+            Account("mail163#2", "ds19910904@163.com", "163", "授权码", "mail163"),
+            Account("mail163#3", "icuy3d5n1@163.com", "163", "授权码", "mail163"),
+        )
+        val h = 3_600_000L
+        fun m(i: Int, a: Account, from: String, subj: String, text: String, ago: Long, unread: Boolean) =
+            Mail("fake$i", a.id, a.address, a.provider, from, "", subj, text, now - ago, unread, webUrl(a.address))
+        _accounts.value = accts
