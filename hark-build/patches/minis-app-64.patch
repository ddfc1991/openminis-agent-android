+        val base = baseFor(addr)
+        val id = PlusVault.accountsOf(base).firstOrNull { PlusVault.entries.value[it]?.account.equals(addr, true) } ?: PlusVault.newAccountId(base)
+        val kind = PlusVault.kind(id) ?: return@withContext "保存失败（找不到 $base）"
