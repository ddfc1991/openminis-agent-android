@@ -0,0 +1,57 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.File
+import java.util.concurrent.TimeUnit
+
+/**
+ * [Mines-38.9] Real site logos for 账号关联 / 应用代理 (user 2026-10-16: 「很多图标都没有，要把图标加上去」). Each site's icon
+ * is fetched once and kept on disk (files/favicons/<domain>.png): Google's favicon service (128 px), DuckDuckGo's, then
+ * the site's own apple-touch-icon / favicon.ico. A miss is remembered for 3 days; the UI shows a letter tile meanwhile.
+ */
+object Favicons {
+    private val mem = android.util.LruCache<String, Bitmap>(80)
+    private val locks = HashMap<String, Mutex>()
+    private val http by lazy { OkHttpClient.Builder().connectTimeout(6, TimeUnit.SECONDS).readTimeout(8, TimeUnit.SECONDS).followRedirects(true).build() }
+
+    fun domainOf(host: String): String = Keychain.root(host)
+
+    private fun dir(c: Context) = File(c.applicationContext.filesDir, "favicons").also { it.mkdirs() }
+
+    fun cached(host: String): Bitmap? = domainOf(host).takeIf { it.isNotBlank() }?.let { mem.get(it) }
+
+    suspend fun get(c: Context, host: String): Bitmap? = withContext(Dispatchers.IO) {
+        val d = domainOf(host); if (d.isBlank() || !d.contains('.')) return@withContext null
+        mem.get(d)?.let { return@withContext it }
+        val lock = synchronized(locks) { locks.getOrPut(d) { Mutex() } }
+        lock.withLock {
+            mem.get(d)?.let { return@withLock it }
+            val f = File(dir(c), "$d.png"); val miss = File(dir(c), "$d.none")
+            if (f.exists()) BitmapFactory.decodeFile(f.path)?.let { mem.put(d, it); return@withLock it }
+            if (miss.exists() && System.currentTimeMillis() - miss.lastModified() < 3 * 86_400_000L) return@withLock null
+            val urls = listOf("https://www.google.com/s2/favicons?domain=$d&sz=128", "https://icons.duckduckgo.com/ip3/$d.ico",
+                "https://$d/apple-touch-icon.png", "https://www.$d/apple-touch-icon.png", "https://$d/favicon.ico")
+            for (u in urls) {
+                val bmp = runCatching {
+                    http.newCall(Request.Builder().url(u).header("User-Agent", "Mozilla/5.0 (Linux; Android 14) Mines").build()).execute().use { r ->
+                        if (!r.isSuccessful) null else r.body?.bytes()?.let { b -> BitmapFactory.decodeByteArray(b, 0, b.size) }
+                    }
+                }.getOrNull()
+                if (bmp != null && bmp.width >= 16 && bmp.height >= 16) {
+                    runCatching { f.outputStream().use { bmp.compress(Bitmap.CompressFormat.PNG, 100, it) } }
+                    mem.put(d, bmp); miss.delete(); return@withLock bmp
+                }
+            }
+            runCatching { miss.writeText("") ; miss.setLastModified(System.currentTimeMillis()) }
+            null
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/FeedRefresh.kt b/src/android/app/src/main/java/com/openminis/app/plus/FeedRefresh.kt
new file mode 100644
index 0000000..89968a0
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/FeedRefresh.kt
@@ -0,0 +1,116 @@
+package com.openminis.app.plus
+
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/**
+ * [Mines-38.9.2] 消息 pull-to-refresh, the parts that need no Android (unit-tested in FeedRefreshTest).
+ *
+ * User report on 38.9.1 (2026-10-17): 「消息没做好，下拉不更新」. Root causes in 38.9.1:
+ *  1. Digest.refresh() returned at once when a refresh was already running (`if (busy) return`). Opening the page
+ *     always starts one and it stayed "busy" through link previews + model headlines, so a pull in that window did nothing.
+ *  2. When it did run, every source came from a cache: mail 5 min, X 10 min, 微博/B站/知乎 10 min.
+ *  3. The spinner was a fake ≤4 s timer, not tied to the read; failures were swallowed (IMAP login refused → empty list).
+ *  4. Coming back to the page (ON_RESUME) did not refresh; 邮箱 tab had the same "busy → skip" bug.
+ * Now: a pull waits for a running refresh and then reads every source again with no cache ([Gate], [Mode.PULL]),
+ * the spinner lasts exactly as long as that read, new cards go to the top, and one short Chinese line says what happened.
+ */
+object FeedRefresh {
+    /** BACKGROUND = patrol / home card (skips when one is running, caches allowed); OPEN = page opened or resumed;
+     *  PULL = the user pulled down (waits for a running one, then no cache at all). */
+    enum class Mode { BACKGROUND, OPEN, PULL }
+
+    /** How old a source's cached read may be for this refresh. */
+    fun maxAgeMs(mode: Mode, background: Long): Long = when (mode) {
+        Mode.PULL -> 0L
+        Mode.OPEN -> minOf(background, 60_000L)
+        Mode.BACKGROUND -> background
+    }
+
+    /** What one refresh found: ids of cards that were not there before, and one plain line per source that failed. */
+    data class Outcome(val fresh: List<String>, val fails: List<String>)
+
+    /** Cards that are new since [before]. On the very first load (nothing shown yet) nothing counts as new unless [countAll]. */
+    fun freshIds(before: Set<String>, after: List<String>, countAll: Boolean): List<String> =
+        if (before.isEmpty() && !countAll) emptyList() else after.filter { it !in before }.distinct()
+
+    /** The short line under the tabs after a pull: 「新到 3 条」 / 「没有新消息」 / + 「163 授权码失效」 per failed source. */
+    fun line(o: Outcome?): String {
+        if (o == null) return "没有新消息"
+        val head = if (o.fresh.isNotEmpty()) "新到 ${o.fresh.size} 条" else "没有新消息"
+        val f = o.fails.map { it.trim() }.filter { it.isNotEmpty() }.distinct()
+        if (f.isEmpty()) return head
+        val shown = f.take(2).joinToString("；") + (if (f.size > 2) " 等 ${f.size} 处没读到" else "")
+        return "$head · $shown"
+    }
+
+    /** Pinned cards first, then the cards that just arrived (in their score order), then the rest (stable). */
+    fun <T> freshFirst(list: List<T>, fresh: Set<String>, id: (T) -> String, pinned: (T) -> Boolean): List<T> {
+        if (fresh.isEmpty()) return list
+        val (p, rest) = list.partition(pinned)
+        val (n, old) = rest.partition { id(it) in fresh }
+        return p + n + old
+    }
+
+    /** The mailbox as the user knows it: 「163」「QQ 邮箱」「Gmail」…, with the start of the address when they have several there. */
+    fun mailLabel(address: String, many: Boolean = false): String {
+        val d = address.substringAfter('@', "").lowercase()
+        val p = when {
+            d == "gmail.com" || d == "googlemail.com" -> "Gmail"
+            d == "163.com" || d == "vip.163.com" -> "163"
+            d == "126.com" -> "126"
+            d == "yeah.net" -> "yeah"
+            d == "qq.com" || d == "foxmail.com" || d == "vip.qq.com" -> "QQ 邮箱"
+            d.contains("outlook") || d.contains("hotmail") || d == "live.com" -> "Outlook"
+            d == "sina.com" || d == "sina.cn" -> "新浪邮箱"
+            d.endsWith("aliyun.com") -> "阿里邮箱"
+            else -> d.substringBefore('.').ifBlank { "邮箱" }
+        }
+        return if (many) "$p ${address.substringBefore('@').take(4)}…" else p
+    }
+
+    /** The mail server refused LOGIN (wrong / expired 授权码 or app password). */
+    class LoginRejected(val server: String) : Exception(server)
+    /** A failure that already carries its plain line (e.g. 「Gmail 网页登录过期」). */
+    class SourceFail(val line: String) : Exception(line)
+
+    /** One plain line for a mailbox that could not be read. */
+    fun mailFail(label: String, t: Throwable?): String = when (t) {
+        null -> "$label 连接超时"
+        is SourceFail -> t.line
+        is LoginRejected -> when {
+            label.startsWith("Gmail") -> "$label 应用专用密码失效"
+            t.server.lowercase().contains("unsafe login") -> "$label 拦了登录（Unsafe Login）"
+            else -> "$label 授权码失效"
+        }
+        else -> netFail(label, t)
+    }
+
+    /** Network-ish failures of any source, in plain words. */
+    fun netFail(label: String, t: Throwable): String {
+        var e: Throwable? = t
+        while (e != null) {
+            when (e) {
+                is SourceFail -> return e.line
+                is java.net.SocketTimeoutException, is java.io.InterruptedIOException -> return "$label 连接超时"
+                is java.net.UnknownHostException, is java.net.ConnectException, is java.net.NoRouteToHostException -> return "$label 网络不通"
+                is javax.net.ssl.SSLException -> return "$label 加密连接失败"
+            }
+            e = e.cause
+        }
+        return "$label 暂时读不到"
+    }
+
+    /**
+     * Only one refresh at a time. A background caller skips when one is running (returns null); a pull or a page
+     * open waits for the running one to end and then runs its own read — so it never silently does nothing.
+     */
+    class Gate {
+        private val mutex = Mutex()
+        val running: Boolean get() = mutex.isLocked
+        suspend fun <T> run(waitIfBusy: Boolean, block: suspend () -> T): T? {
+            if (!waitIfBusy && mutex.isLocked) return null
+            return mutex.withLock { block() }
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/FreeRouteCore.kt b/src/android/app/src/main/java/com/openminis/app/plus/FreeRouteCore.kt
new file mode 100644
index 0000000..a1aa92a
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/FreeRouteCore.kt
@@ -0,0 +1,60 @@
+package com.openminis.app.plus
+
+/**
+ * [Mines-38.9.8] 「免登录 AI（Mines）」 in 模型组 (user 2026-10-19 「这些免登陆的，用不了啊」): the routes it lists (扣子 bots,
+ * web-chat bridges 豆包 / 元宝 / Kimi / DeepSeek / 通义 / 智谱清言 / Gemini / Hark …) were listed as soon as a sign-in cookie
+ * existed — never actually called. Now each route is called for real (one tiny chat, time-limited); a route that does not
+ * answer is hidden from the gateway's model list until a later test passes (user rule: nothing that cannot run is shown),
+ * with its reason kept for 自检 / the 免登录 AI card. Also: two routes with the same name (two bots both called
+ * 「Mines-Test」) get the end of their id appended so they can be told apart. Pure, unit-tested in FreeRouteCoreTest.
+ */
+object FreeRouteCore {
+    const val TEST_PROMPT = "只回复两个字母：OK"
+    const val TEST_TIMEOUT_MS = 45_000L
+    const val CHAT_TIMEOUT_MS = 90_000L
+    const val RETEST_MS = 12 * 3_600_000L
+
+    data class Live(val id: String, val ok: Boolean, val reason: String, val at: Long, val ms: Long = 0)
+
+    /** A reply counts when it has any visible text (the routes are chat pages; they may not obey 「OK」 exactly). */
+    fun answered(reply: String?): Boolean = !reply.isNullOrBlank() && reply.trim().length in 1..4000 && !Regex("^(error|错误|出错)", RegexOption.IGNORE_CASE).containsMatchIn(reply.trim())
+
+    /** Shown in the gateway's /v1/models: never tested yet, or the last test passed. */
+    fun visible(id: String, live: Map<String, Live>): Boolean = live[id]?.ok ?: true
+
+    fun needsTest(id: String, live: Map<String, Live>, now: Long): Boolean = live[id]?.let { now - it.at > RETEST_MS } ?: true
+
+    fun timeoutReason(ms: Long) = "${ms / 1000} 秒没有回复，已停止（网页没打开或要重新登录）"
+
+    /** One 自检 line: 「能用 5 个：豆包、Kimi…；已隐藏 2 个：元宝（45 秒没有回复…）…」. */
+    fun summary(names: Map<String, String>, live: Map<String, Live>): Pair<Boolean, String> {
+        val tested = names.keys.filter { live.containsKey(it) }
+        val ok = tested.filter { live[it]!!.ok }
+        val dead = tested.filter { !live[it]!!.ok }
+        val untested = names.keys.filter { !live.containsKey(it) }
+        if (names.isEmpty()) return true to "没有免登录路线（没登录任何网页版 / 扣子）"
+        val sb = StringBuilder()
+        if (ok.isNotEmpty()) sb.append("能用 ${ok.size} 个：").append(ok.joinToString("、") { names[it] ?: it })
+        if (dead.isNotEmpty()) { if (sb.isNotEmpty()) sb.append("；"); sb.append("已隐藏 ${dead.size} 个：").append(dead.joinToString("、") { "${names[it] ?: it}（${live[it]!!.reason.take(40)}）" }) }
+        if (untested.isNotEmpty()) { if (sb.isNotEmpty()) sb.append("；"); sb.append("没测 ${untested.size} 个") }
+        return (dead.isEmpty()) to sb.toString()
+    }
+
+    /**
+     * Display names that can be told apart: a name used by more than one id gets " · " + the last 4 characters of the
+     * id's own part (coze:7696936574432591908 → 「Mines-Test · 1908」); unique names stay as they are.
+     */
+    fun distinctNames(items: List<Pair<String, String>>): Map<String, String> {
+        val dup = items.groupBy { it.second.trim() }.filter { it.value.map { p -> p.first }.distinct().size > 1 }.keys
+        val out = LinkedHashMap<String, String>()
+        for ((id, name) in items) {
+            if (name.trim() !in dup) { out[id] = name; continue }
+            val tail = id.substringAfterLast(':').substringAfterLast('/').substringAfterLast('#').filter { it.isLetterOrDigit() }.takeLast(4)
+            out[id] = if (tail.isBlank()) name else "$name · $tail"
+        }
+        // still equal (same tail) → use 6 characters
+        val again = out.entries.groupBy { it.value }.filter { it.value.size > 1 }
+        for ((_, es) in again) es.forEach { e -> out[e.key] = items.first { it.first == e.key }.second + " · " + e.key.filter { it.isLetterOrDigit() }.takeLast(6) }
+        return out
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/FreeRoutes.kt b/src/android/app/src/main/java/com/openminis/app/plus/FreeRoutes.kt
new file mode 100644
index 0000000..a7ecdfd
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/FreeRoutes.kt
@@ -0,0 +1,84 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import com.openminis.app.MinisApp
+import com.openminis.app.plus.group.AiClient
+import com.openminis.app.plus.group.Partner
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.withTimeoutOrNull
+import org.json.JSONObject
+
+/**
+ * [Mines-38.9.8] Live test of every 「免登录 AI（Mines）」 route (see [FreeRouteCore]): one tiny real chat per route,
+ * time-limited, sequential (web routes share the phone's WebView). Results persist; a route that does not answer is left
+ * out of the gateway's /v1/models (so 模型组 stops offering it) until a later test passes. Runs ≤ once per 12 h per route
+ * at launch, and on demand from 自检.
+ */
+object FreeRoutes {
+    private const val PREFS = "mines_free_routes"
+    private val _live = MutableStateFlow<Map<String, FreeRouteCore.Live>>(emptyMap())
+    val live: StateFlow<Map<String, FreeRouteCore.Live>> = _live.asStateFlow()
+    @Volatile private var loaded = false
+    @Volatile var testing: Boolean = false; private set
+
+    fun init(c: Context) {
+        if (loaded) return
+        loaded = true
+        runCatching {
+            val o = JSONObject(c.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString("live", "{}") ?: "{}")
+            _live.value = o.keys().asSequence().associateWith { k ->
+                val x = o.getJSONObject(k); FreeRouteCore.Live(k, x.optBoolean("ok"), x.optString("reason"), x.optLong("at"), x.optLong("ms"))
+            }
+        }
+    }
+
+    fun record(c: Context, l: FreeRouteCore.Live) {
+        init(c)
+        _live.value = _live.value + (l.id to l)
+        runCatching {
+            val o = JSONObject(); _live.value.values.forEach { v -> o.put(v.id, JSONObject().put("ok", v.ok).put("reason", v.reason).put("at", v.at).put("ms", v.ms)) }
+            c.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString("live", o.toString()).apply()
+        }
+    }
+
+    fun visible(c: Context, id: String): Boolean { init(c); return FreeRouteCore.visible(id, _live.value) }
+
+    /** One route, one tiny chat (≤ 45 s, detached so a stuck page can not hold the timeout). */
+    suspend fun testOne(c: Context, p: Partner): FreeRouteCore.Live {
+        val t0 = System.currentTimeMillis()
+        val call = CoroutineScope(Dispatchers.IO).async { runCatching { AiClient.reply(p, "", listOf(AiClient.Turn("user", FreeRouteCore.TEST_PROMPT)), 32) } }
+        val r = withTimeoutOrNull(FreeRouteCore.TEST_TIMEOUT_MS) { call.await() }
+        val ms = System.currentTimeMillis() - t0
+        val l = when {
+            r == null -> { call.cancel(); FreeRouteCore.Live(p.id, false, FreeRouteCore.timeoutReason(FreeRouteCore.TEST_TIMEOUT_MS), System.currentTimeMillis(), ms) }
+            r.isFailure -> FreeRouteCore.Live(p.id, false, ((r.exceptionOrNull() as? com.openminis.app.plus.group.MemberError)?.message ?: r.exceptionOrNull()?.message ?: "没有回复").take(80), System.currentTimeMillis(), ms)
+            FreeRouteCore.answered(r.getOrNull()?.text) -> FreeRouteCore.Live(p.id, true, "", System.currentTimeMillis(), ms)
+            else -> FreeRouteCore.Live(p.id, false, "回复是空的", System.currentTimeMillis(), ms)
+        }
+        record(c, l)
+        return l
+    }
+
+    /** Tests the routes that need it ([force] = all), then refreshes the gateway provider's model list. */
+    suspend fun testAll(c: Context, force: Boolean = false): Pair<Boolean, String> {
+        init(c)
+        if (testing) return true to "正在实测…"
+        testing = true
+        try {
+            val routes = PartnerGateway.readyRoutes(c)
+            val now = System.currentTimeMillis()
+            for (p in routes) if (force || FreeRouteCore.needsTest(p.id, _live.value, now)) testOne(c, p)
+            runCatching {
+                val repo = (c.applicationContext as? MinisApp)?.providerRepositoryOrNull
+                c.getSharedPreferences("mines_partner_gateway", Context.MODE_PRIVATE).getString("inst", null)?.let { repo?.triggerAsyncModelReconcile(it, forceRefresh = true) }
+            }
+            val names = routes.associate { it.id to it.spec.name }
+            return FreeRouteCore.summary(names, _live.value.filterKeys { it in names })
+        } finally { testing = false }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/GatewayTunnel.kt b/src/android/app/src/main/java/com/openminis/app/plus/GatewayTunnel.kt
