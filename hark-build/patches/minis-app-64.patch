+                modifier = Modifier.fillMaxWidth().semantics { contentDescription = hint })
+        }
+        if (query.isNotEmpty()) Text("取消", fontSize = MT.Body, color = m.primaryText, modifier = Modifier.clickable { onChange("") }.padding(4.dp))
+    }
