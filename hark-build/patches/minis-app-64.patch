+        assertEquals(Triple("", "weather", "1.0.1"), K.parse("skillhub:weather@1.0.1"))
+        assertNull(K.parse("local"))
+        assertEquals("bob/weather", K.rowKey("bob", "weather")); assertEquals("weather", K.rowKey("", "weather"))
+    }
+}
