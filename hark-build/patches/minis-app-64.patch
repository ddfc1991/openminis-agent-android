+                if (Relogin.recheck(c, root, force = true) == true) return@runCatching ToolExecutionResult("$site 已登录" + (acct?.let { "（${AccountsCore.maskPhone(it.identity)}）" } ?: "") + "：用 browser 直接打开，会话是共享的", true)
