index 0000000..a4ab0fc
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/WeatherSkyCore.kt
@@ -0,0 +1,157 @@
+package com.openminis.app.plus
+
+/**
+ * [Mines-38.9.9 sky v6] photo skies (graded camera stills + slow Ken Burns + procedural overlay) replace the v5 AGSL sky.
+ * [Mines-38.9.6 i14] Weather background v5 (user-approved 2026-10-18 「可以了就这样」): pure part — which scene, the shader
+ * parameters per scene (skybg/v5 README tables), and the theme veil that keeps text ≥ 4.5:1. No Android imports (unit-tested).
+ */
+object WeatherSkyCore {
+    enum class Scene(val id: Int, val key: String, val zh: String) {
+        SUNNY(0, "sunny", "晴"), CLOUDY(1, "cloudy", "多云"), RAIN(2, "rain", "雨"), SNOW(3, "snow", "雪"),
+        FOG(4, "fog", "雾"), NIGHT(5, "night", "夜"), SUNSET(6, "sunset", "日落"),
+        /** [Mines-38.9.9] 阴 (WMO 3): the grey cloud sky; 多云 (WMO 1-2) is now blue sky + clouds */
+        OVERCAST(7, "overcast", "阴");
+        /** the branch of sky.agsl's overlay that draws this scene ([Mines-38.9.9 sky v6]: every scene its own) */
+        val shaderId: Int get() = id
+        /** the scene's own palette is dark (UI column of the README) */
+        val darkSky: Boolean get() = this == RAIN || this == NIGHT || this == SUNSET
+        /** pass 2 (full-res particles) only here */
+        val particles: Boolean get() = this == RAIN || this == SNOW || this == NIGHT
+        companion object { fun of(k: String?): Scene? = values().firstOrNull { it.key == k || it.zh == k } }
+    }
+
+    /** particle overlay loop (rain / snow / stars; cells shift by whole cells per loop → seamless) */
+    const val LOOP_S = 24f
+    /** [Mines-38.9.9 sky v6] atmosphere overlay (wisps / mist bands / glare) loop — long, so no visible repeat */
+    const val OVERLAY_LOOP_S = 600f
+    /** frame cap while live; battery saver drops to [SLOW_FPS]; reduce motion = one still frame */
+    const val FPS = 20
+    const val SLOW_FPS = 4
+    /** crossfade when the weather / time changes */
+    const val FADE_MS = 1500L
+    /** [Mines-38.9.9 sky v6] one 「shot」 (photo + slow Ken Burns path) lasts a slot; the next shot cross-fades in over XFADE */
+    const val SLOT_MS = 240_000L
+    const val XFADE_MS = 20_000L
+
+    fun isRain(code: Int) = code in 51..67 || code in 80..82 || code in 95..99
+    fun isSnow(code: Int) = code in 71..77 || code == 85 || code == 86
+    fun isFog(code: Int) = code == 45 || code == 48
+
+    /**
+     * Scene from the current WMO weather code (open-meteo, null = no fresh weather) and the time of day.
+     * Weather that shows at any hour (rain / snow / fog) wins; a clear or cloudy sky becomes 夜 at night and 日落 in the hour
+     * or so before dark. [Mines-38.9.9] user: grey only for 阴 (WMO 3) and 雾 — 0 = 晴 (blue sky, sun rays), 1-2 = 多云 (blue
+     * sky + clouds), 3 = 阴. Without weather: a time-of-day clear sky (晴 by day, 日落 at dusk, 夜 at night), never grey.
+     */
+    fun pick(code: Int?, hour: Int, isDay: Boolean? = null): Scene {
+        val night = if (isDay != null) !isDay else (hour >= 19 || hour < 6)
+        val dusk = !night && hour in 17..18
+        if (code != null) {
+            if (isRain(code)) return Scene.RAIN
+            if (isSnow(code)) return Scene.SNOW
+            if (isFog(code)) return Scene.FOG
+        }
+        if (night) return Scene.NIGHT
+        if (dusk && (code == null || code in 0..2)) return Scene.SUNSET
+        return when (code) { null, 0 -> Scene.SUNNY; 1, 2 -> Scene.CLOUDY; else -> Scene.OVERCAST }
+    }
+
+    /** true only for the grey skies (阴 / 雾) */
+    fun isGrey(s: Scene): Boolean = s == Scene.OVERCAST || s == Scene.FOG
+
+    /** [Mines-38.9.9] chat page: extra veil of the page colour over the graded sky (long text on it) */
+    fun chatVeil(dark: Boolean): Float = if (dark) 0.18f else 0.42f
+    /** [i27] chat veil (alpha, rgb) per scene: light 夜 = a deeper quiet blue-grey #B8C2D0 @ 50 % instead of the warm paper
+     *  (read as flat grey over the night photo). Ink #2A1E1A on the result: ≥ 6.7:1 over both night photos (r3891/skyveil_i27). */
+    fun chatVeilColor(scene: Scene, dark: Boolean): Pair<Float, Int> = when {
+        dark -> 0.18f to 0x161114
+        scene == Scene.NIGHT -> 0.50f to 0xB8C2D0
+        else -> 0.42f to 0xF4EAE4
+    }
+
+    /**
+     * [Mines-38.9.9 sky v6] user 11:06–11:22 「太蓝了，要淡淡的…真实镜头…云层飘动…自然多变，不要固定动态」: each scene is a set of
+     * graded camera stills (assets/skybg/sky_*.webp, [WeatherSkyPhotos]); a shot = one photo + a slow Ken Burns path
+     * (start → end centre / zoom). A new shot is picked per [SLOT_MS] slot from the wall clock (same shot on every page),
+     * by a hash, so the order never repeats in a fixed loop.
+     */
+    class Shot(val photo: Int, val cx0: Float, val cy0: Float, val z0: Float, val cx1: Float, val cy1: Float, val z1: Float)
+
+    private fun h(x: Long, k: Int): Float {
+        var v = x * 6364136223846793005L + k * 1442695040888963407L
+        v = v xor (v ushr 33); v *= -0x00ae502812aa7333L; v = v xor (v ushr 33); v *= -0x3b314601e57a13adL; v = v xor (v ushr 33)
+        return ((v ushr 11).toDouble() / (1L shl 53).toDouble()).toFloat()
+    }
+
+    fun shot(sceneKey: String, slot: Long, photos: Int): Shot {
+        val seed = slot * 31 + sceneKey.hashCode()
+        val n = photos.coerceAtLeast(1)
+        // never the same photo twice in a row when there is a choice
+        val prev = (h(seed - 31, 1) * n).toInt().coerceAtMost(n - 1)
+        var p = (h(seed, 1) * n).toInt().coerceAtMost(n - 1)
+        if (n > 1 && p == prev) p = (p + 1) % n
+        val zoomIn = h(seed, 2) < 0.5f
+        val zLo = 1.06f + 0.04f * h(seed, 3); val zHi = zLo + 0.08f + 0.06f * h(seed, 4)
+        val dx = (if (h(seed, 5) < 0.5f) -1 else 1) * (0.08f + 0.10f * h(seed, 6))
+        val dy = (h(seed, 7) - 0.5f) * 0.08f
+        val cx = 0.5f + (h(seed, 8) - 0.5f) * 0.10f; val cy = 0.42f + (h(seed, 9) - 0.5f) * 0.10f
+        return Shot(p, cx - dx / 2, cy - dy / 2, if (zoomIn) zLo else zHi, cx + dx / 2, cy + dy / 2, if (zoomIn) zHi else zLo)
+    }
+
+    /** position along a shot: f in [0, 1] over SLOT + XFADE (ease in-out, so a shot never starts or stops with a jerk) */
+    fun along(s: Shot, f: Float): FloatArray {
+        val t = f.coerceIn(0f, 1f); val e = t * t * (3f - 2f * t)
+        return floatArrayOf(s.cx0 + (s.cx1 - s.cx0) * e, s.cy0 + (s.cy1 - s.cy0) * e, s.z0 + (s.z1 - s.z0) * e)
+    }
+
+    /**
+     * Source rectangle (image px: l, t, r, b) that covers a w×h view at zoom z (≥ 1 = cover) centred on (cx, cy) of the
+     * image, clamped inside the image.
+     */
+    fun srcRect(iw: Int, ih: Int, w: Float, h: Float, cx: Float, cy: Float, z: Float): FloatArray {
+        if (iw <= 0 || ih <= 0 || w <= 0f || h <= 0f) return floatArrayOf(0f, 0f, iw.toFloat(), ih.toFloat())
+        val s = maxOf(w / iw, h / ih) * z.coerceAtLeast(1f)
+        val vw = (w / s).coerceAtMost(iw.toFloat()); val vh = (h / s).coerceAtMost(ih.toFloat())
+        val l = (cx * iw - vw / 2).coerceIn(0f, iw - vw); val t = (cy * ih - vh / 2).coerceIn(0f, ih - vh)
+        return floatArrayOf(l, t, l + vw, t + vh)
+    }
+
+    /** gentle warmth by time of day (0 midday … 1 golden hour), applied as a tiny colour shift on the photo */
+    fun warmth(hour: Int, minute: Int): Float {
+        val x = hour + minute / 60f
+        return when {
+            x < 5f || x >= 20f -> 0f
+            x < 9f -> ((9f - x) / 4f).coerceIn(0f, 1f)
+            x >= 15f -> ((x - 15f) / 4f).coerceIn(0f, 1f)
+            else -> 0f
+        }
+    }
+
+    /** [i27] the sky frame loop keeps running only while something moves: live sky or a scene cross-fade */
+    fun keepLooping(fps: Int, fading: Boolean): Boolean = fps > 0 || fading
+
+    /** frames per second for the current power / motion state (0 = draw one still frame) */
+    fun fps(powerSave: Boolean, animOff: Boolean, forcedStatic: Boolean): Int = when {
+        animOff || forcedStatic -> 0
+        powerSave -> SLOW_FPS
+        else -> FPS
+    }
+
+    /** Why the procedural overlay (wisps / glare / rain / snow / stars) is off (null = on). Order matters only for the reported reason. */
+    fun staticReason(api: Int, powerSave: Boolean, animOff: Boolean, forcedStatic: Boolean, shaderError: String?): String? = when {
+        forcedStatic -> "forced"
+        api < 33 -> "api<33"
+        powerSave -> "battery saver"
+        animOff -> "reduce motion"
+        shaderError != null -> "shader error"
+        else -> null
+    }
+
+    /** Splits the bundled sky.agsl into (SKY, PARTICLES) sources at its //#PASS markers. */
+    fun split(src: String): Pair<String, String> {
+        val a = src.indexOf("//#SHARED"); val b = src.indexOf("//#PASS1"); val c = src.indexOf("//#PASS2")
+        require(a >= 0 && b > a && c > b) { "sky.agsl markers missing" }
+        val shared = src.substring(a, b)
+        return (shared + src.substring(b, c)) to (shared + src.substring(c))
+    }
+}
