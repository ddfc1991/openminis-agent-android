+package com.openminis.app.ui.plus
+
+import android.os.Build
+import androidx.compose.foundation.Canvas
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.setValue
+import androidx.compose.runtime.mutableFloatStateOf
+import androidx.compose.runtime.mutableLongStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.drawscope.drawIntoCanvas
+import androidx.compose.ui.graphics.nativeCanvas
+import androidx.compose.ui.platform.LocalContext
+import androidx.lifecycle.repeatOnLifecycle
+import com.openminis.app.plus.WeatherSkyCore
+import com.openminis.app.plus.WeatherSkyCore.Scene
+
+/**
+ * [Mines-38.9.6 i14] Weather background v5 (user-approved 2026-10-18 「可以了就这样」; mockups skybg/v5): a hazy, slowly flowing
+ * sky that shows the current weather + time of day behind the existing frosted glass (home and every page that used the
+ * 暖雾 fog). API 33+: two AGSL RuntimeShaders — SKY at quarter resolution into a RenderNode blurred there (RenderEffect 6 px)
+ * and scaled ×4, PARTICLES at full resolution only for rain / snow / night. 24 s loop, ≤ 30 fps, only while the app is
+ * RESUMED and nothing covers the page (overlay open / page scrolling → still). Static frame (assets/skybg/bg-<scene>.webp)
+ * below API 33, in battery saver, with animations off, when the shader fails to compile, or when switched off.
+ * A theme veil ([WeatherSkyCore.veil]) keeps the ink ≥ 4.5:1 on the bare background in light and dark.
+ */
+object WeatherSky {
+    /** smoke: force a scene (null = from the weather) and / or the static frame */
+    @Volatile var forced: Scene? = null
+    @Volatile var forceStatic: Boolean = false
+    /** smoke / 自检: what is drawn now */
+    @Volatile var lastScene: Scene = Scene.CLOUDY
+    @Volatile var lastMode: String = ""
+    @Volatile var shaderError: String? = null
+    @Volatile var frames: Long = 0
+    val tick = kotlinx.coroutines.flow.MutableStateFlow(0)
+    fun bump() { tick.value++ }
+
+    fun enabled(c: android.content.Context): Boolean = c.getSharedPreferences("mines_sky", 0).getBoolean("on", true)
+    fun setEnabled(c: android.content.Context, on: Boolean) { c.getSharedPreferences("mines_sky", 0).edit().putBoolean("on", on).apply(); bump() }
+
+    /** the current scene: forced (smoke) › HomeGreeting override (smoke) › cached weather + is_day › time-only default */
+    fun scene(c: android.content.Context): Scene {
+        forced?.let { return it }
+        val o = com.openminis.app.plus.HomeGreeting.override
+        val hour = o?.optInt("hour", -1)?.takeIf { it >= 0 } ?: java.util.Calendar.getInstance().get(java.util.Calendar.HOUR_OF_DAY)
+        val w = runCatching { com.openminis.app.plus.HomeGreeting.weatherNow(c) }.getOrNull()
+        val day = if (o != null && o.has("hour")) null else runCatching { com.openminis.app.plus.HomeGreeting.isDayNow(c) }.getOrNull()
+        return WeatherSkyCore.pick(w?.code, hour, day)
+    }
+
+    private var src: Pair<String, String>? = null
+    fun sources(c: android.content.Context): Pair<String, String> = src ?: WeatherSkyCore.split(
+        c.assets.open("skybg/sky.agsl").bufferedReader().use { it.readText() }).also { src = it }
+
+    private val bitmaps = HashMap<Scene, android.graphics.Bitmap>()
+    fun still(c: android.content.Context, s: Scene): android.graphics.Bitmap? = bitmaps[s] ?: runCatching {
+        c.assets.open("skybg/bg-${s.key}.webp").use { android.graphics.BitmapFactory.decodeStream(it) }
+    }.getOrNull()?.also { bitmaps[s] = it }
+
+    /** Builds both shaders once; a compile error is kept (→ static frame) and reported by the 自检 / smoke. */
+    @androidx.annotation.RequiresApi(33)
+    class Shaders(c: android.content.Context) {
+        val sky: android.graphics.RuntimeShader
+        val particles: android.graphics.RuntimeShader
+        init { val (a, b) = sources(c); sky = android.graphics.RuntimeShader(a); particles = android.graphics.RuntimeShader(b) }
+
+        fun set(sh: android.graphics.RuntimeShader, s: Scene, w: Float, h: Float, t: Float) {
+            val p = WeatherSkyCore.params(s)
+            fun f(n: String, vararg v: Float) = runCatching { sh.setFloatUniform(n, v) }
+            fun col(n: String, rgb: Int) = f(n, ((rgb shr 16) and 255) / 255f, ((rgb shr 8) and 255) / 255f, (rgb and 255) / 255f)
+            f("iResolution", w, h); f("iTime", t); f("LOOP", WeatherSkyCore.LOOP_S); f("scene", s.id.toFloat())
+            col("cTop", p.cTop); col("cBot", p.cBot); col("cM0", p.cM[0]); col("cM1", p.cM[1]); col("cM2", p.cM[2]); col("cM3", p.cM[3])
+            f("mistK", p.mistK); f("texK", p.texK); col("cVeil", p.veil); f("veilA", p.veilA)
+            col("cE0", p.cE0); col("cE1", p.cE1); col("cE2", p.cE2)
+            f("kE0", p.kE[0]); f("kE1", p.kE[1]); f("kE2", p.kE[2]); f("kE3", p.kE[3])
+            f("sunPos", p.sun[0], p.sun[1]); f("motion", 1f)
+        }
+    }
+    @Volatile private var shaders: Any? = null
+    fun shadersOrNull(c: android.content.Context): Any? {
+        if (Build.VERSION.SDK_INT < 33 || shaderError != null) return null
+        shaders?.let { return it }
+        return runCatching { Shaders(c) }.onFailure { shaderError = (it.message ?: it.javaClass.simpleName).take(300) }.getOrNull()?.also { shaders = it }
+    }
+}
+
+@Composable
+fun WeatherSkyBackdrop(modifier: Modifier = Modifier) {
+    val ctx = LocalContext.current
+    val m = mines()
+    val gTick by com.openminis.app.plus.HomeGreeting.tick.collectAsState()
+    val sTick by WeatherSky.tick.collectAsState()
+    val scene = remember(gTick, sTick) { WeatherSky.scene(ctx) }
+    // crossfade from the previous scene over 1.5 s
+    var prev by remember { mutableStateOf<Scene?>(null) }
+    var cur by remember { mutableStateOf(scene) }
+    val fadeStart = remember { mutableLongStateOf(0L) }
+    if (scene != cur) { prev = cur; cur = scene; fadeStart.longValue = System.currentTimeMillis() }
+    val powerSave = remember(sTick) { runCatching { (ctx.getSystemService(android.content.Context.POWER_SERVICE) as android.os.PowerManager).isPowerSaveMode }.getOrDefault(false) }
+    val animOff = remember(sTick) { AnimeWeather.still(ctx) }
+    val shaders = remember(sTick) { if (WeatherSky.forceStatic) null else WeatherSky.shadersOrNull(ctx) }
+    val reason = WeatherSkyCore.staticReason(Build.VERSION.SDK_INT, powerSave, animOff, WeatherSky.forceStatic, WeatherSky.shaderError.takeIf { shaders == null })
+    WeatherSky.lastScene = cur
+    WeatherSky.lastMode = reason?.let { "static: $it" } ?: "shader"
+    val time = remember { mutableFloatStateOf(2f) }
+    val owner = androidx.lifecycle.compose.LocalLifecycleOwner.current
+    val fading = prev != null
+    if (reason == null || fading) LaunchedEffect(owner, reason) {
+        owner.lifecycle.repeatOnLifecycle(androidx.lifecycle.Lifecycle.State.RESUMED) {
+            var last = 0L; var base = 0L
+            while (true) androidx.compose.runtime.withFrameMillis { now ->
+                if (base == 0L) base = now - (time.floatValue * 1000).toLong()
+                // ≤ 30 fps; still while an overlay is open (page blurred) or a page is being scrolled
+                val held = System.currentTimeMillis() < FogClock.holdUntil
+                if (now - last >= 1000L / WeatherSkyCore.FPS) {
+                    last = now
+                    if (held) base += 1000L / WeatherSkyCore.FPS
+                    else if (reason == null) time.floatValue = ((now - base) / 1000f) % WeatherSkyCore.LOOP_S
+                    if (prev != null && System.currentTimeMillis() - fadeStart.longValue > WeatherSkyCore.FADE_MS) prev = null
+                    else if (prev != null) time.floatValue = time.floatValue + 0.0001f   // redraw during the crossfade
+                }
+            }
+        }
+    }
+    val dark = m.dark
+    val grain = remember { skyGrain() }
+    val paint = remember { android.graphics.Paint(android.graphics.Paint.FILTER_BITMAP_FLAG or android.graphics.Paint.DITHER_FLAG) }
+    val nodes = remember { arrayOfNulls<Any>(2) }
+    Box(modifier) {
+        Canvas(Modifier.fillMaxSize()) {
+            val t = time.floatValue
+            WeatherSky.frames++
+            val w = size.width; val h = size.height
+            drawIntoCanvas { cv ->
+                val nc = cv.nativeCanvas
+                val fadeK = prev?.let { ((System.currentTimeMillis() - fadeStart.longValue).toFloat() / WeatherSkyCore.FADE_MS).coerceIn(0f, 1f) } ?: 1f
+                fun layer(s: Scene, alpha: Float, slot: Int) {
+                    val sh = shaders
+                    val live = reason == null && sh != null && Build.VERSION.SDK_INT >= 33 && nc.isHardwareAccelerated
+                    if (live) drawLive(nc, sh as WeatherSky.Shaders, s, w, h, t, alpha, nodes, slot)
+                    else WeatherSky.still(ctx, s)?.let { b ->
+                        val sc = maxOf(w / b.width, h / b.height)
+                        val dw = b.width * sc; val dh = b.height * sc
+                        paint.alpha = (255 * alpha).toInt()
+                        nc.drawBitmap(b, null, android.graphics.RectF((w - dw) / 2, (h - dh) / 2, (w + dw) / 2, (h + dh) / 2), paint)
+                        paint.alpha = 255
+                    }
+                    // theme veil (contrast ≥ 4.5:1 for the ink on the bare sky)
+                    val v = WeatherSkyCore.veil(s, dark)
+                    if (v > 0f) nc.drawColor(android.graphics.Color.argb((255 * v * alpha).toInt(), if (dark) 0x16 else 0xF4, if (dark) 0x11 else 0xEA, if (dark) 0x14 else 0xE4))
+                }
+                val p = prev
+                if (p != null && fadeK < 1f) { layer(p, 1f, 1); layer(cur, fadeK, 0) } else layer(cur, 1f, 0)
+                // static grain at ~1 %
+                paint.shader = android.graphics.BitmapShader(grain, android.graphics.Shader.TileMode.REPEAT, android.graphics.Shader.TileMode.REPEAT)
+                paint.alpha = 6; nc.drawRect(0f, 0f, w, h, paint); paint.alpha = 255; paint.shader = null
+            }
+        }
+    }
+}
+
+@androidx.annotation.RequiresApi(33)
+private fun drawLive(nc: android.graphics.Canvas, sh: WeatherSky.Shaders, s: Scene, w: Float, h: Float, t: Float, alpha: Float, nodes: Array<Any?>, slot: Int) {
+    // PASS 1: quarter-res sky into a RenderNode, blurred there, drawn ×4
+    val qw = kotlin.math.ceil(w / 4f).toInt().coerceAtLeast(1); val qh = kotlin.math.ceil(h / 4f).toInt().coerceAtLeast(1)
+    val node = (nodes[slot] as? android.graphics.RenderNode) ?: android.graphics.RenderNode("mines-sky-$slot").also {
+        it.setRenderEffect(android.graphics.RenderEffect.createBlurEffect(6f, 6f, android.graphics.Shader.TileMode.CLAMP)); nodes[slot] = it
+    }
+    node.setPosition(0, 0, qw, qh)
+    node.alpha = alpha
+    sh.set(sh.sky, s, qw.toFloat(), qh.toFloat(), t)
+    val rc = node.beginRecording(qw, qh)
+    try { rc.drawPaint(android.graphics.Paint().apply { shader = sh.sky }) } finally { node.endRecording() }
+    nc.save(); nc.scale(w / qw, h / qh); nc.drawRenderNode(node); nc.restore()
+    // PASS 2: full-res particles (rain / snow / night only)
+    if (s.particles) {
+        sh.set(sh.particles, s, w, h, t)
+        val p = android.graphics.Paint().apply { shader = sh.particles; this.alpha = (255 * alpha).toInt() }
+        nc.drawRect(0f, 0f, w, h, p)
+    }
+}
+
+/** 128 px monochrome noise tile (grain). */
+private fun skyGrain(): android.graphics.Bitmap {
+    val n = 128; val px = IntArray(n * n); val rnd = java.util.Random(11)
+    for (i in px.indices) { val v = 96 + rnd.nextInt(64); px[i] = android.graphics.Color.argb(255, v, v, v) }
+    return android.graphics.Bitmap.createBitmap(px, n, n, android.graphics.Bitmap.Config.ARGB_8888)
+}
