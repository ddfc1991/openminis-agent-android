+                else if (st != WebChat.PageState.LOADING && System.currentTimeMillis() - t0 > 8000) break
+            }
+            when (st) {
+                WebChat.PageState.VERIFY -> { drop(p.id); throw needsUser(name, if (Regex("age|年龄").containsMatchIn(text)) "年龄验证" else "人机验证 / 两步验证") }
