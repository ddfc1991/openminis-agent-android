+package com.openminis.app.plus
+
+import com.openminis.app.plus.WeatherSkyCore.Scene
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/** [Mines-38.9.6 i14 / 38.9.9 sky v6] weather sky: scene choice, photo shots (Ken Burns), grades, overlay-off reasons, AGSL rules. */
+class WeatherSkyCoreTest {
+    @Test fun scenes() {
+        assertEquals(Scene.SUNNY, WeatherSkyCore.pick(0, 11))
+        assertEquals(Scene.CLOUDY, WeatherSkyCore.pick(1, 11))
+        assertEquals(Scene.CLOUDY, WeatherSkyCore.pick(2, 11))
+        assertEquals(Scene.OVERCAST, WeatherSkyCore.pick(3, 11))
+        assertEquals(Scene.RAIN, WeatherSkyCore.pick(61, 23))
+        assertEquals(Scene.RAIN, WeatherSkyCore.pick(95, 12))
+        assertEquals(Scene.SNOW, WeatherSkyCore.pick(73, 9))
+        assertEquals(Scene.FOG, WeatherSkyCore.pick(45, 2))
+        assertEquals(Scene.NIGHT, WeatherSkyCore.pick(0, 23))
+        assertEquals(Scene.NIGHT, WeatherSkyCore.pick(1, 12, isDay = false))
+        assertEquals(Scene.SUNSET, WeatherSkyCore.pick(1, 18))
+        // no weather: time-of-day clear sky, never grey (38.9.9)
+        assertEquals(Scene.SUNNY, WeatherSkyCore.pick(null, 10))
+        for (h in 0..23) assertTrue(!WeatherSkyCore.isGrey(WeatherSkyCore.pick(null, h)))
+        assertTrue(WeatherSkyCore.isGrey(Scene.OVERCAST) && WeatherSkyCore.isGrey(Scene.FOG) && !WeatherSkyCore.isGrey(Scene.CLOUDY))
+        assertEquals(7, Scene.OVERCAST.shaderId)
+        assertEquals(Scene.NIGHT, WeatherSkyCore.pick(null, 2))
+        assertEquals(Scene.SUNSET, WeatherSkyCore.pick(null, 17))
+    }
+
+    @Test fun shotsVaryWithoutFixedLoop() {
+        val a = WeatherSkyCore.shot("sunny", 1000L, 2); val b = WeatherSkyCore.shot("sunny", 1000L, 2)
+        assertEquals(a.photo, b.photo); assertEquals(a.cx0, b.cx0, 0f)              // same slot → same shot on every page
+        val seq = (0L until 40L).map { WeatherSkyCore.shot("sunny", 5000L + it, 2) }
+        for (i in 1 until seq.size) assertTrue("no photo twice in a row", seq[i].photo != seq[i - 1].photo || seq[i].cx0 != seq[i - 1].cx0)
+        assertTrue("paths differ", seq.map { "%.3f".format(it.cx0) }.toSet().size > 30)
+        for (s in seq) { assertTrue(s.z0 >= 1.06f && s.z1 >= 1.06f && s.z0 <= 1.3f && s.z1 <= 1.3f); assertTrue(kotlin.math.abs(s.cx1 - s.cx0) >= 0.08f) }
+        val one = WeatherSkyCore.shot("snow", 7L, 1); assertEquals(0, one.photo)
+    }
+
+    @Test fun kenBurnsStaysInsideThePhoto() {
+        for (slot in 0L until 50L) {
+            val s = WeatherSkyCore.shot("rain", slot, 2)
+            for (f in listOf(0f, 0.3f, 0.7f, 1f, 1.2f)) {
+                val (cx, cy, z) = WeatherSkyCore.along(s, f).let { Triple(it[0], it[1], it[2]) }
+                val r = WeatherSkyCore.srcRect(704, 1520, 1080f, 2412f, cx, cy, z)
+                assertTrue(r[0] >= 0f && r[1] >= 0f && r[2] <= 704f && r[3] <= 1520f && r[2] > r[0] && r[3] > r[1])
+                assertEquals(1080f / 2412f, (r[2] - r[0]) / (r[3] - r[1]), 0.01f)          // aspect kept (no stretch)
+            }
+        }
+        val s = WeatherSkyCore.shot("fog", 3L, 2)
+        assertEquals(s.cx0, WeatherSkyCore.along(s, 0f)[0], 1e-5f); assertEquals(s.cx1, WeatherSkyCore.along(s, 1f)[0], 1e-5f)
+    }
+
+    @Test fun motionAndWarmth() {
+        assertEquals(WeatherSkyCore.FPS, WeatherSkyCore.fps(false, false, false))
+        assertEquals(WeatherSkyCore.SLOW_FPS, WeatherSkyCore.fps(true, false, false))
+        assertEquals(0, WeatherSkyCore.fps(false, true, false)); assertEquals(0, WeatherSkyCore.fps(false, false, true))
+        assertEquals(0f, WeatherSkyCore.warmth(12, 0)); assertTrue(WeatherSkyCore.warmth(6, 30) > 0.5f); assertTrue(WeatherSkyCore.warmth(18, 0) > 0.5f)
+        assertEquals(0f, WeatherSkyCore.warmth(23, 0))
+        for (d in listOf(false, true)) assertTrue(WeatherSkyCore.chatVeil(d) >= 0.15f)
+    }
+
+    @Test fun everySceneHasGradedPhotos() {
+        val dir = File(listOf("src/main/assets", "app/src/main/assets").first { File(it).isDirectory })
+        for (sc in Scene.values()) {
+            val ps = WeatherSkyPhotos.byScene[sc.key]
+            assertTrue("photos for ${sc.key}", ps != null && ps.isNotEmpty())
+            for (p in ps!!) {
+                assertTrue(p.asset, File(dir, p.asset).isFile)
+                assertTrue(File(dir, p.asset).length() in 5_000L..300_000L)
+                assertTrue(p.lift in 0f..0.9f && p.darkMul in 0.1f..1f)
+            }
+            assertEquals(4, WeatherSkyPhotos.mist.getValue(sc.key).size)
+        }
+        val total = File(dir, "skybg").listFiles()!!.filter { it.name.endsWith(".webp") }.sumOf { it.length() }
+        assertTrue("sky photos ≤ 3 MB ($total)", total <= 3_000_000L)
+    }
+
+    @Test fun overcastIsNotFog() {
+        // [i27] offline sheet showed 阴 and 雾 identical: 阴 uses the overcast photo only, 雾 the fog photo only
+        assertEquals(listOf("skybg/sky_overcast.webp"), WeatherSkyPhotos.byScene.getValue("overcast").map { it.asset })
+        assertEquals(listOf("skybg/sky_fog.webp"), WeatherSkyPhotos.byScene.getValue("fog").map { it.asset })
+    }
+
+    @Test fun loopStopsWhenIdleAndNightVeilIsBlueGrey() {
+        assertTrue(WeatherSkyCore.keepLooping(20, false)); assertTrue(WeatherSkyCore.keepLooping(0, true))
+        assertTrue(!WeatherSkyCore.keepLooping(0, false))
+        val (a, rgb) = WeatherSkyCore.chatVeilColor(Scene.NIGHT, false)
+        assertEquals(0xB8C2D0, rgb); assertTrue(a in 0.4f..0.6f)
+        assertTrue((rgb and 255) > ((rgb shr 16) and 255))   // bluer than red: not the warm grey
+        assertEquals(0xF4EAE4, WeatherSkyCore.chatVeilColor(Scene.SUNNY, false).second)
+        assertEquals(0x161114, WeatherSkyCore.chatVeilColor(Scene.NIGHT, true).second)
+    }
+
+    @Test fun staticReasons() {
+        assertEquals("api<33", WeatherSkyCore.staticReason(31, false, false, false, null))
+        assertEquals("battery saver", WeatherSkyCore.staticReason(35, true, false, false, null))
+        assertEquals("reduce motion", WeatherSkyCore.staticReason(35, false, true, false, null))
+        assertEquals("shader error", WeatherSkyCore.staticReason(35, false, false, false, "x"))
+        assertEquals(null, WeatherSkyCore.staticReason(35, false, false, false, null))
+        assertEquals(24f, WeatherSkyCore.LOOP_S)
+    }
+
+    private fun agsl(): String = listOf("src/main/assets/skybg/sky.agsl", "app/src/main/assets/skybg/sky.agsl").map { File(it) }.first { it.isFile }.readText()
+
+    @Test fun agslFollowsSkSLLoopRules() {
+        val src = agsl()
+        val code = src.lines().map { it.substringBefore("//") }.joinToString("\n")
+        assertTrue("no continue / while / do", !Regex("""\b(continue|while|do)\b""").containsMatchIn(code))
+        val loops = Regex("""for\s*\(([^)]*)\)""").findAll(code).map { it.groupValues[1] }.toList()
+        assertTrue(loops.isNotEmpty())
+        loops.forEach { assertTrue("loop must be for (int i = 0; i < CONST; i++): $it", Regex("""^\s*int (\w+) = 0; \1 < \d+; \1\+\+\s*$""").matches(it)) }
+        assertTrue("no child shader", !code.contains("uniform shader"))
+        val (a, b) = WeatherSkyCore.split(src)
+        assertTrue(a.contains("return skyMain(p)") && !a.contains("particleMain"))
+        assertTrue(b.contains("return particleMain(p)") && !b.contains("half4 skyMain"))
+    }
+}
