+        val r = runCatching {
+            AiClient.reply(p, "你在帮 Mines 完成一件事。直接把结果写出来，中文，简洁；做不到就说做不到和原因。",
+                listOf(AiClient.Turn("user", task.take(6000))), maxTokens = 2000)
+        }
+        val ms = System.currentTimeMillis() - t0
