+                    else SmallPill("忽略") { LinkAll.setIgnored(id, true); changed() }
+                }, onClick = if (st == LinkAll.St.IGNORED) null else ({ LinkAll.autoLogin = false; LinkAll.open(id, go, auto = false) }))
+            }
