+@Composable
+fun PresetLoginDialog(p: Partner, onDismiss: () -> Unit, onDone: () -> Unit) {
+    when (PresetRegistry.loginFlowOf(p.id)) {
+        is LoginFlow.RelayCode -> RelayCodeDialog(onDismiss, onDone)
