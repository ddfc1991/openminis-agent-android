         val results = withContext(Dispatchers.IO) {
             servers.map { s -> async { s.id to (if (s.enabled) probe(s) else -1) } }.awaitAll()
         }.toMap()
+        // [Mines-server-card] A reachable box is worth describing: ask it what
+        // it is and where its traffic leaves, so the 工作位置 card can show
+        // 系统 / 出口 without the user opening a terminal. Runs only for the
+        // server that is actually online, and a failure leaves the previous
+        // values alone rather than blanking them.
+        val facts = HashMap<String, Pair<String, String>>()
+        val best = servers.filter { it.enabled && (results[it.id] ?: -1) >= 0 }
+            .minByOrNull { results[it.id] ?: Int.MAX_VALUE }
+        best?.let { s ->
