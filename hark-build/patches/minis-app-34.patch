+        }
         val now = System.currentTimeMillis()
         PlusPrefs.update(context) { st ->
             st.copy(servers = st.servers.map { s ->
                 val r = results[s.id] ?: return@map s
-                s.copy(lastLatencyMs = r, lastCheckedAt = now)
+                val f = facts[s.id]
+                if (f == null) s.copy(lastLatencyMs = r, lastCheckedAt = now)
