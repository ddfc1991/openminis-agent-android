+package com.openminis.app.plus
+
+import android.content.Context
+import android.content.SharedPreferences
+import com.openminis.app.MinisApp
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** A service the Connections page knows how to hold a credential for. */
+data class ConnectionKind(
+    val id: String,
+    val name: String,
+    val desc: String,
+    val color: Long,
+    val letter: String,
+    val accountLabel: String,
+    val secretLabel: String,
+    /** Env var the secret is exposed as (masked in transcripts by Minis' redactor). */
+    val envKey: String?,
+)
+
+data class ConnectionEntry(
+    val kindId: String,
+    val account: String,
+    val shareWithAi: Boolean,
+    val updatedAt: Long,
+)
+
+/**
+ * Account / credential vault behind the Connections page.
+ * Secrets are stored in Minis' existing AES-256-GCM EncryptedSharedPreferences
+ * (Android Keystore). The AI never reads the vault: when "交给 AI 使用" is on,
+ * the secret is injected into the sandbox as an env var, and Minis' env-var
+ * redactor masks the value in anything the model sees.
+ */
+object PlusVault {
+    val kinds: List<ConnectionKind> = listOf(
+        ConnectionKind("gemini", "Gemini", "实时语音、看图、长文本", 0xFF4285F4, "G", "备注", "API Key", "GEMINI_API_KEY"),
+        ConnectionKind("openai", "OpenAI", "GPT 模型与语音", 0xFF10A37F, "O", "备注", "API Key", "OPENAI_API_KEY"),
+        ConnectionKind("anthropic", "Claude", "Anthropic API", 0xFFD97757, "C", "备注", "API Key", "ANTHROPIC_API_KEY"),
+        ConnectionKind("github", "GitHub", "仓库、Actions、Release", 0xFF24292F, "GH", "用户名", "Token", "GITHUB_TOKEN"),
+        ConnectionKind("google", "Google", "Gmail、日历、云盘", 0xFFEA4335, "Go", "邮箱", "密码 / 应用专用密码", null),
+        ConnectionKind("cloudflare", "Cloudflare", "域名、DNS、Workers", 0xFFF38020, "CF", "邮箱", "API Token", "CLOUDFLARE_API_TOKEN"),
+        ConnectionKind("telegram", "Telegram 机器人", "消息推送与机器人", 0xFF229ED9, "TG", "Bot 名称", "Bot Token", "TELEGRAM_BOT_TOKEN"),
+        ConnectionKind("telegram_user", "Telegram 账号", "纸飞机个人账号（手机号登录）", 0xFF2AABEE, "飞", "手机号", "API Hash（my.telegram.org）", "TELEGRAM_API_HASH"),
+        ConnectionKind("feishu", "飞书", "飞书机器人与开放平台应用", 0xFF3370FF, "飞书", "App ID", "App Secret", "FEISHU_APP_SECRET"),
+        ConnectionKind("wechat", "微信", "个人微信账号（自动化登录用）", 0xFF07C160, "微", "微信号 / 手机号", "密码", null),
+        ConnectionKind("wecom", "企业微信", "企业微信群机器人", 0xFF2B7CE9, "企", "机器人名称", "Webhook Key", "WECOM_WEBHOOK_KEY"),
+        ConnectionKind("dingtalk", "钉钉", "钉钉群机器人", 0xFF0089FF, "钉", "机器人名称", "Access Token", "DINGTALK_TOKEN"),
+        ConnectionKind("qq", "QQ", "QQ 账号", 0xFF12B7F5, "Q", "QQ 号", "密码", null),
+        ConnectionKind("discord", "Discord", "服务器机器人", 0xFF5865F2, "D", "Bot 名称", "Bot Token", "DISCORD_BOT_TOKEN"),
+        ConnectionKind("x", "X / Twitter", "推特账号", 0xFF000000, "X", "用户名", "密码", null),
+        ConnectionKind("weibo", "微博", "微博账号", 0xFFE6162D, "博", "手机号 / 邮箱", "密码", null),
+        ConnectionKind("xiaohongshu", "小红书", "小红书账号", 0xFFFF2442, "红", "手机号", "密码", null),
+        ConnectionKind("douyin", "抖音", "抖音账号", 0xFF161823, "抖", "手机号", "密码", null),
+        ConnectionKind("bilibili", "哔哩哔哩", "B 站账号", 0xFFFB7299, "B站", "手机号 / 用户名", "密码", null),
+        ConnectionKind("youtube", "YouTube", "频道与视频", 0xFFFF0000, "YT", "Google 邮箱", "API Key", "YOUTUBE_API_KEY"),
+        ConnectionKind("okx", "OKX", "行情与交易（只读建议）", 0xFF000000, "OK", "API Key", "Secret", null),
+        ConnectionKind("binance", "Binance", "行情与交易（只读建议）", 0xFFF0B90B, "B", "API Key", "Secret", null),
+        ConnectionKind("custom", "其他账号", "任何网站的账号密码", 0xFF8E8E93, "+", "账号", "密码", null),
+    )
+
+    private const val META = "plus_vault_meta"
+    private const val SECRETS = "plus_vault_secrets"
+    private val _entries = MutableStateFlow<Map<String, ConnectionEntry>>(emptyMap())
+    val entries: StateFlow<Map<String, ConnectionEntry>> = _entries.asStateFlow()
+    @Volatile private var meta: SharedPreferences? = null
+    @Volatile private var secrets: SharedPreferences? = null
+
+    fun init(context: Context) {
+        if (meta != null) return
+        synchronized(this) {
+            if (meta != null) return
+            val ctx = context.applicationContext
+            val m = ctx.getSharedPreferences(META, Context.MODE_PRIVATE)
+            secrets = runCatching {
+                com.openminis.app.util.EncryptedPrefsFactory.safeCreate(ctx, SECRETS)
+            }.getOrNull()
+            meta = m
+            _entries.value = runCatching {
+                val arr = JSONArray(m.getString("entries", "[]"))
+                (0 until arr.length()).associate { i ->
+                    val o = arr.getJSONObject(i)
+                    val e = ConnectionEntry(o.getString("kind"), o.optString("account"),
+                        o.optBoolean("share", false), o.optLong("updated"))
+                    e.kindId to e
+                }
+            }.getOrDefault(emptyMap())
+        }
+    }
+
+    /** Raw secret, for in-app use only (e.g. the live-voice connection). Never shown in UI. */
+    fun secret(kindId: String): String? = secrets?.getString(kindId, null)?.takeIf { it.isNotBlank() }
+
+    fun extra(kindId: String, key: String): String? =
+        meta?.getString("extra_${kindId}_$key", null)?.takeIf { it.isNotBlank() }
+
+    fun setExtra(kindId: String, key: String, value: String) {
+        meta?.edit()?.putString("extra_${kindId}_$key", value.trim())?.apply()
+    }
+
+    fun hasSecret(kindId: String): Boolean = secrets?.contains(kindId) == true
+
+    /** Masked preview only — the UI never shows the full secret. */
+    fun preview(kindId: String): String {
+        val s = secrets?.getString(kindId, null) ?: return ""
+        return if (s.length <= 4) "••••" else "••••" + s.takeLast(4)
+    }
+
+    fun save(context: Context, kind: ConnectionKind, account: String, secret: String?, share: Boolean) {
+        init(context)
+        if (secret != null && secret.isNotEmpty()) secrets?.edit()?.putString(kind.id, secret)?.apply()
+        val e = ConnectionEntry(kind.id, account.trim(), share, System.currentTimeMillis())
+        _entries.value = _entries.value + (kind.id to e)
+        persist()
+        syncEnv(context, kind, share)
+    }
+
+    fun remove(context: Context, kind: ConnectionKind) {
+        init(context)
+        secrets?.edit()?.remove(kind.id)?.apply()
+        _entries.value = _entries.value - kind.id
+        persist()
+        syncEnv(context, kind, false)
+    }
+
+    private fun persist() {
+        val arr = JSONArray()
+        _entries.value.values.forEach { e ->
+            arr.put(JSONObject().apply {
+                put("kind", e.kindId); put("account", e.account)
+                put("share", e.shareWithAi); put("updated", e.updatedAt)
+            })
+        }
+        meta?.edit()?.putString("entries", arr.toString())?.apply()
+    }
+
+    private fun syncEnv(context: Context, kind: ConnectionKind, share: Boolean) {
+        val key = kind.envKey ?: return
+        val app = context.applicationContext as? MinisApp ?: return
+        runCatching {
+            val repo = app.envVarRepository
+            val existing = repo.entries.value.firstOrNull { it.key == key }
+            val secret = secrets?.getString(kind.id, null)
+            if (share && secret != null) {
+                if (existing == null) repo.add(key, secret, "来自 账号连接 · ${kind.name}")
+                else repo.update(existing.id, key, secret, "来自 账号连接 · ${kind.name}")
+            } else if (existing != null && existing.note.startsWith("来自 账号连接")) {
+                repo.delete(existing.id)
+            }
+        }
+    }
+}
