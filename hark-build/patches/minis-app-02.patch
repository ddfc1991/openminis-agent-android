+/**
+ * "Today" header on the conversation list: greeting with the avatar, and
+ * one-tap chips for where work runs, servers, and connected accounts.
+ */
+@Composable
+fun TodayCard(onOpen: (String) -> Unit, modifier: Modifier = Modifier) {
+    val context = LocalContext.current
+    PlusPrefs.init(context)
+    PlusVault.init(context)
+    val st by PlusPrefs.state.collectAsState()
+    val vault by PlusVault.entries.collectAsState()
+    LaunchedEffect(Unit) {
+        PlusVps.startMonitor(context)
+        if (PlusPrefs.state.value.petEnabled && com.openminis.app.plus.DeskPetService.canShow(context)) {
+            com.openminis.app.plus.DeskPetService.start(context)
+        }
+    }
+
+    val cal = Calendar.getInstance()
+    val hour = cal.get(Calendar.HOUR_OF_DAY)
+    val greet = when (hour) {
+        in 5..10 -> "早上好"
+        in 11..12 -> "中午好"
+        in 13..17 -> "下午好"
+        in 18..22 -> "晚上好"
+        else -> "夜深了，早点休息"
+    }
+    val date = SimpleDateFormat("M月d日 EEEE", Locale.CHINA).format(cal.time)
+    val primary = MaterialTheme.colorScheme.primary
+
+    Column(
+        modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)
+            .clip(RoundedCornerShape(20.dp))
+            .background(
+                Brush.linearGradient(
+                    listOf(primary.copy(alpha = 0.16f), MaterialTheme.colorScheme.surfaceContainerLow)
+                )
+            ),
+    ) {
+        Row(
+            Modifier.fillMaxWidth()
+                .clickable { PlusPrefs.update(context) { it.copy(todayCollapsed = !it.todayCollapsed) } }
+                .padding(start = 12.dp, end = 12.dp, top = 10.dp, bottom = if (st.todayCollapsed) 10.dp else 4.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Box(Modifier.clickable { onOpen(PlusRoutes.PERSONALIZE) }) {
+                PetAvatar(size = if (st.todayCollapsed) 36.dp else 56.dp)
+            }
+            Spacer(Modifier.width(10.dp))
+            Column(Modifier.weight(1f)) {
+                Text(greet, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+                Text(date, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+            }
+            Icon(
+                if (st.todayCollapsed) Icons.Outlined.ExpandMore else Icons.Outlined.ExpandLess,
+                contentDescription = if (st.todayCollapsed) "展开" else "收起",
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        AnimatedVisibility(!st.todayCollapsed) {
+            Row(
+                Modifier.fillMaxWidth().padding(start = 12.dp, end = 12.dp, bottom = 12.dp),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                val eff = PlusVps.effectiveMode(st)
+                val online = st.onlineServers.size
+                Chip(
+                    Modifier.weight(1f), "工作位置",
+                    when {
+                        !st.isVps -> "本机"
+                        eff == PlusState.MODE_LOCAL -> "已回本机"
+                        else -> "VPS"
+                    },
+                    dot = when {
+                        !st.isVps -> Color(0xFF007AFF)
+                        eff == PlusState.MODE_LOCAL -> Color(0xFFFF9500)
+                        else -> Color(0xFF34C759)
+                    },
+                ) { onOpen(PlusRoutes.WORK) }
+                Chip(
+                    Modifier.weight(1f), "服务器",
+                    if (st.servers.isEmpty()) "未添加" else "$online/${st.servers.size} 在线",
+                    dot = if (st.servers.isEmpty()) Color.Gray else if (online > 0) Color(0xFF34C759) else Color(0xFFFF3B30),
+                ) { onOpen(PlusRoutes.WORK) }
+                Chip(
+                    Modifier.weight(1f), "账号",
+                    if (vault.isEmpty()) "去连接" else "${vault.size} 个已连接",
+                    dot = if (vault.isEmpty()) Color.Gray else Color(0xFF34C759),
+                ) { onOpen(PlusRoutes.CONNECTIONS) }
+            }
+        }
+    }
+}
+
+@Composable
+private fun Chip(modifier: Modifier, label: String, value: String, dot: Color, onClick: () -> Unit) {
+    Column(
+        modifier.clip(RoundedCornerShape(12.dp))
+            .background(MaterialTheme.colorScheme.surface.copy(alpha = 0.7f))
+            .clickable(onClick = onClick)
+            .padding(horizontal = 10.dp, vertical = 8.dp),
+    ) {
+        Text(label, style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        Spacer(Modifier.height(2.dp))
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Box(Modifier.size(7.dp).background(dot, CircleShape))
+            Spacer(Modifier.width(5.dp))
+            Text(value, style = MaterialTheme.typography.labelLarge, maxLines = 1)
+        }
+    }
+}
