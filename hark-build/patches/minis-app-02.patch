+fun wallpaperFile(context: android.content.Context) = File(context.filesDir, "plus_wallpaper.jpg")
+
+/** Loads the custom wallpaper image, downsampled to screen size. */
+@Composable
+fun rememberWallpaperBitmap(spec: String): ImageBitmap? {
+    val context = LocalContext.current
+    val bmp by produceState<ImageBitmap?>(initialValue = null, spec) {
+        value = if (!spec.startsWith("file:")) null else withContext(Dispatchers.IO) {
+            runCatching {
+                val f = wallpaperFile(context)
+                if (!f.exists()) return@runCatching null
+                val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+                BitmapFactory.decodeFile(f.absolutePath, bounds)
+                val target = maxOf(context.resources.displayMetrics.heightPixels, 1)
+                var sample = 1
+                while (bounds.outHeight / (sample * 2) >= target) sample *= 2
+                BitmapFactory.decodeFile(f.absolutePath, BitmapFactory.Options().apply { inSampleSize = sample })
+                    ?.asImageBitmap()
+            }.getOrNull()
+        }
+    }
+    return bmp
+}
+
+/** Chat background. Draws nothing when no wallpaper is chosen. */
+@Composable
+fun ChatWallpaperLayer(modifier: Modifier = Modifier) {
+    val context = LocalContext.current
+    PlusPrefs.init(context)
+    val st by PlusPrefs.state.collectAsState()
+    val spec = st.wallpaper
+    if (spec.isEmpty()) return
+    val dark = MaterialTheme.colorScheme.background.let { (it.red + it.green + it.blue) / 3f < 0.5f }
+    Box(modifier) {
+        if (spec.startsWith("preset:")) {
+            val p = wallpaperPresets.firstOrNull { it.id == spec.removePrefix("preset:") }
+            if (p != null) Box(Modifier.fillMaxSize().background(Brush.linearGradient(p.colors)))
+        } else {
+            val bmp = rememberWallpaperBitmap(spec)
+            if (bmp != null) Image(bmp, null, Modifier.fillMaxSize(), contentScale = ContentScale.Crop)
+        }
+        // Dim layer keeps message text readable.
+        Box(
+            Modifier.fillMaxSize().background(
+                (if (dark) Color.Black else Color.White).copy(alpha = st.wallpaperDim.coerceIn(0f, 0.85f))
+            )
+        )
+    }
+}
+
+/** The avatar, animated (breathing + blinking). */
+@Composable
+fun PetAvatar(size: Dp, style: String? = null, color: Int? = null, animated: Boolean = true) {
+    val context = LocalContext.current
+    PlusPrefs.init(context)
+    val st by PlusPrefs.state.collectAsState()
+    val s = style ?: st.petStyle
+    val c = color ?: st.petColor
+    val t = if (animated) {
+        val inf = rememberInfiniteTransition(label = "pet")
+        inf.animateFloat(0f, 4f, infiniteRepeatable(tween(4000, easing = LinearEasing), RepeatMode.Restart), label = "t").value
+    } else 0f
+    Canvas(Modifier.size(size)) {
+        val blink = if (t > 3.85f) 1f else 0f
+        val bob = sin(t * Math.PI.toFloat()) * 0.025f
+        drawIntoCanvas { canvas ->
+            PetPainter.draw(canvas.nativeCanvas, this.size.width, this.size.height, s, c, blink, bob, 0.6f)
+        }
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PlusPage(title: String, onBack: () -> Unit, content: @Composable ColumnScope.() -> Unit) {
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text(title) },
+                navigationIcon = {
+                    IconButton(onClick = onBack) {
+                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "返回")
+                    }
+                },
+            )
+        },
+    ) { padding ->
+        Column(
+            Modifier.fillMaxSize().padding(padding).verticalScroll(rememberScrollState())
+                .padding(bottom = 32.dp),
+            content = content,
+        )
+    }
+}
+
+@Composable
+fun PlusSection(title: String?, footer: String? = null, content: @Composable ColumnScope.() -> Unit) {
+    Column(Modifier.fillMaxWidth().padding(top = 18.dp)) {
+        if (title != null) Text(
+            title,
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            fontWeight = FontWeight.Medium,
+            letterSpacing = 0.5.sp,
+            modifier = Modifier.padding(horizontal = 20.dp, vertical = 6.dp),
+        )
+        Column(
+            Modifier.fillMaxWidth().padding(horizontal = 16.dp)
+                .clip(RoundedCornerShape(12.dp))
+                .background(MaterialTheme.colorScheme.surfaceContainerLow),
+            content = content,
+        )
+        if (footer != null) Text(
+            footer,
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(horizontal = 20.dp, vertical = 6.dp),
+            lineHeight = 16.sp,
+        )
+    }
+}
