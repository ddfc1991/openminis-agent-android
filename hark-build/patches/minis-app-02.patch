+import kotlinx.coroutines.flow.asStateFlow
+import org.json.JSONObject
+
+/**
+ * Human verification for the agent's browser.
+ *
+ * 1. Challenges: after the agent navigates / clicks / types, the page is
+ *    checked for Cloudflare (interstitial + Turnstile), hCaptcha, reCAPTCHA
+ *    and slider captchas (Alibaba Baxia / NoCaptcha, Geetest, Tencent,
+ *    NetEase). When one shows up the agent's call waits, the user gets a
+ *    notification and an in-chat prompt 「需要你点一下验证」 that opens the
+ *    browser on that tab with the controls handed over, and the call returns
+ *    as soon as the challenge clears (cf_clearance set / challenge gone / URL
+ *    changed). The agent never tries to solve it itself.
+ * 2. One-time codes: when a page asks for an SMS / e-mail code, codes that
+ *    arrive in notifications in the next 2 minutes (4–8 digits next to
+ *    验证码 / code / OTP …) are filled into the code field. Codes stay in
+ *    memory only: never logged, never written to disk, never shown to the
+ *    model.
+ * Cookies live in the WebView's persistent store and are flushed after every
+ * cleared challenge, so a site stays signed in across restarts.
+ */
+object HumanVerify {
+    private const val FILE = "mines_human_verify"
+    private const val CHANNEL = "mines_verify"
+    private const val NOTIF_ID = 47021
+    /** Each wait inside one browser call stays under the tool's 75 s guard. */
+    const val WAIT_SLICE_MS = 50_000L
+    private const val OTP_WINDOW_MS = 120_000L
+
+    data class Settings(val challenges: Boolean = true, val otpAutofill: Boolean = true)
+    data class Pending(val url: String, val kind: String, val since: Long = System.currentTimeMillis()) {
+        val host: String get() = runCatching { android.net.Uri.parse(url).host.orEmpty() }.getOrDefault("")
+    }
+
+    private val _settings = MutableStateFlow(Settings())
+    val settings: StateFlow<Settings> = _settings.asStateFlow()
+    private val _pending = MutableStateFlow<Pending?>(null)
+    val pending: StateFlow<Pending?> = _pending.asStateFlow()
+    @Volatile private var prefs: SharedPreferences? = null
+
+    fun init(context: Context) {
+        if (prefs != null) return
+        synchronized(this) {
+            if (prefs != null) return
+            val p = context.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+            prefs = p
+            _settings.value = Settings(p.getBoolean("challenges", true), p.getBoolean("otp", true))
+        }
+    }
+
+    fun update(context: Context, block: (Settings) -> Settings) {
+        init(context)
+        val n = block(_settings.value)
+        _settings.value = n
+        prefs?.edit()?.putBoolean("challenges", n.challenges)?.putBoolean("otp", n.otpAutofill)?.apply()
+    }
+
+    fun clearPending(context: Context?) {
+        _pending.value = null
+        context?.let { runCatching { androidx.core.app.NotificationManagerCompat.from(it).cancel(NOTIF_ID) } }
+    }
+
+    // ── challenge detection ────────────────────────────────────────────
+
+    /** Returns a JSON string {kind, otp, otpEmpty}. kind "" = no challenge. */
+    const val DETECT_JS = """(function(){
+try{
+var vis=function(e){if(!e)return false;var r=e.getBoundingClientRect();if(r.width<8||r.height<8)return false;var s=getComputedStyle(e);return s.visibility!=='hidden'&&s.display!=='none'&&s.opacity!=='0';};
+var q=function(s){try{return document.querySelectorAll(s);}catch(x){return [];}};
+var any=function(s){var l=q(s);for(var i=0;i<l.length;i++){if(vis(l[i]))return true;}return false;};
+var t=(document.title||'').toLowerCase();var b=((document.body&&document.body.innerText)||'').slice(0,4000).toLowerCase();
+var kind='';
+if(t.indexOf('just a moment')>=0||t.indexOf('attention required')>=0||t.indexOf('请稍候')>=0||any('#challenge-form,#cf-challenge-running,.cf-browser-verification,#challenge-stage,#cf-please-wait'))kind='Cloudflare';
+if(!kind){var tr=q('input[name="cf-turnstile-response"]');var trEmpty=false;for(var i=0;i<tr.length;i++){if(!tr[i].value)trEmpty=true;}
+ if((any('iframe[src*="challenges.cloudflare.com"]')||any('.cf-turnstile'))&&(tr.length===0||trEmpty))kind='Cloudflare Turnstile';}
+if(!kind){var hr=q('textarea[name="h-captcha-response"]');var hEmpty=hr.length===0;for(var i=0;i<hr.length;i++){if(!hr[i].value)hEmpty=true;}
+ if(any('iframe[src*="hcaptcha.com"]')&&hEmpty)kind='hCaptcha';}
+if(!kind){var rr=q('textarea[name="g-recaptcha-response"]');var rEmpty=rr.length===0;for(var i=0;i<rr.length;i++){if(!rr[i].value)rEmpty=true;}
+ var fr=q('iframe[src*="recaptcha/api2/anchor"],iframe[src*="recaptcha/enterprise/anchor"],iframe[src*="recaptcha/api2/bframe"]');
+ for(var i=0;i<fr.length;i++){var src=fr[i].getAttribute('src')||'';if(src.indexOf('size=invisible')<0&&vis(fr[i])&&rEmpty){kind='reCAPTCHA';break;}}}
+if(!kind&&any('#nc_1_n1z,.nc_iconfont.btn_slide,#nc_1_wrapper,.baxia-dialog,#baxia-dialog-content,iframe[src*="punish"],iframe[src*="_____tmd_____"]'))kind='阿里滑块验证';
+if(!kind&&any('.geetest_slider_button,.geetest_panel_box,.geetest_holder,.geetest_box'))kind='极验验证';
+if(!kind&&any('#tcaptcha_iframe,#tcaptcha_iframe_dy,iframe[src*="captcha.qq.com"],iframe[src*="turing.captcha"]'))kind='腾讯验证码';
+if(!kind&&any('.yidun_slider,.yidun_panel,.yidun'))kind='网易易盾验证';
+if(!kind&&(b.indexOf('verify you are human')>=0||b.indexOf('确认您是真人')>=0||b.indexOf('请按住滑块')>=0||b.indexOf('拖动滑块')>=0||b.indexOf('请完成安全验证')>=0)&&b.length<1500)kind='人机验证';
+var otp=null;var ins=q('input');var cands=[];
+for(var i=0;i<ins.length;i++){var e=ins[i];if(!vis(e)||e.disabled||e.readOnly)continue;var ty=(e.type||'text').toLowerCase();if(['text','tel','number','password',''].indexOf(ty)<0)continue;
+ var h=((e.name||'')+' '+(e.id||'')+' '+(e.placeholder||'')+' '+(e.getAttribute('aria-label')||'')+' '+(e.className||'')).toLowerCase();
+ var ml=e.maxLength;
+ if((e.autocomplete||'').indexOf('one-time-code')>=0||/otp|smscode|sms_code|verif.*code|checkcode|authcode|验证码|校验码|动态码|code/.test(h)){if(!/captcha|图形|image/.test(h))cands.push(e);}
+ else if(ml===1&&(ty==='tel'||ty==='number'||ty==='text')){cands.push(e);}}
+var single=cands.filter(function(e){return e.maxLength===1;});
+var otpEmpty=cands.length>0&&cands.every(function(e){return !e.value;});
+return JSON.stringify({kind:kind,otp:cands.length>0,split:single.length>=4,otpEmpty:otpEmpty});
+}catch(x){return JSON.stringify({kind:'',otp:false,split:false,otpEmpty:false});}
+})()"""
+
+    data class Scan(val kind: String, val otpField: Boolean, val otpEmpty: Boolean)
+
+    fun parseScan(raw: String?): Scan = runCatching {
+        val o = JSONObject(raw ?: "{}")
+        Scan(o.optString("kind"), o.optBoolean("otp"), o.optBoolean("otpEmpty"))
+    }.getOrDefault(Scan("", false, false))
+
+    private fun hasClearance(url: String): Boolean = runCatching {
+        CookieManager.getInstance().getCookie(url)?.contains("cf_clearance=") == true
+    }.getOrDefault(false)
+
+    private fun notify(context: Context, p: Pending) {
+        runCatching {
+            if (Build.VERSION.SDK_INT >= 33 &&
+                ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
+            ) return
+            val nm = context.getSystemService(NotificationManager::class.java)
+            if (Build.VERSION.SDK_INT >= 26 && nm.getNotificationChannel(CHANNEL) == null) {
+                nm.createNotificationChannel(NotificationChannel(CHANNEL, "需要你验证", NotificationManager.IMPORTANCE_HIGH))
+            }
+            val launch = context.packageManager.getLaunchIntentForPackage(context.packageName)
+            val pi = launch?.let { PendingIntent.getActivity(context, NOTIF_ID, it, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT) }
+            val n = NotificationCompat.Builder(context, CHANNEL)
+                .setSmallIcon(android.R.drawable.ic_dialog_alert)
+                .setContentTitle("需要你点一下验证")
+                .setContentText("${p.host.ifBlank { "网页" }} 弹出了${p.kind}，Mines 在等你，点完会自动继续")
+                .setPriority(NotificationCompat.PRIORITY_HIGH)
+                .setAutoCancel(true)
+                .apply { if (pi != null) setContentIntent(pi) }
+                .build()
+            nm.notify(NOTIF_ID, n)
+        }
+    }
+
+    /**
+     * Called by the browser after a page-changing action. If a challenge is up,
+     * waits (≤ [WAIT_SLICE_MS]) for the user to clear it.
+     * @return null when there was nothing to do, otherwise a note for the agent.
+     */
+    suspend fun handle(
+        context: Context?,
+        scan: Scan,
+        url: String,
+        rescan: suspend () -> Scan,
+        currentUrl: suspend () -> String,
+    ): String? {
+        if (context == null || !_settings.value.challenges) return null
+        if (scan.kind.isBlank()) {
+            if (_pending.value != null) clearPending(context)
+            return null
+        }
+        // Shorter here: this wait follows the action itself inside one guarded call.
+        return waitForHuman(context, scan.kind, url, rescan, currentUrl, maxWaitMs = 30_000L)
+    }
+
+    suspend fun waitForHuman(
+        context: Context,
+        kind: String,
+        url: String,
+        rescan: suspend () -> Scan,
+        currentUrl: suspend () -> String,
+        maxWaitMs: Long = WAIT_SLICE_MS,
+    ): String {
+        val prior = _pending.value
+        if (prior == null || prior.url.substringBefore('#') != url.substringBefore('#')) {
+            val p = Pending(url, kind)
+            _pending.value = p
+            notify(context, p)
+        }
+        val hadClearance = hasClearance(url)
+        val start = System.currentTimeMillis()
+        while (System.currentTimeMillis() - start < maxWaitMs) {
+            delay(1500)
+            val now = runCatching { currentUrl() }.getOrDefault(url)
+            val urlChanged = now.substringBefore('#') != url.substringBefore('#')
+            val cleared = urlChanged || (!hadClearance && hasClearance(now)) || runCatching { rescan().kind.isBlank() }.getOrDefault(false)
+            if (cleared) {
+                delay(800) // let the site finish its redirect
+                clearPending(context)
+                runCatching { CookieManager.getInstance().flush() }
+                return "[人工验证] 页面出现$kind，用户已完成验证，现在可以继续操作（先截图看看当前页面）。"
+            }
+        }
+        return "[需要人工验证] 页面出现$kind，已通知用户点一下。不要自己去点或破解验证码；请调用 browser 的 wait_for_human 动作继续等待（每次最多约 50 秒），用户完成后会自动继续。"
+    }
+
+    // ── one-time codes ─────────────────────────────────────────────────
+
+    @Volatile private var armedAt = 0L
+    @Volatile private var code: String? = null
+    @Volatile private var codeAt = 0L
+
+    /** A page is asking for a code (or the agent said it requested one). */
+    fun armOtp() {
+        if (System.currentTimeMillis() - armedAt > OTP_WINDOW_MS) { armedAt = System.currentTimeMillis(); code = null }
+    }
+
+    private val KEYWORDS = Regex("(验证码|校验码|动态码|確認碼|驗證碼|动态密码|短信码|verification|security code|one[- ]time|passcode|\\bcode\\b|\\botp\\b)", RegexOption.IGNORE_CASE)
+    private val DIGITS = Regex("(?<![0-9])([0-9]{4,8})(?![0-9])")
+
+    /** From the notification listener. Never logs the text or the code. */
+    fun onNotification(context: Context, sbn: StatusBarNotification) {
+        if (!_settings.value.otpAutofill) return
+        val now = System.currentTimeMillis()
+        if (armedAt == 0L || now - armedAt > OTP_WINDOW_MS) return
+        if (sbn.packageName == context.packageName) return
+        val ex = sbn.notification?.extras ?: return
+        val text = listOfNotNull(
+            ex.getCharSequence("android.title"), ex.getCharSequence("android.text"), ex.getCharSequence("android.bigText"),
+        ).joinToString(" ")
+        extractCode(text)?.let { code = it; codeAt = now }
+    }
+
+    fun extractCode(text: String): String? {
+        val kw = KEYWORDS.findAll(text).map { it.range.first }.toList()
+        if (kw.isEmpty()) return null
+        return DIGITS.findAll(text)
+            .filterNot { m -> // skip things that look like years / amounts / phone numbers
+                val v = m.value
+                (v.length == 4 && v.startsWith("20") && text.getOrNull(m.range.last + 1) == '年') ||
+                    text.getOrNull(m.range.first - 1) == '¥' || text.getOrNull(m.range.first - 1) == '$'
+            }
+            .minByOrNull { m -> kw.minOf { k -> kotlin.math.abs(k - m.range.first) } }
+            ?.value
+    }
+
+    /** A code that arrived after the page asked, not used yet. Consumes it. */
+    fun takeCode(): String? {
+        val c = code ?: return null
+        if (codeAt < armedAt || System.currentTimeMillis() - codeAt > OTP_WINDOW_MS) return null
+        code = null
+        return c
+    }
+
+    /** Keep a code that could not be placed yet (still within its window). */
+    fun putBack(c: String) { code = c; codeAt = System.currentTimeMillis() }
+
+    fun hasFreshCode(): Boolean = code != null && codeAt >= armedAt && System.currentTimeMillis() - codeAt <= OTP_WINDOW_MS
+
+    /** Waits up to [timeoutMs] for a code; null on timeout. */
+    suspend fun awaitCode(timeoutMs: Long): String? {
+        armOtp()
+        val start = System.currentTimeMillis()
+        while (System.currentTimeMillis() - start < timeoutMs) {
+            takeCode()?.let { return it }
+            delay(700)
+        }
+        return null
+    }
+
+    /** JS that types [code] into the page's code field(s); returns "ok" / "nofield". */
+    fun fillJs(code: String, selector: String?): String {
+        val sel = JSONObject.quote(selector ?: "")
+        val c = JSONObject.quote(code)
+        return """(function(){try{
+var code=$c,sel=$sel;
+var setv=function(e,v){var p=Object.getPrototypeOf(e);var d=Object.getOwnPropertyDescriptor(p,'value');if(d&&d.set){d.set.call(e,v);}else{e.value=v;}
+ e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));};
+var vis=function(e){var r=e.getBoundingClientRect();return r.width>4&&r.height>4;};
+if(sel){var t=document.querySelector(sel);if(!t)return 'nofield';t.focus();setv(t,code);return 'ok';}
+var ins=[].slice.call(document.querySelectorAll('input')).filter(function(e){return vis(e)&&!e.disabled&&!e.readOnly;});
+var single=ins.filter(function(e){return e.maxLength===1;});
+if(single.length>=code.length){for(var i=0;i<code.length;i++){single[i].focus();setv(single[i],code[i]);}return 'ok';}
+var t=ins.find(function(e){var h=((e.name||'')+' '+(e.id||'')+' '+(e.placeholder||'')+' '+(e.getAttribute('aria-label')||'')).toLowerCase();
+ return (e.autocomplete||'').indexOf('one-time-code')>=0||(/otp|smscode|sms_code|verif.*code|checkcode|authcode|验证码|校验码|动态码|code/.test(h)&&!/captcha|图形|image/.test(h));});
+if(!t)return 'nofield';t.focus();setv(t,code);return 'ok';
+}catch(x){return 'nofield';}})()"""
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/LocalGateway.kt b/src/android/app/src/main/java/com/openminis/app/plus/LocalGateway.kt
new file mode 100644
index 0000000..5877f6f
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/LocalGateway.kt
@@ -0,0 +1,108 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import com.openminis.app.MinisApp
+import com.openminis.app.data.model.ProviderCredential
+import com.openminis.app.data.model.ProviderInstance
+import com.openminis.app.data.model.ProviderType
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.UUID
+
+/**
+ * Finds OpenAI-compatible model gateways running on this phone (e.g. a
+ * WorkBuddy reverse-proxy app on 127.0.0.1:8788, Ollama, LM Studio, LiteLLM)
+ * and adds one as a provider in one tap.
+ */
+object LocalGateway {
+    /** 8788 first: the user's WorkBuddy proxy app. 8790 is Mines' own plugin gateway, skipped. */
+    val PORTS = listOf(8788, 8317, 11434, 1234, 4000, 8000, 8080, 3000, 5000, 8888)
+    private const val PREFS = "mines_local_gateway"
+
+    data class Found(
+        val port: Int,
+        val models: List<String>,
+        /** The gateway answered 401/403: it wants a key. */
+        val needsKey: Boolean,
+    ) {
+        val baseUrl: String get() = "http://127.0.0.1:$port/v1"
+        val title: String get() = when (port) {
+            8788 -> "WorkBuddy 网关"
+            11434 -> "Ollama"
+            1234 -> "LM Studio"
+            4000 -> "LiteLLM"
+            else -> "本机模型网关"
+        }
+    }
+
+    private val _found = MutableStateFlow<List<Found>>(emptyList())
+    val found: StateFlow<List<Found>> = _found.asStateFlow()
+
+    private fun probe(port: Int, key: String? = null): Found? = runCatching {
+        val c = URL("http://127.0.0.1:$port/v1/models").openConnection() as HttpURLConnection
+        c.connectTimeout = 600; c.readTimeout = 2500
+        if (!key.isNullOrBlank()) c.setRequestProperty("Authorization", "Bearer $key")
+        val code = c.responseCode
+        if (code == 401 || code == 403) return@runCatching Found(port, emptyList(), needsKey = true)
+        if (code !in 200..299) return@runCatching null
+        val body = c.inputStream.use { it.readBytes() }.toString(Charsets.UTF_8)
+        val arr = JSONObject(body).optJSONArray("data") ?: return@runCatching null
+        Found(port, (0 until arr.length()).mapNotNull { arr.optJSONObject(it)?.optString("id")?.takeIf { s -> s.isNotBlank() } }, false)
+    }.getOrNull()
+
+    /** Ports already added as a provider (by base URL). */
+    private fun addedPorts(context: Context): Set<Int> {
+        val repo = (context.applicationContext as? MinisApp)?.providerRepositoryOrNull ?: return emptySet()
+        return repo.config.value.instances.mapNotNull { inst ->
+            val b = inst.customBaseURL ?: return@mapNotNull null
+            Regex("^https?://(127\\.0\\.0\\.1|localhost):(\\d+)").find(b)?.groupValues?.get(2)?.toIntOrNull()
+        }.toSet()
+    }
+
+    fun dismissed(context: Context): Set<Int> =
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getStringSet("dismissed", emptySet())!!
+            .mapNotNull { it.toIntOrNull() }.toSet()
+
+    fun dismiss(context: Context, port: Int) {
+        val p = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        p.edit().putStringSet("dismissed", dismissed(context).map { it.toString() }.toSet() + port.toString()).apply()
+        _found.value = _found.value.filter { it.port != port }
+    }
+
+    /** Probe all ports in parallel; keeps only gateways not yet added or dismissed. */
+    suspend fun scan(context: Context, includeDismissed: Boolean = false): List<Found> = withContext(Dispatchers.IO) {
+        val skip = addedPorts(context) + if (includeDismissed) emptySet() else dismissed(context)
+        val res = coroutineScope { PORTS.filter { it !in skip }.map { p -> async { probe(p) } }.awaitAll() }.filterNotNull()
+        _found.value = res
+        res
+    }
+
+    /** Add [port] as an OpenAI-compatible provider; returns a status line. */
+    suspend fun add(context: Context, f: Found, key: String?): String = withContext(Dispatchers.IO) {
+        val repo = (context.applicationContext as? MinisApp)?.providerRepositoryOrNull ?: return@withContext "供应商还没加载，稍后再试"
+        val check = probe(f.port, key) ?: return@withContext "连不上 127.0.0.1:${f.port}，确认网关 App 正在运行"
+        if (check.needsKey) return@withContext "密钥不对，网关拒绝了"
+        val inst = ProviderInstance(
+            id = UUID.randomUUID().toString(),
+            label = "${f.title} :${f.port}",
+            providerType = ProviderType.openAI,
+            credentialType = ProviderCredential.apiKey,
+            customBaseURL = f.baseUrl,
+            appendV1Suffix = true,
+        )
+        repo.addInstance(inst)
+        if (!key.isNullOrBlank()) repo.saveApiKey(inst.id, key.trim())
+        repo.triggerAsyncModelReconcile(inst.id, forceRefresh = true)
+        _found.value = _found.value.filter { it.port != f.port }
+        "已添加 ${f.title}，${check.models.size} 个模型"
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/MinesUpdate.kt b/src/android/app/src/main/java/com/openminis/app/plus/MinesUpdate.kt
new file mode 100644
index 0000000..c454fbe
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/MinesUpdate.kt
@@ -0,0 +1,151 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import com.openminis.app.BuildConfig
+import com.openminis.app.data.UpdateChecker
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * In-app update for Mines builds published on GitHub
+ * (ddfc1991/openminis-agent-android, releases `build-<n>` with `mines-<n>.apk`).
+ *
+ * Every build has the same package, signing key and versionCode, so Android
+ * installs a newer build in place — and an older one too, which is what makes
+ * rollback possible: before installing, the APK the phone is running now is
+ * copied aside, and 「回到上一版」 installs that copy.
+ */
+object MinesUpdate {
+    const val OWNER = "ddfc1991"
+    const val REPO = "openminis-agent-android"
+    private const val PREFS = "mines_update"
+    val currentBuild: Int get() = BuildConfig.MINES_BUILD
+
+    data class Release(
+        val build: Int,
+        val tag: String,
+        val apkUrl: String,
+        val apkSize: Long,
+        val pageUrl: String,
+        val publishedAt: String,
+        val notes: String,
+    )
+
+    sealed class State {
+        data object Idle : State()
+        data object Checking : State()
+        data class UpToDate(val latest: Int) : State()
+        data class Available(val release: Release) : State()
+        data class Downloading(val release: Release, val progress: Float) : State()
+        data class Ready(val release: Release, val apk: File) : State()
+        data class Failed(val message: String) : State()
+    }
+
+    private val _state = MutableStateFlow<State>(State.Idle)
+    val state: StateFlow<State> = _state.asStateFlow()
+
+    private fun get(url: String): String {
+        val c = URL(url).openConnection() as HttpURLConnection
+        c.connectTimeout = 8000; c.readTimeout = 15000
+        c.setRequestProperty("Accept", "application/vnd.github+json")
+        c.setRequestProperty("User-Agent", "Mines-build-$currentBuild")
+        val code = c.responseCode
+        if (code == 403) throw IllegalStateException("GitHub 暂时限流了，过一会再试")
+        if (code !in 200..299) throw IllegalStateException("GitHub 返回 $code")
+        return c.inputStream.use { it.readBytes() }.toString(Charsets.UTF_8)
+    }
+
+    private fun parse(arr: JSONArray): List<Release> = (0 until arr.length()).mapNotNull { i ->
+        val r = arr.getJSONObject(i)
+        if (r.optBoolean("draft")) return@mapNotNull null
+        val tag = r.optString("tag_name")
+        val n = Regex("^build-(\\d+)$").find(tag)?.groupValues?.get(1)?.toIntOrNull() ?: return@mapNotNull null
+        val assets = r.optJSONArray("assets") ?: return@mapNotNull null
+        val apk = (0 until assets.length()).map { assets.getJSONObject(it) }
+            .firstOrNull { it.optString("name").startsWith("mines-") && it.optString("name").endsWith(".apk") }
+            ?: return@mapNotNull null
+        Release(n, tag, apk.optString("browser_download_url"), apk.optLong("size"), r.optString("html_url"),
+            r.optString("published_at"), r.optString("body"))
+    }
+
+    /** The change list for a build: the message of the commit its tag points at. */
+    private fun changelog(tag: String): String = runCatching {
+        val c = JSONObject(get("https://api.github.com/repos/$OWNER/$REPO/commits/$tag"))
+        c.optJSONObject("commit")?.optString("message").orEmpty()
+    }.getOrDefault("")
+
+    suspend fun check(context: Context, quiet: Boolean = false): State = withContext(Dispatchers.IO) {
+        if (!quiet) _state.value = State.Checking
+        val result = runCatching {
+            val all = parse(JSONArray(get("https://api.github.com/repos/$OWNER/$REPO/releases?per_page=20")))
+            val latest = all.maxByOrNull { it.build } ?: return@runCatching State.Failed("还没有发布的版本")
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putLong("checked", System.currentTimeMillis()).apply()
+            if (currentBuild > 0 && latest.build <= currentBuild) State.UpToDate(latest.build)
+            else State.Available(latest.copy(notes = changelog(latest.tag).ifBlank { latest.notes }))
+        }.getOrElse { State.Failed(it.message ?: "检查失败") }
+        if (!(quiet && result is State.Failed)) _state.value = result
+        result
+    }
+
+    /** At most once a day, silently (for the home card). */
+    suspend fun checkDaily(context: Context) {
+        val last = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getLong("checked", 0L)
+        if (System.currentTimeMillis() - last > 20 * 3600_000L || _state.value is State.Idle) check(context, quiet = true)
+    }
+
+    fun dismissedBuild(context: Context): Int = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getInt("dismissed", 0)
+    fun dismiss(context: Context, build: Int) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putInt("dismissed", build).apply()
+    }
+
+    private fun updatesDir(context: Context) = File(context.filesDir, "updates").apply { mkdirs() }
+
+    /** The copy of the build that was running before the last update, if any. */
+    fun rollbackApk(context: Context): Pair<Int, File>? {
+        val f = updatesDir(context).listFiles()?.filter { it.name.startsWith("rollback-build-") && it.name.endsWith(".apk") }
+            ?.maxByOrNull { it.lastModified() } ?: return null
+        val n = Regex("rollback-build-(\\d+)\\.apk").find(f.name)?.groupValues?.get(1)?.toIntOrNull() ?: 0
+        return if (n == currentBuild) null else n to f
+    }
+
+    /** Keep the APK we are running now, so the user can go back to it. */
+    private fun saveRollback(context: Context) {
+        val dir = updatesDir(context)
+        val target = File(dir, "rollback-build-$currentBuild.apk")
+        if (target.exists() && target.length() > 0) return
+        dir.listFiles()?.filter { it.name.startsWith("rollback-build-") }?.forEach { it.delete() }
+        File(context.applicationInfo.sourceDir).copyTo(target, overwrite = true)
+    }
+
+    suspend fun download(context: Context, release: Release) = withContext(Dispatchers.IO) {
+        _state.value = State.Downloading(release, 0f)
+        runCatching { saveRollback(context) }
+        when (val r = UpdateChecker.download(context, release.apkUrl, versionName = null) { p ->
+            _state.value = State.Downloading(release, p)
+        }) {
+            is UpdateChecker.DownloadResult.Success -> {
+                val dest = File(updatesDir(context), "mines-${release.build}.apk")
+                if (r.file != dest) { r.file.copyTo(dest, overwrite = true); r.file.delete() }
+                _state.value = State.Ready(release, dest)
+            }
+            is UpdateChecker.DownloadResult.Error -> _state.value = State.Failed("下载失败：${r.message}")
+        }
+    }
+
+    /** Launches the system installer; asks for the install permission first when needed. */
+    fun install(context: Context, apk: File): Boolean {
+        if (!UpdateChecker.canInstall(context)) {
+            UpdateChecker.openInstallPermissionSettings(context)
+            return false
+        }
+        return UpdateChecker.installApk(context, apk)
+    }
+}
