+@Composable
+fun ConnectionsScreen(onBack: () -> Unit) {
+    val context = LocalContext.current
+    PlusVault.init(context)
+    val entries by PlusVault.entries.collectAsState()
+    var open by remember { mutableStateOf<ConnectionKind?>(null) }
+
+    PlusPage("账号连接", onBack) {
+        Row(
+            Modifier.fillMaxWidth().padding(horizontal = 20.dp).padding(top = 12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Icon(Icons.Outlined.Lock, null, tint = MaterialTheme.colorScheme.primary, modifier = Modifier.size(18.dp))
+            Spacer(Modifier.width(8.dp))
+            Text(
+                "密钥加密存在这台手机里。AI 只能用，看不到明文。",
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        val connected = PlusVault.kinds.filter { entries.containsKey(it.id) }
+        val available = PlusVault.kinds.filterNot { entries.containsKey(it.id) }
+        if (connected.isNotEmpty()) {
+            PlusSection("已连接 · ${connected.size}") {
+                connected.forEachIndexed { i, k ->
+                    val e = entries[k.id]
+                    ConnectionRow(k, sub = buildString {
+                        append(e?.account?.ifBlank { null } ?: "已保存")
+                        val pv = PlusVault.preview(k.id)
+                        if (pv.isNotEmpty()) append(" · ").append(pv)
+                        if (e?.shareWithAi == true && k.envKey != null) append(" · AI 可用")
+                    }, connected = true) { open = k }
+                    if (i < connected.lastIndex) PlusDivider()
+                }
+            }
+        }
+        val social = setOf("telegram", "telegram_user", "feishu", "wechat", "wecom", "dingtalk", "qq", "discord",
+            "x", "weibo", "xiaohongshu", "douyin", "bilibili", "youtube")
+        listOf(
+            "AI 与开发" to available.filterNot { it.id in social },
+            "社交与媒体" to available.filter { it.id in social },
+        ).filter { it.second.isNotEmpty() }.forEach { (title, list) ->
+            PlusSection(title) {
+                list.forEachIndexed { i, k ->
+                    ConnectionRow(k, sub = k.desc, connected = false) { open = k }
+                    if (i < list.lastIndex) PlusDivider()
+                }
+            }
+        }
+    }
+
+    open?.let { k -> ConnectionDialog(k, onDismiss = { open = null }) }
+}
+
+@Composable
+private fun ConnectionRow(k: ConnectionKind, sub: String, connected: Boolean, onClick: () -> Unit) {
+    Row(
+        Modifier.fillMaxWidth().clickable(onClick = onClick).padding(horizontal = 14.dp, vertical = 12.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Box(
+            Modifier.size(38.dp).background(Color(k.color), RoundedCornerShape(10.dp)),
+            contentAlignment = Alignment.Center,
+        ) {
+            Text(k.letter, color = Color.White, fontWeight = FontWeight.Bold, fontSize = if (k.letter.length > 1) 12.sp else 15.sp, maxLines = 1)
+        }
+        Spacer(Modifier.width(14.dp))
+        Column(Modifier.weight(1f)) {
+            Text(k.name, style = MaterialTheme.typography.bodyLarge)
+            Text(sub, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+        if (connected) {
+            Text("已连接", color = Color(0xFF34C759), style = MaterialTheme.typography.labelMedium)
+        } else {
+            Text("连接", color = MaterialTheme.colorScheme.primary, style = MaterialTheme.typography.labelLarge)
+        }
+        Icon(
+            Icons.AutoMirrored.Filled.KeyboardArrowRight, null,
+            tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.5f),
+        )
+    }
+}
+
+@Composable
+private fun ConnectionDialog(k: ConnectionKind, onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    val existing = PlusVault.entries.value[k.id]
+    var account by remember { mutableStateOf(existing?.account ?: "") }
+    var secret by remember { mutableStateOf("") }
+    var share by remember { mutableStateOf(existing?.shareWithAi ?: (k.envKey != null)) }
+    val hasSaved = PlusVault.hasSecret(k.id)
+    var model by remember { mutableStateOf(PlusVault.extra(k.id, "model") ?: com.openminis.app.plus.GeminiLive.DEFAULT_MODEL) }
+    var voice by remember { mutableStateOf(PlusVault.extra(k.id, "voice") ?: "Puck") }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(k.name) },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                OutlinedTextField(account, { account = it }, label = { Text(k.accountLabel) }, singleLine = true)
+                OutlinedTextField(
+                    secret, { secret = it },
+                    label = { Text(if (hasSaved) "${k.secretLabel}（留空=不改）" else k.secretLabel) },
+                    singleLine = true,
+                    visualTransformation = PasswordVisualTransformation(),
+                )
+                if (k.id == "gemini") {
+                    OutlinedTextField(model, { model = it }, label = { Text("实时语音模型") }, singleLine = true)
+                    Text("声音", style = MaterialTheme.typography.labelMedium)
+                    Row(
+                        Modifier.horizontalScroll(androidx.compose.foundation.rememberScrollState()),
+                        horizontalArrangement = Arrangement.spacedBy(6.dp),
+                    ) {
+                        com.openminis.app.plus.GeminiLive.voices.forEach { v ->
+                            androidx.compose.material3.FilterChip(
+                                selected = voice == v, onClick = { voice = v }, label = { Text(v) },
+                            )
+                        }
+                    }
+                }
+                if (k.envKey != null) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Column(Modifier.weight(1f)) {
+                            Text("交给 AI 使用")
+                            Text(
+                                "以 ${k.envKey} 提供给沙箱，聊天里自动打码",
+                                style = MaterialTheme.typography.bodySmall,
+                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            )
+                        }
+                        Switch(share, onCheckedChange = { share = it })
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(
+                enabled = secret.isNotEmpty() || hasSaved || account.isNotBlank(),
+                onClick = {
+                    if (k.id == "gemini") { PlusVault.setExtra(k.id, "model", model); PlusVault.setExtra(k.id, "voice", voice) }
+                    PlusVault.save(context, k, account, secret.ifEmpty { null }, share); onDismiss()
+                },
+            ) { Text("保存") }
+        },
+        dismissButton = {
+            Row {
+                if (existing != null) TextButton(onClick = { PlusVault.remove(context, k); onDismiss() }) {
+                    Text("断开", color = Color(0xFFFF3B30))
+                }
+                TextButton(onClick = onDismiss) { Text("取消") }
+            }
+        },
+    )
+}
