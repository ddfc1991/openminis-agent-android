+    /**
+     * [Mines-a11y-list] Numbered snapshot of the interactive elements on
+     * screen, as plain text.
+     *
+     * The old surface was `ui dump` (a full JSON tree, hundreds of nodes, most
+     * of them layout containers) followed by `tap node <id>`. Driving the UI
+     * that way costs three round trips per interaction and the intermediate
+     * output is large enough to crowd out everything else in the transcript.
+     *
+     * `ui list` prints only what a person would tap or type into, numbered:
+     *
+     *     1  [设置]            Button            (540, 210)
+     *     2  [搜索]            EditText          (540, 320)
+     *
+     * and `tap 1` resolves the number against the most recent snapshot, so
+     * the common case is `ui list` → `tap 3`. `--all` keeps non-interactive
+     * nodes for when the list alone is not enough.
+     */
+    private fun uiList(args: OffloadArgs): NativeOffloadResult {
+        val svc = svcOrThrow()
+        val limit = args.getInt("limit") ?: 60
+        val depth = args.getInt("depth") ?: 40
+        val all = args.hasFlag("all")
+        val collected = ArrayList<AccessibilityNodeInfo>()
+        for (root in svc.rootNodes()) {
+            collectListable(root, depth, 0, collected, limit, all)
+        }
+        val sb = StringBuilder()
+        val ids = ArrayList<String>(collected.size)
+        val (pkg, cls) = svc.foregroundPackage()
+        sb.append("$pkg / $cls\n")
+        collected.forEachIndexed { i, n ->
+            // Register the node so the number stays resolvable after this
+            // command returns — AccessibilityNodeInfo handles go stale, but
+            // the registry keeps them alive for the tap that follows.
+            val id = svc.nodeRegistry.put(n)
+            ids.add(id)
+            val rect = Rect(); n.getBoundsInScreen(rect)
+            val label = listLabel(n)
+            val kind = shortKind(n)
+            sb.append("%3d  %-28s %-16s (%d, %d)%s\n".format(
+                i + 1,
+                label.take(28).padEnd(28),
+                kind,
+                rect.centerX(), rect.centerY(),
+                if (n.isEditable) "  [输入框]" else "",
+            ))
+        }
+        if (collected.isEmpty()) sb.append("（没有找到可操作的元素，加 --all 看全部节点）\n")
+        lastListIds = ids
+        sb.append("\n提示：tap <编号> 直接点，例如 tap 2；input text <编号> \"内容\" 往输入框打字\n")
+        return NativeOffloadResult(0, sb.toString())
+    }
+
+    /** Last snapshot's numbers → registry ids, so `tap 3` needs no re-walk. */
+    private var lastListIds: List<String> = emptyList()
+
+    private fun collectListable(
+        node: AccessibilityNodeInfo?, maxDepth: Int, depth: Int,
+        out: MutableList<AccessibilityNodeInfo>, limit: Int, all: Boolean,
+    ) {
+        if (node == null || depth > maxDepth || out.size >= limit) return
+        val hasText = !node.text.isNullOrEmpty() || !node.contentDescription.isNullOrEmpty()
+        val interactive = node.isClickable || node.isLongClickable || node.isEditable || node.isScrollable
+        // A node with text but no action is usually a label belonging to a
+        // clickable parent; keeping it would double every row in the list.
+        if (all || interactive || (hasText && node.childCount == 0)) out.add(node)
+        for (i in 0 until node.childCount) {
+            collectListable(node.getChild(i), maxDepth, depth + 1, out, limit, all)
+        }
+    }
+
+    private fun listLabel(n: AccessibilityNodeInfo): String {
+        val t = n.text?.toString()?.trim()
+        if (!t.isNullOrEmpty()) return t
+        val d = n.contentDescription?.toString()?.trim()
+        if (!d.isNullOrEmpty()) return d
+        val rid = n.viewIdResourceName?.substringAfterLast('/')
+        if (!rid.isNullOrEmpty()) return rid
+        return n.className?.toString()?.substringAfterLast('.') ?: "?"
+    }
+
+    private fun shortKind(n: AccessibilityNodeInfo): String = when {
+        n.isEditable -> "EditText"
+        n.isScrollable -> "ScrollView"
+        n.isCheckable -> "CheckBox"
+        n.isClickable -> n.className?.toString()?.substringAfterLast('.') ?: "View"
+        else -> n.className?.toString()?.substringAfterLast('.') ?: "View"
+    }
+
+    /** Resolve a `ui list` number to a live node, or null when it is stale. */
+    private fun listNode(svc: MinisAccessibilityService, index: Int): AccessibilityNodeInfo? {
+        if (index < 1 || index > lastListIds.size) return null
+        return svc.nodeRegistry.get(lastListIds[index - 1])
