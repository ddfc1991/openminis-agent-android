+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * [Mines-dsh] Runs a sandbox command in the background with a small progress
+ * dialog — installs, removals and checks no longer open the terminal and wait
+ * for the user to press Enter.
+ */
+class ShellTaskState {
+    var title by mutableStateOf("")
+    var lines by mutableStateOf(listOf<String>())
+    var running by mutableStateOf(false)
+    var exit by mutableStateOf<Int?>(null)
+    var visible by mutableStateOf(false)
+}
+
+class ShellTaskRunner(val state: ShellTaskState, val run: (title: String, command: String) -> Unit)
+
+@Composable
+fun rememberShellTask(onFinished: (Int) -> Unit = {}): ShellTaskRunner {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val state = remember { ShellTaskState() }
+    val runner = remember {
+        ShellTaskRunner(state) { title, command ->
+            if (state.running) return@ShellTaskRunner
+            state.title = title; state.lines = emptyList(); state.exit = null; state.running = true; state.visible = true
+            scope.launch {
+                val code = withContext(Dispatchers.IO) {
+                    runCatching {
+                        var waited = 0
+                        while (!com.openminis.app.sandbox.PRootKernel.isBooted && waited < 60_000) { Thread.sleep(500); waited += 500 }
+                        com.openminis.app.sandbox.ShellExecutor.execute(
+                            context.applicationContext, command, timeout = 900_000L,
+                            environment = mapOf("CI" to "true", "npm_config_yes" to "true"),
+                        ) { line ->
+                            val clean = line.replace(Regex("\u001B\\[[0-9;]*[A-Za-z]"), "").trimEnd()
+                            if (clean.isNotBlank()) state.lines = (state.lines + clean).takeLast(120)
+                        }.let { r ->
+                            if (state.lines.isEmpty() && r.output.isNotBlank()) state.lines = r.output.lines().filter { it.isNotBlank() }.takeLast(120)
+                            r.exitCode
+                        }
+                    }.getOrElse { state.lines = state.lines + "出错：${it.message}"; -1 }
+                }
+                state.exit = code; state.running = false
+                onFinished(code)
+            }
+        }
+    }
+    ShellTaskDialog(state)
+    return runner
+}
+
+@Composable
+fun ShellTaskDialog(state: ShellTaskState) {
+    if (!state.visible) return
+    val scroll = rememberScrollState()
+    LaunchedEffect(state.lines.size) { scroll.animateScrollTo(scroll.maxValue) }
+    AlertDialog(
+        onDismissRequest = { if (!state.running) state.visible = false },
+        title = { Text(state.title, fontSize = 18.sp) },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    if (state.running) { CircularProgressIndicator(Modifier.size(18.dp), strokeWidth = 2.dp); Spacer(Modifier.width(8.dp)) }
+                    Text(
+                        when (val e = state.exit) { null -> "进行中，请稍等…"; 0 -> "完成 ✓"; else -> "没成功（退出码 $e），看下面的信息" },
+                        fontSize = 15.sp,
+                        color = when (state.exit) { null -> MaterialTheme.colorScheme.onSurface; 0 -> Color(0xFF34C759); else -> Color(0xFFFF3B30) },
+                    )
+                }
+                Column(Modifier.fillMaxWidth().heightIn(max = 260.dp).verticalScroll(scroll)) {
+                    state.lines.forEach { Text(it, fontSize = 12.sp, fontFamily = FontFamily.Monospace) }
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(enabled = !state.running, onClick = { state.visible = false }) { Text(if (state.running) "进行中" else "好") }
+        },
+    )
+}
