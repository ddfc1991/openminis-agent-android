+BASE_OPTS="-o BatchMode=yes -o ConnectTimeout=12 -o ConnectionAttempts=2 -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o IPQoS=none -o StrictHostKeyChecking=accept-new"
