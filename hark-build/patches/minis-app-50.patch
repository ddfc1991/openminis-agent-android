+package com.openminis.app.plus
+
+import android.content.Context
+import android.speech.tts.TextToSpeech
+import android.speech.tts.UtteranceProgressListener
+import com.openminis.app.MinisApp
+import com.openminis.app.debug.HeadlessChatRunner
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.util.Locale
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+/**
+ * [Mines-voice-29] 普通语音模式: voice chat that needs no Google.
+ *
+ * listen (system recognizer → on-device → Vosk offline, see [Listen]) →
+ * the user's normal chat model in a regular Mines chat session (so DeepSeek
+ * etc. reached directly, tools included) → read the reply aloud with the
+ * system TTS → listen again. Offered by the Live screen when every Gemini
+ * route failed.
+ */
+class PlainVoice(private val context: Context) {
+    enum class Phase { IDLE, LISTENING, THINKING, SPEAKING, ERROR }
+
+    private val _phase = MutableStateFlow(Phase.IDLE)
+    val phase: StateFlow<Phase> = _phase.asStateFlow()
+    private val _status = MutableStateFlow<String?>(null)
+    val status: StateFlow<String?> = _status.asStateFlow()
+    private val _lines = MutableStateFlow<List<GeminiLive.Line>>(emptyList())
+    val lines: StateFlow<List<GeminiLive.Line>> = _lines.asStateFlow()
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var job: Job? = null
+    private var tts: TextToSpeech? = null
+    @Volatile private var ttsReady = false
+    private var sessionId: String? = null
+
+    fun start() {
+        if (job?.isActive == true) return
+        initTts()
+        job = scope.launch { loop() }
+    }
+
+    fun stop() {
+        job?.cancel(); job = null
+        runCatching { tts?.stop(); tts?.shutdown() }
+        tts = null; ttsReady = false
+        _phase.value = Phase.IDLE
+    }
+
+    private fun initTts() {
+        if (tts != null) return
+        val latch = CountDownLatch(1)
+        tts = TextToSpeech(context.applicationContext) { st ->
+            ttsReady = st == TextToSpeech.SUCCESS
+            if (ttsReady) runCatching { tts?.language = Locale.SIMPLIFIED_CHINESE }
+            latch.countDown()
+        }
+        scope.launch { latch.await(5, TimeUnit.SECONDS) }
+    }
+
+    private suspend fun ensureSession(): String? {
+        sessionId?.let { return it }
+        val app = context.applicationContext as? MinisApp ?: return null
+        val model = app.providerRepository.lastUsedVisibleEntry()?.baseModel?.id
+            ?: app.providerRepository.allVisibleEntries().firstOrNull()?.baseModel?.id ?: return null
+        val s = app.chatRepository.createSession(modelId = model, title = "语音对话")
+        runCatching { app.chatRepository.dao.updateSource(s.id, "voice") }
+        sessionId = s.id
+        return s.id
+    }
+
+    private suspend fun loop() {
+        var misses = 0
+        while (currentCoroutineContextActive()) {
+            _phase.value = Phase.LISTENING
+            _status.value = "请说话…"
+            val heard = withContext(Dispatchers.IO) { Listen.once(context, maxSec = 20) }
+            if (heard.text.isNullOrBlank()) {
+                if (heard.error == Listen.NO_SPEECH) {
+                    misses++
+                    if (misses >= 3) { _status.value = "好像没人说话，已暂停。点「继续」再聊。"; _phase.value = Phase.IDLE; return }
+                    continue
+                }
+                _status.value = "听不了：${heard.error}"
+                _phase.value = Phase.ERROR
+                return
+            }
+            misses = 0
+            add(true, heard.text)
+            _phase.value = Phase.THINKING
+            _status.value = "正在想…"
+            val sid = ensureSession()
+            if (sid == null) { _status.value = "没有可用的聊天模型：先在 设置 → 模型 里添加一个"; _phase.value = Phase.ERROR; return }
+            val r = runCatching {
+                HeadlessChatRunner.prompt(context, sid,
+                    heard.text + "\n（这是语音对话：请用简短口语回答，不要用 Markdown、表格或代码块。）",
+                    wait = true, timeoutMs = 120_000)
+            }.getOrNull()
+            val reply = r?.responseText?.takeIf { it.isNotBlank() && r.status != "Error" && r.status != "Rejected" }
+            if (reply == null) {
+                _status.value = "模型没有回答（${r?.status ?: "出错"}${r?.responseText?.let { "：" + it.take(80) } ?: ""}）"
+                _phase.value = Phase.ERROR
+                return
+            }
+            add(false, reply)
+            _phase.value = Phase.SPEAKING
+            _status.value = null
+            speak(clean(reply))
+            delay(250)
+        }
+    }
+
+    private suspend fun currentCoroutineContextActive(): Boolean = kotlinx.coroutines.currentCoroutineContext().isActive
+
+    private fun clean(t: String) = t.replace(Regex("```[\\s\\S]*?```"), "（代码略）")
+        .replace(Regex("[*#>`|_]+"), "").replace(Regex("\\[(.*?)]\\(.*?\\)"), "$1").take(1500)
+
+    private fun speak(text: String) {
+        val t = tts ?: return
+        if (!ttsReady) return
+        val done = CountDownLatch(1)
+        t.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
+            override fun onStart(utteranceId: String?) {}
+            override fun onDone(utteranceId: String?) { done.countDown() }
+            @Deprecated("Deprecated in Java") override fun onError(utteranceId: String?) { done.countDown() }
+        })
+        t.speak(text, TextToSpeech.QUEUE_FLUSH, null, "mines-plain")
+        done.await((text.length / 3L + 10).coerceAtMost(180), TimeUnit.SECONDS)
+    }
+
+    private fun add(user: Boolean, text: String) {
+        _lines.value = (_lines.value + GeminiLive.Line(user, text)).takeLast(40)
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/SelfTestProvider.kt b/src/android/app/src/main/java/com/openminis/app/plus/SelfTestProvider.kt
new file mode 100644
index 0000000..0912e7d
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/SelfTestProvider.kt
@@ -0,0 +1,84 @@
+package com.openminis.app.plus
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.database.Cursor
+import android.net.Uri
+import android.os.Binder
+import android.os.Bundle
+import android.os.Process
+import com.openminis.app.offload.OffloadPermissionManager
+import com.openminis.app.sandbox.NativeOffloadRequest
+import com.openminis.app.sandbox.NativeOffloadServer
+import java.util.concurrent.Callable
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/**
+ * [Mines-selftest-29] Lets the CI emulator smoke test run the same offload
+ * commands the agent runs (android-a11y-cli open, android-device storage,
+ * android-speech, android-clipboard, android-location …) without the arm64
+ * sandbox, which can't boot on the x86_64 emulator:
+ *
+ *   adb shell content call --uri content://com.openminis.mines.plus.selftest \
+ *       --method offload --arg 'android-device storage'
+ *
+ * Only the adb shell (uid 2000) and root may call it; anything else gets a
+ * SecurityException. It adds no capability an app could use.
+ */
+class SelfTestProvider : ContentProvider() {
+    override fun onCreate() = true
+
+    override fun call(method: String, arg: String?, extras: Bundle?): Bundle {
+        val uid = Binder.getCallingUid()
+        if (uid != 2000 && uid != 0) throw SecurityException("self-test is adb-only")
+        val out = Bundle()
+        when (method) {
+            "allow" -> {
+                // grant the agent gate for one offload tool (BYPASS), e.g. a11y_cli
+                OffloadPermissionManager.setLevel(arg ?: "", OffloadPermissionManager.PermissionLevel.BYPASS)
+                out.putString("result", "ok")
+            }
+            "offload" -> {
+                val argv = split(arg ?: "")
+                val h = NativeOffloadServer.handlerFor(argv.firstOrNull() ?: "")
+                if (h == null) { out.putInt("exit", 127); out.putString("result", "no handler"); return out }
+                val timeout = extras?.getLong("timeoutMs", 40_000L) ?: 40_000L
+                val ex = Executors.newSingleThreadExecutor()
+                val t0 = System.currentTimeMillis()
+                try {
+                    val r = ex.submit(Callable { h.handle(NativeOffloadRequest(Process.myPid(), argv, emptyMap(), "/", null)) })
+                        .get(timeout, TimeUnit.MILLISECONDS)
+                    out.putInt("exit", r.exitCode); out.putString("result", r.output)
+                } catch (e: java.util.concurrent.TimeoutException) {
+                    out.putInt("exit", 124); out.putString("result", "TIMEOUT after ${timeout} ms")
+                } catch (e: Throwable) {
+                    out.putInt("exit", 1); out.putString("result", "${e.javaClass.simpleName}: ${e.message}")
+                } finally { ex.shutdownNow() }
+                out.putLong("ms", System.currentTimeMillis() - t0)
+            }
+            else -> out.putString("result", "unknown method")
+        }
+        return out
+    }
+
+    private fun split(s: String): List<String> {
+        val out = ArrayList<String>(); val cur = StringBuilder(); var q: Char? = null; var any = false
+        for (c in s) {
+            when {
+                q != null -> if (c == q) q = null else cur.append(c)
+                c == '"' || c == '\'' -> { q = c; any = true }
+                c == ' ' -> { if (cur.isNotEmpty() || any) { out += cur.toString(); cur.clear(); any = false } }
+                else -> cur.append(c)
+            }
+        }
+        if (cur.isNotEmpty() || any) out += cur.toString()
+        return out
+    }
+
+    override fun query(uri: Uri, p: Array<out String>?, s: String?, a: Array<out String>?, o: String?): Cursor? = null
+    override fun getType(uri: Uri): String? = null
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = null
+    override fun delete(uri: Uri, s: String?, a: Array<out String>?) = 0
+    override fun update(uri: Uri, v: ContentValues?, s: String?, a: Array<out String>?) = 0
+}
