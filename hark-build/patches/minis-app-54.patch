+                if (!r.isSuccessful) return null
+                JSONObject(r.body?.string().orEmpty()).getJSONArray("choices").getJSONObject(0).getJSONObject("message").getString("content")
+            }
+        }.getOrNull() ?: return null
+        val o = runCatching { JSONObject(text.substring(text.indexOf('{'), text.lastIndexOf('}') + 1)) }.getOrNull() ?: return null
+        return Entry(sid, title, o.optString("topic").ifBlank { ChatOrganizerTopic.of(title + transcript) }, o.optString("summary").take(400),
+            arr(o, "facts").take(8), arr(o, "decisions").take(5), (arr(o, "links") + links).distinct().take(12), (arr(o, "files") + files).distinct().take(12),
+            System.currentTimeMillis(), true)
+    }
+
+    private fun fallback(sid: String, title: String, lines: List<String>, links: List<String>, files: List<String>): Entry {
+        val asks = lines.filter { it.startsWith("用户：") }.map { it.removePrefix("用户：").take(80) }.take(4)
+        return Entry(sid, title, ChatOrganizerTopic.of(title + lines.joinToString(" ")), "聊了：" + asks.joinToString("；").take(200),
+            asks, emptyList(), links, files, System.currentTimeMillis(), false)
+    }
+}
+
+/** Topic by the same keywords 对话整理 chips use (no model). */
+internal object ChatOrganizerTopic {
+    fun of(text: String): String {
+        val t = text.lowercase()
+        return ChatOrganizer.topics.maxByOrNull { tp -> tp.keywords.count { t.contains(it) } }
+            ?.takeIf { tp -> tp.keywords.any { t.contains(it) } }?.name ?: "其他"
+    }
+}
