+/** Line icon in a tinted circle. */
+@Composable
+fun IconBubble(icon: androidx.compose.ui.graphics.vector.ImageVector, tint: Color = minesAccent(), size: Dp = 36.dp) {
+    Box(Modifier.size(size).clip(CircleShape).background(tint.copy(alpha = 0.16f)), contentAlignment = Alignment.Center) {
+        MinesIcon(icon, null, tint = tint, modifier = Modifier.size(size * 0.54f))
+    }
+}
+
+/** The standard row: icon bubble · title / subtitle · value · chevron. */
+@Composable
+fun PlusRow(
+    icon: androidx.compose.ui.graphics.vector.ImageVector?,
+    title: String,
+    sub: String? = null,
+    value: String? = null,
+    tint: Color = minesAccent(),
+    chevron: Boolean = true,
+    trailing: (@Composable () -> Unit)? = null,
+    onClick: (() -> Unit)? = null,
+) {
+    Row(
+        Modifier.fillMaxWidth().heightIn(min = 58.dp)
+            .then(if (onClick != null) Modifier.clickable(onClick = onClick) else Modifier)
+            .padding(horizontal = 16.dp, vertical = 10.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        if (icon != null) { IconBubble(icon, tint); Spacer(Modifier.width(14.dp)) }
+        Column(Modifier.weight(1f)) {
+            Text(title, fontSize = 16.sp, fontWeight = FontWeight.Medium, color = MaterialTheme.colorScheme.onSurface)
+            if (!sub.isNullOrBlank()) Text(sub, fontSize = 14.sp, lineHeight = 19.sp, color = minesMuted())
+        }
+        if (value != null) Text(value, fontSize = 15.sp, color = minesMuted(), maxLines = 1,
+            modifier = Modifier.padding(start = 8.dp).widthIn(max = 150.dp))
+        if (trailing != null) { Spacer(Modifier.width(8.dp)); trailing() }
+        else if (chevron && onClick != null) Text("›", fontSize = 24.sp, color = minesMuted(), modifier = Modifier.padding(start = 8.dp))
+    }
+}
+
+/** Status dot + word (能用 / 连不上 …). */
+@Composable
+fun StatusPill(text: String, ok: Boolean?) {
+    val c = when (ok) { true -> Color(0xFF34C759); false -> Color(0xFFFF6B5E); null -> minesMuted() }
+    Row(Modifier.clip(RoundedCornerShape(50)).background(c.copy(alpha = 0.15f)).padding(horizontal = 10.dp, vertical = 4.dp),
+        verticalAlignment = Alignment.CenterVertically) {
+        Box(Modifier.size(7.dp).clip(CircleShape).background(c))
+        Spacer(Modifier.width(6.dp))
+        Text(text, fontSize = 13.sp, fontWeight = FontWeight.SemiBold, color = c)
+    }
+}
+
+/** Pill buttons: primary (accent fill) and secondary (outlined, quiet). */
+@Composable
+fun PillButton(text: String, modifier: Modifier = Modifier, primary: Boolean = true, enabled: Boolean = true, onClick: () -> Unit) {
+    val accent = minesAccent()
+    val shape = RoundedCornerShape(50)
+    val bg = when { !enabled -> Color.Transparent; primary -> accent; else -> Color.Transparent }
+    val fg = when { !enabled -> minesMuted().copy(alpha = 0.5f); primary -> Color.White; else -> accent }
+    val border = when { !enabled -> minesMuted().copy(alpha = 0.3f); primary -> Color.Transparent; else -> accent.copy(alpha = 0.6f) }
+    Box(
+        modifier.heightIn(min = 50.dp).shadow(if (primary && enabled) 4.dp else 0.dp, shape, clip = false)
+            .clip(shape).background(bg).border(1.dp, border, shape)
+            .then(if (enabled) Modifier.clickable(onClick = onClick) else Modifier)
+            .padding(horizontal = 22.dp, vertical = 12.dp),
+        contentAlignment = Alignment.Center,
+    ) { Text(text, fontSize = 16.sp, fontWeight = FontWeight.SemiBold, color = fg) }
+}
+
+/** Short hint line with an ⓘ, instead of long paragraphs. */
+@Composable
+fun InfoLine(text: String) {
+    Row(Modifier.fillMaxWidth().padding(horizontal = 24.dp, vertical = 6.dp), verticalAlignment = Alignment.Top) {
+        Text("ⓘ", fontSize = 14.sp, color = MaterialTheme.colorScheme.onBackground.copy(alpha = 0.6f))
+        Spacer(Modifier.width(6.dp))
+        Text(text, fontSize = 13.sp, lineHeight = 18.sp, color = MaterialTheme.colorScheme.onBackground.copy(alpha = 0.66f))
+    }
+}
 
