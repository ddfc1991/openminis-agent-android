+package com.openminis.app.plus
+
+import android.content.Context
+import android.util.Log
+import com.openminis.app.MinisApp
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.net.InetSocketAddress
+import java.net.Socket
+
+/**
+ * Health checks for the user's VPS list, and the bridge into the sandbox.
+ *
+ * Every check opens a TCP connection to the SSH port and reads the server
+ * banner, so "online" means sshd is really answering (not just a ping).
+ * The ordered list of healthy servers is published to the sandbox as env
+ * vars, which `minis-vps` reads: it tries servers in order (lowest latency
+ * first) and moves to the next one when a connection fails. When every
+ * server is down and auto-fallback is on, the effective mode drops to local.
+ */
+object PlusVps {
+    private const val TAG = "PlusVps"
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var monitor: Job? = null
+
+    /** Returns latency in ms, or -2 when unreachable / not an SSH server. */
+    suspend fun probe(server: VpsServer, timeoutMs: Int = 5000): Int = withContext(Dispatchers.IO) {
+        val start = System.nanoTime()
+        try {
+            Socket().use { sock ->
+                sock.connect(InetSocketAddress(server.host, server.port), timeoutMs)
+                val connectMs = ((System.nanoTime() - start) / 1_000_000).toInt()
+                sock.soTimeout = timeoutMs
+                val buf = ByteArray(64)
+                val n = sock.getInputStream().read(buf)
+                val banner = if (n > 0) String(buf, 0, n) else ""
+                if (banner.startsWith("SSH-")) connectMs else -2
+            }
+        } catch (e: Exception) {
+            Log.d(TAG, "probe ${server.host}:${server.port} failed: ${e.message}")
+            -2
+        }
+    }
+
+    suspend fun probeAll(context: Context) {
+        PlusPrefs.init(context)
+        val servers = PlusPrefs.state.value.servers
+        if (servers.isEmpty()) { syncToSandbox(context); return }
+        val results = withContext(Dispatchers.IO) {
+            servers.map { s -> async { s.id to (if (s.enabled) probe(s) else -1) } }.awaitAll()
+        }.toMap()
+        val now = System.currentTimeMillis()
+        PlusPrefs.update(context) { st ->
+            st.copy(servers = st.servers.map { s ->
+                val r = results[s.id] ?: return@map s
+                s.copy(lastLatencyMs = r, lastCheckedAt = now)
+            })
+        }
+        syncToSandbox(context)
+    }
+
+    /** Servers in the order minis-vps should try them. */
+    fun orderedTargets(st: PlusState): List<VpsServer> {
+        val enabled = st.servers.filter { it.enabled }
+        val online = enabled.filter { it.lastLatencyMs >= 0 }.sortedBy { it.lastLatencyMs }
+        val unknown = enabled.filter { it.lastLatencyMs == -1 }
+        return online + unknown
+    }
+
+    fun effectiveMode(st: PlusState): String {
+        if (!st.isVps) return PlusState.MODE_LOCAL
+        if (st.autoFallback && orderedTargets(st).isEmpty()) return PlusState.MODE_LOCAL
+        return PlusState.MODE_VPS
+    }
+
+    /** Publish work mode + server list into the sandbox environment. */
+    fun syncToSandbox(context: Context) {
+        val st = PlusPrefs.state.value
+        val list = orderedTargets(st).joinToString(",") { "${it.user}@${it.host}:${it.port}" }
+        val mode = effectiveMode(st)
+        val app = context.applicationContext as? MinisApp ?: return
+        runCatching {
+            val repo = app.envVarRepository
+            fun put(key: String, value: String, note: String) {
+                val existing = repo.entries.value.firstOrNull { it.key == key }
+                if (existing == null) repo.add(key, value, note)
+                else if (repo.getValue(key) != value) repo.update(existing.id, key, value, note)
+            }
+            put("MINIS_WORK_MODE", mode,
+                "Mines Plus 工作位置: local=手机沙箱, vps=把重任务交给 VPS（用 minis-vps run/bg 执行）")
+            put("MINIS_VPS_SERVERS", list.ifEmpty { "none" },
+                "Mines Plus 服务器列表，按延迟排序；minis-vps 自动选第一个可用的，断开切下一台")
+        }.onFailure { Log.w(TAG, "env sync failed: ${it.message}") }
+    }
+
+    /** Re-check servers every 90 s while VPS mode is on. */
+    fun startMonitor(context: Context) {
+        val appCtx = context.applicationContext
+        PlusPrefs.init(appCtx)
+        if (monitor?.isActive == true) return
+        monitor = scope.launch {
+            delay(3000)
+            while (isActive) {
+                if (PlusPrefs.state.value.isVps) runCatching { probeAll(appCtx) }
+                delay(90_000)
+            }
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/SandboxCare.kt b/src/android/app/src/main/java/com/openminis/app/plus/SandboxCare.kt
new file mode 100644
index 0000000..7df8f25
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/SandboxCare.kt
@@ -0,0 +1,89 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import android.os.Process
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import java.io.File
+
+/** One process the sandbox started (same Linux uid as the app). */
+data class SandboxProc(val pid: Int, val name: String, val rssKb: Long, val cpuTicks: Long) {
+    val heavy: Boolean get() = HEAVY.any { name.contains(it, ignoreCase = true) }
+    companion object {
+        val HEAVY = listOf("chrom", "playwright", "node", "python", "java", "firefox", "ffmpeg", "gradle", "npm", "pip")
+    }
+}
+
+/**
+ * Sandbox housekeeping: lists the processes the sandbox left running, frees
+ * memory on request, and (optionally) closes heavy processes that have sat
+ * idle — no CPU used — for 10 minutes.
+ */
+object SandboxCare {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var job: Job? = null
+    private val lastTicks = HashMap<Int, Pair<Long, Long>>() // pid -> (ticks, sinceMs)
+
+    fun list(): List<SandboxProc> {
+        val me = Process.myPid()
+        val uid = Process.myUid()
+        val out = ArrayList<SandboxProc>()
+        File("/proc").listFiles()?.forEach { d ->
+            val pid = d.name.toIntOrNull() ?: return@forEach
+            if (pid == me) return@forEach
+            runCatching {
+                val status = File(d, "status").readText()
+                val u = Regex("Uid:\\s+(\\d+)").find(status)?.groupValues?.get(1)?.toInt()
+                if (u != uid) return@runCatching
+                val rss = Regex("VmRSS:\\s+(\\d+)").find(status)?.groupValues?.get(1)?.toLong() ?: 0L
+                if (rss == 0L) return@runCatching
+                val cmd = runCatching { File(d, "cmdline").readText().replace('\u0000', ' ').trim() }.getOrDefault("")
+                val comm = runCatching { File(d, "comm").readText().trim() }.getOrDefault("")
+                val name = cmd.split(' ').firstOrNull { it.isNotBlank() && !it.contains("libproot") }
+                    ?.substringAfterLast('/')?.takeIf { it.isNotBlank() } ?: comm
+                // Skip the app's own helper processes (e.g. :remote services).
+                if (name.startsWith("com.openminis")) return@runCatching
+                val stat = File(d, "stat").readText().substringAfterLast(')').trim().split(' ')
+                val ticks = (stat.getOrNull(11)?.toLongOrNull() ?: 0L) + (stat.getOrNull(12)?.toLongOrNull() ?: 0L)
+                out += SandboxProc(pid, name.ifBlank { "pid $pid" }, rss, ticks)
+            }
+        }
+        return out.sortedByDescending { it.rssKb }
+    }
+
+    fun kill(pid: Int) { runCatching { Process.killProcess(pid) } }
+
+    /** Close every heavy process (browsers, node, python…). Returns how many. */
+    fun cleanHeavy(): Int {
+        val heavy = list().filter { it.heavy }
+        heavy.forEach { kill(it.pid) }
+        return heavy.size
+    }
+
+    /** Auto-clean loop: heavy + idle for 10 minutes -> closed. */
+    fun startAuto(context: Context) {
+        PlusPrefs.init(context)
+        if (job?.isActive == true) return
+        job = scope.launch {
+            while (isActive) {
+                if (PlusPrefs.state.value.autoClean) {
+                    val now = System.currentTimeMillis()
+                    val procs = list()
+                    val alive = procs.map { it.pid }.toSet()
+                    lastTicks.keys.retainAll(alive)
+                    for (p in procs) {
+                        val prev = lastTicks[p.pid]
+                        if (prev == null || prev.first != p.cpuTicks) lastTicks[p.pid] = p.cpuTicks to now
+                        else if (p.heavy && now - prev.second > 10 * 60_000) { kill(p.pid); lastTicks.remove(p.pid) }
+                    }
+                }
+                delay(2 * 60_000)
+            }
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/SmartRouter.kt b/src/android/app/src/main/java/com/openminis/app/plus/SmartRouter.kt
new file mode 100644
index 0000000..2c09928
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/SmartRouter.kt
@@ -0,0 +1,161 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import android.content.SharedPreferences
+import com.openminis.app.MinisApp
+import com.openminis.app.data.model.ModelEntry
+import com.openminis.app.data.model.ModelGroup
+import com.openminis.app.data.model.ProviderInstance
+import com.openminis.app.data.model.ProviderType
+import com.openminis.app.data.model.RoutingStrategy
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.withContext
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * Smart routing (智能路由): keeps a speed / health reading per provider and
+ * lets model groups use it.
+ *
+ *  - Speed test: one light request to each enabled provider's API host (any
+ *    HTTP answer = reachable; the time to the answer = latency). Runs on
+ *    demand and every few minutes while Mines is open.
+ *  - With 智能路由 on, a 「按顺序备用」 group starts with the fastest
+ *    healthy member instead of the first one, and its automatic fallback
+ *    chain (on errors / timeouts, already part of Mines) is walked in the
+ *    same fastest-first order.
+ *  - 「同模型自动成组」 builds one group per model that several providers
+ *    serve (e.g. the same DeepSeek model from three gateways), so the
+ *    fastest working one is used and the others back it up.
+ */
+object SmartRouter {
+    private const val FILE = "mines_smart_router"
+    const val GROUP_PREFIX = "⚡ "
+
+    data class Stat(val latencyMs: Int, val ok: Boolean, val code: Int, val error: String?, val at: Long)
+
+    private val _enabled = MutableStateFlow(false)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+    private val _stats = MutableStateFlow<Map<String, Stat>>(emptyMap())
+    val stats: StateFlow<Map<String, Stat>> = _stats.asStateFlow()
+    private val _testing = MutableStateFlow(false)
+    val testing: StateFlow<Boolean> = _testing.asStateFlow()
+    @Volatile private var prefs: SharedPreferences? = null
+
+    fun init(context: Context) {
+        if (prefs != null) return
+        synchronized(this) {
+            if (prefs != null) return
+            val p = context.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+            prefs = p
+            _enabled.value = p.getBoolean("enabled", false)
+        }
+    }
+
+    fun setEnabled(context: Context, on: Boolean) {
+        init(context)
+        _enabled.value = on
+        prefs?.edit()?.putBoolean("enabled", on)?.apply()
+    }
+
+    private fun probeUrl(inst: ProviderInstance): String? {
+        inst.effectiveBaseURL?.let { return it.trimEnd('/') + "/models" }
+        return when (inst.providerType) {
+            ProviderType.anthropic -> "https://api.anthropic.com/v1/models"
+            ProviderType.gemini -> "https://generativelanguage.googleapis.com/v1beta/models"
+            ProviderType.openAI -> "https://api.openai.com/v1/models"
+            ProviderType.openRouter -> "https://openrouter.ai/api/v1/models"
+            ProviderType.xAI -> "https://api.x.ai/v1/models"
+            else -> null
+        }
+    }
+
+    private fun probe(url: String): Stat {
+        val t0 = System.nanoTime()
+        return try {
+            val c = URL(url).openConnection() as HttpURLConnection
+            c.connectTimeout = 5000; c.readTimeout = 6000
+            c.requestMethod = "GET"
+            val code = c.responseCode
+            runCatching { (if (code < 400) c.inputStream else c.errorStream)?.use { it.read() } }
+            c.disconnect()
+            val ms = ((System.nanoTime() - t0) / 1_000_000).toInt()
+            // 401/403/404 still means the host answered; 5xx / 429 means trouble.
+            Stat(ms, code < 500 && code != 429, code, null, System.currentTimeMillis())
+        } catch (e: Exception) {
+            Stat(((System.nanoTime() - t0) / 1_000_000).toInt(), false, 0, e.javaClass.simpleName, System.currentTimeMillis())
+        }
+    }
+
+    /** Measure every enabled provider in parallel. */
+    suspend fun testAll(context: Context) = withContext(Dispatchers.IO) {
+        val repo = (context.applicationContext as? MinisApp)?.providerRepositoryOrNull ?: return@withContext
+        _testing.value = true
+        try {
+            val insts = repo.config.value.instances.filter { it.isEnabled }
+            val res = coroutineScope {
+                insts.mapNotNull { i -> probeUrl(i)?.let { u -> i.id to u } }
+                    .map { (id, u) -> async { id to probe(u) } }.awaitAll()
+            }
+            _stats.value = _stats.value + res.toMap()
+        } finally {
+            _testing.value = false
+        }
+    }
+
+    /** Re-test when the last reading is older than [maxAgeMs]. */
+    suspend fun refreshIfStale(context: Context, maxAgeMs: Long = 5 * 60_000L) {
+        val newest = _stats.value.values.maxOfOrNull { it.at } ?: 0L
+        if (System.currentTimeMillis() - newest > maxAgeMs) testAll(context)
+    }
+
+    private fun rank(instanceId: String?): Int {
+        val s = instanceId?.let { _stats.value[it] } ?: return 50_000          // unknown: middle
+        return if (s.ok) s.latencyMs else 100_000 + s.latencyMs              // broken: last
+    }
+
+    /** Fastest healthy first (stable for equal / unknown). No-op when off. */
+    fun order(entries: List<ModelEntry>): List<ModelEntry> =
+        if (!_enabled.value) entries else entries.sortedBy { rank(it.providerInstanceId) }
+
+    fun <T> sortByHealth(items: List<T>, instanceIdOf: (T) -> String?): List<T> =
+        if (!_enabled.value) items else items.sortedBy { rank(instanceIdOf(it)) }
+
+    private fun family(modelId: String): String =
+        modelId.lowercase().substringAfterLast('/').replace(Regex("[\\s_]+"), "-").removeSuffix(":free")
+
+    /**
+     * One 「⚡ 模型名」 group (fallback strategy) per model that two or more
+     * enabled providers serve. Existing ⚡ groups are updated, others untouched.
+     * @return number of groups created or updated.
+     */
+    fun buildSameModelGroups(context: Context): Int {
+        val repo = (context.applicationContext as? MinisApp)?.providerRepositoryOrNull ?: return 0
+        val cfg = repo.config.value
+        val enabledIds = cfg.instances.filter { it.isEnabled }.map { it.id }.toSet()
+        val byFamily = cfg.modelEntries
+            .filter { it.providerInstanceId in enabledIds && !it.isHidden && !it.isUnavailableFromProvider }
+            .groupBy { family(it.model.id) }
+            .filter { (_, es) -> es.map { it.providerInstanceId }.distinct().size >= 2 }
+        var n = 0
+        for ((fam, entries) in byFamily) {
+            val members = entries.distinctBy { it.providerInstanceId }.map { it.id }.toMutableList()
+            val name = GROUP_PREFIX + (entries.first().model.displayName.ifBlank { fam })
+            val existing = cfg.modelGroups.firstOrNull { it.name == name }
+            if (existing == null) {
+                repo.addGroup(ModelGroup(name = name, memberEntryIds = members, strategy = RoutingStrategy.fallback))
+                n++
+            } else if (existing.memberEntryIds.toSet() != members.toSet()) {
+                repo.updateGroup(existing.copy(memberEntryIds = members, strategy = RoutingStrategy.fallback))
+                n++
+            }
+        }
+        return n
+    }
+}
