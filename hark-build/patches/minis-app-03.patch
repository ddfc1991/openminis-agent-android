+    fun init(context: Context) {
+        if (meta != null) return
+        synchronized(this) {
+            if (meta != null) return
+            val ctx = context.applicationContext
+            val m = ctx.getSharedPreferences(META, Context.MODE_PRIVATE)
+            secrets = runCatching {
