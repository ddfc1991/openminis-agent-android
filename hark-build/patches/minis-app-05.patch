+            ConnMethod.GITHUB, ConnMethod.MICROSOFT -> DeviceFlowBlock(kind, autoStart && entry == null, onWeb)
+            ConnMethod.KEY -> KeyBlock(kind, resumes, autoStart && entry == null)
