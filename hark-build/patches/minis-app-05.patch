+@Composable
+private fun ConnectionRow(k: ConnectionKind, sub: String, connected: Boolean, onConnect: () -> Unit, onClick: () -> Unit) {
+    Row(
+        Modifier.fillMaxWidth().heightIn(min = 68.dp).clickable(onClick = onClick).padding(horizontal = 14.dp, vertical = 10.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        BrandIcon(k)
+        Spacer(Modifier.width(14.dp))
+        Column(Modifier.weight(1f)) {
+            Text(k.name, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.Medium)
+            Text(sub, style = MaterialTheme.typography.bodyMedium, color = if (connected) Green else MaterialTheme.colorScheme.onSurfaceVariant,
+                maxLines = 2)
+        }
+        Spacer(Modifier.width(8.dp))
+        if (connected) {
+            Icon(Icons.AutoMirrored.Filled.KeyboardArrowRight, null, tint = MaterialTheme.colorScheme.onSurfaceVariant)
+        } else {
+            FilledTonalButton(onClick = onConnect, modifier = Modifier.heightIn(min = 44.dp)) {
+                Text("连接", fontSize = 16.sp, fontWeight = FontWeight.SemiBold)
+            }
+        }
+    }
+}
