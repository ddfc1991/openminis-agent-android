+@Composable
+private fun KeyBlock(kind: ConnectionKind, resumes: Int, autoStart: Boolean) {
+    PlusSection(null, footer = "点「去获取密钥」会打开官方页面。复制密钥后回到这里，Mines 会自动发现剪贴板里的密钥。") {
+        KeyBlockBody(kind, resumes, autoStart)
+    }
