+@Composable
+private fun KeyBlockBody(kind: ConnectionKind, resumes: Int, autoStart: Boolean) {
+    val context = LocalContext.current
+    val existing = PlusVault.entries.value[kind.id]
+    var found by remember { mutableStateOf<String?>(null) }
+    var manual by remember { mutableStateOf("") }
+    var account by remember { mutableStateOf(existing?.account ?: "") }
+    var model by remember { mutableStateOf(PlusVault.extra(kind.id, "model") ?: com.openminis.app.plus.GeminiLive.DEFAULT_MODEL) }
+    var voice by remember { mutableStateOf(PlusVault.extra(kind.id, "voice") ?: "Puck") }
+    val needsAccount = kind.id == "gmail"
+
+    LaunchedEffect(resumes) {
+        // Clipboard reads need window focus on Android 10+: try twice shortly after resuming.
+        repeat(2) {
+            delay(if (it == 0) 450 else 1200)
+            val k = PlusConnect.keyOnClipboard(context, kind)
+            if (k != null && k != PlusVault.secret(kind.id)) { found = k; return@LaunchedEffect }
+        }
+    }
+    LaunchedEffect(Unit) { if (autoStart && kind.keyUrl != null && kind.method == ConnMethod.KEY) { delay(300); openExternal(context, kind.keyUrl) } }
+
+    fun save(secret: String) {
+        if (kind.id == "gemini") { PlusVault.setExtra(kind.id, "model", model); PlusVault.setExtra(kind.id, "voice", voice) }
+        PlusVault.save(context, kind, account.ifBlank { existing?.account ?: "" }, secret,
+            share = existing?.shareWithAi ?: (kind.envKey != null), via = "key")
+        found = null; manual = ""
+        Toast.makeText(context, "已连接 ${kind.name}", Toast.LENGTH_SHORT).show()
+    }
+
+    Column(Modifier.fillMaxWidth()) {
+        if (kind.keyUrl != null) BigAction("去获取${kind.keyLabel}") { openExternal(context, kind.keyUrl) }
+        val f = found
+        if (f != null) {
+            Column(
+                Modifier.fillMaxWidth().padding(horizontal = 14.dp, vertical = 6.dp).clip(RoundedCornerShape(14.dp))
+                    .background(Green.copy(alpha = 0.12f)).border(BorderStroke(2.dp, Green), RoundedCornerShape(14.dp)).padding(14.dp),
+            ) {
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    Icon(Icons.Outlined.ContentPaste, null, tint = Green)
+                    Spacer(Modifier.width(8.dp))
+                    Text("剪贴板里有 ${kind.name} 的${kind.keyLabel}", style = MaterialTheme.typography.titleMedium)
+                }
+                Text("••••" + f.takeLast(4), style = MaterialTheme.typography.bodyLarge, modifier = Modifier.padding(vertical = 6.dp))
+                Button(
+                    onClick = { if (!needsAccount || account.isNotBlank()) save(f) else Toast.makeText(context, "先填上你的 Gmail 地址", Toast.LENGTH_SHORT).show() },
+                    colors = ButtonDefaults.buttonColors(containerColor = Green),
+                    modifier = Modifier.fillMaxWidth().heightIn(min = 52.dp),
+                ) { Text("一键填入并连接", fontSize = 18.sp, fontWeight = FontWeight.SemiBold) }
+            }
+        }
+        if (needsAccount) OutlinedTextField(account, { account = it }, label = { Text("Gmail 地址") }, singleLine = true,
+            textStyle = MaterialTheme.typography.titleMedium,
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 14.dp, vertical = 4.dp))
+        OutlinedTextField(
+            manual, { manual = it },
+            label = { Text(if (PlusVault.hasSecret(kind.id)) "或手动粘贴（已保存 ${PlusVault.preview(kind.id)}）" else "或手动粘贴${kind.keyLabel}") },
+            singleLine = true, visualTransformation = PasswordVisualTransformation(),
+            textStyle = MaterialTheme.typography.titleMedium,
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 14.dp, vertical = 4.dp),
+        )
+        if (kind.id == "gemini") {
+            OutlinedTextField(model, { model = it }, label = { Text("实时语音模型") }, singleLine = true,
+                modifier = Modifier.fillMaxWidth().padding(horizontal = 14.dp, vertical = 4.dp))
+            Row(
+                Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()).padding(horizontal = 14.dp, vertical = 4.dp),
+                horizontalArrangement = Arrangement.spacedBy(6.dp),
+            ) {
+                com.openminis.app.plus.GeminiLive.voices.forEach { v ->
+                    androidx.compose.material3.FilterChip(selected = voice == v, onClick = {
+                        voice = v; PlusVault.setExtra(kind.id, "voice", v)
+                    }, label = { Text(v) })
+                }
+            }
+        }
+        if (manual.isNotBlank()) Button(
+            onClick = { if (!needsAccount || account.isNotBlank()) save(manual.trim()) else Toast.makeText(context, "先填上你的 Gmail 地址", Toast.LENGTH_SHORT).show() },
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 14.dp, vertical = 8.dp).heightIn(min = 52.dp),
+        ) { Text("保存并连接", fontSize = 17.sp) }
+        Spacer(Modifier.height(6.dp))
+    }
