+                                Box(
+                                    Modifier.weight(1f).heightIn(min = 46.dp).clip(RoundedCornerShape(12.dp))
+                                        .background(if (sel) color.copy(alpha = 0.16f) else MaterialTheme.colorScheme.surface)
+                                        .border(BorderStroke(if (sel) 2.dp else 1.dp, if (sel) color else MaterialTheme.colorScheme.outlineVariant), RoundedCornerShape(12.dp))
+                                        .clickable(enabled = !cap.locked) { PlusVault.setLevel(kind, cap, lv) },
+                                    contentAlignment = Alignment.Center,
