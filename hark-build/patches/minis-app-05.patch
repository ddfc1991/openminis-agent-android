+                BigAction("在 Chrome 里登录 Google") { openExternal(context, kind.loginUrl ?: "https://accounts.google.com/") }
+                if (entry == null) SecondaryAction("我已经登录好了") {
+                    PlusVault.save(context, kind, "Chrome 已登录", null, share = false, via = "chrome")
