+/**
+ * Full-screen live voice call with Gemini. Needs a Gemini key saved under
+ * 账号连接; talks back instantly and can be interrupted mid-sentence.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VoiceLiveScreen(onBack: () -> Unit, onOpenConnections: () -> Unit) {
+    val context = LocalContext.current
+    PlusVault.init(context)
+    val key = remember { PlusVault.secret("gemini") }
+    var hasMic by remember {
+        mutableStateOf(ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED)
+    }
+    val askMic = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { hasMic = it }
+    val live = remember(key) {
+        key?.let { GeminiLive(it, PlusVault.extra("gemini", "model") ?: GeminiLive.DEFAULT_MODEL,
+            PlusVault.extra("gemini", "voice") ?: "Puck") }
+    }
+
+    // Keep the screen on during a call; hang up when leaving.
+    DisposableEffect(Unit) {
+        val act = context as? android.app.Activity
+        act?.window?.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        onDispose {
+            act?.window?.clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+            live?.stop()
+        }
+    }
+    LaunchedEffect(live, hasMic) {
+        if (live != null && hasMic) live.start()
+        else if (live != null && !hasMic) askMic.launch(Manifest.permission.RECORD_AUDIO)
+    }
+
+    Scaffold(
+        containerColor = Color(0xFF0E1320),
+        topBar = {
+            TopAppBar(
+                title = { Text("实时语音", color = Color.White) },
+                navigationIcon = {
+                    IconButton(onClick = onBack) { Icon(Icons.AutoMirrored.Filled.ArrowBack, "返回", tint = Color.White) }
+                },
+                colors = androidx.compose.material3.TopAppBarDefaults.topAppBarColors(containerColor = Color.Transparent),
+            )
+        },
+    ) { pad ->
+        Column(Modifier.fillMaxSize().padding(pad), horizontalAlignment = Alignment.CenterHorizontally) {
+            if (live == null) {
+                Spacer(Modifier.height(80.dp))
+                PetAvatar(size = 120.dp)
+                Spacer(Modifier.height(24.dp))
+                Text("先填一个 Gemini API Key", color = Color.White, style = MaterialTheme.typography.titleMedium)
+                Spacer(Modifier.height(16.dp))
+                Button(onClick = onOpenConnections) { Text("去 账号连接 填写") }
+                return@Column
+            }
+            val phase by live.phase.collectAsState()
+            val level by live.level.collectAsState()
+            val muted by live.muted.collectAsState()
+            val error by live.error.collectAsState()
+            val lines by live.lines.collectAsState()
+
+            Spacer(Modifier.height(24.dp))
+            Orb(phase, level)
+            Spacer(Modifier.height(16.dp))
+            Text(
+                when (phase) {
+                    GeminiLive.Phase.IDLE -> "准备中"
+                    GeminiLive.Phase.CONNECTING -> "正在连接…"
+                    GeminiLive.Phase.LISTENING -> if (muted) "已静音" else "我在听，直接说"
+                    GeminiLive.Phase.SPEAKING -> "说话中（随时打断我）"
+                    GeminiLive.Phase.ERROR -> error ?: "出错了"
+                },
+                color = if (phase == GeminiLive.Phase.ERROR) Color(0xFFFF6B6B) else Color.White,
+                style = MaterialTheme.typography.titleMedium,
+                textAlign = TextAlign.Center,
+                modifier = Modifier.padding(horizontal = 24.dp),
+            )
+            if (phase == GeminiLive.Phase.ERROR) {
+                Spacer(Modifier.height(12.dp))
+                Button(onClick = { live.start() }) { Text("重新连接") }
+            }
+
+            val listState = rememberLazyListState()
+            LaunchedEffect(lines.size, lines.lastOrNull()?.text?.length) {
+                if (lines.isNotEmpty()) listState.animateScrollToItem(lines.lastIndex)
+            }
+            LazyColumn(
+                state = listState,
+                modifier = Modifier.weight(1f).fillMaxWidth().padding(horizontal = 16.dp, vertical = 12.dp),
+                verticalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                items(lines) { l ->
+                    Row(Modifier.fillMaxWidth(), horizontalArrangement = if (l.user) Arrangement.End else Arrangement.Start) {
+                        Text(
+                            l.text,
+                            color = Color.White,
+                            style = MaterialTheme.typography.bodyLarge,
+                            modifier = Modifier.clip(RoundedCornerShape(16.dp))
+                                .background(if (l.user) Color(0xFF3A5BD9) else Color(0x33FFFFFF))
+                                .padding(horizontal = 12.dp, vertical = 8.dp),
+                        )
+                    }
+                }
+            }
+
+            Row(
+                Modifier.fillMaxWidth().padding(bottom = 36.dp),
+                horizontalArrangement = Arrangement.SpaceEvenly,
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                RoundButton(if (muted) Icons.Filled.MicOff else Icons.Filled.Mic,
+                    if (muted) "取消静音" else "静音", if (muted) Color(0xFFFF9500) else Color(0x33FFFFFF)) {
+                    live.setMuted(!muted)
+                }
+                RoundButton(Icons.Filled.CallEnd, "挂断", Color(0xFFFF3B30)) { live.stop(); onBack() }
+            }
+        }
+    }
+}
+
+@Composable
+private fun Orb(phase: GeminiLive.Phase, level: Float) {
+    val target = when (phase) {
+        GeminiLive.Phase.SPEAKING -> 1.15f
+        GeminiLive.Phase.LISTENING -> 1f + level * 0.35f
+        else -> 0.9f
+    }
+    val scale by animateFloatAsState(target, label = "orb")
+    Box(Modifier.size(220.dp), contentAlignment = Alignment.Center) {
+        Canvas(Modifier.fillMaxSize()) {
+            val r = size.minDimension / 2f * 0.8f * scale
+            drawCircle(
+                Brush.radialGradient(
+                    listOf(
+                        if (phase == GeminiLive.Phase.SPEAKING) Color(0xFF8E7CFF) else Color(0xFF4FA3FF),
+                        Color(0x004FA3FF),
+                    ),
+                    center = center, radius = r * 1.25f,
+                ),
+                radius = r * 1.25f,
+            )
+        }
+        PetAvatar(size = 120.dp)
+    }
+}
+
+@Composable
+private fun RoundButton(icon: androidx.compose.ui.graphics.vector.ImageVector, label: String, bg: Color, onClick: () -> Unit) {
+    Column(horizontalAlignment = Alignment.CenterHorizontally) {
+        Box(
+            Modifier.size(68.dp).clip(CircleShape).background(bg).clickable(onClick = onClick),
+            contentAlignment = Alignment.Center,
+        ) { Icon(icon, label, tint = Color.White, modifier = Modifier.size(30.dp)) }
+        Spacer(Modifier.height(6.dp))
+        Text(label, color = Color.White, style = MaterialTheme.typography.labelMedium)
