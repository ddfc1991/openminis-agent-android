index 0000000..0859d81
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/AccountLabel.kt
@@ -0,0 +1,68 @@
+package com.openminis.app.plus
+
+/**
+ * [Mines-accounts-31] What an account row on 账号连接 says instead of "账号 1":
+ * how it was connected + a masked identity, e.g.
+ *   "Google 登录 · den•••@gmail.com", "GitHub · ddfc1991", "API Key · sk-•••3f2a".
+ * The full identity is only shown on the account's detail page.
+ */
+object AccountLabel {
+    fun method(kind: ConnectionKind, entry: ConnectionEntry?): String {
+        val via = entry?.via.orEmpty()
+        return when {
+            kind.method == ConnMethod.GOOGLE || PlusVault.baseId(kind.id) in setOf("google", "gcal", "gdrive", "youtube") && via != "key" -> "Google 登录"
+            kind.method == ConnMethod.GITHUB && via != "key" -> "GitHub"
+            kind.method == ConnMethod.MICROSOFT -> "Microsoft 登录"
+            kind.method == ConnMethod.CALENDAR -> "手机日历"
+            kind.method == ConnMethod.A11Y -> "无障碍"
+            via == "key" || via == "token" || kind.method == ConnMethod.KEY -> kind.keyLabel
+            via == "oauth" -> "授权登录"
+            via == "app" -> "应用密码"
+            via == "web" || kind.method == ConnMethod.WEB -> "网页登录"
+            else -> "已连接"
+        }
+    }
+
+    /** "den•••@gmail.com" — keep the first 3 characters of the name and the domain. */
+    fun maskEmail(e: String): String {
+        val at = e.indexOf('@')
+        if (at <= 0) return e
+        val name = e.substring(0, at)
+        return name.take(minOf(3, maxOf(1, name.length - 1))) + "•••" + e.substring(at)
+    }
+
+    /** "sk-•••3f2a" — keep a short prefix (up to the first - or _) and the last 4. */
+    fun maskSecret(s: String): String {
+        val t = s.trim()
+        if (t.length <= 8) return "•••" + t.takeLast(2)
+        val cut = t.take(12).indexOfFirst { it == '-' || it == '_' }
+        val prefix = if (cut in 1..10) t.substring(0, cut + 1) else t.take(2)
+        return prefix + "•••" + t.takeLast(4)
+    }
+
+    /** The phone number style "138••••8658". */
+    private fun maskPhone(p: String): String = if (p.length >= 7) p.take(3) + "••••" + p.takeLast(4) else p
+
+    fun maskIdentity(raw: String): String {
+        val a = raw.trim()
+        return when {
+            a.contains('@') -> maskEmail(a)
+            a.matches(Regex("""\+?\d{7,15}""")) -> maskPhone(a)
+            else -> a // a user name (GitHub login, site handle) is not secret
+        }
+    }
+
+    /** Full identity, or null when nothing is known. */
+    fun identity(id: String, entry: ConnectionEntry?): String? =
+        entry?.account?.trim()?.takeIf { it.isNotBlank() && it != "网页登录" }
+            ?: PlusVault.extra(id, "identity")?.takeIf { it.isNotBlank() }
+
+    /** Row title: "<method> · <masked identity or masked key>". */
+    fun row(id: String, kind: ConnectionKind, entry: ConnectionEntry?): String {
+        val m = method(kind, entry)
+        val ident = identity(id, entry)?.let { maskIdentity(it) }
+            ?: PlusVault.secret(id)?.takeIf { entry?.via == "key" || entry?.via == "token" || kind.method == ConnMethod.KEY }?.let { maskSecret(it) }
+            ?: "未读到账号名"
+        return "$m · $ident"
+    }
+}
