+/**
+ * [Mines-link-31] 快速线路: the HTTPS (wss) link to the server's mines-link worker.
+ * Pairing is one tap when SSH works once (reads /etc/mines-link/phone.txt),
+ * else one paste of the 连接码 the installer printed.
+ */
+@Composable
+private fun LinkSection(server: VpsServer) {
+    val context = LocalContext.current
+    val states by com.openminis.app.plus.MinesLink.states.collectAsState()
+    val scope = androidx.compose.runtime.rememberCoroutineScope()
+    var msg by remember { mutableStateOf<String?>(null) }
+    val paired = com.openminis.app.plus.MinesLink.parse(server.linkUrl) != null
+    LaunchedEffect(server.linkUrl) { if (paired) com.openminis.app.plus.MinesLink.conn(server) }
+    fun save(code: String) {
+        PlusPrefs.update(context) { st -> st.copy(servers = st.servers.map { if (it.id == server.id) it.copy(linkUrl = code.trim()) else it }) }
+        msg = "已保存连接码，正在连接…"
+    }
+    val install = "curl -fsSL https://cdn.jsdelivr.net/gh/ddfc1991/openminis-agent-android@hark-minis-build/hark-build/vps-worker/install.sh | sh"
+    PlusSection("快速线路（HTTPS，抗代理和断线）",
+        footer = if (paired) "任务在服务器上跑，手机断线不会中断；网络恢复后自动续上输出。" else
+            "在服务器上用 root 运行一次下面的安装命令（只装一个小程序，开机自启）。装好后点「自动配置」，或复制它打印的连接码后点「粘贴连接码」。") {
+        val st = states[server.id]
+        Text(
+            when {
+                !paired -> "未配置"
+                st == null -> "正在连接…"
+                else -> st.second
+            },
+            fontSize = 17.sp,
+            color = if (st?.first == com.openminis.app.plus.MinesLink.State.ONLINE) Color(0xFF1F7A3F) else MaterialTheme.colorScheme.onSurface,
+            modifier = Modifier.padding(horizontal = 14.dp, vertical = 10.dp),
+        )
+        msg?.let { Text(it, fontSize = 15.sp, modifier = Modifier.padding(horizontal = 14.dp)) }
+        Row(Modifier.fillMaxWidth().padding(12.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            Button(onClick = {
+                msg = "正在通过 SSH 读取服务器上的连接码…"
+                scope.launch {
+                    val r = kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.IO) {
+                        runCatching { com.openminis.app.plus.VpsSsh.run(context, server.copy(linkUrl = ""), "cat /etc/mines-link/phone.txt 2>/dev/null", 15_000, 2).first.output.trim() }
+                    }
+                    val code = r.getOrNull()?.lines()?.firstOrNull { it.startsWith("mines-link://") }
+                    if (code != null) save(code)
+                    else msg = if (r.isFailure) "SSH 也连不上：${com.openminis.app.plus.VpsSsh.reason(r.exceptionOrNull()!!)}。请粘贴连接码。"
+                        else "服务器上还没装快速线路。请先运行安装命令。"
+                }
+            }, modifier = Modifier.weight(1f).heightIn(min = 52.dp)) { Text("自动配置") }
+            OutlinedButton(onClick = {
+                val cm = context.getSystemService(android.content.ClipboardManager::class.java)
+                val t = cm?.primaryClip?.getItemAt(0)?.coerceToText(context)?.toString()?.trim().orEmpty()
+                val code = Regex("""mines-link://\S+""").find(t)?.value
+                if (code != null && com.openminis.app.plus.MinesLink.parse(code) != null) save(code) else msg = "剪贴板里没有连接码（以 mines-link:// 开头）"
+            }, modifier = Modifier.weight(1f).heightIn(min = 52.dp)) { Text("粘贴连接码") }
+        }
+        TextButton(onClick = {
+            val cm = context.getSystemService(android.content.ClipboardManager::class.java)
+            cm?.setPrimaryClip(android.content.ClipData.newPlainText("install", install))
+            msg = "安装命令已复制"
+        }, modifier = Modifier.padding(horizontal = 6.dp)) { Text("复制安装命令") }
+    }
+}
