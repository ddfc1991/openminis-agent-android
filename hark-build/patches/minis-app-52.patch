+@Composable
+private fun DigestRow(it: Digest.Item, onOpen: () -> Unit, onMenu: () -> Unit) {
+    val catColor = when (it.cat) {
+        Digest.Cat.ACT -> Color(0xFFD93025); Digest.Cat.DEAL -> Color(0xFF1E8E3E); Digest.Cat.LEARN -> Color(0xFF1A73E8)
+        Digest.Cat.HOT -> Color(0xFFE37400); Digest.Cat.OTHER -> Color(0xFF80868B)
+    }
+    Row(Modifier.fillMaxWidth().padding(horizontal = 12.dp, vertical = 5.dp).clip(RoundedCornerShape(16.dp))
+        .background(MaterialTheme.colorScheme.surfaceContainerLow).clickable(onClick = onOpen).padding(12.dp),
+        verticalAlignment = Alignment.CenterVertically) {
+        Box(Modifier.size(44.dp).clip(RoundedCornerShape(12.dp)).background(catColor.copy(alpha = 0.15f)), contentAlignment = Alignment.Center) {
+            Text(sourceGlyph(it.source), fontSize = 18.sp, fontWeight = FontWeight.Bold, color = catColor)
+        }
+        Spacer(Modifier.width(12.dp))
+        Column(Modifier.weight(1f)) {
+            Text((if (it.pinned) "📌 " else "") + it.cat.label + " · " + it.source + (if (it.sender.isNotBlank() && it.sender != it.title) " · " + it.sender else ""),
+                fontSize = 13.sp, color = catColor, maxLines = 1, overflow = TextOverflow.Ellipsis)
+            Text(it.summary.ifBlank { it.title }, fontSize = 17.sp, maxLines = 2, overflow = TextOverflow.Ellipsis)
+        }
+        TextButton(onClick = onMenu) { Text("⋯", fontSize = 22.sp) }
+    }
+}
+
+private fun sourceGlyph(s: String) = when (s) {
+    "微信" -> "微"; "GitHub" -> "GH"; "Trending" -> "★"; "X" -> "X"; "Gmail" -> "M"; "账号巡查" -> "!"; else -> s.take(1)
+}
+
+/** Loads x.com searches for the first followed keywords in a hidden WebView (user's own cookies), extracts posts. */
+@SuppressLint("SetJavaScriptEnabled")
+@Composable
+private fun XReader(tick: Int, onDone: () -> Unit) {
+    val context = LocalContext.current
+    LaunchedEffect(tick) {
+        val wv = WebView(context).apply {
+            settings.javaScriptEnabled = true; settings.domStorageEnabled = true
+            settings.userAgentString = com.openminis.app.plus.MINES_MOBILE_UA
+            webViewClient = WebViewClient()
+        }
+        suspend fun eval(js: String): String = suspendCancellableCoroutine { c ->
+            wv.evaluateJavascript(js) { r -> if (c.isActive) c.resume(runCatching { org.json.JSONTokener(r ?: "\"\"").nextValue() as? String }.getOrNull() ?: "") }
+        }
+        val out = ArrayList<Digest.Item>()
+        val qs = Digest.follows(context).take(4)
+        try {
+            for (q in qs) {
+                wv.loadUrl("https://x.com/search?q=" + Uri.encode(q) + "&f=live")
+                var got = ""
+                repeat(8) { if (got.length < 10) { delay(1500); got = eval(DigestX.EXTRACT_JS) } }
+                out += DigestX.parse(got, q)
+            }
+            wv.loadUrl("https://x.com/i/bookmarks"); delay(5000)
+            out += DigestX.parse(eval(DigestX.EXTRACT_JS), "书签")
+        } finally { runCatching { wv.destroy() } }
+        if (out.isNotEmpty()) { DigestX.store(out.distinctBy { it.id }); onDone() }
+    }
+}
