+/** [Mines-report-31] 一键冒烟测试 + 上报, and 报告问题 (description + screenshot). */
+@Composable
+fun ReportScreen(onBack: () -> Unit) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val uri = LocalUriHandler.current
+    var busy by remember { mutableStateOf<String?>(null) }
+    var checks by remember { mutableStateOf<List<MinesSelfCheck.Check>>(emptyList()) }
+    var result by remember { mutableStateOf<MinesSelfCheck.Filed?>(null) }
+    var desc by remember { mutableStateOf("") }
+    var shot by remember { mutableStateOf<Uri?>(null) }
+    val pick = rememberLauncherForActivityResult(ActivityResultContracts.PickVisualMedia()) { shot = it }
+
+    fun runAndReport() {
+        if (busy != null) return
+        scope.launch {
+            busy = "正在检查…"
+            checks = MinesSelfCheck.runAll(context) { busy = "正在检查：$it" }
+            val fails = checks.filter { !it.ok && !it.warn }
+            busy = "正在上报…"
+            result = MinesSelfCheck.file(context,
+                "[自检] build-${com.openminis.app.BuildConfig.MINES_BUILD} · " + (if (fails.isEmpty()) "全部通过" else "${fails.size} 项失败：" + fails.take(3).joinToString("、") { it.name }),
+                checks)
+            busy = null
+        }
+    }
+
+    fun manual() {
+        if (busy != null || desc.isBlank()) return
+        scope.launch {
+            busy = "正在上报…"
+            val png = shot?.let { u -> withContext(Dispatchers.IO) { runCatching { context.contentResolver.openInputStream(u)?.use { it.readBytes() } }.getOrNull() } }
+            result = MinesSelfCheck.file(context, "[报告问题] " + desc.lines().first().take(60), checks, desc, png)
+            busy = null
+        }
+    }
+
+    PlusPage("测试与上报", onBack) {
+        PlusSection(null, footer = "会检查：模型服务、实时语音握手、账号密钥、无障碍/Shizuku/悬浮窗、沙箱、MCP。结果和日志（密钥、Token 已隐去，邮箱打码）用你连接的 GitHub 账号发成一条问题，Hark 会看。") {
+            Button(onClick = { runAndReport() }, enabled = busy == null,
+                modifier = Modifier.fillMaxWidth().padding(14.dp).heightIn(min = 64.dp)) {
+                Text(busy ?: "一键冒烟测试 + 上报", fontSize = 19.sp, fontWeight = FontWeight.SemiBold)
+            }
+        }
+        result?.let { r ->
+            PlusSection(null) {
+                Text(if (r.ok) "✓ 已上报给 Hark" else "✗ " + r.message, fontSize = 18.sp,
+                    color = if (r.ok) Color(0xFF1F7A3F) else Color(0xFFB3261E), modifier = Modifier.padding(14.dp))
+                if (r.url != null) OutlinedButton(onClick = { uri.openUri(r.url) }, modifier = Modifier.padding(horizontal = 14.dp, vertical = 4.dp)) { Text("打开这条问题") }
+            }
+        }
+        if (checks.isNotEmpty()) PlusSection("检查结果") {
+            checks.forEach { c ->
+                Row(Modifier.fillMaxWidth().padding(horizontal = 14.dp, vertical = 8.dp)) {
+                    Text(if (c.ok) "✓" else if (c.warn) "!" else "✗", fontSize = 18.sp,
+                        color = if (c.ok) Color(0xFF1F7A3F) else if (c.warn) Color(0xFF9A6700) else Color(0xFFB3261E))
+                    Spacer(Modifier.width(10.dp))
+                    Column(Modifier.weight(1f)) {
+                        Text(c.name, fontSize = 16.sp)
+                        Text(c.detail, fontSize = 14.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                    }
+                }
+            }
+        }
+        PlusSection("报告问题", footer = "写一句哪里不对就行；截图可选。") {
+            OutlinedTextField(desc, { desc = it }, label = { Text("哪里不对？") }, minLines = 3,
+                modifier = Modifier.fillMaxWidth().padding(14.dp))
+            OutlinedButton(onClick = { pick.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly)) },
+                modifier = Modifier.fillMaxWidth().padding(horizontal = 14.dp).heightIn(min = 52.dp)) {
+                Text(if (shot != null) "已选截图 ✓（点这里换一张）" else "加一张截图（可选）", fontSize = 16.sp)
+            }
+            Button(onClick = { manual() }, enabled = busy == null && desc.isNotBlank(),
+                modifier = Modifier.fillMaxWidth().padding(14.dp).heightIn(min = 56.dp)) { Text("发给 Hark", fontSize = 18.sp) }
+        }
+    }
+}
