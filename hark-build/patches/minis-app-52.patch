+/** [Mines-digest-31] 消息汇总 page: ranked, categorised, big text, one tap opens the source. */
+@Composable
+fun DigestScreen(onBack: () -> Unit) {
+    val context = LocalContext.current
+    val items by Digest.items.collectAsState()
+    val busy by Digest.busy.collectAsState()
+    val scope = rememberCoroutineScope()
+    var cat by remember { mutableStateOf<Digest.Cat?>(null) }
+    var menuFor by remember { mutableStateOf<Digest.Item?>(null) }
+    var editFollows by remember { mutableStateOf(false) }
+    var xTick by remember { mutableStateOf(0) }
+    LaunchedEffect(Unit) { Digest.refresh(context); xTick++ }
+
+    // X: read the user's own logged-in session in an off-screen WebView (followed keywords, live).
+    if (xTick > 0) XReader(xTick) { scope.launch { Digest.refresh(context) } }
+
+    PlusPage("消息汇总", onBack) {
+        Row(Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()).padding(horizontal = 12.dp, vertical = 8.dp),
+            horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            FilterChip(cat == null, { cat = null }, label = { Text("全部 ${items.size}", fontSize = 16.sp) })
+            Digest.Cat.values().forEach { c ->
+                val n = items.count { it.cat == c }
+                if (n > 0 || c != Digest.Cat.OTHER) FilterChip(cat == c, { cat = if (cat == c) null else c }, label = { Text("${c.label} $n", fontSize = 16.sp) })
+            }
+        }
+        Row(Modifier.fillMaxWidth().padding(horizontal = 12.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            Button(onClick = { scope.launch { Digest.refresh(context) }; xTick++ }, enabled = !busy, modifier = Modifier.weight(1f).heightIn(min = 52.dp)) {
+                Text(if (busy) "正在汇总…" else "刷新", fontSize = 17.sp)
+            }
+            TextButton(onClick = { editFollows = true }, modifier = Modifier.heightIn(min = 52.dp)) { Text("关注的内容", fontSize = 16.sp) }
+        }
+        Digest.lastError?.let { Text(it, fontSize = 13.sp, color = MaterialTheme.colorScheme.onSurfaceVariant, modifier = Modifier.padding(horizontal = 16.dp)) }
+        if (!com.openminis.app.offload.MinisNotificationListenerService.isEnabled(context)) {
+            TextButton(onClick = {
+                runCatching { context.startActivity(Intent(android.provider.Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) }
+            }, modifier = Modifier.padding(horizontal = 8.dp)) { Text("打开「通知使用权」，微信等应用的消息才能汇总进来", fontSize = 15.sp) }
+        }
+        val shown = items.filter { cat == null || it.cat == cat }
+        if (shown.isEmpty() && !busy) Text("现在没有需要看的消息", fontSize = 17.sp, modifier = Modifier.padding(20.dp))
+        shown.take(80).forEach { it -> DigestRow(it, onOpen = {
+            Digest.opened(context, it)
+            val u = it.url
+            runCatching {
+                if (u != null) context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(u)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+                else it.pkg?.let { p -> context.packageManager.getLaunchIntentForPackage(p)?.let { li -> context.startActivity(li.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) } }
+            }
+        }, onMenu = { menuFor = it }) }
+    }
+
+    menuFor?.let { m ->
+        AlertDialog(onDismissRequest = { menuFor = null }, title = { Text(m.source + " · " + m.sender, maxLines = 1) },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Button(onClick = { Digest.pin(context, m); menuFor = null }, modifier = Modifier.fillMaxWidth().heightIn(min = 52.dp)) { Text(if (m.pinned) "取消置顶" else "置顶", fontSize = 17.sp) }
+                    Button(onClick = { Digest.mute(context, m); menuFor = null }, modifier = Modifier.fillMaxWidth().heightIn(min = 52.dp)) { Text("静音此来源", fontSize = 17.sp) }
+                    Button(onClick = { Digest.notInterested(context, m); menuFor = null }, modifier = Modifier.fillMaxWidth().heightIn(min = 52.dp)) { Text("不感兴趣", fontSize = 17.sp) }
+                }
+            }, confirmButton = { TextButton(onClick = { menuFor = null }) { Text("关闭") } })
+    }
+    if (editFollows) {
