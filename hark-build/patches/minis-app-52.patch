@@ -0,0 +1,208 @@
+package com.openminis.app.plus
+
+/**
+ * [Mines-keys-31] Smart API-key acquisition.
+ *
+ * The user only logs in. After that Mines drives the provider's own key page
+ * (in-app WebView with injected JS; Google pages in Chrome through the
+ * accessibility service), creates a key, reads it straight off the page,
+ * saves it encrypted, tests it with one cheap call and shows ✓.
+ *
+ * It stops and asks exactly one simple thing when a step really needs the
+ * user (SMS code, CAPTCHA, payment) and never clicks anything that pays.
+ * Console URLs checked 2026-10-13 against the providers' docs:
+ *  - Gemini: aistudio.google.com/apikey
+ *  - Mistral: console.mistral.ai → API Keys → Create new key (Free mode, no card)
+ *  - Perplexity: console.perplexity.ai/project/settings (project first) → /project/keys (pay-as-you-go, needs credit)
+ *  - Hugging Face: huggingface.co/settings/tokens/new
+ *  - DigitalOcean: cloud.digitalocean.com → Account → API → Generate New Token
+ *  - Cloudflare: dash.cloudflare.com/profile/api-tokens
+ *  - GitHub: github.com/settings/tokens/new (classic, scopes via query)
+ *  - 阿里云百炼: bailian.console.aliyun.com/cn-beijing/model/settings/api-key → 创建 API Key
+ */
+object KeyAgent {
+    enum class Mode { WEBVIEW, CHROME_A11Y }
+
+    /** One step: click the first element whose text matches any label; or fill the name field. */
+    data class Step(val click: List<String> = emptyList(), val fill: String? = null, val optional: Boolean = false)
+
+    data class Recipe(
+        val kindId: String,
+        val mode: Mode,
+        val url: String,
+        val keyRegex: Regex,
+        val steps: List<Step>,
+        /** A page-text hint that the user still has to sign in. */
+        val loginHints: List<String> = listOf("Sign in", "Log in", "登录", "Continue with Google", "Sign up"),
+        /** Plain note shown before starting. */
+        val note: String = "",
+    )
+
+    private val nameField = "Mines"
+
+    val recipes: Map<String, Recipe> = listOf(
+        Recipe("gemini", Mode.CHROME_A11Y, "https://aistudio.google.com/apikey",
+            Regex("""AIza[0-9A-Za-z_\-]{35}"""),
+            listOf(
+                Step(listOf("Create API key", "创建 API 密钥", "创建 API key", "Get API key")),
+                Step(listOf("Create API key in new project", "在新项目中创建 API 密钥", "Create key", "创建密钥", "Create"), optional = true),
+            ),
+            note = "Google 只能在 Chrome 里登录；需要打开 Mines 的无障碍，Mines 才能在 Chrome 里替你点。"),
+        Recipe("mistral", Mode.WEBVIEW, "https://console.mistral.ai/api-keys",
+            Regex("""\b[A-Za-z0-9]{32}\b"""),
+            listOf(
+                Step(listOf("Free", "Experiment", "Activate", "Start for free", "Choose Experiment", "Subscribe to Experiment"), optional = true),
+                Step(listOf("Create new key", "Create API key", "Create key", "New key")),
+                Step(fill = nameField, optional = true),
+                Step(listOf("Create new key", "Create key", "Create")),
+            ),
+            note = "选免费模式（不绑卡）。如果要验证手机号，Mines 会停下来请你填短信验证码。"),
+        Recipe("perplexity", Mode.WEBVIEW, "https://console.perplexity.ai/project/keys",
+            Regex("""pplx-[A-Za-z0-9]{40,}"""),
+            listOf(
+                Step(listOf("Create project", "Create Project", "New project"), optional = true),
+                Step(fill = nameField, optional = true),
+                Step(listOf("Create", "Save"), optional = true),
+                Step(listOf("Create Key", "Create API Key", "Generate", "Create key", "+ Create Key")),
+                Step(fill = nameField, optional = true),
+                Step(listOf("Create", "Generate", "Confirm"), optional = true),
+            ),
+            note = "Perplexity 的 API 要先充值才能用。Mines 只创建密钥，不会替你付钱。"),
+        Recipe("huggingface", Mode.WEBVIEW, "https://huggingface.co/settings/tokens/new?tokenType=read",
+            Regex("""hf_[A-Za-z0-9]{30,}"""),
+            listOf(
+                Step(listOf("Read"), optional = true),
+                Step(fill = nameField),
+                Step(listOf("Create token", "Create")),
+            )),
+        Recipe("digitalocean", Mode.WEBVIEW, "https://cloud.digitalocean.com/account/api/tokens",
+            Regex("""dop_v1_[a-f0-9]{64}"""),
+            listOf(
+                Step(listOf("Generate New Token", "Generate new token", "Create Token")),
+                Step(fill = nameField),
+                Step(listOf("Full Access"), optional = true),
+                Step(listOf("Generate Token", "Generate token")),
+            )),
+        Recipe("cloudflare", Mode.WEBVIEW, "https://dash.cloudflare.com/profile/api-tokens",
+            Regex("""\b[A-Za-z0-9_\-]{40}\b"""),
+            listOf(
+                Step(listOf("Create Token", "创建令牌")),
+                Step(listOf("Use template", "使用模板")),
+                Step(listOf("Continue to summary", "继续以显示摘要", "继续")),
+                Step(listOf("Create Token", "创建令牌")),
+            ),
+            note = "会用 Cloudflare 的第一个模板（编辑区域 DNS）创建令牌，之后可在 Cloudflare 里改权限。"),
+        Recipe("github", Mode.WEBVIEW, "https://github.com/settings/tokens/new?scopes=repo,workflow,read:user,notifications&description=Mines",
+            Regex("""ghp_[A-Za-z0-9]{36}"""),
+            listOf(
+                Step(listOf("Generate token")),
+            )),
+        Recipe("qwen", Mode.WEBVIEW, "https://bailian.console.aliyun.com/cn-beijing/model/settings/api-key",
+            Regex("""sk-[a-f0-9]{32}"""),
+            listOf(
+                Step(listOf("创建 API Key", "创建API Key", "创建 API-KEY", "创建我的API-KEY")),
+                Step(listOf("确定", "确认")),
+                Step(listOf("查看", "显示"), optional = true),
+            ),
+            note = "百炼按量计费、开通免费；Mines 不会点任何充值或购买按钮。"),
+    ).associateBy { it.kindId }
+
+    fun recipe(kindId: String): Recipe? = recipes[PlusVault.baseId(kindId)]
+
+    /** Words that mean "this step costs money": never clicked, the user is told instead. */
+    val payWords = listOf("支付", "付款", "充值", "购买", "下单", "Add payment", "Payment method", "Credit card", "Add credits", "Buy credits", "Upgrade", "Checkout", "Pay ")
+    val captchaWords = listOf("captcha", "CAPTCHA", "人机验证", "Verify you are human", "I'm not a robot", "滑块", "拖动滑块", "安全验证")
+    val smsWords = listOf("verification code", "Verify your phone", "phone number", "SMS", "短信验证码", "手机号", "验证码")
+
+    /** What the user has to do, in one sentence, or null when Mines can continue. */
+    fun needsUser(pageText: String): String? = when {
+        captchaWords.any { pageText.contains(it, true) } -> "页面要你做一次人机验证，请完成后点「继续」"
+        smsWords.any { pageText.contains(it, true) } && (pageText.contains("phone", true) || pageText.contains("手机", true)) ->
+            "要验证手机号：请在页面上填手机号和收到的短信验证码，填好后点「继续」"
+        else -> null
+    }
+
+    /**
+     * JS helper injected into the page. `click(labels)` only clicks buttons /
+     * links whose own text matches, never anything with a payment word.
+     */
+    val JS_HELPER = """
+(function(){
+ if (window.__mines) return;
+ var PAY = ${payWords.joinToString(",", "[", "]") { "\"" + it.trim().lowercase() + "\"" }};
+ function vis(e){ var r=e.getBoundingClientRect(); return r.width>1&&r.height>1&&getComputedStyle(e).visibility!='hidden'; }
+ function txt(e){ return (e.innerText||e.value||e.getAttribute('aria-label')||'').trim(); }
+ window.__mines = {
+  text: function(){
+    var t = document.body ? document.body.innerText : '';
+    var ins = document.querySelectorAll('input,textarea,code,pre');
+    for (var i=0;i<ins.length;i++){ t += '\n' + (ins[i].value||ins[i].innerText||''); }
+    return t;
+  },
+  click: function(labels){
+    var els = Array.prototype.slice.call(document.querySelectorAll('button,a,[role=button],[role=menuitem],[role=radio],[role=tab],label,div[tabindex],span'));
+    var want = labels.map(function(l){return l.toLowerCase();});
+    for (var pass=0; pass<2; pass++){
+      for (var i=els.length-1;i>=0;i--){
+        var e=els[i]; if(!vis(e)) continue; var t=txt(e).toLowerCase(); if(!t||t.length>60) continue;
+        if (PAY.some(function(p){return t.indexOf(p)>=0;})) continue;
+        for (var j=0;j<want.length;j++){
+          if ((pass==0 && t==want[j]) || (pass==1 && t.indexOf(want[j])>=0)){
+            if (e.disabled) continue;
+            e.scrollIntoView({block:'center'}); e.click(); return labels[j];
+          }
+        }
+      }
+    }
+    return '';
+  },
+  fill: function(v){
+    var root = document.querySelector('[role=dialog]') || document;
+    var ins = root.querySelectorAll('input[type=text],input:not([type]),input[name*=name i]');
+    for (var i=0;i<ins.length;i++){
+      var e=ins[i]; if(!vis(e)||e.readOnly||e.disabled) continue;
+      if (e.value && e.value.length>0) continue;
+      var set = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set; set.call(e,v);
+      e.dispatchEvent(new Event('input',{bubbles:true})); e.dispatchEvent(new Event('change',{bubbles:true}));
+      return 'ok';
+    }
+    return '';
+  }
+ };
+})();
+""".trimIndent()
+
+    /** Find a key in page text; the first match that is not something we already saved. */
+    fun findKey(recipe: Recipe, text: String, known: String?): String? =
+        recipe.keyRegex.findAll(text).map { it.value }.firstOrNull { it != known && !it.all { c -> c.isDigit() } }
+
+    /**
+     * Gemini (and any Chrome page): drive Chrome through Mines' accessibility
+     * service. Blocking; call on IO. [status] gets one-line progress.
+     */
+    fun runChromeA11y(context: android.content.Context, recipe: Recipe, known: String?, cancelled: () -> Boolean, status: (String) -> Unit): String? {
+        val ui = com.openminis.app.sandbox.offload.FastUi(context)
+        if (!ui.ready()) { status("没有打开 Mines 的无障碍：请复制密钥后回到这里，Mines 会自动填入"); return null }
+        val until = System.currentTimeMillis() + 4 * 60_000
+        var step = 0
+        var waitedLogin = false
+        while (!cancelled() && System.currentTimeMillis() < until) {
+            Thread.sleep(1500)
+            val text = ui.allText()
+            val found = findKey(recipe, text, known)
+            if (found != null) return found
+            val ask = needsUser(text)
+            if (ask != null) { status(ask); continue }
+            if (recipe.loginHints.any { text.contains(it) } && step == 0) {
+                if (!waitedLogin) status("请在 Chrome 里登录，登录好 Mines 会自动继续"); waitedLogin = true; continue
+            }
+            if (step < recipe.steps.size) {
+                val s = recipe.steps[step]
+                val ok = s.click.isNotEmpty() && s.click.any { ui.tapText(it) }
+                if (ok) { status("已点「${s.click.first()}」…"); step++ }
+                else if (s.optional) step++
+            } else status("正在读取新密钥…")
+        }
+        return null
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/KeyTester.kt b/src/android/app/src/main/java/com/openminis/app/plus/KeyTester.kt
new file mode 100644
index 0000000..671fbdd
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/KeyTester.kt
@@ -0,0 +1,85 @@
+package com.openminis.app.plus
+
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONObject
+import java.net.InetSocketAddress
+import java.net.Proxy
+import java.util.concurrent.TimeUnit
+
+/**
+ * [Mines-keys-31] One cheap call per provider to prove a key works, and read
+ * the account name when the provider says it ("who am I"). Never spends money
+ * beyond a 1-token request where no free endpoint exists (Perplexity).
+ * Domestic providers go direct; overseas ones try direct, then the local
+ * proxies Mines knows (分流代理 / VPN-app ports).
+ */
+object KeyTester {
+    data class Result(val ok: Boolean, val message: String, val identity: String? = null, val needsCredit: Boolean = false)
+
+    private val domestic = setOf("qwen", "deepseek", "kimi", "zhipu", "siliconflow", "aliyun")
+
+    private fun clients(base: String): List<OkHttpClient> {
+        fun c(p: Proxy) = OkHttpClient.Builder().proxy(p).connectTimeout(8, TimeUnit.SECONDS)
+            .readTimeout(15, TimeUnit.SECONDS).callTimeout(25, TimeUnit.SECONDS).build()
+        val out = arrayListOf(c(Proxy.NO_PROXY))
+        if (base !in domestic) {
+            if (SplitProxy.active) out += c(Proxy(Proxy.Type.HTTP, InetSocketAddress("127.0.0.1", SplitProxy.PORT)))
+            SplitProxy.settings.value.all.take(2).forEach { u ->
+                runCatching { out += c(Proxy(if (u.type == "socks5") Proxy.Type.SOCKS else Proxy.Type.HTTP, InetSocketAddress(u.host, u.port))) }
+            }
+        }
+        return out
+    }
+
+    private data class Http(val code: Int, val body: String)
+
+    private fun call(base: String, req: Request): Http {
+        var last: Exception? = null
+        for (cl in clients(base)) {
+            try { cl.newCall(req).execute().use { r -> return Http(r.code, r.body?.string().orEmpty().take(4000)) } }
+            catch (e: Exception) { last = e }
+        }
+        throw last ?: IllegalStateException("连不上")
+    }
+
+    private fun bearer(url: String, key: String) = Request.Builder().url(url).header("Authorization", "Bearer $key").build()
+
+    fun test(baseId: String, key: String): Result = runCatching { testInner(baseId, key.trim()) }
+        .getOrElse { Result(false, "测试时连不上服务器：${it.message?.take(80)}") }
+
+    private fun testInner(base: String, key: String): Result {
+        fun verdict(h: Http, ident: (JSONObject) -> String? = { null }): Result = when {
+            h.code in 200..299 -> Result(true, "可以用", runCatching { ident(JSONObject(h.body)) }.getOrNull()?.takeIf { it.isNotBlank() })
+            h.code == 401 || h.code == 403 -> Result(false, "密钥无效或没有权限（HTTP ${h.code}）")
+            h.code == 402 || h.body.contains("insufficient", true) || h.body.contains("credit", true) || h.body.contains("余额", true) ->
+                Result(true, "密钥有效，但账户余额不足，需要你自己充值（Mines 不会替你付钱）", needsCredit = true)
+            h.code == 429 -> Result(true, "密钥有效（暂时限流）")
+            else -> Result(false, "服务器回复 HTTP ${h.code}")
+        }
+        return when (base) {
+            "gemini" -> verdict(call(base, Request.Builder().url("https://generativelanguage.googleapis.com/v1beta/models?pageSize=1&key=$key").build()))
+            "mistral" -> verdict(call(base, bearer("https://api.mistral.ai/v1/models", key)))
+            "perplexity" -> verdict(call(base, Request.Builder().url("https://api.perplexity.ai/chat/completions")
+                .header("Authorization", "Bearer $key")
+                .post("""{"model":"sonar","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}""".toRequestBody("application/json".toMediaType())).build()))
+            "huggingface" -> verdict(call(base, bearer("https://huggingface.co/api/whoami-v2", key))) { it.optString("name") }
+            "digitalocean" -> verdict(call(base, bearer("https://api.digitalocean.com/v2/account", key))) { it.optJSONObject("account")?.optString("email") }
+            "cloudflare" -> verdict(call(base, bearer("https://api.cloudflare.com/client/v4/user/tokens/verify", key)))
+            "github" -> verdict(call(base, bearer("https://api.github.com/user", key))) { it.optString("login") }
+            "qwen" -> verdict(call(base, bearer("https://dashscope.aliyuncs.com/compatible-mode/v1/models", key)))
+            "openai" -> verdict(call(base, bearer("https://api.openai.com/v1/models", key)))
+            "deepseek" -> verdict(call(base, bearer("https://api.deepseek.com/models", key)))
+            "openrouter" -> verdict(call(base, bearer("https://openrouter.ai/api/v1/key", key))) { it.optJSONObject("data")?.optString("label") }
+            "siliconflow" -> verdict(call(base, bearer("https://api.siliconflow.cn/v1/user/info", key))) { it.optJSONObject("data")?.optString("name") }
+            "kimi" -> verdict(call(base, bearer("https://api.moonshot.cn/v1/models", key)))
+            "zhipu" -> verdict(call(base, bearer("https://open.bigmodel.cn/api/paas/v4/models", key)))
+            "xai" -> verdict(call(base, bearer("https://api.x.ai/v1/api-key", key))) { it.optString("name") }
+            "anthropic" -> verdict(call(base, Request.Builder().url("https://api.anthropic.com/v1/models")
+                .header("x-api-key", key).header("anthropic-version", "2023-06-01").build()))
+            else -> Result(true, "已保存（这个服务没有测试接口）")
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/LinkBridge.kt b/src/android/app/src/main/java/com/openminis/app/plus/LinkBridge.kt
new file mode 100644
index 0000000..41b65d9
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/LinkBridge.kt
@@ -0,0 +1,109 @@
+package com.openminis.app.plus
+
+import android.content.Context
+import android.util.Log
+import kotlinx.coroutines.runBlocking
+import java.io.OutputStream
+import java.net.InetAddress
+import java.net.ServerSocket
+import java.net.Socket
+import java.net.URLDecoder
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/**
+ * [Mines-link-31] Loopback bridge so the sandbox's `minis-vps` can use the
+ * app's HTTPS link (MinesLink) instead of its own ssh: the reconnecting /
+ * resuming happens in the app, the sandbox keeps one local HTTP stream.
+ *   127.0.0.1:8792  header X-Mines: $MINIS_LINK_TOKEN
+ *   GET /ping · POST /exec?t=sec · POST /run?name= · GET /attach?name=&since= · GET /jobs · POST /stop?name=
+ * Output of exec/run/attach ends with a line "__MINES_RC=<code>".
+ */
+object LinkBridge {
+    const val PORT = 8792
+    private const val TAG = "LinkBridge"
+    val token: String = java.util.UUID.randomUUID().toString().replace("-", "")
+    @Volatile private var server: ServerSocket? = null
+    private val pool = Executors.newCachedThreadPool()
+
+    fun start(context: Context) {
+        if (server != null) return
+        val app = context.applicationContext
+        runCatching {
+            val ss = ServerSocket(PORT, 16, InetAddress.getByName("127.0.0.1"))
+            server = ss
+            Thread({
+                while (!ss.isClosed) {
+                    val sock = runCatching { ss.accept() }.getOrNull() ?: break
+                    pool.execute { runCatching { handle(app, sock) }.onFailure { Log.w(TAG, "req: ${it.message}") }; runCatching { sock.close() } }
+                }
+            }, "mines-link-bridge").apply { isDaemon = true; start() }
+        }.onFailure { Log.w(TAG, "bridge not started: ${it.message}") }
+    }
+
+    private fun linkServer(id: String?): Pair<VpsServer, MinesLink.Conn>? {
+        val list = PlusPrefs.state.value.servers.filter { it.enabled && MinesLink.parse(it.linkUrl) != null }
+        val s = (if (!id.isNullOrBlank()) list.firstOrNull { it.id == id || it.name == id || it.host == id } else null) ?: list.firstOrNull() ?: return null
+        val c = MinesLink.conn(s) ?: return null
+        return s to c
+    }
+
+    private fun handle(app: Context, sock: Socket) {
+        sock.soTimeout = 30_000
+        val inp = sock.getInputStream().buffered()
+        fun line(): String { val sb = StringBuilder(); while (true) { val c = inp.read(); if (c < 0 || c == '\n'.code) break; if (c != '\r'.code) sb.append(c.toChar()) }; return sb.toString() }
+        val req = line().split(' ')
+        val headers = HashMap<String, String>()
+        while (true) { val l = line(); if (l.isEmpty()) break; val i = l.indexOf(':'); if (i > 0) headers[l.substring(0, i).trim().lowercase()] = l.substring(i + 1).trim() }
+        val out = sock.getOutputStream()
+        if (headers["x-mines"] != token) { reply(out, 403, "forbidden\n"); return }
+        val path = req.getOrNull(1) ?: "/"
+        val q = path.substringAfter('?', "").split('&').mapNotNull { p -> p.split('=', limit = 2).takeIf { it.size == 2 }?.let { it[0] to URLDecoder.decode(it[1], "UTF-8") } }.toMap()
+        val len = headers["content-length"]?.toIntOrNull() ?: 0
+        val body = if (len > 0) String(ByteArray(len).also { var o = 0; while (o < len) { val n = inp.read(it, o, len - o); if (n < 0) break; o += n } }, Charsets.UTF_8) else ""
+        val target = linkServer(q["s"])
+        when (path.substringBefore('?')) {
+            "/ping" -> reply(out, 200, if (target != null && target.second.online) "pong ${target.first.name}\n" else "pong-offline\n")
+            "/exec" -> {
+                val (_, c) = target ?: return reply(out, 503, "no link\n")
+                val r = runBlocking { c.exec(body, q["t"]?.toIntOrNull() ?: 600) }
+                if (r == null) reply(out, 503, "link offline\n") else reply(out, 200, r.second + (if (r.second.endsWith("\n") || r.second.isEmpty()) "" else "\n") + "__MINES_RC=${r.first}\n")
+            }
+            "/run", "/attach" -> {
+                val (_, c) = target ?: return reply(out, 503, "no link\n")
+                val name = q["name"] ?: ("run-" + System.currentTimeMillis())
+                out.write("HTTP/1.0 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n".toByteArray()); out.flush()
+                val done = CountDownLatch(1); var rc = 1
+                val onOut: (ByteArray) -> Unit = { b -> synchronized(out) { runCatching { out.write(b); out.flush() } } }
+                val onExit: (Int) -> Unit = { code -> rc = code; done.countDown() }
+                val ok = runBlocking {
+                    if (path.startsWith("/run")) c.runJob(name, body, onOut, onExit) else c.attach(name, q["since"]?.toLongOrNull() ?: 0, onOut, onExit)
+                }
+                if (!ok) { out.write("\n__MINES_RC=255\n".toByteArray()); return }
+                sock.soTimeout = 0
+                // The phone link may drop and come back meanwhile; MinesLink resumes the stream.
+                done.await(24, TimeUnit.HOURS)
+                synchronized(out) { runCatching { out.write("\n__MINES_RC=$rc\n".toByteArray()); out.flush() } }
+            }
+            "/jobs" -> {
+                val (_, c) = target ?: return reply(out, 503, "no link\n")
+                val j = runBlocking { c.jobs() }
+                if (j == null) reply(out, 503, "link offline\n") else reply(out, 200, j + "\n")
+            }
+            "/start" -> {
+                val (_, c) = target ?: return reply(out, 503, "no link\n")
+                val name = q["name"] ?: ("bg-" + System.currentTimeMillis())
+                if (runBlocking { c.startOnly(name, body) }) reply(out, 200, "started $name\n") else reply(out, 503, "link offline\n")
+            }
+            "/stop" -> { target?.second?.stop(q["name"] ?: ""); reply(out, 200, "ok\n") }
+            else -> reply(out, 404, "not found\n")
+        }
+    }
+
+    private fun reply(out: OutputStream, code: Int, text: String) {
+        val b = text.toByteArray()
+        out.write("HTTP/1.0 $code X\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: ${b.size}\r\n\r\n".toByteArray())
+        out.write(b); out.flush()
+    }
+}
