+                    Text(if (c.ok) "✓" else if (c.warn) "!" else "✗", fontSize = 18.sp,
+                        color = if (c.ok) Color(0xFF1F7A3F) else if (c.warn) Color(0xFF9A6700) else Color(0xFFB3261E))
+                    Spacer(Modifier.width(10.dp))
+                    Column(Modifier.weight(1f)) {
+                        Text(c.name, fontSize = 16.sp)
+                        Text(c.detail, fontSize = 14.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                    }
+                }
+            }
+        }
+        PlusSection("报告问题", footer = "写一句哪里不对就行；截图可选。") {
+            OutlinedTextField(desc, { desc = it }, label = { Text("哪里不对？") }, minLines = 3,
+                modifier = Modifier.fillMaxWidth().padding(14.dp))
+            OutlinedButton(onClick = { pick.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly)) },
+                modifier = Modifier.fillMaxWidth().padding(horizontal = 14.dp).heightIn(min = 52.dp)) {
+                Text(if (shot != null) "已选截图 ✓（点这里换一张）" else "加一张截图（可选）", fontSize = 16.sp)
+            }
+            Button(onClick = { manual() }, enabled = busy == null && desc.isNotBlank(),
+                modifier = Modifier.fillMaxWidth().padding(14.dp).heightIn(min = 56.dp)) { Text("发给 Hark", fontSize = 18.sp) }
+        }
+    }
+}
