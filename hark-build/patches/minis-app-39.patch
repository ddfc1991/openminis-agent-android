diff --git a/src/android/app/src/main/java/com/openminis/app/plus/DeskPetService.kt b/src/android/app/src/main/java/com/openminis/app/plus/DeskPetService.kt
--- a/src/android/app/src/main/java/com/openminis/app/plus/DeskPetService.kt
+++ b/src/android/app/src/main/java/com/openminis/app/plus/DeskPetService.kt
@@ -282,12 +282,20 @@
             val petSize = height / 1.6f
             val left = width - petSize
             val topY = height - petSize
-            // Gentle bob only (no blink): the characters are pictures.
-            val bob = if (held) -0.03f else sin(t * 2.2f) * 0.018f
+            // [Mines-pet-motion] Dropped the old `bob` local: it was a single
+            // 1.8%-amplitude sine, replaced below by breathing + sway + dip.
+            // [Mines-pet-motion] Same three composable motions AvatarView got:
+            // a 6% breath, a 2.5% sway out of phase, and a brief dip on a ~4 s
+            // cycle. The old single 1.8%-amplitude sine at 12 fps was
+            // effectively a still image.
+            val breathing = sin(t * 1.6f) * 0.06f
+            val sway = sin(t * 0.9f + 1.1f) * 0.025f
+            val dip = if (((t * 1000f) % 4000f) < 120f) 0.94f else 1f
             canvas.save()
             canvas.translate(left, topY)
             renderer.draw(canvas, petSize, petSize, st.petStyle, face = false,
-                ringColor = if (st.petStyle == Avatars.CUSTOM) st.petColor else null, bob = bob,
+                ringColor = if (st.petStyle == Avatars.CUSTOM) st.petColor else null, bob = breathing,
+                sway = sway, squash = dip,
                 crop = AvatarCrop(st.avatarScale, st.avatarOffX, st.avatarOffY),
                 version = st.avatarVersion, noBg = st.avatarRemoveBg)
             canvas.restore()
