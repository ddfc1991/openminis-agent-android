+                    .border(1.dp, m.glassBorder, RoundedCornerShape(18.dp)).padding(horizontal = 16.dp, vertical = 5.dp)
+                    .semantics(mergeDescendants = true) {},
+                horizontalAlignment = Alignment.CenterHorizontally,
+            ) {
+                Text(name, fontSize = 16.sp, lineHeight = 21.sp, fontWeight = FontWeight.SemiBold, color = m.ink, maxLines = 1)
+                Row(verticalAlignment = Alignment.CenterVertically) {
