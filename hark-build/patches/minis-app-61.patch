+/** One entry of the bottom bar. */
+data class WarmNavItem(val label: String, val icon: ImageVector, val badge: Int = 0, val onClick: () -> Unit)
+
+/** Bottom bar: 对话 · 消息 · 灵感 · 任务 · 应用, a frosted pill; 消息 carries the red count of things to handle. */
+@Composable
+fun WarmNavBar(items: List<WarmNavItem>, current: Int, modifier: Modifier = Modifier) {
+    val m = mines()
+    val shape = RoundedCornerShape(30.dp)
+    Row(
+        modifier.fillMaxWidth().padding(horizontal = 14.dp, vertical = 8.dp)
+            .shadow(if (m.dark) 0.dp else 6.dp, shape, clip = false, ambientColor = Color(0x333C2814), spotColor = Color(0x333C2814))
+            .clip(shape).background(minesGlassFill(strong = true)).border(1.dp, m.glassBorder, shape)
+            .heightIn(min = 68.dp).padding(horizontal = 4.dp, vertical = 6.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        items.forEachIndexed { i, it ->
+            val on = i == current
+            val fg = if (on) m.primaryText else m.ink2
+            Column(
+                Modifier.weight(1f).heightIn(min = 56.dp).clip(RoundedCornerShape(18.dp)).clickable(onClick = it.onClick)
+                    .semantics(mergeDescendants = true) {
+                        contentDescription = it.label + (if (it.badge > 0) "，${it.badge} 件要处理" else ""); this.selected = on; role = Role.Tab
+                    },
+                horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.Center,
+            ) {
+                Box {
+                    MinesIcon(it.icon, null, tint = fg, modifier = Modifier.padding(top = 2.dp).size(26.dp))
+                    if (it.badge > 0) Box(Modifier.align(Alignment.TopEnd).offset(x = 12.dp, y = (-6).dp).heightIn(min = 20.dp).widthIn(min = 20.dp)
+                        .clip(RoundedCornerShape(50)).background(MinesDesign.DangerFill).border(1.5.dp, m.bg, RoundedCornerShape(50))
+                        .padding(horizontal = 5.dp), contentAlignment = Alignment.Center) {
+                        Text(if (it.badge > 99) "99+" else it.badge.toString(), fontSize = 12.sp, lineHeight = 14.sp, fontWeight = FontWeight.Bold, color = Color.White, maxLines = 1)
+                    }
+                }
+                Text(it.label, fontSize = 14.sp, lineHeight = 18.sp, fontWeight = if (on) FontWeight.Bold else FontWeight.Medium, color = fg,
+                    maxLines = 1, softWrap = false)
+            }
+        }
+    }
+}
