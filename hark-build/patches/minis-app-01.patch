index 0000000..01db9e9
--- /dev/null
+++ b/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-dsh
@@ -0,0 +1,123 @@
+#!/bin/sh
+# minis-dsh: use DeepSeek Harness (dsh) plugins in Minis, without installing dsh.
+#
+#   minis-dsh add <npm-package | github:owner/repo>   install a dsh plugin
+#   minis-dsh remove <package>                          uninstall it
+#   minis-dsh list                                      what is installed and which tools each one adds
+#   minis-dsh off|on <package>                          disable / re-enable without uninstalling
+#
+# All plugins share ONE MCP server named "dsh" in Minis (started only when a
+# tool is called), so adding plugins doesn't add background processes.
+# Works for plugins that add tools / prompt sections; plugins that need dsh's
+# own model loop, sessions or web UI are reported as unsupported.
+set -e
+H="${MINIS_DSH_HOME:-$HOME/.minis-dsh}"
+SOCK=/usr/local/lib/minis-dsh/socket.mjs
+SERVERS="${MINIS_MCP_SERVERS:-/var/minis/mcp-servers/servers.json}"
+mkdir -p "$H"
+[ -f "$H/package.json" ] || printf '{"name":"minis-dsh-plugins","private":true,"type":"module"}\n' > "$H/package.json"
+[ -f "$H/plugins.json" ] || printf '{"plugins":[]}\n' > "$H/plugins.json"
+
+need_node() {
+    command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 && return
+    echo "第一次使用，正在安装 Node.js（只装一次）…" >&2
+    apk add --no-cache nodejs npm >/dev/null
+}
+
+# Edit plugins.json / servers.json with node (always present after need_node).
+js() { node --input-type=module -e "$1" -- "$@"; }
+
+register_mcp() {
+    [ -f "$SERVERS" ] || { echo "minis-dsh: 找不到 Minis 的 MCP 配置（$SERVERS）" >&2; return 0; }
+    NODE_BIN=$(command -v node)
+    SERVERS="$SERVERS" NODE_BIN="$NODE_BIN" SOCK="$SOCK" H="$H" node --input-type=module -e '
+      import fs from "node:fs"
+      const f = process.env.SERVERS
+      const j = JSON.parse(fs.readFileSync(f, "utf8") || "{}")
+      j.mcpServers ||= {}
+      j.mcpServers.dsh = { command: process.env.NODE_BIN, args: [process.env.SOCK],
+        env: { MINIS_DSH_HOME: process.env.H }, note: "dsh 插件插座（minis-dsh 管理）" }
+      fs.writeFileSync(f, JSON.stringify(j, null, 2))
+    '
+}
+
+unregister_if_empty() {
+    [ -f "$SERVERS" ] || return 0
+    H="$H" SERVERS="$SERVERS" node --input-type=module -e '
+      import fs from "node:fs"
+      const p = JSON.parse(fs.readFileSync(process.env.H + "/plugins.json", "utf8"))
+      if ((p.plugins || []).length) process.exit(0)
+      const j = JSON.parse(fs.readFileSync(process.env.SERVERS, "utf8"))
+      if (j.mcpServers) delete j.mcpServers.dsh
+      fs.writeFileSync(process.env.SERVERS, JSON.stringify(j, null, 2))
+    '
+}
+
+set_state() { # op pkg
+    H="$H" OP="$1" PKG="$2" node --input-type=module -e '
+      import fs from "node:fs"
+      const f = process.env.H + "/plugins.json"
+      const j = JSON.parse(fs.readFileSync(f, "utf8")); j.plugins ||= []
+      const pkg = process.env.PKG, op = process.env.OP
+      const i = j.plugins.findIndex(p => p.package === pkg)
+      if (op === "add") { if (i < 0) j.plugins.push({ package: pkg, enabled: true }); else j.plugins[i].enabled = true }
+      if (op === "remove" && i >= 0) j.plugins.splice(i, 1)
+      if (op === "off" && i >= 0) j.plugins[i].enabled = false
+      if (op === "on" && i >= 0) j.plugins[i].enabled = true
+      fs.writeFileSync(f, JSON.stringify(j, null, 2))
+    '
+}
+
+# npm spec -> installed package name
+pkg_name() {
+    case "$1" in
+        github:*|*/*.git|https://*|git+*)
+            (cd "$H" && node -e 'const d=require("./package.json").dependencies||{};const s=process.argv[1];for(const[k,v]of Object.entries(d))if(v.includes(s.replace(/^github:/,"").replace(/^https:\/\/github.com\//,"").replace(/\.git$/,""))){console.log(k);process.exit(0)}' "$1") ;;
+        @*/*@*) echo "${1%@*}" ;;
+        @*) echo "$1" ;;
+        *@*) echo "${1%%@*}" ;;
+        *) echo "$1" ;;
+    esac
+}
+
+cmd="${1:-help}"; [ $# -gt 0 ] && shift
+case "$cmd" in
+add)
+    [ -n "$1" ] || { echo "用法: minis-dsh add <npm 包名 或 github:用户/仓库>" >&2; exit 2; }
+    need_node
+    echo "安装 $1 …" >&2
+    NPMI="npm install --no-audit --no-fund --omit=dev --ignore-scripts --legacy-peer-deps"
+    # The pieces of dsh that plugins import directly (about 11 MB, installed once).
+    [ -d "$H/node_modules/@deepseek-ai/dsh-tools" ] || (cd "$H" && $NPMI @deepseek-ai/dsh-tools@next @deepseek-ai/cordis@next \
+        @deepseek-ai/dsh-scope@next @deepseek-ai/dsh-llm@next @deepseek-ai/dsh-sandbox@next >&2) || true
+    (cd "$H" && $NPMI "$1" >&2)
+    name=$(pkg_name "$1"); [ -n "$name" ] || name="$1"
+    set_state add "$name"
+    # Fill in any other dsh library the plugin imports (only @deepseek-ai/*).
+    i=0
+    while [ $i -lt 8 ]; do
+        miss=$(MINIS_DSH_HOME="$H" node "$SOCK" --check 2>&1 | grep -F "$name" | grep -o "Cannot find package '@deepseek-ai/[^']*'" | sed "s/Cannot find package '//;s/'//" | head -1)
+        [ -n "$miss" ] || break
+        echo "补装 $miss …" >&2
+        (cd "$H" && { $NPMI "$miss@next" >/dev/null 2>&1 || $NPMI "$miss" >/dev/null 2>&1; }) || break
+        i=$((i+1))
+    done
+    register_mcp
+    MINIS_DSH_HOME="$H" node "$SOCK" --check | grep -F "$name" || true
+    ;;
+remove|rm)
+    need_node
+    name=$(pkg_name "$1")
+    set_state remove "$name"
+    (cd "$H" && npm uninstall --no-audit --no-fund "$name" >/dev/null 2>&1) || true
+    unregister_if_empty
+    echo "已卸载 $name"
+    ;;
+off|on)
+    need_node; set_state "$cmd" "$1"; echo "$1: $cmd" ;;
+list|ls)
+    need_node
+    MINIS_DSH_HOME="$H" node "$SOCK" --check
+    ;;
+*) sed -n '2,13p' "$0" ;;
+esac
diff --git a/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-vps b/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-vps
new file mode 100755
index 0000000..c1033ef
--- /dev/null
+++ b/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-vps
@@ -0,0 +1,116 @@
+#!/bin/sh
+# minis-vps: use a VPS as Minis' back-end processor, over plain ssh.
+#
+# Modelled on nanoMuse's `nanomuse-pc ... --on <device>` (run on the computer,
+# get the answer back on the phone), minus the relay: the phone dials the VPS
+# directly, so nothing has to listen on the phone and no account is needed.
+#
+#   minis-vps setup user@host [port]   make a key, install it on the VPS (asks the password once)
+#   minis-vps run  <command...>        run a command on the VPS, stream output back
+#   minis-vps bg   <name> <command...> start a long job on the VPS that survives disconnects
+#   minis-vps logs <name>              tail a background job's log
+#   minis-vps put  <local> [remote]    copy a file/dir to the VPS
+#   minis-vps get  <remote> [local]    copy a file/dir back
+#   minis-vps shell                    interactive login
+#   minis-vps status                   quick health: uptime, memory, disk, public IP
+#   minis-vps attach <name>            follow a background job live; reconnects by itself if the network drops
+#   minis-vps jobs                     list background jobs and whether they are still running
+#   minis-vps servers                  list the servers Minis Plus is using, fastest first
+#
+# Minis Plus: servers added under 设置 → 工作位置 arrive as MINIS_VPS_SERVERS
+# (user@host:port,… ordered by latency). Every command tries them in order and
+# moves to the next one when a server can't be reached.
+set -e
+CONF="$HOME/.config/minis-vps"
+KEY="$HOME/.ssh/minis_vps_ed25519"
+mkdir -p "$HOME/.ssh" "$(dirname "$CONF")"; chmod 700 "$HOME/.ssh"
+
+need_ssh() {
+    command -v ssh >/dev/null 2>&1 && return
+    echo "installing openssh-client…" >&2
+    apk add --no-cache openssh-client rsync >/dev/null
+}
+set_target() { VPS_TARGET="${1%:*}"; VPS_PORT="${1##*:}"; }
+load() {
+    SERVERS=""
+    if [ -n "$MINIS_VPS_SERVERS" ] && [ "$MINIS_VPS_SERVERS" != none ]; then
+        SERVERS=$(printf '%s' "$MINIS_VPS_SERVERS" | tr ',' ' ')
+    elif [ -f "$CONF" ]; then
+        . "$CONF"; SERVERS="$VPS_TARGET:$VPS_PORT"
+    else
+        echo "minis-vps: no server. Add one in 设置 → 工作位置, or run: minis-vps setup user@host [port]" >&2; exit 2
+    fi
+    set_target "${SERVERS%% *}"
+}
+SSH_OPTS="-o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new"
+# Try each server in order; ssh exits 255 only when it couldn't connect.
+s() {
+    for srv in $SERVERS; do
+        set_target "$srv"
+        if ssh $SSH_OPTS -i "$KEY" -p "$VPS_PORT" "$VPS_TARGET" "$@"; then return 0; else rc=$?; fi
+        [ "$rc" -ne 255 ] && return "$rc"
+        echo "minis-vps: $VPS_TARGET:$VPS_PORT 连不上，换下一台…" >&2
+    done
+    echo "minis-vps: 所有服务器都连不上" >&2
+    return 255
+}
+# Ship a command to the VPS without any quoting layer: base64 it locally, decode
+# and run it remotely. Quotes, ;, $, newlines all arrive exactly as typed.
+b64() { printf '%s' "$1" | base64 | tr -d '\n'; }
+# One argument = a shell script ("cd app && make"). Several = an argv, each
+# word single-quoted so `minis-vps run echo "it's"` prints it's.
+script() {
+    if [ $# -eq 1 ]; then printf '%s' "$1"; return; fi
+    for w; do printf "'%s' " "$(printf '%s' "$w" | sed "s/'/'\\\\''/g")"; done
+}
+valid_name() { case "$1" in ''|*[!A-Za-z0-9._-]*) echo "minis-vps: job name must be letters, digits, . _ -" >&2; exit 2;; esac; }
+
+cmd="${1:-help}"; [ $# -gt 0 ] && shift
+case "$cmd" in
+setup)
+    need_ssh
+    [ -n "$1" ] || { echo "usage: minis-vps setup user@host [port]" >&2; exit 2; }
+    printf 'VPS_TARGET=%s\nVPS_PORT=%s\n' "$1" "${2:-22}" > "$CONF"
+    . "$CONF"; SERVERS="$VPS_TARGET:$VPS_PORT"
+    [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N '' -C "minis@phone" -f "$KEY"
+    echo "Installing the key on $VPS_TARGET (enter the VPS password once)…"
+    echo "Note: the VPS host key is trusted on first connect (accept-new). Do this on a network you trust." >&2
+    # The key travels on stdin, never inside the remote command string.
+    ssh -o StrictHostKeyChecking=accept-new -p "$VPS_PORT" "$VPS_TARGET" \
+        'umask 077; mkdir -p ~/.ssh ~/minis-jobs; k=$(cat); touch ~/.ssh/authorized_keys; grep -qxF "$k" ~/.ssh/authorized_keys || printf "%s\n" "$k" >> ~/.ssh/authorized_keys' < "$KEY.pub"
+    s 'echo ok: $(hostname)'
+    ;;
+run)    need_ssh; load; s "sh -c \"\$(echo $(b64 "$(script "$@")") | base64 -d)\"" ;;
+bg)
+    need_ssh; load
+    name="$1"; shift; valid_name "$name"
+    s "mkdir -p ~/minis-jobs; cd ~; echo $(b64 "$(script "$@")") | base64 -d > ~/minis-jobs/$name.sh; nohup sh ~/minis-jobs/$name.sh > ~/minis-jobs/$name.log 2>&1 < /dev/null & echo \$! > ~/minis-jobs/$name.pid; echo started $name pid \$(cat ~/minis-jobs/$name.pid) on \$(hostname)"
+    mkdir -p "$HOME/.config/minis-vps-jobs"; printf '%s:%s\n' "$VPS_TARGET" "$VPS_PORT" > "$HOME/.config/minis-vps-jobs/$name"
+    ;;
+logs)   need_ssh; load; valid_name "$1"
+        [ -f "$HOME/.config/minis-vps-jobs/$1" ] && SERVERS=$(cat "$HOME/.config/minis-vps-jobs/$1")
+        s "tail -n ${2:-100} ~/minis-jobs/$1.log" ;;
+put)    need_ssh; load; rsync -az -e "ssh $SSH_OPTS -i $KEY -p $VPS_PORT" "$1" "$VPS_TARGET:${2:-~/}" ;;
+get)    need_ssh; load; rsync -az -e "ssh $SSH_OPTS -i $KEY -p $VPS_PORT" "$VPS_TARGET:$1" "${2:-.}" ;;
+shell)  need_ssh; load; ssh -t -i "$KEY" -p "$VPS_PORT" -o ServerAliveInterval=15 "$VPS_TARGET" ;;
+status) need_ssh; load; s 'uptime; free -m | sed -n 2p; df -h / | tail -1; curl -s --max-time 5 https://ipinfo.io/ip; echo' ;;
+attach)
+    need_ssh; load; valid_name "$1"
+    [ -f "$HOME/.config/minis-vps-jobs/$1" ] && SERVERS=$(cat "$HOME/.config/minis-vps-jobs/$1")
+    cache="$HOME/.cache/minis-vps/$1.log"; mkdir -p "$(dirname "$cache")"; : > "$cache"
+    tail -n +1 -f "$cache" & tp=$!
+    trap 'kill $tp 2>/dev/null' EXIT INT TERM
+    set +e
+    while :; do
+        off=$(wc -c < "$cache")
+        s "f=~/minis-jobs/$1; [ -f \$f.log ] || { echo 'minis-vps: no such job' >&2; exit 3; }; tail -c +$((off+1)) -f \$f.log & t=\$!; while kill -0 \$(cat \$f.pid) 2>/dev/null; do sleep 2; done; sleep 1; kill \$t" >> "$cache"
+        rc=$?
+        [ "$rc" -ne 255 ] && break
+        echo "minis-vps: 断线了，3 秒后从断点续上…" >&2; sleep 3
+    done
+    sleep 1; echo "minis-vps: $1 已结束" >&2
+    ;;
+jobs)   need_ssh; load; s 'cd ~/minis-jobs 2>/dev/null || exit 0; for p in *.pid; do [ -f "$p" ] || continue; n=${p%.pid}; if kill -0 $(cat "$p") 2>/dev/null; then st=running; else st=done; fi; echo "$n $st"; done' ;;
+servers) load; for srv in $SERVERS; do echo "$srv"; done ;;
+*)      sed -n '2,25p' "$0" ;;
+esac
diff --git a/src/android/app/src/main/assets/default_mount/usr/local/lib/minis-dsh/socket.mjs b/src/android/app/src/main/assets/default_mount/usr/local/lib/minis-dsh/socket.mjs
