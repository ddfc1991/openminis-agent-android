@@ -0,0 +1,10 @@
+# Minis defaults for ssh from the phone sandbox (mobile networks drop idle
+# TCP and change address often). Override per host in ~/.ssh/config.
+Host *
+    ServerAliveInterval 15
+    ServerAliveCountMax 4
+    TCPKeepAlive yes
+    ConnectTimeout 20
+    ConnectionAttempts 3
+    StrictHostKeyChecking accept-new
+    IPQoS none
diff --git a/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-dsh b/src/android/app/src/main/assets/default_mount/usr/local/bin/minis-dsh
