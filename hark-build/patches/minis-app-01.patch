index 0000000..8f87354
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/DeskPetService.kt
@@ -0,0 +1,230 @@
+package com.openminis.app.plus
+
+import android.annotation.SuppressLint
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.RectF
+import android.os.Build
+import android.os.IBinder
+import android.provider.Settings
+import android.view.GestureDetector
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.WindowManager
+import com.openminis.app.MainActivity
+import com.openminis.app.R
+import kotlin.math.abs
+import kotlin.math.sin
+
+/**
+ * Desk pet: the Minis Plus avatar floating over other apps.
+ * Drag to move, tap to say something, double-tap to open Minis,
+ * long-press to tuck it away. Needs "display over other apps".
+ */
+class DeskPetService : Service() {
+
+    companion object {
+        private const val CHANNEL = "minis_plus_pet"
+        private const val NOTIF_ID = 7301
+        const val ACTION_STOP = "com.openminis.app.plus.PET_STOP"
+
+        fun canShow(context: Context) = Settings.canDrawOverlays(context)
+
+        fun start(context: Context) {
+            if (!canShow(context)) return
+            val i = Intent(context, DeskPetService::class.java)
+            runCatching {
+                context.startForegroundService(i)
+            }
+        }
+
+        fun stop(context: Context) {
+            context.stopService(Intent(context, DeskPetService::class.java))
+        }
+    }
+
+    private var wm: WindowManager? = null
+    private var petView: PetView? = null
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (intent?.action == ACTION_STOP) {
+            PlusPrefs.update(this) { it.copy(petEnabled = false) }
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        goForeground()
+        if (petView == null && canShow(this)) addPet()
+        return START_STICKY
+    }
+
+    private fun goForeground() {
+        val nm = getSystemService(NotificationManager::class.java)
+        if (nm.getNotificationChannel(CHANNEL) == null) {
+            nm.createNotificationChannel(
+                NotificationChannel(CHANNEL, "桌宠", NotificationManager.IMPORTANCE_MIN).apply {
+                    setShowBadge(false)
+                }
+            )
+        }
+        val open = PendingIntent.getActivity(
+            this, 0, Intent(this, MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+        val stop = PendingIntent.getService(
+            this, 1, Intent(this, DeskPetService::class.java).setAction(ACTION_STOP),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+        val n: Notification = Notification.Builder(this, CHANNEL)
+            .setSmallIcon(R.mipmap.ic_launcher)
+            .setContentTitle("Minis 桌宠在桌面上")
+            .setContentText("双击它打开 Minis，长按收起")
+            .setContentIntent(open)
+            .addAction(Notification.Action.Builder(null as android.graphics.drawable.Icon?, "收起桌宠", stop).build())
+            .setOngoing(true)
+            .build()
+        if (Build.VERSION.SDK_INT >= 34) {
+            startForeground(NOTIF_ID, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE)
+        } else {
+            startForeground(NOTIF_ID, n)
+        }
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    private fun addPet() {
+        PlusPrefs.init(this)
+        val manager = getSystemService(WINDOW_SERVICE) as WindowManager
+        wm = manager
+        val density = resources.displayMetrics.density
+        val sizePx = (96 * density).toInt()
+        val lp = WindowManager.LayoutParams(
+            (sizePx * 2.2f).toInt(), (sizePx * 1.6f).toInt(),
+            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+            PixelFormat.TRANSLUCENT,
+        ).apply {
+            gravity = Gravity.TOP or Gravity.START
+            x = resources.displayMetrics.widthPixels - (sizePx * 2.2f).toInt()
+            y = (resources.displayMetrics.heightPixels * 0.55f).toInt()
+        }
+        val view = PetView(this)
+        petView = view
+
+        var downX = 0f; var downY = 0f; var startX = 0; var startY = 0; var dragging = false
+        val gestures = GestureDetector(this, object : GestureDetector.SimpleOnGestureListener() {
+            override fun onSingleTapConfirmed(e: MotionEvent): Boolean { view.say(); return true }
+            override fun onDoubleTap(e: MotionEvent): Boolean {
+                startActivity(Intent(this@DeskPetService, MainActivity::class.java)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_REORDER_TO_FRONT))
+                return true
+            }
+            override fun onLongPress(e: MotionEvent) {
+                if (!dragging) {
+                    PlusPrefs.update(this@DeskPetService) { it.copy(petEnabled = false) }
+                    stopSelf()
+                }
+            }
+        })
+        view.setOnTouchListener { _, ev ->
+            gestures.onTouchEvent(ev)
+            when (ev.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    downX = ev.rawX; downY = ev.rawY; startX = lp.x; startY = lp.y; dragging = false
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    val dx = ev.rawX - downX; val dy = ev.rawY - downY
+                    if (dragging || abs(dx) > 12 * density || abs(dy) > 12 * density) {
+                        dragging = true
+                        view.held = true
+                        lp.x = (startX + dx).toInt(); lp.y = (startY + dy).toInt()
+                        runCatching { manager.updateViewLayout(view, lp) }
+                    }
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> { view.held = false }
+            }
+            true
+        }
+        runCatching { manager.addView(view, lp) }.onFailure { stopSelf() }
+    }
+
+    override fun onDestroy() {
+        petView?.let { v -> runCatching { wm?.removeView(v) } }
+        petView = null
+        super.onDestroy()
+    }
+
+    private class PetView(context: Context) : View(context) {
+        private val lines = listOf(
+            "我在这儿陪你～", "今天也要加油！", "有事双击我", "累了就休息一下",
+            "服务器我盯着呢", "喝口水吧", "要我帮你做点什么？", "摸摸头 (•ᴗ•)",
+        )
+        private var bubble: String? = null
+        private var bubbleUntil = 0L
+        private var lastIdx = -1
+        var held = false
+        private val start = System.currentTimeMillis()
+        private val bubblePaint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = Color.parseColor("#222222")
+            textSize = 13f * context.resources.displayMetrics.scaledDensity
+        }
+
+        fun say() {
+            var i: Int
+            do { i = lines.indices.random() } while (i == lastIdx && lines.size > 1)
+            lastIdx = i
+            bubble = lines[i]
+            bubbleUntil = System.currentTimeMillis() + 3000
+            invalidate()
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            super.onDraw(canvas)
+            val st = PlusPrefs.state.value
+            val t = (System.currentTimeMillis() - start) / 1000f
+            val petSize = height / 1.6f
+            val left = width - petSize
+            val topY = height - petSize
+            val blinkCycle = t % 4f
+            val blink = if (blinkCycle > 3.85f) 1f else 0f
+            val bob = if (held) -0.04f else sin(t * 2.4f) * 0.025f
+            canvas.save()
+            canvas.translate(left, topY)
+            PetPainter.draw(canvas, petSize, petSize, st.petStyle, st.petColor,
+                blink = blink, bob = bob, happy = if (bubble != null) 1f else 0.5f)
+            canvas.restore()
+
+            val b = bubble
+            if (b != null) {
+                if (System.currentTimeMillis() > bubbleUntil) bubble = null
+                else {
+                    val pad = 10f * resources.displayMetrics.density
+                    val tw = textPaint.measureText(b)
+                    val bw = tw + pad * 2
+                    val bh = textPaint.textSize + pad * 1.6f
+                    val bx = (width - petSize * 0.6f - bw).coerceAtLeast(0f)
+                    val by = (topY - bh * 0.2f).coerceAtLeast(0f)
+                    bubblePaint.color = Color.argb(70, 0, 0, 0)
+                    canvas.drawRoundRect(RectF(bx + 2, by + 3, bx + bw + 2, by + bh + 3), bh / 2, bh / 2, bubblePaint)
+                    bubblePaint.color = Color.WHITE
+                    canvas.drawRoundRect(RectF(bx, by, bx + bw, by + bh), bh / 2, bh / 2, bubblePaint)
+                    canvas.drawText(b, bx + pad, by + bh / 2 + textPaint.textSize / 3f, textPaint)
+                }
+            }
+            postInvalidateDelayed(33)
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/PetPainter.kt b/src/android/app/src/main/java/com/openminis/app/plus/PetPainter.kt
new file mode 100644
index 0000000..c154112
--- /dev/null
+++ b/src/android/app/src/main/java/com/openminis/app/plus/PetPainter.kt
@@ -0,0 +1,173 @@
+package com.openminis.app.plus
+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+
+/**
+ * Draws the Minis Plus avatar with plain android.graphics so the same
+ * character renders in Compose (Today card, settings) and in the desk-pet
+ * overlay window. Vector-drawn: crisp at any size, no image assets.
+ */
+object PetPainter {
+    val styles = listOf("penguin" to "小企鹅", "cat" to "小猫", "ghost" to "小幽灵")
+    val colors = listOf(
+        0xFF5B8DEF.toInt(), 0xFFFF8A65.toInt(), 0xFF66BB6A.toInt(),
+        0xFFAB47BC.toInt(), 0xFF26C6DA.toInt(), 0xFF455A64.toInt(),
+    )
+
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    private val stroke = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE; strokeCap = Paint.Cap.ROUND
+    }
+
+    /**
+     * @param blink 0 = eyes open, 1 = closed
+     * @param bob vertical offset as a fraction of size (-0.05..0.05)
+     * @param happy 0..1 how big the smile is
+     */
+    fun draw(c: Canvas, w: Float, h: Float, style: String, color: Int,
+             blink: Float = 0f, bob: Float = 0f, happy: Float = 0.5f) {
+        val s = minOf(w, h)
+        val cx = w / 2f
+        val top = (h - s) / 2f + bob * s
+        when (style) {
+            "cat" -> drawCat(c, cx, top, s, color, blink, happy)
+            "ghost" -> drawGhost(c, cx, top, s, color, blink, happy)
+            else -> drawPenguin(c, cx, top, s, color, blink, happy)
+        }
+    }
+
+    private fun shadow(c: Canvas, cx: Float, top: Float, s: Float) {
+        fill.color = Color.argb(40, 0, 0, 0)
+        c.drawOval(RectF(cx - s * 0.28f, top + s * 0.9f, cx + s * 0.28f, top + s * 0.97f), fill)
+    }
+
+    private fun eyes(c: Canvas, cx: Float, y: Float, s: Float, gap: Float, r: Float, blink: Float, light: Boolean = false) {
+        val open = 1f - blink.coerceIn(0f, 1f)
+        for (dx in floatArrayOf(-gap, gap)) {
+            if (open < 0.15f) {
+                stroke.color = Color.parseColor("#222222"); stroke.strokeWidth = s * 0.025f
+                c.drawLine(cx + dx - r, y, cx + dx + r, y, stroke)
+            } else {
+                fill.color = if (light) Color.WHITE else Color.parseColor("#222222")
+                c.drawOval(RectF(cx + dx - r, y - r * open * 1.2f, cx + dx + r, y + r * open * 1.2f), fill)
+                fill.color = if (light) Color.parseColor("#222222") else Color.WHITE
+                val hr = r * 0.38f
+                c.drawCircle(cx + dx + r * 0.3f, y - r * 0.35f * open, hr, fill)
+            }
+        }
+    }
+
+    private fun smile(c: Canvas, cx: Float, y: Float, s: Float, happy: Float, col: Int) {
+        stroke.color = col; stroke.strokeWidth = s * 0.022f
+        val wdt = s * 0.07f
+        val p = Path().apply {
+            moveTo(cx - wdt, y)
+            quadTo(cx, y + s * (0.02f + 0.05f * happy), cx + wdt, y)
+        }
+        c.drawPath(p, stroke)
+    }
+
+    private fun cheeks(c: Canvas, cx: Float, y: Float, s: Float, gap: Float) {
+        fill.color = Color.argb(90, 255, 120, 140)
+        c.drawOval(RectF(cx - gap - s * 0.05f, y - s * 0.025f, cx - gap + s * 0.05f, y + s * 0.025f), fill)
+        c.drawOval(RectF(cx + gap - s * 0.05f, y - s * 0.025f, cx + gap + s * 0.05f, y + s * 0.025f), fill)
+    }
+
+    private fun drawPenguin(c: Canvas, cx: Float, top: Float, s: Float, color: Int, blink: Float, happy: Float) {
+        shadow(c, cx, top, s)
+        // feet
+        fill.color = Color.parseColor("#FFB74D")
+        c.drawOval(RectF(cx - s * 0.22f, top + s * 0.84f, cx - s * 0.04f, top + s * 0.93f), fill)
+        c.drawOval(RectF(cx + s * 0.04f, top + s * 0.84f, cx + s * 0.22f, top + s * 0.93f), fill)
+        // flippers
+        fill.color = darker(color)
+        c.drawOval(RectF(cx - s * 0.38f, top + s * 0.42f, cx - s * 0.22f, top + s * 0.72f), fill)
+        c.drawOval(RectF(cx + s * 0.22f, top + s * 0.42f, cx + s * 0.38f, top + s * 0.72f), fill)
+        // body
+        fill.color = color
+        c.drawOval(RectF(cx - s * 0.3f, top + s * 0.1f, cx + s * 0.3f, top + s * 0.9f), fill)
+        // belly / face
+        fill.color = Color.WHITE
+        c.drawOval(RectF(cx - s * 0.22f, top + s * 0.26f, cx + s * 0.22f, top + s * 0.86f), fill)
+        eyes(c, cx, top + s * 0.38f, s, s * 0.09f, s * 0.045f, blink)
+        cheeks(c, cx, top + s * 0.47f, s, s * 0.15f)
+        // beak
+        fill.color = Color.parseColor("#FFA726")
+        val beak = Path().apply {
+            moveTo(cx - s * 0.05f, top + s * 0.45f)
+            lineTo(cx + s * 0.05f, top + s * 0.45f)
+            lineTo(cx, top + s * 0.5f + s * 0.02f * happy)
+            close()
+        }
+        c.drawPath(beak, fill)
+    }
+
+    private fun drawCat(c: Canvas, cx: Float, top: Float, s: Float, color: Int, blink: Float, happy: Float) {
+        shadow(c, cx, top, s)
+        fill.color = color
+        // tail
+        stroke.color = color; stroke.strokeWidth = s * 0.07f
+        val tail = Path().apply {
+            moveTo(cx + s * 0.22f, top + s * 0.8f)
+            quadTo(cx + s * 0.45f, top + s * 0.75f, cx + s * 0.4f, top + s * 0.5f)
+        }
+        c.drawPath(tail, stroke)
+        // body
+        c.drawOval(RectF(cx - s * 0.26f, top + s * 0.5f, cx + s * 0.26f, top + s * 0.92f), fill)
+        // ears
+        val ears = Path().apply {
+            moveTo(cx - s * 0.3f, top + s * 0.3f); lineTo(cx - s * 0.26f, top + s * 0.06f); lineTo(cx - s * 0.08f, top + s * 0.18f); close()
+            moveTo(cx + s * 0.3f, top + s * 0.3f); lineTo(cx + s * 0.26f, top + s * 0.06f); lineTo(cx + s * 0.08f, top + s * 0.18f); close()
+        }
+        c.drawPath(ears, fill)
+        // head
+        c.drawOval(RectF(cx - s * 0.33f, top + s * 0.13f, cx + s * 0.33f, top + s * 0.62f), fill)
+        // muzzle
+        fill.color = Color.argb(230, 255, 255, 255)
+        c.drawOval(RectF(cx - s * 0.13f, top + s * 0.4f, cx + s * 0.13f, top + s * 0.57f), fill)
+        eyes(c, cx, top + s * 0.34f, s, s * 0.12f, s * 0.045f, blink)
+        cheeks(c, cx, top + s * 0.46f, s, s * 0.19f)
+        fill.color = Color.parseColor("#F06292")
+        c.drawCircle(cx, top + s * 0.44f, s * 0.022f, fill)
+        smile(c, cx, top + s * 0.48f, s, happy, Color.parseColor("#444444"))
+        // whiskers
+        stroke.color = Color.argb(140, 60, 60, 60); stroke.strokeWidth = s * 0.01f
+        for (dy in floatArrayOf(-0.015f, 0.02f)) {
+            c.drawLine(cx - s * 0.15f, top + s * (0.47f + dy), cx - s * 0.3f, top + s * (0.45f + dy * 2), stroke)
+            c.drawLine(cx + s * 0.15f, top + s * (0.47f + dy), cx + s * 0.3f, top + s * (0.45f + dy * 2), stroke)
+        }
+    }
+
+    private fun drawGhost(c: Canvas, cx: Float, top: Float, s: Float, color: Int, blink: Float, happy: Float) {
+        shadow(c, cx, top, s)
+        fill.color = lighter(color)
+        val body = Path().apply {
+            moveTo(cx - s * 0.3f, top + s * 0.85f)
+            lineTo(cx - s * 0.3f, top + s * 0.42f)
+            cubicTo(cx - s * 0.3f, top + s * 0.05f, cx + s * 0.3f, top + s * 0.05f, cx + s * 0.3f, top + s * 0.42f)
+            lineTo(cx + s * 0.3f, top + s * 0.85f)
+            val step = s * 0.6f / 4f
+            for (i in 0 until 4) {
+                val x0 = cx + s * 0.3f - step * i
+                quadTo(x0 - step / 2f, top + s * (if (i % 2 == 0) 0.76f else 0.94f), x0 - step, top + s * 0.85f)
+            }
+            close()
+        }
+        c.drawPath(body, fill)
+        eyes(c, cx, top + s * 0.38f, s, s * 0.1f, s * 0.05f, blink)
+        cheeks(c, cx, top + s * 0.48f, s, s * 0.17f)
+        smile(c, cx, top + s * 0.49f, s, happy, Color.parseColor("#333333"))
+    }
+
+    private fun darker(c: Int): Int = Color.rgb(
+        (Color.red(c) * 0.75f).toInt(), (Color.green(c) * 0.75f).toInt(), (Color.blue(c) * 0.75f).toInt())
+
+    private fun lighter(c: Int): Int = Color.rgb(
+        Color.red(c) + (255 - Color.red(c)) * 6 / 10,
+        Color.green(c) + (255 - Color.green(c)) * 6 / 10,
+        Color.blue(c) + (255 - Color.blue(c)) * 6 / 10)
+}
diff --git a/src/android/app/src/main/java/com/openminis/app/plus/PlusPrefs.kt b/src/android/app/src/main/java/com/openminis/app/plus/PlusPrefs.kt
