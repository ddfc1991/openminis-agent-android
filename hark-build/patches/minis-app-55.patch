+/**
+ * [Mines-voiceprint-34] 语音设置 → 「只听我的声音」: on/off, 录入声纹 (three phrases,
+ * full-screen page), 试一下 (score), sensitivity, 删除. Everything runs on the phone.
+ */
+@Composable
+fun VoiceprintSection() {
+    val c = LocalContext.current
+    val m = mines()
+    var s by remember { mutableStateOf(Voiceprint.settings(c)) }
+    var enrol by remember { mutableStateOf(false) }
+    var msg by remember { mutableStateOf<String?>(null) }
+    var busy by remember { mutableStateOf(false) }
+    val scope = rememberCoroutineScope()
+    val progress by Voiceprint.progress.collectAsState()
+    Column(Modifier.fillMaxWidth(), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+        Text("只听我的声音（声纹）", fontSize = 16.sp, fontWeight = FontWeight.SemiBold, color = m.ink2)
+        Text("录下你的声音后，通话里别人的说话不会传给 AI。全部在手机上识别，不上传。",
+            fontSize = 15.sp, lineHeight = 20.sp, color = m.ink3)
+        Row(Modifier.fillMaxWidth().heightIn(min = 52.dp).clip(RoundedCornerShape(16.dp)).background(m.surface2)
+            .padding(horizontal = 14.dp), verticalAlignment = Alignment.CenterVertically) {
+            Text(if (s.enrolled) "已录入你的声音" else "还没录入", fontSize = 16.sp, color = m.ink, modifier = Modifier.weight(1f))
+            Switch(checked = s.enabled && s.enrolled, enabled = s.enrolled, onCheckedChange = {
+                Voiceprint.setEnabled(c, it); s = Voiceprint.settings(c)
+            }, modifier = Modifier.semantics { contentDescription = "只听我的声音" })
+        }
+        PillButton(if (s.enrolled) "重新录入声纹" else "录入声纹", Modifier.fillMaxWidth(), primary = !s.enrolled) { enrol = true }
+        if (s.enrolled) {
+            Text("灵敏度 ${"%.2f".format(s.threshold)}（越高越严格）", fontSize = 16.sp, color = m.ink)
+            Slider(s.threshold, { Voiceprint.setThreshold(c, (it * 100).toInt() / 100f); s = Voiceprint.settings(c) }, valueRange = 0.30f..0.75f)
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                PillButton(if (busy) "正在听…" else "试一下", Modifier.weight(1f), primary = false, enabled = !busy) {
+                    busy = true; msg = "说一句话（3 秒）…"
+                    scope.launch {
+                        msg = runCatching {
+                            val pcm = Voiceprint.record(3000)
+                            val sc = withContext(Dispatchers.Default) { Voiceprint.score(c, pcm) }
+                            when {
+                                sc == null -> "声音太短，再说长一点"
+                                sc >= s.threshold -> "是你 ✓（相似度 ${"%.2f".format(sc)}）"
+                                else -> "不像你（相似度 ${"%.2f".format(sc)}），可以调低灵敏度或重新录入"
+                            }
+                        }.getOrElse { "没测成：${it.message?.take(60)}" }
+                        busy = false
+                    }
+                }
+                PillButton("删除声纹", Modifier.weight(1f), primary = false) {
+                    Voiceprint.clear(c); s = Voiceprint.settings(c); msg = "已删除"
+                }
+            }
+        }
+        (progress ?: msg)?.let { Text(it, fontSize = 15.sp, color = m.ink2) }
+    }
+    if (enrol) VoiceprintEnrolDialog(onDone = { enrol = false; s = Voiceprint.settings(c) })
+}
+
+@Composable
+fun VoiceprintEnrolDialog(onDone: () -> Unit) {
+    val c = LocalContext.current
+    val m = mines()
+    val scope = rememberCoroutineScope()
+    val clips = remember { mutableStateListOf<ShortArray>() }
+    var step by remember { mutableStateOf(0) }          // phrase index 0..2, 3 = saving/done
+    var recording by remember { mutableStateOf(false) }
+    var msg by remember { mutableStateOf<String?>(null) }
+    var done by remember { mutableStateOf(false) }
+    val progress by Voiceprint.progress.collectAsState()
+    var hasMic by remember {
+        mutableStateOf(ContextCompat.checkSelfPermission(c, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED)
+    }
+    val ask = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { hasMic = it }
+
+    fun recordOne() {
+        if (!hasMic) { ask.launch(Manifest.permission.RECORD_AUDIO); return }
+        recording = true; msg = null
+        scope.launch {
+            runCatching {
+                Voiceprint.ensureModel(c)
+                val pcm = Voiceprint.record(4000)
+                var sum = 0.0; for (v in pcm) sum += v.toDouble() * v
+                if (Math.sqrt(sum / pcm.size.coerceAtLeast(1)) < 250) throw IllegalStateException("没听清，靠近一点再读一遍")
+                clips.add(pcm)
+                if (clips.size >= Voiceprint.PHRASES.size) {
+                    step = Voiceprint.PHRASES.size
+                    val q = withContext(Dispatchers.Default) { Voiceprint.saveEnrolment(c, clips.toList()) }
+                    msg = if (q > 0.6f) "录好了，以后通话只听你的声音。" else "录好了（声音有点不稳，安静的地方重录效果更好）。"
+                    done = true
+                } else step = clips.size
+            }.onFailure { msg = it.message ?: "没录成，再试一次" }
+            recording = false
+        }
+    }
+
+    Dialog(onDismissRequest = { if (!recording) onDone() }, properties = DialogProperties(usePlatformDefaultWidth = false)) {
+        Box(Modifier.fillMaxSize().background(m.bg)) {
+            Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(24.dp),
+                verticalArrangement = Arrangement.spacedBy(16.dp)) {
+                Spacer(Modifier.height(24.dp))
+                Text("录入你的声音", fontSize = 30.sp, fontWeight = FontWeight.Bold, color = m.ink)
+                Text("在安静的地方，按「开始」后用平常的声音读出下面这句。一共三句。", fontSize = 17.sp, lineHeight = 24.sp, color = m.ink2)
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Voiceprint.PHRASES.indices.forEach { i ->
+                        Box(Modifier.size(12.dp).clip(CircleShape).background(if (i < clips.size) m.primary else m.hairline))
+                    }
+                }
+                val phrase = Voiceprint.PHRASES.getOrNull(step)
+                Column(Modifier.fillMaxWidth().clip(RoundedCornerShape(22.dp)).background(m.glassStrong).padding(20.dp),
+                    verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Text(if (phrase != null) "第 ${step + 1} 句" else "完成", fontSize = 15.sp, color = m.ink3)
+                    Text(phrase ?: "三句都录好了", fontSize = 24.sp, lineHeight = 32.sp, fontWeight = FontWeight.SemiBold, color = m.ink)
+                }
+                (progress ?: msg)?.let { Text(it, fontSize = 16.sp, color = m.ink2) }
+                if (!done) PillButton(
+                    when { recording && progress != null -> "准备中…"; recording -> "正在听…读出上面这句"; !hasMic -> "允许使用麦克风"; else -> "开始" },
+                    Modifier.fillMaxWidth(), primary = true, enabled = !recording) { recordOne() }
+                PillButton(if (done) "完成" else "取消", Modifier.fillMaxWidth(), primary = done, enabled = !recording) { onDone() }
+            }
+        }
+    }
+}
