+# [Mines-net-26] Network settings Mines puts into every sandbox process.
+# Read by the app at boot (PRootKernel → SandboxNet) and by the CI sandbox test,
+# so both run with exactly the same values. KEY=VALUE, no quotes, no spaces.
+# The CA lines are only applied when /etc/ssl/minis-ca.pem was built.
+SSL_CERT_FILE=/etc/ssl/minis-ca.pem
+REQUESTS_CA_BUNDLE=/etc/ssl/minis-ca.pem
+PIP_CERT=/etc/ssl/minis-ca.pem
+CURL_CA_BUNDLE=/etc/ssl/minis-ca.pem
+NODE_EXTRA_CA_CERTS=/etc/ssl/minis-ca.pem
+GIT_SSL_CAINFO=/etc/ssl/minis-ca.pem
+PIP_TIMEOUT=20
+PIP_RETRIES=3
+PIP_DISABLE_PIP_VERSION_CHECK=1
+npm_config_fetch_timeout=60000
+npm_config_fetch_retries=3
+npm_config_fetch_retry_maxtimeout=60000
